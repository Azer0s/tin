// libs/blas/complex_test - inline correctness tests for the z* (double
// precision complex) CBLAS bindings.
//
// Inputs use small integer real / imag parts so the results are exactly
// representable in IEEE 754 binary64 -- strict assert::equals works on
// every Complex field across Accelerate / OpenBLAS / MKL.

use assert
use blas
use math::complex

fn eq(a complex::Complex, b complex::Complex) =
  assert::equals(a.re, b.re)
  assert::equals(a.im, b.im)

// Build helpers - keep test bodies readable.
fn cz(re f64, im f64) complex::Complex = complex::Complex{re: re, im: im}

// ===== Level 1 =====

test "zdotc computes conj(x) . y" =
  let x [complex::Complex] = [cz(1.0, 2.0), cz(3.0, -1.0)]
  let y [complex::Complex] = [cz(4.0, 0.0), cz(0.0, 1.0)]
  // conj(x) = [(1,-2), (3,1)]; conj(x).y = (1-2i)*4 + (3+i)*i
  //         = (4 - 8i) + (3i + i^2)  = (4 - 8i) + (-1 + 3i) = 3 - 5i
  eq(blas::zdotc(x, y), cz(3.0, -5.0))

test "zdotu computes x . y (unconjugated)" =
  let x [complex::Complex] = [cz(1.0, 2.0), cz(3.0, -1.0)]
  let y [complex::Complex] = [cz(4.0, 0.0), cz(0.0, 1.0)]
  // x.y = (1+2i)*4 + (3-i)*i = (4 + 8i) + (3i - i^2)
  //     = (4 + 8i) + (1 + 3i) = 5 + 11i
  eq(blas::zdotu(x, y), cz(5.0, 11.0))

test "dzasum sums |Re| + |Im| over the vector" =
  let x [complex::Complex] = [cz(1.0, -2.0), cz(-3.0, 4.0)]
  // (1 + 2) + (3 + 4) = 10
  assert::equals(10.0, blas::dzasum(x))

test "dznrm2 is the Euclidean norm of the complex vector" =
  let x [complex::Complex] = [cz(3.0, 0.0), cz(0.0, 4.0)]
  // sqrt(|3+0i|^2 + |0+4i|^2) = sqrt(9 + 16) = 5
  assert::equals(5.0, blas::dznrm2(x))

test "zscal scales by a complex factor" =
  let x [complex::Complex] = [cz(1.0, 0.0), cz(0.0, 1.0)]
  blas::zscal(cz(0.0, 2.0), x)
  // 2i * 1     = 2i        -> (0, 2)
  // 2i * i     = -2        -> (-2, 0)
  eq(x[0], cz(0.0, 2.0))
  eq(x[1], cz(-2.0, 0.0))

test "zdscal scales by a real factor" =
  let x [complex::Complex] = [cz(1.0, -1.0), cz(2.0, 3.0)]
  blas::zdscal(0.5, x)
  eq(x[0], cz(0.5, -0.5))
  eq(x[1], cz(1.0, 1.5))

test "zaxpy: y := alpha * x + y" =
  let x [complex::Complex] = [cz(1.0, 1.0), cz(2.0, -1.0)]
  let y [complex::Complex] = [cz(0.0, 0.0), cz(0.0, 0.0)]
  blas::zaxpy(cz(0.0, 1.0), x, y)
  // alpha = i; y[0] += i*(1+i)  = i - 1   -> (-1, 1)
  //          y[1] += i*(2-i) = 2i + 1     -> (1, 2)
  eq(y[0], cz(-1.0, 1.0))
  eq(y[1], cz(1.0, 2.0))
  // x unchanged
  eq(x[0], cz(1.0, 1.0))

test "zcopy duplicates x into y" =
  let x [complex::Complex] = [cz(7.0, -8.0), cz(9.0, 10.0)]
  let y [complex::Complex] = [cz(0.0, 0.0), cz(0.0, 0.0)]
  blas::zcopy(x, y)
  eq(y[0], cz(7.0, -8.0))
  eq(y[1], cz(9.0, 10.0))

test "zswap exchanges x and y" =
  let x [complex::Complex] = [cz(1.0, 2.0), cz(3.0, 4.0)]
  let y [complex::Complex] = [cz(5.0, 6.0), cz(7.0, 8.0)]
  blas::zswap(x, y)
  // Assert every slot: a bug in unpack_z that only wrote one element
  // per array would still pass a half-checked version of this test.
  eq(x[0], cz(5.0, 6.0))
  eq(x[1], cz(7.0, 8.0))
  eq(y[0], cz(1.0, 2.0))
  eq(y[1], cz(3.0, 4.0))

test "izamax returns the 0-based index of the largest |Re|+|Im|" =
  let x [complex::Complex] = [cz(1.0, 1.0), cz(0.0, 5.0), cz(2.0, -2.0)]
  // |Re|+|Im|: 2, 5, 4 -> index 1
  assert::equals(1, blas::izamax(x))

// ===== Level 2 =====

test "zgemv: y := A * x" =
  // A = [[1, i], [1, 1]];  x = [1, 1]
  // y[0] = 1*1 + i*1 = 1 + i
  // y[1] = 1*1 + 1*1 = 2
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 1.0)],
    [cz(1.0, 0.0), cz(1.0, 0.0)],
  ]
  let x [complex::Complex] = [cz(1.0, 0.0), cz(1.0, 0.0)]
  let y [complex::Complex] = [cz(0.0, 0.0), cz(0.0, 0.0)]
  blas::zgemv(a, x, y)
  eq(y[0], cz(1.0, 1.0))
  eq(y[1], cz(2.0, 0.0))

test "zgerc: A := alpha * x * y^H + A   (conjugated outer product)" =
  // alpha = 1; x = [1, i]; y = [1, i]
  // y^H = [1, -i]
  // x * y^H = [[1*1, 1*(-i)], [i*1, i*(-i)]] = [[1, -i], [i, 1]]
  // Add to zero matrix -> same.
  let alpha = cz(1.0, 0.0)
  let x [complex::Complex] = [cz(1.0, 0.0), cz(0.0, 1.0)]
  let y [complex::Complex] = [cz(1.0, 0.0), cz(0.0, 1.0)]
  let a [[complex::Complex]] = [
    [cz(0.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(0.0, 0.0)],
  ]
  blas::zgerc(alpha, x, y, a)
  eq(a[0][0], cz(1.0, 0.0))
  eq(a[0][1], cz(0.0, -1.0))
  eq(a[1][0], cz(0.0, 1.0))
  eq(a[1][1], cz(1.0, 0.0))

test "zgeru: A := alpha * x * y^T + A   (unconjugated outer product)" =
  let alpha = cz(1.0, 0.0)
  let x [complex::Complex] = [cz(1.0, 0.0), cz(0.0, 1.0)]
  let y [complex::Complex] = [cz(1.0, 0.0), cz(0.0, 1.0)]
  // x * y^T = [[1, i], [i, -1]]
  let a [[complex::Complex]] = [
    [cz(0.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(0.0, 0.0)],
  ]
  blas::zgeru(alpha, x, y, a)
  eq(a[0][0], cz(1.0, 0.0))
  eq(a[0][1], cz(0.0, 1.0))
  eq(a[1][0], cz(0.0, 1.0))
  eq(a[1][1], cz(-1.0, 0.0))

test "zhemv: y := A * x   (A Hermitian)" =
  // A = [[2, 1+i], [1-i, 3]]  -- Hermitian (A[1][0] = conj(A[0][1]))
  // x = [1, 1]
  // y[0] = 2*1 + (1+i)*1 = 3 + i
  // y[1] = (1-i)*1 + 3*1 = 4 - i
  let a [[complex::Complex]] = [
    [cz(2.0, 0.0), cz(1.0, 1.0)],
    [cz(1.0, -1.0), cz(3.0, 0.0)],
  ]
  let x [complex::Complex] = [cz(1.0, 0.0), cz(1.0, 0.0)]
  let y [complex::Complex] = [cz(0.0, 0.0), cz(0.0, 0.0)]
  blas::zhemv(blas::UPPER, a, x, y)
  eq(y[0], cz(3.0, 1.0))
  eq(y[1], cz(4.0, -1.0))

test "ztrmv: x := A * x   (A upper triangular)" =
  // A = [[1, i], [0, 2]]; x = [1, 1]
  // x[0] := 1*1 + i*1 = 1 + i
  // x[1] := 2*1       = 2
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 1.0)],
    [cz(0.0, 0.0), cz(2.0, 0.0)],
  ]
  let x [complex::Complex] = [cz(1.0, 0.0), cz(1.0, 0.0)]
  blas::ztrmv(blas::UPPER, blas::NON_UNIT, a, x)
  eq(x[0], cz(1.0, 1.0))
  eq(x[1], cz(2.0, 0.0))

test "ztrsv: solve A * x = b   (A upper triangular)" =
  // A = [[1, i], [0, 2]]; b = [1+i, 2]  -> x = [1, 1]
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 1.0)],
    [cz(0.0, 0.0), cz(2.0, 0.0)],
  ]
  let x [complex::Complex] = [cz(1.0, 1.0), cz(2.0, 0.0)]
  blas::ztrsv(blas::UPPER, blas::NON_UNIT, a, x)
  eq(x[0], cz(1.0, 0.0))
  eq(x[1], cz(1.0, 0.0))

// ===== Level 3 =====

test "zgemm: C := A * B" =
  // A = [[1, i]], B = [[1], [i]]   (1x2 * 2x1)
  // C[0][0] = 1*1 + i*i = 0
  let a [[complex::Complex]] = [[cz(1.0, 0.0), cz(0.0, 1.0)]]
  let b [[complex::Complex]] = [[cz(1.0, 0.0)], [cz(0.0, 1.0)]]
  let c [[complex::Complex]] = [[cz(0.0, 0.0)]]
  blas::zgemm(a, b, c)
  eq(c[0][0], cz(0.0, 0.0))

test "zgemm on 2x2 identity is the identity" =
  let id [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(1.0, 0.0)],
  ]
  let b [[complex::Complex]] = [
    [cz(2.0, 1.0), cz(0.0, -1.0)],
    [cz(3.0, 0.0), cz(4.0, 5.0)],
  ]
  let c [[complex::Complex]] = [
    [cz(0.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(0.0, 0.0)],
  ]
  blas::zgemm(id, b, c)
  eq(c[0][0], b[0][0])
  eq(c[0][1], b[0][1])
  eq(c[1][0], b[1][0])
  eq(c[1][1], b[1][1])

test "zherk: C := A * A^H   (Hermitian rank-k)" =
  // A = [[1, i]] (1x2);  A * A^H = [1*1 + i*(-i)] = [2]    (1x1)
  let a [[complex::Complex]] = [[cz(1.0, 0.0), cz(0.0, 1.0)]]
  let c [[complex::Complex]] = [[cz(0.0, 0.0)]]
  blas::zherk(blas::UPPER, 1.0, a, 0.0, c)
  // C is Hermitian -> upper triangle holds (2, 0).  Diagonal is real
  // by construction.
  assert::equals(2.0, c[0][0].re)
  assert::equals(0.0, c[0][0].im)

test "zhemm with LEFT side: C := A * B   (A Hermitian)" =
  // A = [[1, 0], [0, 1]] (identity, trivially Hermitian)
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(1.0, 0.0)],
  ]
  let b [[complex::Complex]] = [
    [cz(1.0, 1.0), cz(2.0, 0.0)],
    [cz(3.0, 0.0), cz(4.0, -1.0)],
  ]
  let c [[complex::Complex]] = [
    [cz(0.0, 0.0), cz(0.0, 0.0)],
    [cz(0.0, 0.0), cz(0.0, 0.0)],
  ]
  blas::zhemm(blas::LEFT, blas::UPPER, a, b, c)
  // Identity A means every slot of C must equal B, including
  // off-diagonal entries.  Half-checking the diagonal would let a
  // half-broken pack_zmat / unpack_zmat slip through.
  eq(c[0][0], b[0][0])
  eq(c[0][1], b[0][1])
  eq(c[1][0], b[1][0])
  eq(c[1][1], b[1][1])

test "ztrmm: B := A * B   (A upper triangular, side=LEFT, no transpose)" =
  // A = [[1, i], [0, 2]];  B = [[1], [1]]
  // (A * B)[0] = 1 + i;   (A * B)[1] = 2
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 1.0)],
    [cz(0.0, 0.0), cz(2.0, 0.0)],
  ]
  let b [[complex::Complex]] = [[cz(1.0, 0.0)], [cz(1.0, 0.0)]]
  blas::ztrmm(blas::LEFT, blas::UPPER, blas::NON_UNIT, cz(1.0, 0.0), a, b)
  eq(b[0][0], cz(1.0, 1.0))
  eq(b[1][0], cz(2.0, 0.0))

test "ztrsm: solve A * X = B   (A upper triangular, side=LEFT)" =
  // A = [[1, i], [0, 2]];  B = [[1+i], [2]];  X = [[1], [1]]
  let a [[complex::Complex]] = [
    [cz(1.0, 0.0), cz(0.0, 1.0)],
    [cz(0.0, 0.0), cz(2.0, 0.0)],
  ]
  let b [[complex::Complex]] = [[cz(1.0, 1.0)], [cz(2.0, 0.0)]]
  blas::ztrsm(blas::LEFT, blas::UPPER, blas::NON_UNIT, cz(1.0, 0.0), a, b)
  eq(b[0][0], cz(1.0, 0.0))
  eq(b[1][0], cz(1.0, 0.0))
