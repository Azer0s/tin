// libs/sqlite/sqlite_test - end-to-end tests for the blocking
// sqlite bindings.  Each test creates and drops an isolated table so
// the suite stays deterministic across re-runs.

use sqlite
use { sql } from sqlite
use assert

const TEST_DB = "/tmp/tin_sqlite_test.db"

fn fresh_db() sqlite::Connection =
  return sqlite::open(TEST_DB).unwrap()

test "open + exec + close round-trip" =
  let db = fresh_db()
  let n  i64 = db.exec("DROP TABLE IF EXISTS smoke_a", [])
  assert::ok(n == 0)
  let n2 i64 = db.exec("CREATE TABLE smoke_a (id INTEGER)", [])
  assert::ok(n2 == 0)
  db.close()

test "exec with Int param inserts row" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS smoke_b", [])
  let _create i64 = db.exec("CREATE TABLE smoke_b (id INTEGER)", [])
  let r i64 = db.exec("INSERT INTO smoke_b VALUES (?)", [Int(42)])
  assert::ok(r == 1)
  db.close()

test "exec with Text param inserts row" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS smoke_c", [])
  let _create i64 = db.exec("CREATE TABLE smoke_c (name TEXT)", [])
  let r i64 = db.exec("INSERT INTO smoke_c VALUES (?)", [Text("alice")])
  assert::ok(r == 1)
  db.close()

test "exec with mixed Int + Text params inserts row" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS smoke_d", [])
  let _create i64 = db.exec("CREATE TABLE smoke_d (id INTEGER, name TEXT)", [])
  let r i64 = db.exec("INSERT INTO smoke_d VALUES (?, ?)", [Int(7), Text("bob")])
  assert::ok(r == 1)
  db.close()

test "exec without params still works" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS smoke_e", [])
  let _create i64 = db.exec("CREATE TABLE smoke_e (x INTEGER)", [])
  let r i64 = db.exec("INSERT INTO smoke_e VALUES (99)", [])
  assert::ok(r == 1)
  db.close()

test "exec on bad SQL returns negative error code" =
  let db = fresh_db()
  let n i64 = db.exec("THIS IS NOT VALID SQL", [])
  assert::ok(n < 0)
  db.close()

test "query returns Rows with correct row + column counts" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_a", [])
  let _create i64 = db.exec("CREATE TABLE q_a (id INTEGER, name TEXT)", [])
  let _ia i64 = db.exec("INSERT INTO q_a VALUES (?, ?)", [Int(1), Text("alice")])
  let _ib i64 = db.exec("INSERT INTO q_a VALUES (?, ?)", [Int(2), Text("bob")])
  let rows = db.query("SELECT id, name FROM q_a ORDER BY id", []).unwrap()
  assert::ok(rows.count() == 2)
  assert::ok(rows.cols()  == 2)
  db.close()

test "query Int and Text getters return correct cell values" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_b", [])
  let _create i64 = db.exec("CREATE TABLE q_b (id INTEGER, name TEXT)", [])
  let _ia i64 = db.exec("INSERT INTO q_b VALUES (?, ?)", [Int(7), Text("hello")])
  let rows = db.query("SELECT id, name FROM q_b", []).unwrap()
  assert::ok(rows.count() == 1)
  let id   i64    = rows.get_i64(0, 0)
  let name string = rows.get_string(0, 1)
  assert::ok(id == 7)
  assert::ok(name == "hello")
  db.close()

test "query with WHERE param filters rows" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_c", [])
  let _create i64 = db.exec("CREATE TABLE q_c (id INTEGER)", [])
  let _ia i64 = db.exec("INSERT INTO q_c VALUES (?)", [Int(1)])
  let _ib i64 = db.exec("INSERT INTO q_c VALUES (?)", [Int(2)])
  let _ic i64 = db.exec("INSERT INTO q_c VALUES (?)", [Int(3)])
  let rows = db.query("SELECT id FROM q_c WHERE id >= ? ORDER BY id", [Int(2)]).unwrap()
  assert::ok(rows.count() == 2)
  assert::ok(rows.get_i64(0, 0) == 2)
  assert::ok(rows.get_i64(1, 0) == 3)
  db.close()

test "query on empty table returns zero rows" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_d", [])
  let _create i64 = db.exec("CREATE TABLE q_d (x INTEGER)", [])
  let rows = db.query("SELECT x FROM q_d", []).unwrap()
  assert::ok(rows.count() == 0)
  db.close()

test "Real param + get_f64 round-trip" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_f", [])
  let _create i64 = db.exec("CREATE TABLE q_f (x REAL)", [])
  let _i i64 = db.exec("INSERT INTO q_f VALUES (?)", [Real(3.14159)])
  let rows = db.query("SELECT x FROM q_f", []).unwrap()
  assert::ok(rows.count() == 1)
  let v f64 = rows.get_f64(0, 0)
  assert::ok(v > 3.14158 && v < 3.14160)
  db.close()

test "implicit coerce: bare i64/string in params array" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_imp", [])
  let _create i64 = db.exec("CREATE TABLE q_imp (id INTEGER, name TEXT)", [])
  let params [sqlite::SqlValue] = [42, "alice"]
  let _i i64 = db.exec("INSERT INTO q_imp VALUES (?, ?)", params)
  let rows = db.query("SELECT id, name FROM q_imp", []).unwrap()
  assert::ok(rows.count() == 1)
  assert::ok(rows.get_i64(0, 0) == 42)
  assert::ok(rows.get_string(0, 1) == "alice")
  db.close()

test "is_null detects SQL NULL columns" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS q_e", [])
  let _create i64 = db.exec("CREATE TABLE q_e (a INTEGER, b TEXT)", [])
  let _ia i64 = db.exec("INSERT INTO q_e VALUES (?, NULL)", [Int(1)])
  let rows = db.query("SELECT a, b FROM q_e", []).unwrap()
  assert::ok(rows.count() == 1)
  assert::ok(rows.is_null(0, 0) == false)
  assert::ok(rows.is_null(0, 1) == true)
  db.close()

test "_sql macro: identifier placeholders rewrite to `?` + params array" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS m_a", [])
  let _create i64 = db.exec("CREATE TABLE m_a (id INTEGER, name TEXT)", [])
  let id   i64    = 11
  let name string = "carol"
  let n i64 = db.run("INSERT INTO m_a VALUES ({id}, {name})"_sql)
  assert::ok(n == 1)
  let rows = db.fetch("SELECT id, name FROM m_a"_sql).unwrap()
  assert::ok(rows.count() == 1)
  assert::ok(rows.get_i64(0, 0) == 11)
  assert::ok(rows.get_string(0, 1) == "carol")
  db.close()

test "_sql macro: WHERE clause with single ident binds correctly" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS m_b", [])
  let _create i64 = db.exec("CREATE TABLE m_b (id INTEGER)", [])
  let _i1 i64 = db.exec("INSERT INTO m_b VALUES (1)", [])
  let _i2 i64 = db.exec("INSERT INTO m_b VALUES (2)", [])
  let _i3 i64 = db.exec("INSERT INTO m_b VALUES (3)", [])
  let cutoff i64 = 2
  let rows = db.fetch("SELECT id FROM m_b WHERE id >= {cutoff} ORDER BY id"_sql).unwrap()
  assert::ok(rows.count() == 2)
  assert::ok(rows.get_i64(0, 0) == 2)
  assert::ok(rows.get_i64(1, 0) == 3)
  db.close()

test "Connection.exec_is: shape-specialized fast path" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS h_a", [])
  let _create i64 = db.exec("CREATE TABLE h_a (id INTEGER, name TEXT)", [])
  let n i64 = db.exec_is("INSERT INTO h_a VALUES (?, ?)", 5, "eve")
  assert::ok(n == 1)
  let rows = db.query("SELECT id, name FROM h_a", []).unwrap()
  assert::ok(rows.count() == 1)
  assert::ok(rows.get_i64(0, 0) == 5)
  assert::ok(rows.get_string(0, 1) == "eve")
  db.close()

test "stmt cache: hot-loop INSERTs reuse the prepared statement" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS m_cache", [])
  let _create i64 = db.exec("CREATE TABLE m_cache (id INTEGER)", [])
  for let i i64 = 0; i < 200; i = i + 1:
    let _n i64 = db.exec("INSERT INTO m_cache VALUES (?)", [Int(i)])
  let rows = db.query("SELECT COUNT(*) FROM m_cache", []).unwrap()
  assert::ok(rows.get_i64(0, 0) == 200)
  let last = db.query("SELECT id FROM m_cache ORDER BY id DESC LIMIT 1", []).unwrap()
  assert::ok(last.get_i64(0, 0) == 199)
  db.close()

test "Stmt: prepare-once + bind/step/reset loop inserts all rows" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS s_a", [])
  let _create i64 = db.exec("CREATE TABLE s_a (id INTEGER, name TEXT)", [])
  let stmt = db.prepare("INSERT INTO s_a VALUES (?, ?)").unwrap()
  for let i i64 = 0; i < 5; i = i + 1:
    let _b1 i32 = stmt.bind_int(1, i)
    let _b2 i32 = stmt.bind_text(2, "row")
    let n i64 = stmt.step()
    assert::ok(n == 1)
    stmt.reset()
  stmt.close()
  let rows = db.query("SELECT COUNT(*) FROM s_a", []).unwrap()
  assert::ok(rows.get_i64(0, 0) == 5)
  db.close()

test "Stmt: exec_is combinator binds int+text + step in one call" =
  let db = fresh_db()
  let _drop i64 = db.exec("DROP TABLE IF EXISTS s_b", [])
  let _create i64 = db.exec("CREATE TABLE s_b (id INTEGER, name TEXT)", [])
  let stmt = db.prepare("INSERT INTO s_b VALUES (?, ?)").unwrap()
  for let i i64 = 0; i < 5; i = i + 1:
    let n i64 = stmt.exec_is(i, "row")
    assert::ok(n == 1)
  stmt.close()
  let rows = db.query("SELECT COUNT(*), MAX(id) FROM s_b", []).unwrap()
  assert::ok(rows.get_i64(0, 0) == 5)
  assert::ok(rows.get_i64(0, 1) == 4)
  db.close()

test "Stmt: bad SQL returns Err from prepare" =
  let db = fresh_db()
  let r = db.prepare("THIS IS NOT VALID SQL")
  match r:
    case Ok(_): assert::ok(false)
    case Err(_): assert::ok(true)
  db.close()

test "explicit Int / Text construction round-trips through match" =
  match Int(42):
    case Int(v): assert::ok(v == 42)
    case Real(_): assert::ok(false)
    case Text(_): assert::ok(false)
    case Null: assert::ok(false)
  match Text("hi"):
    case Int(_): assert::ok(false)
    case Real(_): assert::ok(false)
    case Text(s): assert::ok(s == "hi")
    case Null: assert::ok(false)
