//!+sqlite_worker.c -- -lsqlite3
// libs/sqlite - async SQLite bindings.
//
// Each Connection owns a dedicated worker pthread that holds the
// sqlite3* handle exclusively.  Tin fibers submit tasks through an
// MPSC queue; results come back via a per-call Completion that the
// Tin side awaits as a typed `SqliteCall[T]`.  No fiber blocks on a
// pthread primitive directly -- the worker unparks the awaiting
// fiber through _tin_fiber_unpark_fib.
//
//   use sqlite
//   use { Int, Text } from sqlite
//
//   let db = sqlite::open("test.db").unwrap()
//   await db.exec("CREATE TABLE users (id INTEGER, name TEXT)")
//   await db.exec("INSERT INTO users VALUES (?, ?)", [Int(1), Text("alice")])
//   db.close()

use rc
use errors
use result
use { Result } from result

// ---------------------------------------------------------------------------
// SqlValue: tagged input value, one per parameter slot.
// ---------------------------------------------------------------------------

data SqlValue (implicit[i64], implicit[f64], implicit[string]) =
  Int(v i64)
  Real(v f64)
  Text(v string)
  Null

  // implicit lets call sites pass bare primitives in the params
  // array: `db.exec("...", [id, name, score])` instead of
  // `[Int(id), Text(name), Real(score)]`.  Tin's coerce path picks
  // the matching impl per element type.
  static fn ::implicit(v i64) SqlValue    = return Int(v)
  static fn ::implicit(v f64) SqlValue    = return Real(v)
  static fn ::implicit(s string) SqlValue = return Text(s)

// SqlQuery bundles a parameterised SQL statement and its bound
// values.  Produced by the `_sql` suffix macro and consumed by
// Connection.run / Connection.fetch.
struct SqlQuery =
  sql    string
  params [SqlValue]

// `_sql` rewrites `"... {ident} ..."_sql` at compile time into
// `SqlQuery{sql: "... ? ...", params: [ident, ...]}`.  Each `{name}`
// becomes a `?` placeholder; the named identifier flows in as a
// raw value, which the SqlValue implicit-coerce wraps element-wise
// when the array lands in the SqlQuery.params field.
//
// Brace escapes work the standard way: `\{` and `\}` survive as
// literal text and are NOT treated as placeholders.
macro{#suffix@string #no_excl #no_parens} sql(s) =
  let rewritten string = ""
  let idents    string = ""
  let i i64 = 0
  let n i64 = 0
  for let _k i64 = 0; i < len(s); _k = _k + 1:
    if s[i..i+1] == "{":
      let j i64 = i + 1
      for let _m i64 = 0; s[j..j+1] != "}"; _m = _m + 1:
        j = j + 1
      if n > 0:
        idents = idents ++ ", "
      idents = idents ++ s[i+1..j]
      rewritten = rewritten ++ "?"
      n = n + 1
      i = j + 1
    else:
      rewritten = rewritten ++ s[i..i+1]
      i = i + 1
  let sql_lit string = "\"" ++ rewritten ++ "\""
  return `sqlite::SqlQuery{sql: {sql_lit}, params: [{idents}]}`

// Params marshal as three parallel arrays (tags, ints, texts).  For
// each Int param: tag=1, int holds the value, text="".  For each
// Text param: tag=3, text holds the string, int=0.  For Null:
// tag=5.  Real / Blob land in v2 -- they'd need extra slots (f64
// array, *byte+len arrays) and aren't blocking the common case.
// Parallel `[i64]` / `[string]` lowers cleanly through the C ABI;
// `[T]` of a user struct carries a vtable header that C can't model.

// ---------------------------------------------------------------------------
// C externs
// ---------------------------------------------------------------------------

fn c_sqlite_open(path string) *void = extern("_tin_sqlite_open")
fn c_sqlite_close(conn *void)       = extern("_tin_sqlite_close")
fn c_sqlite_submit_exec(conn *void, sql string, tags [i64], ints [i64], reals [f64], texts [*char], n_params i64) *void = extern("_tin_sqlite_submit_exec")
fn c_sqlite_submit_query(conn *void, sql string, tags [i64], ints [i64], reals [f64], texts [*char], n_params i64) *void = extern("_tin_sqlite_submit_query")
fn c_sqlite_exec_blocking(conn *void, sql string, tags [i64], ints [i64], reals [f64], texts [*char], n_params i64) i64 = extern("_tin_sqlite_exec_blocking")

fn c_stmt_prepare(conn *void, sql string, out_rc *i32) *void = extern("_tin_sqlite_stmt_prepare")
fn c_stmt_finalize(p *void)                                  = extern("_tin_sqlite_stmt_finalize")
fn c_stmt_bind_int(p *void, idx i32, v i64)             i32  = extern("_tin_sqlite_stmt_bind_int")
fn c_stmt_bind_real(p *void, idx i32, v f64)            i32  = extern("_tin_sqlite_stmt_bind_real")
fn c_stmt_bind_text(p *void, idx i32, s *char, n i64)   i32  = extern("_tin_sqlite_stmt_bind_text")
fn c_stmt_bind_null(p *void, idx i32)                   i32  = extern("_tin_sqlite_stmt_bind_null")
fn c_stmt_step(p *void)                                 i64  = extern("_tin_sqlite_stmt_step")
fn c_stmt_reset(p *void)                                     = extern("_tin_sqlite_stmt_reset")

fn c_completion_ready(p *void)        i32    = extern("_tin_sqlite_completion_ready")
fn c_completion_take(p *void)         i64    = extern("_tin_sqlite_completion_take")
fn c_completion_take_ptr(p *void)     *void  = extern("_tin_sqlite_completion_take_ptr")
fn c_completion_err(p *void)          string = extern("_tin_sqlite_completion_err")
fn c_completion_free(p *void)                = extern("_tin_sqlite_completion_free")

fn c_rows_free(p *void)                        = extern("_tin_sqlite_rows_free")
fn c_rows_count(p *void)              i64      = extern("_tin_sqlite_rows_count")
fn c_rows_cols(p *void)               i64      = extern("_tin_sqlite_rows_cols")
fn c_rows_get_i64(p *void, r i64, c i64) i64   = extern("_tin_sqlite_rows_get_i64")
fn c_rows_get_f64(p *void, r i64, c i64) f64   = extern("_tin_sqlite_rows_get_f64")
fn c_rows_get_text(p *void, r i64, c i64, out *string) = extern("_tin_sqlite_rows_get_text")
fn c_rows_is_null(p *void, r i64, c i64) i32   = extern("_tin_sqlite_rows_is_null")

fn c_str_data(s string) *char                  = extern("_tin_string_data")

// ---------------------------------------------------------------------------
// Errors
// ---------------------------------------------------------------------------

data SqliteError(errors::Err, print) =
  OpenFailed(path string)
  ExecFailed(code i32, msg string)

  fn errors::Err::message(this SqliteError) string =
    match this:
      case OpenFailed(p):     return "sqlite: open failed for {p}"
      case ExecFailed(c, m):  return "sqlite: exec failed (code {c}): {m}"

  fn ::print(this SqliteError) string = return this.message()

// ---------------------------------------------------------------------------
// Awaitable for a single sqlite call.
// ---------------------------------------------------------------------------
//
// SqliteCall[T] wraps a Completion handle.  awaitable::result blocks
// (via _tin_fiber_park inside completion_take) until the worker has
// signalled the completion, then casts the raw i64 result back to T.

// ---------------------------------------------------------------------------
// Rows: materialized SELECT result, packed in a C-side buffer.
// ---------------------------------------------------------------------------
//
// Each cell holds a tag + the matching payload; get_*(row, col) is a
// pure C memcpy with no await.  The Rows handle owns the buffer via
// an rc::Cell so iterating + copying Rows shares ownership and the
// buffer is freed on the last drop.

struct Rows =
  cell *rc::Cell[*void]   // owns the result_set_t*

  fn count(this Rows) i64 = return c_rows_count(this.cell.payload())
  fn cols(this Rows)  i64 = return c_rows_cols(this.cell.payload())

  // get_* are named per type because Tin's `where t is X` guards
  // narrow on primitive WIDTH categories (w1/w2/w4/w8), not on
  // specific named types -- the generic `get[t]` body can't be
  // type-checked under the constraint.  We could revisit if
  // where-guards grow per-type narrowing.
  fn get_i64(this Rows, row i64, col i64) i64 =
    return c_rows_get_i64(this.cell.payload(), row, col)

  fn get_f64(this Rows, row i64, col i64) f64 =
    return c_rows_get_f64(this.cell.payload(), row, col)

  fn get_string(this Rows, row i64, col i64) string =
    let out string = ""
    c_rows_get_text(this.cell.payload(), row, col, &out)
    return out

  fn is_null(this Rows, row i64, col i64) bool =
    return c_rows_is_null(this.cell.payload(), row, col) != 0

// SqliteCall[t] is the awaitable for value-typed results (currently
// just i64 for exec rowcount).  Future scalar-result ops slot in via
// new where-guards on `t`.
struct SqliteCall[t](awaitable[t]) =
  cell *rc::Cell[*void]   // owns the completion_t*; dtor frees it

  fn awaitable[t]::ready(this SqliteCall[t]) bool =
    return c_completion_ready(this.cell.payload()) != 0

  fn awaitable[t]::result(this SqliteCall[t]) t where t is i64 =
    return c_completion_take(this.cell.payload())

// SqliteQuery is the awaitable for query results (`Rows`).  Split
// from SqliteCall because where-guards only narrow on primitive types,
// not on user-defined structs.
struct SqliteQuery(awaitable[Rows]) =
  cell *rc::Cell[*void]

  fn awaitable[Rows]::ready(this SqliteQuery) bool =
    return c_completion_ready(this.cell.payload()) != 0

  fn awaitable[Rows]::result(this SqliteQuery) Rows =
    let p *void = c_completion_take_ptr(this.cell.payload())
    return Rows{cell: rc::Cell[*void].new(p, c_rows_free)}

// ---------------------------------------------------------------------------
// Connection
// ---------------------------------------------------------------------------

// Stmt is a user-managed prepared statement.  Each bind/step/reset is
// one direct C call; no Tin-side array marshalling.  Use for hot
// inner loops where exec_blocking's per-call allocations show up.
//
//   let stmt = db.prepare("INSERT INTO t VALUES (?, ?)").unwrap()
//   for let i i64 = 0; i < n; i = i + 1:
//     stmt.bind_int(1, i)
//     stmt.bind_text(2, "row")
//     stmt.step()
//     stmt.reset()
//   stmt.close()
//
// All operations take the same per-conn mutex the async worker uses;
// safe to interleave with `await db.exec(...)` on the same Connection.
struct Stmt (io::Closeable) =
  cell *rc::Cell[*void]   // owns the C stmt_handle_t*; dtor finalizes the stmt

  fn bind_int(this Stmt, idx i64, v i64) i32 =
    return c_stmt_bind_int(this.cell.payload(), idx as i32, v)

  fn bind_real(this Stmt, idx i64, v f64) i32 =
    return c_stmt_bind_real(this.cell.payload(), idx as i32, v)

  fn bind_text(this Stmt, idx i64, v string) i32 =
    return c_stmt_bind_text(this.cell.payload(), idx as i32, c_str_data(v), len(v))

  fn bind_null(this Stmt, idx i64) i32 =
    return c_stmt_bind_null(this.cell.payload(), idx as i32)

  // step returns changes() on SQLITE_DONE, -1 on SQLITE_ROW (caller
  // should iterate via the query-row path), or -(error_code).
  fn step(this Stmt) i64 = return c_stmt_step(this.cell.payload())

  fn reset(this Stmt) = c_stmt_reset(this.cell.payload())

  fn io::Closeable::close(this Stmt) =
    c_stmt_finalize(this.cell.payload())
    this.cell.set(nil)

struct Connection (io::Closeable) =
  cell *rc::Cell[*void]   // owns the C conn_t*; dtor sends SHUTDOWN + joins

  // exec runs a statement that returns no rows.  Result is the count
  // from sqlite3_changes(), or a negated SQLite error code.
  //
  // The param-marshalling loop is inlined (not a helper fn) because
  // Tin autocopies fat-array parameters -- mutations inside a helper
  // don't propagate back to the caller's array.
  fn exec(this Connection, sql string, params [SqlValue]) SqliteCall[i64] =
    let n i64 = len(params)
    let slots i64 = if_zero_use_one(n)
    let tags  [i64]   = [0] * slots
    let ints  [i64]   = [0] * slots
    let reals [f64]   = [0.0] * slots
    let text_keep [string] = [""] * slots
    let text_ptrs [*char]  = [nil as *char] * slots
    for let i i64 = 0; i < n; i = i + 1:
      match params[i]:
        case Int(v):
          tags[i] = 1
          ints[i] = v
        case Real(v):
          tags[i]  = 2
          reals[i] = v
        case Text(s):
          tags[i]      = 3
          text_keep[i] = s
          text_ptrs[i] = c_str_data(s)
        case Null:
          tags[i] = 5
    let p *void = c_sqlite_submit_exec(this.cell.payload(), sql, tags, ints, reals, text_ptrs, n)
    return SqliteCall[i64]{cell: rc::Cell[*void].new(p, c_completion_free)}

  // query runs a statement and returns a materialized Rows handle
  // covering every row of the result set.
  fn query(this Connection, sql string, params [SqlValue]) SqliteQuery =
    let n i64 = len(params)
    let slots i64 = if_zero_use_one(n)
    let tags  [i64]   = [0] * slots
    let ints  [i64]   = [0] * slots
    let reals [f64]   = [0.0] * slots
    let text_keep [string] = [""] * slots
    let text_ptrs [*char]  = [nil as *char] * slots
    for let i i64 = 0; i < n; i = i + 1:
      match params[i]:
        case Int(v):
          tags[i] = 1
          ints[i] = v
        case Real(v):
          tags[i]  = 2
          reals[i] = v
        case Text(s):
          tags[i]      = 3
          text_keep[i] = s
          text_ptrs[i] = c_str_data(s)
        case Null:
          tags[i] = 5
    let p *void = c_sqlite_submit_query(this.cell.payload(), sql, tags, ints, reals, text_ptrs, n)
    return SqliteQuery{cell: rc::Cell[*void].new(p, c_completion_free)}

  // exec_blocking runs the same workload as exec, but on the
  // caller's thread (no fiber park/unpark, no worker round-trip).
  // Takes a per-connection mutex shared with the async worker;
  // uncontended when only blocking calls are in flight.
  //
  // Use when the call is known to be fast (cached stmt, no long
  // SELECT, no contended write).  Slow sqlite calls inside
  // exec_blocking pin the fiber's worker thread.
  fn exec_blocking(this Connection, sql string, params [SqlValue]) i64 =
    let n i64 = len(params)
    let slots i64 = if_zero_use_one(n)
    let tags  [i64]   = [0] * slots
    let ints  [i64]   = [0] * slots
    let reals [f64]   = [0.0] * slots
    let text_keep [string] = [""] * slots
    let text_ptrs [*char]  = [nil as *char] * slots
    for let i i64 = 0; i < n; i = i + 1:
      match params[i]:
        case Int(v):
          tags[i] = 1
          ints[i] = v
        case Real(v):
          tags[i]  = 2
          reals[i] = v
        case Text(s):
          tags[i]      = 3
          text_keep[i] = s
          text_ptrs[i] = c_str_data(s)
        case Null:
          tags[i] = 5
    return c_sqlite_exec_blocking(this.cell.payload(), sql, tags, ints, reals, text_ptrs, n)

  // prepare compiles a SQL statement into a reusable Stmt.  Use for
  // hot loops where exec_blocking's per-call array marshalling is the
  // bottleneck.  Returns Err on compile error.
  fn prepare(this Connection, sql string) Result[Stmt, errors::Err] =
    let rc i32 = 0
    let p *void = c_stmt_prepare(this.cell.payload(), sql, &rc)
    if p == nil:
      return Err(ExecFailed(rc, "prepare failed"))
    return Ok(Stmt{cell: rc::Cell[*void].new(p, c_stmt_finalize)})

  // run is the SqlQuery-shaped twin of exec: takes the bundle the
  // `_sql` macro produces and threads sql + params through to exec.
  fn run(this Connection, q SqlQuery) SqliteCall[i64] =
    return this.exec(q.sql, q.params)

  // fetch is the SqlQuery-shaped twin of query.
  fn fetch(this Connection, q SqlQuery) SqliteQuery =
    return this.query(q.sql, q.params)

  fn io::Closeable::close(this Connection) =
    c_sqlite_close(this.cell.payload())
    this.cell.set(nil)

fn if_zero_use_one(n i64) i64 =
  if n > 0:
    return n
  return 1

// open opens (or creates) the database at path and spawns its worker.
fn open(path string) Result[Connection, errors::Err] =
  let p *void = c_sqlite_open(path)
  if p == nil:
    return Err(OpenFailed(path))
  return Ok(Connection{cell: rc::Cell[*void].new(p, c_sqlite_close)})

export {
  Connection, SqliteError,
  SqliteCall, SqliteQuery,
  SqlValue, SqlQuery, Rows, Stmt,
  sql,
  open,
} as sqlite
