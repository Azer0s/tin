fn is_key_down(key i32) bool = extern("IsKeyDown")
fn is_key_pressed(key i32) bool = extern("IsKeyPressed")
fn is_key_released(key i32) bool = extern("IsKeyReleased")
fn is_key_up(key i32) bool = extern("IsKeyUp")
fn get_key_pressed() i32 = extern("GetKeyPressed")
fn is_mouse_button_down(button i32) bool = extern("IsMouseButtonDown")
fn is_mouse_button_pressed(button i32) bool = extern("IsMouseButtonPressed")
fn get_mouse_x() i32 = extern("GetMouseX")
fn get_mouse_y() i32 = extern("GetMouseY")
fn get_random_value(min i32, max i32) i32 = extern("GetRandomValue")
