// bench/sqlite/tin_inserts_prepared - same workload as tin_inserts*
// but using the Stmt API: prepare once, then bind+step+reset directly
// per row.  No per-call Tin-side array marshalling, one FFI call per
// bind/step/reset.
//
// Usage: ./tin_inserts_prepared N

use sqlite
use strings
use measure

const DB_PATH = "/tmp/tin_sqlite_bench_prepared.db"

fn{#async} main(args [string]) =
  if len(args) < 2:
    echo("usage: tin_inserts_prepared N")
    return

  let total i64 = strings::atol(args[1])

  let db = sqlite::open(DB_PATH).unwrap()

  let _w  i64 = db.exec_blocking("PRAGMA journal_mode=WAL", [])
  let _s  i64 = db.exec_blocking("PRAGMA synchronous=NORMAL", [])
  let _d  i64 = db.exec_blocking("DROP TABLE IF EXISTS bench", [])
  let _c  i64 = db.exec_blocking("CREATE TABLE bench (i INTEGER, name TEXT)", [])
  let _b  i64 = db.exec_blocking("BEGIN", [])

  let stmt = db.prepare("INSERT INTO bench (i, name) VALUES (?, ?)").unwrap()

  let t0 i64 = measure::now_us()

  for let i i64 = 0; i < total; i = i + 1:
    let _b1 i32 = stmt.bind_int(1, i)
    let _b2 i32 = stmt.bind_text(2, "row")
    let _n i64 = stmt.step()
    stmt.reset()

  let t1 i64 = measure::now_us()

  stmt.close()
  let _co i64 = db.exec_blocking("COMMIT", [])

  let elapsed_us i64 = t1 - t0
  let ops_per_sec i64 = total * 1000000 / elapsed_us
  echo("n={total} elapsed_us={elapsed_us} ops_per_sec={ops_per_sec}")

  db.close()
