// bench/sqlite/tin_inserts - high-level API: INSERT N rows via
// db.exec_is on the Connection.  One FFI call per row, no SqlValue
// boxing, no params-array allocation.  This is the idiomatic Tin
// path for hot-loop inserts; for maximum throughput see
// tin_inserts_stmt.tin which prepares the stmt once.
//
// Usage: ./tin_inserts N

use sqlite
use strings
use measure

const DB_PATH = "/tmp/tin_sqlite_bench.db"

fn main(args [string]) =
  if len(args) < 2:
    echo("usage: tin_inserts N")
    return

  let total i64 = strings::atol(args[1])

  let db = sqlite::open(DB_PATH).unwrap()
  let _w  i64 = db.exec("PRAGMA journal_mode=WAL", [])
  let _s  i64 = db.exec("PRAGMA synchronous=NORMAL", [])
  let _d  i64 = db.exec("DROP TABLE IF EXISTS bench", [])
  let _c  i64 = db.exec("CREATE TABLE bench (i INTEGER, name TEXT)", [])
  let _b  i64 = db.exec("BEGIN", [])

  let sql string = "INSERT INTO bench (i, name) VALUES (?, ?)"

  let t0 i64 = measure::now_us()
  for let i i64 = 0; i < total; i = i + 1:
    let _n i64 = db.exec_is(sql, i, "row")
  let t1 i64 = measure::now_us()

  let _co i64 = db.exec("COMMIT", [])

  let elapsed_us i64 = t1 - t0
  let ops_per_sec i64 = total * 1000000 / elapsed_us
  echo("n={total} elapsed_us={elapsed_us} ops_per_sec={ops_per_sec}")

  db.close()
