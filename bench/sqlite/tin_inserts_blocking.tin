// bench/sqlite/tin_inserts_blocking - same workload as
// tin_inserts.tin but using db.exec_blocking instead of `await
// db.exec`.  Skips the per-call worker-thread round-trip + fiber
// park/unpark; the call goes straight to sqlite on the caller's
// thread.  Useful when the call is known to be fast (cached stmt,
// no long-running SELECT, no contended write).
//
// Usage: ./tin_inserts_blocking N

use sqlite
use strings
use measure

const DB_PATH = "/tmp/tin_sqlite_bench_blocking.db"

fn{#async} main(args [string]) =
  if len(args) < 2:
    echo("usage: tin_inserts_blocking N")
    return

  let total i64 = strings::atol(args[1])

  let db = sqlite::open(DB_PATH).unwrap()

  let _w  i64 = db.exec_blocking("PRAGMA journal_mode=WAL", [])
  let _s  i64 = db.exec_blocking("PRAGMA synchronous=NORMAL", [])
  let _d  i64 = db.exec_blocking("DROP TABLE IF EXISTS bench", [])
  let _c  i64 = db.exec_blocking("CREATE TABLE bench (i INTEGER, name TEXT)", [])
  let _b  i64 = db.exec_blocking("BEGIN", [])

  let t0 i64 = measure::now_us()

  // Hoist the literal-string ops -- c_str_data + len are pure but
  // Tin doesn't constant-fold extern calls, so without this they run
  // every iteration.
  let row_text string = "row"
  let sql string = "INSERT INTO bench (i, name) VALUES (?, ?)"
  for let i i64 = 0; i < total; i = i + 1:
    // exec_is takes raw primitives directly: no SqlValue boxing,
    // no array allocation, one FFI call per row.
    let _n i64 = db.exec_is(sql, i, row_text)

  let t1 i64 = measure::now_us()

  let _co i64 = db.exec_blocking("COMMIT", [])

  let elapsed_us i64 = t1 - t0
  let ops_per_sec i64 = total * 1000000 / elapsed_us
  echo("n={total} elapsed_us={elapsed_us} ops_per_sec={ops_per_sec}")

  db.close()
