// examples/fibers/panic_propagation.tin
//
// Tests that panics from awaited fibers propagate to the awaiting fiber,
// where they can be caught with defer + recover().
//
// Fire-and-forget fibers that panic are checked at loop back edges: an async
// function that loops after spawning (but not awaiting) a panicking fiber will
// receive the panic at the next auto-yield, where it can be caught via recover().
// Fibers that complete before any loop edge or that are never looped over will
// still be detected at scheduler shutdown.
//
// Run with: tin test examples/fibers/panic_propagation.tin

use assert
use sync

fn{#async} always_panics() i64 =
  panic("boom from fiber")
  return 0

fn{#async} panics_with_value(msg string) =
  panic(msg)

fn{#async} returns_normally() i64 =
  return 42

// Panic from awaited fiber is catchable

test "await panic propagates to caller" =
  let caught string = ""

  defer do:
    let msg = recover()

    if len(msg) > 0:
      caught = msg

  let f = spawn always_panics()

  await f
  // unreachable if panic propagated
  assert::ok(false)

test "await panic message is preserved" =
  let caught string = ""

  defer do:
    let msg = recover()

    if len(msg) > 0:
      caught = msg

  let f = spawn panics_with_value("my error")

  await f
  assert::equals(caught, "my error")

test "no panic from awaited fiber leaves caught empty" =
  let caught string = ""

  defer do:
    let msg = recover()

    if len(msg) > 0:
      caught = msg

  let f = spawn returns_normally()
  let v = await f

  assert::equals(v, 42)
  assert::equals(caught, "")

test "panic does not affect subsequent fibers" =
  let caught string = ""

  defer do:
    let msg = recover()

    if len(msg) > 0:
      caught = msg

  let f1 = spawn always_panics()

  await f1
  // After catching the panic, spawn another fiber normally.
  let f2 = spawn returns_normally()
  let v = await f2

  assert::equals(v, 42)
  assert::equals(caught, "boom from fiber")

// Recovered panic in async fn yields zero value to outer awaiter
//
// If an async function catches a panic from an inner fiber via defer+recover
// and does NOT explicitly override the return value, the outer awaiter should
// receive the zero value of the return type (not crash with a NULL dereference).

fn{#async} catches_await_panic() i64 =
  defer do:
    let _ = recover()
  let _ = await spawn always_panics()

  return 0

fn{#async} catches_direct_panic() i64 =
  defer do:
    let _ = recover()
  panic("direct")

  return 0

test "recovered await-panic in async fn yields zero to outer awaiter" =
  let result = await spawn catches_await_panic()

  assert::equals(result, 0)

test "recovered direct panic in async fn yields zero to outer awaiter" =
  let result = await spawn catches_direct_panic()

  assert::equals(result, 0)

// Loop-edge panic re-raise: an async function that loops after spawning
// (but not awaiting) a panicking fiber should receive the panic at the next
// loop back-edge auto-yield, catchable via defer + recover().

fn{#async} fire_and_forget_panicker() =
  panic("ff panic")

fn{#async} loop_catches_ff_panic() i64 =
  defer do:
    let _ = recover()
  spawn fire_and_forget_panicker()
  let i i64 = 0

  for true:
    i = i + 1

    if i >= 1000000:
      return -1  // safety: should never reach this

  return 0  // unreachable normally; panic from ff fiber exits the loop via auto-yield check

test "loop-edge re-raises panic from fire-and-forget fiber" =
  let result = await spawn loop_catches_ff_panic()

  assert::equals(result, 0)
