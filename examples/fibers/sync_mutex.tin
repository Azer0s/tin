// examples/fibers/sync_mutex.tin
//
// Correctness tests for fiber-aware Mutex, RWMutex, and Cond.
//
// Core invariant: N fibers each performing M protected increments on a shared
// counter must produce exactly N*M.  Without a working mutex the counter races
// and the result is lower.  Cond tests verify signal/broadcast wake semantics.
//
// Tests:
//   Mutex
//     - basic sequential lock/unlock
//     - 4 fibers x 50 increments  -> 200
//     - 8 fibers x 100 increments -> 800
//     - 16 fibers x 25 increments -> 400
//
//   RWMutex
//     - basic sequential read_lock / write lock
//     - 4 writers x 50 increments  -> 200
//     - 8 writers x 100 increments -> 800
//     - mixed readers + writers: final write count is exact
//
//   Cond
//     - signal wakes exactly one waiter
//     - broadcast wakes all N waiters

use assert
use sync

// ---------------------------------------------------------------------------
// Mutex shared counter
// ---------------------------------------------------------------------------

var g_mu      sync::Mutex
var g_counter i64
var g_done_ch sync::Channel[i64]

fn{#async} mutex_incrementer(n i64) =
  let i i64 = 0

  for i < n:
    await g_mu.lock()
    g_counter = g_counter + 1
    g_mu.unlock()
    i = i + 1

  await g_done_ch.send(1)

fn{#async} run_mutex_counter(fibers i64, per_fiber i64) i64 =
  g_mu      = sync::Mutex.new()
  g_counter = 0
  g_done_ch = sync::Channel[i64].make(fibers)
  let i i64 = 0

  for i < fibers:
    spawn mutex_incrementer(per_fiber)
    i = i + 1

  let j i64 = 0

  for j < fibers:
    await g_done_ch.recv()
    j = j + 1

  return g_counter

// ---------------------------------------------------------------------------
// RWMutex shared counter (write-lock only path)
// ---------------------------------------------------------------------------

var g_rwmu    sync::RWMutex
var g_rw_val  i64
var g_rw_done sync::Channel[i64]

fn{#async} rwmutex_writer(n i64) =
  let i i64 = 0

  for i < n:
    await g_rwmu.lock()
    g_rw_val = g_rw_val + 1
    g_rwmu.unlock()
    i = i + 1

  await g_rw_done.send(1)

fn{#async} run_rwmutex_writers(fibers i64, per_fiber i64) i64 =
  g_rwmu    = sync::RWMutex.new()
  g_rw_val  = 0
  g_rw_done = sync::Channel[i64].make(fibers)
  let i i64 = 0

  for i < fibers:
    spawn rwmutex_writer(per_fiber)
    i = i + 1

  let j i64 = 0

  for j < fibers:
    await g_rw_done.recv()
    j = j + 1

  return g_rw_val

// ---------------------------------------------------------------------------
// RWMutex mixed: readers run concurrently alongside writers
// ---------------------------------------------------------------------------
// Readers hold the read lock briefly while verifying the value is non-negative;
// writers increment under the write lock.  Final write count must be exact.

var g_mix_done sync::Channel[i64]

fn{#async} mix_writer(n i64) =
  let i i64 = 0

  for i < n:
    await g_rwmu.lock()
    g_rw_val = g_rw_val + 1
    g_rwmu.unlock()
    i = i + 1

  await g_mix_done.send(1)

fn{#async} mix_reader(n i64) =
  let i i64 = 0

  for i < n:
    await g_rwmu.read_lock()
    let v = g_rw_val

    g_rwmu.read_unlock()

    if v < 0:
      await g_mix_done.send(0 - 1)  // signal error
    i = i + 1

  await g_mix_done.send(0)

fn{#async} run_rwmutex_mixed(writers i64, readers i64, per i64) i64 =
  g_rwmu     = sync::RWMutex.new()
  g_rw_val   = 0
  g_mix_done = sync::Channel[i64].make(writers + readers)
  let i i64 = 0

  for i < writers:
    spawn mix_writer(per)
    i = i + 1

  let j i64 = 0

  for j < readers:
    spawn mix_reader(per)
    j = j + 1

  let total i64 = writers + readers
  let k i64 = 0

  for k < total:
    await g_mix_done.recv()
    k = k + 1

  return g_rw_val

// ---------------------------------------------------------------------------
// Cond signal and broadcast
// ---------------------------------------------------------------------------

var g_cond     sync::Cond
var g_cond_mu  sync::Mutex
var g_payload  i64
var g_ready    bool
var g_cond_out sync::Channel[i64]

fn{#async} cond_consumer() =
  await g_cond_mu.lock()

  for !g_ready:
    await g_cond.wait(g_cond_mu)
  let v = g_payload

  g_cond_mu.unlock()
  await g_cond_out.send(v)

fn{#async} cond_producer(val i64) =
  await g_cond_mu.lock()
  g_payload = val
  g_ready   = true
  g_cond_mu.unlock()
  g_cond.signal()

fn{#async} cond_producer_broadcast(val i64) =
  await g_cond_mu.lock()
  g_payload = val
  g_ready   = true
  g_cond_mu.unlock()
  g_cond.broadcast()

// ---------------------------------------------------------------------------
// main() for standalone run
// ---------------------------------------------------------------------------

fn{#async} main() =
  let h1 = spawn run_mutex_counter(8, 100)
  let got1 = await h1

  if got1 == 800:
    echo "mutex 8x100: OK"
  else:
    echo "mutex 8x100: FAIL (got {got1})"

  let h2 = spawn run_rwmutex_writers(8, 100)
  let got2 = await h2

  if got2 == 800:
    echo "rwmutex writers 8x100: OK"
  else:
    echo "rwmutex writers 8x100: FAIL (got {got2})"

  let h3 = spawn run_rwmutex_mixed(4, 4, 50)
  let got3 = await h3

  if got3 == 200:
    echo "rwmutex mixed 4w+4r x50: OK"
  else:
    echo "rwmutex mixed 4w+4r x50: FAIL (got {got3})"

  g_cond     = sync::Cond.new()
  g_cond_mu  = sync::Mutex.new()
  g_payload  = 0
  g_ready    = false
  g_cond_out = sync::Channel[i64].make(1)

  spawn cond_consumer()
  spawn cond_producer(42)
  let r = await g_cond_out.recv()

  if r == 42:
    echo "cond signal: OK"
  else:
    echo "cond signal: FAIL (got {r})"

  g_cond     = sync::Cond.new()
  g_cond_mu  = sync::Mutex.new()
  g_payload  = 0
  g_ready    = false
  g_cond_out = sync::Channel[i64].make(4)

  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_producer_broadcast(10)
  let bsum i64 = 0
  let bi i64 = 0

  for bi < 4:
    bsum = bsum + (await g_cond_out.recv())
    bi = bi + 1

  if bsum == 40:
    echo "cond broadcast 4x: OK"
  else:
    echo "cond broadcast 4x: FAIL (got {bsum})"

  echo "sync_mutex: OK"

// ---------------------------------------------------------------------------
// test blocks
// ---------------------------------------------------------------------------

test "mutex basic lock unlock" =
  let m = sync::Mutex.new()

  await m.lock()
  m.unlock()
  assert::ok(true)

test "mutex protects shared counter: 4 fibers x 50" =
  let h = spawn run_mutex_counter(4, 50)

  assert::equals(await h, 200)

test "mutex protects shared counter: 8 fibers x 100" =
  let h = spawn run_mutex_counter(8, 100)

  assert::equals(await h, 800)

test "mutex protects shared counter: 16 fibers x 25" =
  let h = spawn run_mutex_counter(16, 25)

  assert::equals(await h, 400)

test "rwmutex basic read_lock read_unlock" =
  let rw = sync::RWMutex.new()

  await rw.read_lock()
  rw.read_unlock()
  assert::ok(true)

test "rwmutex basic write lock unlock" =
  let rw = sync::RWMutex.new()

  await rw.lock()
  rw.unlock()
  assert::ok(true)

test "rwmutex protects shared counter: 4 writers x 50" =
  let h = spawn run_rwmutex_writers(4, 50)

  assert::equals(await h, 200)

test "rwmutex protects shared counter: 8 writers x 100" =
  let h = spawn run_rwmutex_writers(8, 100)

  assert::equals(await h, 800)

test "rwmutex mixed readers and writers: 4w+4r x 50 writes" =
  let h = spawn run_rwmutex_mixed(4, 4, 50)

  assert::equals(await h, 200)

test "cond signal wakes consumer with correct value" =
  g_cond     = sync::Cond.new()
  g_cond_mu  = sync::Mutex.new()
  g_payload  = 0
  g_ready    = false
  g_cond_out = sync::Channel[i64].make(1)

  spawn cond_consumer()
  spawn cond_producer(99)
  assert::equals(await g_cond_out.recv(), 99)

test "cond broadcast wakes 4 consumers" =
  g_cond     = sync::Cond.new()
  g_cond_mu  = sync::Mutex.new()
  g_payload  = 0
  g_ready    = false
  g_cond_out = sync::Channel[i64].make(4)

  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_consumer()
  spawn cond_producer_broadcast(10)
  let sum i64 = 0
  let i i64 = 0

  for i < 4:
    sum = sum + (await g_cond_out.recv())
    i = i + 1

  assert::equals(sum, 40)
