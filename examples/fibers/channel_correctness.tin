// examples/fibers/channel_correctness.tin
//
// Assertion-based tests for channel semantics not previously covered by
// any assertion (only echo output).
//
// Covers:
//   - FIFO ordering: send 0..4, verify recv order matches
//   - Channel capacity=1 (ring buffer boundary condition)
//   - is_closed_empty: false before close, false if non-empty after close,
//     true after close and full drain
//   - Channel[bool] (scalar, non-RC type)
//   - Multiple concurrent producers with done-channel pattern

use assert
use sync

// Module-level channels for the concurrent producer test

var prod_ch   sync::Channel[i64]
var prod_done sync::Channel[i64]

fn{#async} producer_counted(id i64, count i64) =
  let i i64 = 0
  for i < count:
    await prod_ch.send(id * 100 + i)
    i = i + 1
  await prod_done.send(id)

// main() for the CI fiber run step

fn{#async} main() =
  // FIFO ordering
  let ch = sync::Channel[i64].make(8)
  await ch.send(0)
  await ch.send(1)
  await ch.send(2)
  await ch.send(3)
  await ch.send(4)
  let fifo_ok bool = true
  let i i64 = 0
  for i < 5:
    let v = await ch.recv()
    if v != i:
      fifo_ok = false
    i = i + 1
  if fifo_ok:
    echo "FIFO ordering: OK"
  else:
    echo "FIFO ordering: FAIL"

  // Capacity-1 boundary
  let c1 = sync::Channel[i64].make(1)
  await c1.send(777)
  let v1 = await c1.recv()
  if v1 == 777:
    echo "capacity=1: OK"
  else:
    echo "capacity=1: FAIL ({v1})"

  // is_closed_empty after close and full drain
  let ce = sync::Channel[i64].make(4)
  await ce.send(10)
  await ce.send(20)
  ce.close()
  await ce.recv()
  await ce.recv()
  if ce.is_closed_empty():
    echo "is_closed_empty after drain: OK"
  else:
    echo "is_closed_empty after drain: FAIL"

  // Channel[bool]
  let bch = sync::Channel[bool].make(4)
  await bch.send(true)
  await bch.send(false)
  let bt = await bch.recv()
  let bf = await bch.recv()
  if bt && !bf:
    echo "Channel[bool]: OK"
  else:
    echo "Channel[bool]: FAIL"

  echo "channel_correctness: OK"

// test blocks for tin test framework

test "channel FIFO ordering 5 elements" =
  let ch = sync::Channel[i64].make(8)
  await ch.send(0)
  await ch.send(1)
  await ch.send(2)
  await ch.send(3)
  await ch.send(4)
  assert::equals(await ch.recv(), 0)
  assert::equals(await ch.recv(), 1)
  assert::equals(await ch.recv(), 2)
  assert::equals(await ch.recv(), 3)
  assert::equals(await ch.recv(), 4)

test "channel capacity 1 boundary" =
  let ch = sync::Channel[i64].make(1)
  await ch.send(42)
  let v = await ch.recv()
  assert::equals(v, 42)

test "is_closed_empty false before close" =
  let ch = sync::Channel[i64].make(4)
  await ch.send(1)
  assert::not_ok(ch.is_closed_empty())

test "is_closed_empty false when closed but not empty" =
  let ch = sync::Channel[i64].make(4)
  await ch.send(1)
  await ch.send(2)
  ch.close()
  assert::not_ok(ch.is_closed_empty())

test "is_closed_empty true after close and full drain" =
  let ch = sync::Channel[i64].make(4)
  await ch.send(100)
  await ch.send(200)
  ch.close()
  await ch.recv()
  await ch.recv()
  assert::ok(ch.is_closed_empty())

test "Channel[bool] preserves true and false correctly" =
  let ch = sync::Channel[bool].make(4)
  await ch.send(true)
  await ch.send(false)
  await ch.send(true)
  let b1 = await ch.recv()
  let b2 = await ch.recv()
  let b3 = await ch.recv()
  assert::ok(b1)
  assert::not_ok(b2)
  assert::ok(b3)

test "multiple concurrent producers deliver correct total count" =
  prod_ch   = sync::Channel[i64].make(100)
  prod_done = sync::Channel[i64].make(4)
  spawn producer_counted(0, 10)
  spawn producer_counted(1, 10)
  spawn producer_counted(2, 10)
  spawn producer_counted(3, 10)
  let j i64 = 0
  for j < 4:
    await prod_done.recv()
    j = j + 1
  let total i64 = 0
  let k i64 = 0
  for k < 40:
    await prod_ch.recv()
    total = total + 1
    k = k + 1
  assert::equals(total, 40)
