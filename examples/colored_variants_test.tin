// examples/colored_variants_test.tin -- regression coverage for the
// $colored sync variant emission (slot 1 of the fat-fn-ptr ABI).
//
// The $colored variant lets sync helpers cooperate with the scheduler
// when called from a coroutine context.  When an {#async} fn calls a
// plain sync helper that has a hot loop, the colored variant inserts
// runtime yields at coloring decisions so other fibers on the same
// worker keep making progress.  See docs/internals/fn-coloring.md.

use assert
use sync

// 1. {#async} -> sync helper: the helper carries auto-yield in its
// $colored variant so concurrent fibers interleave.  Two fibers each
// hammer a shared atomic counter through the sync helper; with
// colored yields they interleave and both contribute.  Without
// yields, one fiber would monopolise the worker until done.  Final
// count is the deterministic correctness check; the cooperation
// itself is observable only via timing.

fn hot_increment(c *sync::Atomic[i64], n i64) i64 =
  let i i64 = 0

  for i < n :
    let _ = c.add(1)
    i = i + 1

  return i

fn{#async} bump_async(c *sync::Atomic[i64], n i64) i64 = return hot_increment(c, n)

test "colored: sync helper called from async caller produces correct sum" =
  let a = sync::Atomic[i64].new(0)
  let f1 = spawn bump_async(&a, 100)
  let f2 = spawn bump_async(&a, 100)
  let _ = await f1
  let _ = await f2

  assert::equals(a.load(), 200)

// 2. Plain sync caller -> sync helper: should still work, no yields.
test "colored: plain sync caller uses uncolored body" =
  let a = sync::Atomic[i64].new(0)
  let r = hot_increment(&a, 5)

  assert::equals(r, 5)
  assert::equals(a.load(), 5)

// 3. Boxed sync fn -> stored as fn value, called from {#async} body:
// the call routes through slot 1 (colored) of the fat-fn-ptr because
// the caller is in coro context.

fn counter_body(c *sync::Atomic[i64], n i64) i64 =
  let i i64 = 0

  for i < n :
    let _ = c.add(1)
    i = i + 1

  return i

fn{#async} invoke_boxed(cb fn(*sync::Atomic[i64], i64) i64, c *sync::Atomic[i64], n i64) i64 = return cb(c, n)

test "colored: boxed sync fn invoked via fat-fn-ptr in coro context" =
  let a = sync::Atomic[i64].new(0)
  let f = spawn invoke_boxed(counter_body, &a, 50)
  let _ = await f

  assert::equals(a.load(), 50)

// 4. {#no_autoyield} suppresses $colored emission.  Body runs without
// yields when called from cooperative context -- correct but no
// scheduler give-up.  Result must still be right.

fn{#no_autoyield} tight_loop(c *sync::Atomic[i64], n i64) i64 =
  let i i64 = 0

  for i < n :
    let _ = c.add(1)
    i = i + 1

  return i

fn{#async} spawn_tight(c *sync::Atomic[i64], n i64) i64 = return tight_loop(c, n)

test "colored: #no_autoyield opts out without affecting correctness" =
  let a = sync::Atomic[i64].new(0)
  let f = spawn spawn_tight(&a, 10)
  let _ = await f

  assert::equals(a.load(), 10)
