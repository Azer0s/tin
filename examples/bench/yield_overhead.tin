// examples/bench/yield_overhead.tin
//
// Measures the overhead of explicit yield in a tight loop.
// Spawns two variants back to back:
//   - {#async}             : auto-yield on every loop backedge
//   - {#async #no_autoyield}: manual yield every 1000 iterations
//
// Usage:
//   ./tin build examples/bench/yield_overhead.tin -lm -o /tmp/bench_yield
//   /tmp/bench_yield
//
// Expected output (approximate):
//   auto-yield  10000000 iters: ~XXXms
//   no-autoyield 10000000 iters: ~XXXms

use sync
use io

fn _tin_now_ms() i64 = extern("_tin_now_ms")

fn{#async} count_autoyield(n i64) i64 =
  let sum i64 = 0
  let i i64 = 0

  for i < n:
    sum = sum + i
    i = i + 1

  return sum

fn{#async #no_autoyield} count_manual_yield(n i64) i64 =
  let sum i64 = 0
  let i i64 = 0

  for i < n:
    sum = sum + i
    i = i + 1

    if i % 1000 == 0:
      yield

  return sum

fn{#async} main() =
  let n i64 = 10000000

  let t0 = _tin_now_ms()
  let f1 = spawn count_autoyield(n)
  let r1 = await f1
  let t1 = _tin_now_ms()

  echo "auto-yield  {n} iters: ~{t1 - t0}ms  (sum={r1})"

  let t2 = _tin_now_ms()
  let f2 = spawn count_manual_yield(n)
  let r2 = await f2
  let t3 = _tin_now_ms()

  echo "no-autoyield {n} iters: ~{t3 - t2}ms  (sum={r2})"
