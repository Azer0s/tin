// Atoms: symbolic constants written with a leading single-quote.
// Atoms are interned at compile time and compare by identity.
use assert

// An atom enum declares a set of named atom constants.
enum atom status =
  'ok,
  'err,

enum atom weather =
  'sunny,
  'rainy,
  'cloudy,

// Functions can pattern-match on atoms using where clauses.
fn describe_weather(w atom) =
  where 'sunny: echo "It is sunny!"
  where 'rainy: echo "It is rainy!"
  where 'cloudy: echo "It is cloudy!"
  where _:      echo "Unknown weather"

fn status_message(s atom) string =
  where 'ok:  return "Everything is fine"
  where 'err: return "Something went wrong"
  where _:    return "Unknown status"

describe_weather('sunny)
describe_weather('rainy)
describe_weather('cloudy)
describe_weather('windy)

echo status_message('ok)
echo status_message('err)

// Atoms can be stored in variables.
let current_weather atom = 'sunny
describe_weather(current_weather)

// Atoms are echoed with their name.
echo 'ok
echo 'err

test "status messages" =
  assert::equals_str(status_message('ok), "Everything is fine")
  assert::equals_str(status_message('err), "Something went wrong")

test "unknown status" =
  assert::equals_str(status_message('other), "Unknown status")

test "quoted atom equals simple atom" =
  // '"hello" and 'hello are the same atom
  let a atom = 'hello
  let b atom = '"hello"
  assert::ok(a == b)
  assert::equals_str(a, "'hello")
  assert::equals_str(b, "'hello")
