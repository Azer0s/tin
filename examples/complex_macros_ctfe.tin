// complex_macros_ctfe.tin - complex compile-time macro evaluation patterns.
//
// macros_ctfe.tin exercises the basic CTFE macro shapes (iterative/recursive
// numeric, conditional code splice, string concat). This file pushes harder:
// composition with expression-body helpers, control flow with match and for,
// string manipulation at compile time, and macros that exercise the
// budget/depth ceilings end-to-end.
//
// Note on composition: a CTFE macro body may call expression-body macros
// (they expand textually before the body compiles) and ordinary fns, but
// not other CTFE macros - the inner macro's body lives in a separate
// translation unit at expansion time.
use assert

// -------------------------------------------------------------------------
// Composition: CTFE body calling expression-body helpers
// -------------------------------------------------------------------------

macro dbl!(x) = x * 2
macro qdr!(x) = dbl!(x) * 2

macro hex_pow!(n) =
  // 16^n via repeated doubling done by expression-body helpers
  let r i64 = 1

  for let i i64 = 0; i < n; i++:
    r = qdr!(qdr!(r))

  return r

test "macro composition: expression-body helper chained" =
  assert::equals(qdr!(5), 20)
  assert::equals(qdr!(qdr!(2)), 32)

test "macro composition: helpers driven by CTFE loop" =
  assert::equals(hex_pow!(0), 1)
  assert::equals(hex_pow!(1), 16)
  assert::equals(hex_pow!(3), 4096)

// -------------------------------------------------------------------------
// CTFE with match: discriminant + literal cases + default arm
// -------------------------------------------------------------------------

macro stage_cost!(stage) =
  match stage:
    case 0: return 100
    case 1: return 250
    case 2: return 600
    case 3: return 1500
    default: return stage * 1000

test "macro: match with multiple cases and default" =
  assert::equals(stage_cost!(0), 100)
  assert::equals(stage_cost!(1), 250)
  assert::equals(stage_cost!(3), 1500)
  assert::equals(stage_cost!(7), 7000)

// -------------------------------------------------------------------------
// String building at compile time
// -------------------------------------------------------------------------

macro repeat_str!(s, n) =
  let acc string = ""

  for let i i64 = 0; i < n; i++:
    acc = acc ++ s

  return acc

test "macro: string repeat" =
  assert::equals(repeat_str!("ab", 0), "")
  assert::equals(repeat_str!("ab", 1), "ab")
  assert::equals(repeat_str!("ab", 4), "abababab")

// -------------------------------------------------------------------------
// Many parameters + arithmetic chain
// -------------------------------------------------------------------------

macro weighted_sum!(a, b, c, d) =
  return a * 1000 + b * 100 + c * 10 + d

test "macro: multi-arg numeric weave" =
  assert::equals(weighted_sum!(1, 2, 3, 4), 1234)
  assert::equals(weighted_sum!(0, 0, 0, 0), 0)
  assert::equals(weighted_sum!(9, 8, 7, 6), 9876)

// -------------------------------------------------------------------------
// Recursion exercising depth without crossing the ceiling
// -------------------------------------------------------------------------

macro power!(base, exp) =
  if exp == 0:
    return 1
  return base * power!(base, exp - 1)

test "macro: recursive power, moderate depth" =
  assert::equals(power!(2, 0), 1)
  assert::equals(power!(2, 10), 1024)
  assert::equals(power!(3, 5), 243)
  assert::equals(power!(7, 4), 2401)

// -------------------------------------------------------------------------
// Conditional code-splice: macro chooses between two AST fragments
// -------------------------------------------------------------------------

macro bind_choice!(use_alpha) =
  if use_alpha:
    return `alpha`
  return `beta`

test "macro: backtick splice from CTFE branch" =
  let alpha i64 = 100
  let beta i64 = 200

  assert::equals(bind_choice!(true), 100)
  assert::equals(bind_choice!(false), 200)

// -------------------------------------------------------------------------
// CTFE drives a numeric loop whose result selects which name to splice
// -------------------------------------------------------------------------

macro lookup_idx!(n) =
  let parity i64 = 0

  for let i i64 = 0; i < n; i++:
    parity = 1 - parity
  if parity == 0:
    return `alpha`

  return `beta`

test "macro: parity-driven splice" =
  let alpha i64 = 1
  let beta i64 = 2

  assert::equals(lookup_idx!(0), 1)
  assert::equals(lookup_idx!(1), 2)
  assert::equals(lookup_idx!(7), 2)
  assert::equals(lookup_idx!(8), 1)

// -------------------------------------------------------------------------
// Boolean logic chain - short-circuit semantics at compile time
// -------------------------------------------------------------------------

macro all_pos!(a, b, c) =
  return (a > 0) && (b > 0) && (c > 0)

macro any_zero!(a, b, c) =
  return (a == 0) || (b == 0) || (c == 0)

test "macro: boolean folds (and)" =
  assert::equals(all_pos!(1, 2, 3), true)
  assert::equals(all_pos!(1, 0, 3), false)
  assert::equals(all_pos!(-1, 2, 3), false)

test "macro: boolean folds (or)" =
  assert::equals(any_zero!(0, 1, 2), true)
  assert::equals(any_zero!(1, 2, 3), false)
  assert::equals(any_zero!(1, 2, 0), true)

// -------------------------------------------------------------------------
// Heavier loop body - CTFE for 2D grid sum
// -------------------------------------------------------------------------

macro grid_sum!(rows, cols) =
  let total i64 = 0

  for let r i64 = 0; r < rows; r++:
    for let c i64 = 0; c < cols; c++:
      total = total + (r * cols + c)

  return total

test "macro: 2D loop fold" =
  // grid_sum(rows,cols) = sum_{i=0..rows*cols-1} i = N(N-1)/2 with N=rows*cols
  assert::equals(grid_sum!(0, 0), 0)
  assert::equals(grid_sum!(1, 1), 0)
  assert::equals(grid_sum!(3, 3), 36)   // N=9 -> 9*8/2 = 36
  assert::equals(grid_sum!(5, 4), 190)  // N=20 -> 20*19/2 = 190

// -------------------------------------------------------------------------
// Float arithmetic + accumulator
// -------------------------------------------------------------------------

macro double_sum!(n) =
  // Sum of 1.5 added n times - exact in f64 for small n (1.5 has finite
  // binary representation), so the result round-trips through CTFE without
  // the precision drift that bit-comparing 1/3 etc. would incur.
  let acc f64 = 0.0

  for let i i64 = 0; i < n; i++:
    acc = acc + 1.5

  return acc

test "macro: f64 accumulator (exact-rep sum)" =
  assert::equals(double_sum!(0), 0.0)
  assert::equals(double_sum!(2), 3.0)
  assert::equals(double_sum!(8), 12.0)

// -------------------------------------------------------------------------
// Deep iteration - well below the loop-iteration ceiling
// -------------------------------------------------------------------------

macro count_to!(n) =
  let acc i64 = 0

  for let i i64 = 0; i < n; i++:
    acc = acc + 1

  return acc

test "macro: deep loop (10k iterations)" =
  assert::equals(count_to!(10000), 10000)

// -------------------------------------------------------------------------
// Branch-pruning: only the live arm's body is evaluated
// -------------------------------------------------------------------------

macro safe_classify!(n) =
  if n > 1000000:
    // dead branch at every test call site below; if this evaluated, the
    // loop would still finish (200k < 100k ceiling? no - at 200k it would
    // trip the iteration cap, proving the dead branch is never walked).
    let acc i64 = 0

    for let i i64 = 0; i < 200000; i++:
      acc = acc + 1

    return acc

  return n + 1

test "macro: dead branch is not walked" =
  assert::equals(safe_classify!(0), 1)
  assert::equals(safe_classify!(42), 43)
  assert::equals(safe_classify!(999999), 1000000)
