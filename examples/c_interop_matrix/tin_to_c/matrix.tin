// examples/c_interop_matrix/tin_to_c/matrix.tin
//
// Tin -> C interop matrix: every row in docs/internals/c-interop-matrix.md
// section "Tin -> C" gets a test here.  Group ordering matches the doc.
// Each test is named "T<id>" so a failure trivially maps back to a row.

//!+./matrix.c

use assert
use math

// ===== T1-T4: Scalars =====

fn c_add_i32(a i32, b i32) i32 = extern("c_add_i32")
fn c_sub_f64(a f64, b f64) f64 = extern("c_sub_f64")
fn c_negate_bool(b bool) bool = extern("c_negate_bool")
fn c_write_42(out *i64) = extern("c_write_42")

test "T1: scalar i32 round trip" =
  assert::equals(c_add_i32(40, 2), 42)

test "T2: f64 with two args" =
  assert::ok(math::fabs(c_sub_f64(3.5, 1.25) - 2.25) < 1e-9)

test "T3: bool ABI (i1 <-> i8)" =
  assert::ok(c_negate_bool(true) == false)
  assert::ok(c_negate_bool(false) == true)

test "T4: out-param via *i64" =
  let x i64 = 0
  c_write_42(&x)
  assert::equals(x, 42)

// ===== T5-T8: Strings =====

fn c_strlen_wrap(s string) i64 = extern("c_strlen_wrap")
fn c_static_str() string = extern("c_static_str")
fn{#handover} c_malloc_str() string = extern("c_malloc_str")
fn c_concat_pair(a string, b string) string = extern("c_concat_pair")

test "T5: string -> char*" =
  assert::equals(c_strlen_wrap("hello"), 5)

test "T6: char* (static) -> string copy" =
  assert::equals(c_static_str(), "static")

test "T7: #handover malloc'd char* adopted by Tin" =
  assert::equals(c_malloc_str(), "from-malloc")

test "T8: string round trip via C concat" =
  assert::equals(c_concat_pair("foo", "bar"), "foobar")

// ===== T9-T10: Atoms =====

fn c_atom_len(a atom) i64 = extern("c_atom_len")
fn c_make_atom_name() atom = extern("c_make_atom_name")

test "T9: atom -> char* (interned name)" =
  assert::equals(c_atom_len('hello), 5)

test "T10: C-returned char* interned into atom" =
  assert::ok(c_make_atom_name() == 'from_c)

// ===== T11-T13: Arrays of primitives =====

fn c_sum_i32_arr(xs [i32], n i64) i64 = extern("c_sum_i32_arr")
fn c_double_f64_arr(xs [f64], n i64) = extern("c_double_f64_arr")
fn c_byte_first(buf [byte; 8]) i64 = extern("c_byte_first")

test "T11: [i32] -> int32_t* with length" =
  let xs [i32] = [1, 2, 3, 4]
  assert::equals(c_sum_i32_arr(xs, len(xs)), 10)

test "T12: [f64] mutated by C, visible in Tin (shared buffer)" =
  let xs [f64] = [1.0, 2.0, 3.0]
  c_double_f64_arr(xs, len(xs))
  assert::ok(math::fabs(xs[0] - 2.0) < 1e-9)
  assert::ok(math::fabs(xs[2] - 6.0) < 1e-9)

test "T13: fixed-size [byte; N] decays to *byte" =
  let buf [byte; 8] = [9, 0, 0, 0, 0, 0, 0, 0]
  assert::equals(c_byte_first(buf), 9)

// ===== T14-T15: Arrays of strings / atoms =====

fn c_strarr_total(xs [string], n i64) i64 = extern("c_strarr_total")
fn c_atomarr_total(xs [atom], n i64) i64 = extern("c_atomarr_total")

test "T14: [string] -> char**" =
  let xs = ["aa", "bbb", "cccc"]
  assert::equals(c_strarr_total(xs, len(xs)), 9)

test "T15: [atom] -> char** via name lookup" =
  let xs = ['p, 'qq, 'rrr]
  assert::equals(c_atomarr_total(xs, len(xs)), 6)

// ===== T16-T17: Structs by value =====

struct pt_small =
  x i32
  y i32

fn c_pt_small_sum(p pt_small) i32 = extern("c_pt_small_sum")

struct pt_big =
  a i64
  b i64
  c i64

fn c_pt_big_sum(p pt_big) i64 = extern("c_pt_big_sum")
fn c_pt_big_make(a i64, b i64, c i64) pt_big = extern("c_pt_big_make")

test "T16: small struct (<=16B) by value" =
  let p = pt_small{x: 10, y: 32}
  assert::equals(c_pt_small_sum(p), 42)

test "T17: large struct (>16B) by value (byval/sret)" =
  let p = pt_big{a: 1, b: 2, c: 3}
  assert::equals(c_pt_big_sum(p), 6)
  let q = c_pt_big_make(10, 20, 30)
  assert::equals(q.a, 10)
  assert::equals(q.b, 20)
  assert::equals(q.c, 30)

// ===== T18-T19: Pointer-to-struct =====

struct vec3 =
  x f32
  y f32
  z f32

fn c_vec3_get() *vec3 = extern("c_vec3_get")
fn c_vec3_bump_z(v *vec3, dz f32) = extern("c_vec3_bump_z")

test "T18: *vec3 mutated by C, observed via Tin" =
  let v = c_vec3_get()
  let z0 = (*v).z
  c_vec3_bump_z(v, 5.0)
  assert::ok(math::fabs((*v).z - (z0 + 5.0)) < 1e-9)

test "T19: C make() returning *vec3" =
  let v = c_vec3_get()
  assert::ok(math::fabs((*v).x - 0.0) < 1e-9)

// ===== T20: Nested struct =====

struct inner =
  a i64
  b i64

struct outer =
  lo inner
  hi inner

fn c_outer_sum(o outer) i64 = extern("c_outer_sum")

test "T20: nested struct by value" =
  let o = outer{lo: inner{a: 1, b: 2}, hi: inner{a: 10, b: 20}}
  assert::equals(c_outer_sum(o), 33)

// ===== T21: #packed struct =====

struct {#packed} packed_pt =
  x i32
  y i32

fn c_packed_sum(p packed_pt) i32 = extern("c_packed_sum")

test "T21: #packed struct <=8B in single register" =
  let p = packed_pt{x: 17, y: 25}
  assert::equals(c_packed_sum(p), 42)

// ===== T23-T25: Callbacks =====

fn c_invoke_cb_i64(cb fn(i64) i64, x i64) i64 = extern("c_invoke_cb_i64")
fn c_invoke_cb_str(cb fn(string) i64, s string) i64 = extern("c_invoke_cb_str")

test "T23: callback fn(i64) i64 invoked by C" =
  let f = fn(x i64) i64 = return x * 2
  assert::equals(c_invoke_cb_i64(f, 21), 42)

test "T24: callback fn(string) i64 invoked by C" =
  let f = fn(s string) i64 = return len(s)
  assert::equals(c_invoke_cb_str(f, "hello world"), 11)

test "T25: callback capturing local" =
  let bias i64 = 100
  let f = fn(x i64) i64 = return x + bias
  assert::equals(c_invoke_cb_i64(f, 42), 142)

// ===== T28-T29: Variadic =====
//
// One extern declaration with `...` covers all argument shapes; per-
// callsite type checking still applies to args that follow the format
// string.  Pass the format with the trailing %d / %s removed in the
// test so we don't depend on stdout state.

fn c_printf(format string, ...) i32 = extern("printf")

test "T28: variadic printf with i32" =
  let n = c_printf("", 42)
  assert::ok(n >= 0)

test "T29: variadic printf with string" =
  let n = c_printf("", "abc")
  assert::ok(n >= 0)

// ===== T30: void* handle round trip =====

fn c_handle_make() *void = extern("c_handle_make")
fn c_handle_use(h *void) i64 = extern("c_handle_use")
fn c_handle_free(h *void) = extern("c_handle_free")

test "T30: void* opaque handle round trip" =
  let h = c_handle_make()
  let v = c_handle_use(h)
  assert::equals(v, 1234)
  c_handle_free(h)

// ===== T32-T33: address-of-local struct -> C =====
//
// Pass a Tin-allocated struct by pointer to a C extern.  The Tin
// allocation has the type_id + vtable header in front of the user
// fields; the call-site adapter (codegen/extern.go::
// adaptTinPtrToNativePtr) GEPs to the user-fields region so the C
// side sees the bare native layout it expects, with shared storage
// for round-trip mutations.

struct dyad =
  a i64
  b i64

fn c_dyad_read(p *dyad) i64 = extern("c_dyad_read")
fn c_dyad_mutate(p *dyad) = extern("c_dyad_mutate")

test "T32: &local_struct -> *T   (C reads through the pointer)" =
  let d = dyad{a: 17, b: 25}
  assert::equals(c_dyad_read(&d), 42)

test "T33: &local_struct -> *T   (C mutates; Tin observes)" =
  let d dyad = dyad{a: 0, b: 0}
  c_dyad_mutate(&d)
  assert::equals(d.a, 11)
  assert::equals(d.b, 22)

// ===== T34-T37: Mixed-parameter shapes =====
//
// Real C APIs combine the primitives above in arbitrary orders.
// These rows pin the joint behavior so a regression in one
// individual lowering doesn't slip through when its neighbor in
// the same signature still happens to land in the right register.

fn c_mix_sps(p *dyad, n i64, s string) i64 = extern("c_mix_sps")

fn c_mix_full(
  cb fn(i64) i64,
  s string,
  p *dyad,
  xs [i64], xs_len i64,
  k i64,
) i64 = extern("c_mix_full")

fn c_mix_make(s string, n i64) dyad = extern("c_mix_make")

fn c_mix_arr_struct(xs [i64], n i64, p pt_big) i64 = extern("c_mix_arr_struct")

test "T34: extern(*struct, scalar, string) returning i64" =
  let d = dyad{a: 7, b: 8}
  // C body: (a + b) * n + strlen(s) = 15 * 4 + 5 = 65
  assert::equals(c_mix_sps(&d, 4, "hello"), 65)

test "T35: extern(callback, string, *struct, [i64], scalar)" =
  let d = dyad{a: 1, b: 2}
  let xs [i64] = [10, 20, 30]
  let double = fn(x i64) i64 = return x * 2
  // C body: cb(a + b) + strlen(s) + sum(xs) + k = 6 + 5 + 60 + 100 = 171
  assert::equals(c_mix_full(double, "hello", &d, xs, len(xs), 100), 171)

test "T36: extern(string, scalar) returning struct by value" =
  let d = c_mix_make("abcd", 7)
  // C body: dyad{a: strlen(s), b: n} = (4, 7)
  assert::equals(d.a, 4)
  assert::equals(d.b, 7)

test "T37: extern([i64], large_struct_by_value) returning i64" =
  let xs [i64] = [4, 5, 6]
  let p = pt_big{a: 1, b: 2, c: 3}
  // C body: sum(xs) + p.a + p.b + p.c = 15 + 6 = 21
  assert::equals(c_mix_arr_struct(xs, len(xs), p), 21)

test "T38: reassigning a cLayoutStruct wrapper binding does not leak" =
  // First wrapper call rc-allocates a block; the reassignment must
  // release that block before storing the second call's result, or
  // --leaks flags the first allocation.
  let d = c_mix_make("abcd", 7)
  d = c_mix_make("xy", 3)
  assert::equals(d.a, 2)
  assert::equals(d.b, 3)

fn build_dyad() dyad =
  return c_mix_make("zz", 9)

test "T39: cLayoutStruct returned through a Tin function does not leak" =
  // The wrapper rc-block must survive the build_dyad return and get
  // released by the receiving let-binding.  If the binding's scope
  // exit doesn't see this as heap-tracked, the rc-block leaks.
  let d = build_dyad()
  assert::equals(d.a, 2)
  assert::equals(d.b, 9)

test "T40: inline wrapper result consumed by a Tin function does not leak" =
  // No let-binding to anchor the rc-block; the inline call result is
  // copied into sum_dyad's parameter.  The call site must release the
  // wrapper's rc allocation after the call returns.
  assert::equals(sum_dyad(c_mix_make("ab", 4)), 6)

fn sum_dyad(d dyad) i64 =
  return d.a + d.b

test "T41: wrapper result inside an inline interpolation does not leak" =
  // Wrapper call result accessed via field in interpolation context.
  let s = "a={c_mix_make(\"qq\", 5).a},b={c_mix_make(\"qq\", 5).b}"
  assert::equals(s, "a=2,b=5")

test "T42: reassign through a forwarder function does not leak" =
  // Forwarder result reassigned; previous block must release before the
  // second one is stored.
  let d = build_dyad()
  d = build_dyad()
  assert::equals(d.b, 9)

test "T43: copy binding `let d2 = d` flows + releases correctly" =
  // d2 shares the underlying rc-block with d.  Both scope-exits will
  // try to release it -- without retain on copy the second release is
  // a double-free.  With retain, the rc-block is freed exactly once.
  let d = c_mix_make("ab", 4)
  let d2 = d
  assert::equals(d2.a + d2.b, 6)
  assert::equals(d.a + d.b, 6)

test "T44: pass-by-value into a Tin function does not double-free" =
  // sum_dyad copies the struct into its parameter; that copy aliases
  // the caller's rc-block.  The callee's scope exit must not release
  // (borrow semantics), only the caller's let-binding scope exit does.
  let d = c_mix_make("xy", 3)
  assert::equals(sum_dyad(d), 5)
  // Re-use d after the call to detect use-after-free.
  assert::equals(d.b, 3)

struct holder =
  data dyad

test "T45: stored as a struct field, lifetime tied to the holder" =
  // Storing the wrapper into another struct.  When the outer holder is
  // dropped, the inner dyad's rc-block must also be released.
  let h = holder{data: c_mix_make("ab", 4)}
  assert::equals(h.data.a + h.data.b, 6)

test "T46: stack-bound dyad literal stored as holder field is a no-op release" =
  // Same field-storage pattern but the source is a stack-bound dyad
  // literal -- its c_data_ptr points to caller stack with no rc header.
  // Releasing via c_data_ptr - sizeof(wrapper) must hit the immortal RC
  // sentinel and skip, not corrupt the stack.
  let h = holder{data: dyad{a: 11, b: 22}}
  assert::equals(h.data.a + h.data.b, 33)

test "T47: holder with wrapper-call field, holder doesn't escape" =
  // `holder{data: c_mix_make(...)}` where the outer holder is bound to
  // a non-escape let.  The inner cLayout's storage can live alongside
  // holder in the caller's stack frame -- IR check shows no
  // _tin_rc_alloc for the dyad portion (stack composite via the
  // curStructLitOuterIsLocal flag).
  let h = holder{data: c_mix_make("ab", 4)}
  assert::equals(h.data.a + h.data.b, 6)

fn extract_holder_data() dyad =
  // Force the inner cLayout field to escape via let-extract + return.
  // If the escape walker were to stack-bind the inner dyad, the dyad
  // value returned here would carry c_data_ptr into our dead stack
  // frame, and the caller would UAF on the next field read.  Heap
  // allocation is the only safe choice.
  let h = holder{data: c_mix_make("zy", 5)}
  let saved = h.data
  return saved

test "T48: cLayout field escape via FieldAccess forces heap" =
  // saved's c_data_ptr must survive past extract_holder_data's frame.
  // Heap mode is the correct choice; the walker treats h.data as
  // escape because dyad is the cLayoutStruct field type.
  let d = extract_holder_data()
  assert::equals(d.a, 2)
  assert::equals(d.b, 5)

// Nested non-cLayout struct containing a cLayout field: extracting the
// outer field still yields a value whose embedded dyad's c_data_ptr
// references the holder's storage.  The walker's transitive carrier
// check classifies sub_carrier as a cLayout carrier (it owns a dyad
// field), so the FieldAccess rule fires for outer.s reads.
struct sub_carrier =
  d dyad

struct outer_layered =
  s sub_carrier

fn extract_layered() dyad =
  let h = outer_layered{s: sub_carrier{d: c_mix_make("qr", 6)}}
  let saved = h.s
  return saved.d

test "T49: nested struct carrying cLayout field escapes via outer field" =
  let d = extract_layered()
  assert::equals(d.a, 2)
  assert::equals(d.b, 6)

test "T50: field reassign of cLayout releases the displaced value" =
  // Initial dyad stack-binds (holder doesn't escape).  Subsequent
  // assignments to h.data swap the field to heap-allocated dyads;
  // genAssign's struct-value branch must load the previous wrapper,
  // release its rc-block (skip for the initial stack composite,
  // free for the heap successors), then store the new wrapper --
  // otherwise every overwrite leaks the displaced block.
  let h = holder{data: c_mix_make("a", 1)}
  h.data = c_mix_make("bb", 2)
  h.data = c_mix_make("ccc", 3)
  assert::equals(h.data.a, 3)
  assert::equals(h.data.b, 3)

test "T51: cLayout binding inside a lambda body is scoped to the lambda" =
  // The escape walker tracks the AST body of the surrounding fn.
  // For a let-decl inside a lambda body the walker must restrict
  // its lookups to the lambda's body, otherwise a same-named outer
  // binding would falsely flag the inner one as escaping.  Both
  // bindings here only feed scalar field reads, so neither should
  // leak regardless of which scope analysis picks them up.
  let d = c_mix_make("outer", 11)
  let f = fn() i64 =
    let d = c_mix_make("inner", 22)
    return d.a + d.b
  assert::equals(f() + d.a + d.b, 27 + 5 + 11)

