// examples/operator_overload_phase0_test.tin -- op-overload
// fall-through: when a struct lists an op-trait impl for one rhs
// shape (e.g. `add[Foo, Foo]`) but the call site uses a different
// rhs (`Foo + i64`), dispatch must fall through to the "binary
// operator not defined" compile error rather than silently
// compiling or invoking the wrong impl.
//
// The bad code lives in examples/fixtures/operator_overload_phase0/
// and the test below shells out to `./tin run` to verify the
// diagnostic.

use assert
use "./fixtures/run_compiler"

test "Foo(add[Foo, Foo]) + i64 errors with 'binary operator'" =
  let r = run_tin("run", "examples/fixtures/operator_overload_phase0/fallthrough.tin")

  assert::ok(r.exit_code != 0 as i32)
  assert::ok(contains_text(r.stderr, "binary operator"))
