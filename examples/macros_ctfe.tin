// macros_ctfe.tin — CTFE (compile-time function evaluation) macros.
// Macros with block bodies are compiled and run at compile time;
// the function's return value becomes the expansion result.
use assert

// Iterative factorial — evaluated entirely at compile time
macro factorial!(n) =
  let result i64 = 1
  for let i i64 = 1; i <= n; i++:
    result = result * i
  return result

// Recursive fibonacci — recursive macros are allowed; the 5-second timeout
// protects against accidental infinite recursion
macro fib!(n) =
  if (n <= 1):
    return n
  return (fib!((n - 1)) + fib!((n - 2)))

test "CTFE macro: factorial" =
  assert::equals(factorial!(0), 1)
  assert::equals(factorial!(5), 120)
  assert::equals(factorial!(10), 3628800)

test "CTFE macro: recursive fibonacci" =
  assert::equals(fib!(0), 0)
  assert::equals(fib!(1), 1)
  assert::equals(fib!(10), 55)
