// macros_ctfe.tin - CTFE (compile-time function evaluation) macros.
// Macros with block bodies are compiled and run at compile time;
// the function's return value becomes the expansion result.
use assert

// Iterative factorial - evaluated entirely at compile time
macro factorial!(n) =
  let result i64 = 1
  for let i i64 = 1; i <= n; i++:
    result = result * i
  return result

// Recursive fibonacci - recursive macros are allowed; the 5-second timeout
// protects against accidental infinite recursion
macro fib!(n) =
  if (n <= 1):
    return n
  return (fib!((n - 1)) + fib!((n - 2)))

test "CTFE macro: factorial" =
  assert::equals(factorial!(0), 1)
  assert::equals(factorial!(5), 120)
  assert::equals(factorial!(10), 3628800)

test "CTFE macro: recursive fibonacci" =
  assert::equals(fib!(0), 0)
  assert::equals(fib!(1), 1)
  assert::equals(fib!(10), 55)

// Backtick literals: `expr` splices raw tin code at the call site.
// Simple (expression-body) version: body is a backtick literal.
macro field_a!() = `alpha`
macro field_b!() = `beta`

// CTFE version: conditionally return a code splice.
macro pick_var!(n) =
  if (n == 0):
    return `alpha`
  return `beta`

test "backtick splice: simple macro returns identifier" =
  let alpha i64 = 42
  let beta i64 = 99
  assert::equals(field_a!(), 42)
  assert::equals(field_b!(), 99)

test "backtick splice: CTFE macro conditionally returns identifier" =
  let alpha i64 = 10
  let beta i64 = 20
  assert::equals(pick_var!(0), 10)
  assert::equals(pick_var!(1), 20)

// String-returning CTFE macro (returns the string value, not a code splice)
macro greet_ctfe!(name) =
  return "Hello, " ++ name ++ "!"

test "CTFE macro: string return" =
  assert::equals_str(greet_ctfe!("World"), "Hello, World!")
