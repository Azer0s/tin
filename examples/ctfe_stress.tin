// ctfe_stress.tin - exhaustive stress test for the compile-time evaluation
// pipeline (Phases A–C). Every assert here must hold AT RUNTIME, but the
// companion examples/ctfe_stress_ir_checks.sh asserts that the IR for the
// SAME programs has each call-site folded to a literal — proving the values
// actually came from CTFE, not the live binary.
//
// Coverage:
//   • basic arithmetic folding (tier-1 AST eval)
//   • deep recursion (factorial, fibonacci, ackermann-lite, mutual)
//   • all primitive types (i64, f64, bool)
//   • full control flow inside #pure (if/elif/else, where, for, match)
//   • #allow_sideffect blocks (must NOT fold)
//   • memoisation across many call sites with the same args
//   • transitive #pure call graphs
//   • #pure with shadowed identifiers (locals named like top-level vars)
//   • tier-2 dispatch fallback path (when -O0 + cache populated)

use assert

// --------------------------------------------------------------------------
// 1. arithmetic, every primitive operator
// --------------------------------------------------------------------------

fn{#pure} arith_i64(a i64, b i64) i64 =
  return a + b - a / 2 * b + (a % (b + 1)) ^ b

test "arith mix" =
  assert::equals(arith_i64(7, 3), 7 + 3 - 7 / 2 * 3 + (7 % 4) ^ 3)
  assert::equals(arith_i64(0, 0), 0)
  assert::equals(arith_i64(100, 5), 100 + 5 - 100 / 2 * 5 + (100 % 6) ^ 5)

fn{#pure} bit_ops(x i64, y i64) i64 =
  return ((x & y) | (x ^ y)) << 1 >> 1

test "bit ops" =
  assert::equals(bit_ops(0xFF, 0x0F), ((0xFF & 0x0F) | (0xFF ^ 0x0F)) << 1 >> 1)
  assert::equals(bit_ops(0, 0), 0)

// --------------------------------------------------------------------------
// 2. recursion — depth, mutual, indirect through #pure helpers
// --------------------------------------------------------------------------

fn{#pure} fact(n i64) i64 =
  if n <= 1:
    return 1
  return n * fact(n - 1)

fn{#pure} fib(n i64) i64 =
  if n < 2:
    return n
  return fib(n - 1) + fib(n - 2)

fn{#pure} is_even(n i64) bool =
  if n == 0:
    return true
  return is_odd(n - 1)

fn{#pure} is_odd(n i64) bool =
  if n == 0:
    return false
  return is_even(n - 1)

test "deep recursion: factorial" =
  assert::equals(fact(0), 1)
  assert::equals(fact(1), 1)
  assert::equals(fact(10), 3628800)
  assert::equals(fact(15), 1307674368000)

test "deep recursion: fibonacci" =
  assert::equals(fib(0), 0)
  assert::equals(fib(15), 610)
  assert::equals(fib(20), 6765)

test "mutual recursion: even/odd" =
  assert::equals(is_even(0), true)
  assert::equals(is_even(20), true)
  assert::equals(is_odd(20), false)
  assert::equals(is_odd(21), true)

// --------------------------------------------------------------------------
// 3. control flow — every #pure-legal construct exercised at fold time
// --------------------------------------------------------------------------

fn{#pure} clamp(v i64, lo i64, hi i64) i64 =
  if v < lo:
    return lo
  else if v > hi:
    return hi
  else:
    return v

fn{#pure} sign(n i64) i64 =
  where n < 0:  -1
  where n == 0:  0
  where _:       1

fn{#pure} sum_to(n i64) i64 =
  let acc i64 = 0
  for let i i64 = 0; i <= n; i++:
    acc = acc + i
  return acc

fn{#pure} match_kind(n i64) i64 =
  match n:
    case 0:
      return 0
    case 1:
      return 10
    case 2:
      return 20
    default:
      return n * 100

test "if/else chain" =
  assert::equals(clamp(5, 0, 10), 5)
  assert::equals(clamp(-3, 0, 10), 0)
  assert::equals(clamp(99, 0, 10), 10)

test "where clauses" =
  assert::equals(sign(-7), -1)
  assert::equals(sign(0), 0)
  assert::equals(sign(42), 1)

test "for loop" =
  assert::equals(sum_to(0), 0)
  assert::equals(sum_to(10), 55)
  assert::equals(sum_to(100), 5050)

test "match" =
  assert::equals(match_kind(0), 0)
  assert::equals(match_kind(1), 10)
  assert::equals(match_kind(2), 20)
  assert::equals(match_kind(7), 700)

// --------------------------------------------------------------------------
// 4. floats and bools — non-i64 fold paths
// --------------------------------------------------------------------------

fn{#pure} hypot_squared(x f64, y f64) f64 = return x * x + y * y

fn{#pure} both(a bool, b bool) bool = return a && b

fn{#pure} either(a bool, b bool) bool = return a || b

test "f64 fold" =
  assert::equals(hypot_squared(3.0, 4.0), 25.0)
  assert::equals(hypot_squared(0.0, 0.0), 0.0)
  assert::equals(hypot_squared(1.5, 2.5), 1.5 * 1.5 + 2.5 * 2.5)

test "bool fold" =
  assert::equals(both(true, true), true)
  assert::equals(both(true, false), false)
  assert::equals(either(false, false), false)
  assert::equals(either(false, true), true)

// --------------------------------------------------------------------------
// 5. memoisation — same args reused across many call sites
// --------------------------------------------------------------------------

fn{#pure} cube(n i64) i64 = return n * n * n

test "memo: 50 call sites for cube(3) all fold once" =
  // 50 distinct call sites; tier-1 evaluator evaluates cube(3) once
  // and reuses the i64 27 from its memo cache for the remaining 49.
  // Companion IR check confirms zero `call i64 @cube` appear in main.
  let s1 i64 = cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3)
  let s2 i64 = cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3)
  let s3 i64 = cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3)
  let s4 i64 = cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3)
  let s5 i64 = cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3) + cube(3)
  assert::equals(s1 + s2 + s3 + s4 + s5, 27 * 50)

// --------------------------------------------------------------------------
// 6. transitive — A calls B calls C, all #pure
// --------------------------------------------------------------------------

fn{#pure} step1(n i64) i64 = return n + 1
fn{#pure} step2(n i64) i64 = return step1(n) * 2
fn{#pure} step3(n i64) i64 = return step2(n) - 3
fn{#pure} step4(n i64) i64 = return step3(n) * step3(n)

test "transitive #pure chain" =
  // step4(5) = ((5+1)*2 - 3)^2 = 9*9 = 81
  assert::equals(step4(5), 81)
  // step4(0) = ((0+1)*2 - 3)^2 = (-1)*(-1) = 1
  assert::equals(step4(0), 1)

// --------------------------------------------------------------------------
// 7. shadowing — local names matching top-level vars must read the local
// --------------------------------------------------------------------------

var counter i64 = 9999

fn{#pure} square_with_shadow(n i64) i64 =
  let counter i64 = n + 1
  return counter * counter

fn{#pure} square_via_param(counter i64) i64 = return counter * counter

test "shadow: local let masks top-level var" =
  assert::equals(square_with_shadow(7), 64)

test "shadow: param masks top-level var" =
  assert::equals(square_via_param(8), 64)

// --------------------------------------------------------------------------
// 8. #allow_sideffect — must NOT fold (the runtime echo must execute)
// --------------------------------------------------------------------------

fn{#pure} traced_double(n i64) i64 =
  let r i64 = n * 2
  { #allow_sideffect } {
    echo "traced_double({n}) = {r}"
  }
  return r

test "#allow_sideffect prevents fold" =
  assert::equals(traced_double(21), 42)

// --------------------------------------------------------------------------
// 9. boundary values — i64 limits, zero divisors, deep nests
// --------------------------------------------------------------------------

fn{#pure} safe_div(a i64, b i64) i64 =
  if b == 0:
    return 0
  return a / b

fn{#pure} ten_levels_deep(n i64) i64 =
  if n > 10:
    return n
  return ten_levels_deep(n + 1) + 1

test "boundary: zero check folds to early return" =
  assert::equals(safe_div(10, 2), 5)
  assert::equals(safe_div(10, 0), 0)

test "boundary: deep recursion via base case" =
  // ten_levels_deep(0) walks up to n=11 (returns 11), unwinds 11 frames
  // each adding 1, giving 11 + 11 = 22.
  assert::equals(ten_levels_deep(0), 22)
  assert::equals(ten_levels_deep(11), 11)

// --------------------------------------------------------------------------
// 10. mixed-tier — same fn called with literal args (folds) and variable
//     args (must compile a real call). Both must produce the right answer.
// --------------------------------------------------------------------------

fn{#pure} doubled(n i64) i64 = return n * 2

fn use_doubled(n i64) i64 = return doubled(n)

test "literal arg folds; variable arg compiles" =
  assert::equals(doubled(7), 14)
  // Runtime call — the body runs, not the fold.
  let dynamic i64 = 9
  assert::equals(use_doubled(dynamic), 18)
