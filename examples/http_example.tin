// examples/http_example.tin - HTTP client demo
//
// Requires network access. Run with:
//   tin run examples/http_example.tin

use http
use strings

fn print_resp(label string, resp http::HttpResponse) =
  echo "{label}: {resp.version} {resp.status} {resp.reason}"
  let ct = resp.headers.get("content-type")

  if ct != "":
    echo "  content-type: {ct}"
  let cl = resp.headers.get("content-length")

  if cl != "":
    echo "  content-length: {cl}"
  if len(resp.body) > 0:
    let preview = resp.body

    if len(preview) > 120:
      preview = strings::substr(preview, 0, 120) ++ "..."
    echo "  body: {preview}"

fn{#async} main() =
  echo "=== default client ==="
  let resp = await http::get("http://httpbin.org/get")

  print_resp("GET /get", resp)

  echo "=== explicit request ==="
  let req = http::Request{
    method:  "POST",
    url:     "http://httpbin.org/post",
    headers: collections::HashMap[string, string]::make(1),
    body:    "hello",
  }
  let resp2 = await http::send(req)

  print_resp("POST /post", resp2)

  echo "=== custom client ==="
  let c = http::Client::new()

  c.set_header("x-app", "tin")
  let resp3 = await http::get(c, "http://httpbin.org/get")

  print_resp("GET /get (x-app: tin)", resp3)
  let resp4 = await http::post_json(c, "http://httpbin.org/post", "\{\"ok\":true}")

  print_resp("POST /post json", resp4)

  echo "=== put / patch / delete / head ==="
  print_resp("PUT    /put",    await http::put("http://httpbin.org/put", "body"))
  print_resp("PATCH  /patch",  await http::patch("http://httpbin.org/patch", "data"))
  print_resp("DELETE /delete", await http::delete("http://httpbin.org/delete"))
  print_resp("HEAD   /get",    await http::head("http://httpbin.org/get"))
  echo "done"
