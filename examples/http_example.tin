// examples/http_example.tin - HTTP client demo
//
// Requires network access. Run with:
//   tin run examples/http_example.tin

use http

fn{#async} main() =
  echo "=== default client ==="
  let resp = await http::get("http://httpbin.org/get")
  echo resp.status

  echo "=== explicit request ==="
  let req = http::Request{
    method:  "POST",
    url:     "http://httpbin.org/post",
    headers: collections::HashMap[string, string]::new(1),
    body:    "hello",
  }
  let resp2 = await http::send(req)
  echo resp2.status

  echo "=== custom client ==="
  let c = http::Client::new()
  c.set_header("x-app", "tin")
  let resp3 = await http::get(c, "http://httpbin.org/get")
  echo resp3.status
  let resp4 = await http::post_json(c, "http://httpbin.org/post", "{\"ok\":true}")
  echo resp4.status

  echo "=== put / patch / delete / head ==="
  let r5 = await http::put("http://httpbin.org/put", "body")
  echo r5.status
  let r6 = await http::patch("http://httpbin.org/patch", "data")
  echo r6.status
  let r7 = await http::delete("http://httpbin.org/delete")
  echo r7.status
  let r8 = await http::head("http://httpbin.org/get")
  echo r8.status
  echo "done"
