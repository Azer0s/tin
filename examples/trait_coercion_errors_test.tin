// examples/trait_coercion_errors_test.tin -- runtime semantics for
// trait coercion.
//
//   - `let f Trait = b` produces a fat-ptr that owns a heap-allocated
//     snapshot of `b`.  Mutations through *Self impl methods land on
//     the snapshot, not on `b`.
//   - `let f Trait = &b` aliases the source pointer when the source
//     is RC-managed (heap-promoted local, `&T{...}`, etc.).
//     Mutations through *Self impl methods propagate to `b`.
//   - `let a *Trait = &b` is the long-form alias.  Still supported
//     but flagged with -Wptr-trait -- the value-form is the
//     canonical shape.

use assert
use "./fixtures/run_compiler"

trait Fooable =
  fn foo(this *Fooable, n i64) = virtual

struct CBox(Fooable) =
  v i64

  fn Fooable::foo(this *CBox, n i64) =
    this.v = n

test "value source: trait owns a snapshot, mutation does not propagate" =
  let b = CBox{v: 0}
  let f Fooable = b

  f.foo(2)

  assert::equals(0 as i64, b.v)

test "pointer source: trait aliases the source, mutation propagates" =
  let b = CBox{v: 0}
  let f Fooable = &b

  f.foo(2)

  assert::equals(2 as i64, b.v)

test "*Trait form aliases the source: mutation propagates" =
  let b = CBox{v: 0}
  let a *Fooable = &b

  (*a).foo(2)

  assert::equals(2 as i64, b.v)

// 5. Value form is fine when every method takes the receiver by value.

trait Readable =
  fn read(this Readable) i64 = virtual

struct Source(Readable) =
  v i64

  fn Readable::read(this Source) i64 =
    return this.v

test "value Trait works for read-only traits (Self receiver)" =
  let s = Source{v: 7}
  let r Readable = s

  assert::equals(7 as i64, r.read())

// 6. Atomic[t].for_locked accepts a multi-statement anon lambda
// whose last stmt carries the call's `)` on the same line.  The
// parser must defer the lambda body's DEDENT so it doesn't pop the
// surrounding scope (regression for the "for_locked won't parse"
// bug).

use sync

struct Stats =
  count i64
  total i64

test "Atomic.for_locked accepts indented multi-stmt anon lambda" =
  let s = sync::Atomic[Stats].new(Stats{count: 0, total: 0})

  s.for_locked(fn(p *Stats) =
    p.count = p.count + 1
    p.total = p.total + 100)
  s.for_locked(fn(p *Stats) =
    p.count = p.count + 1
    p.total = p.total + 200)

  let snap = s.load()

  assert::equals(2 as i64,   snap.count)
  assert::equals(300 as i64, snap.total)
