use assert
use encoding::url
use strings
use collections

test "encode unreserved chars unchanged" =
  assert::equals(url::encode("abc"), "abc")
  assert::equals(url::encode("ABC"), "ABC")
  assert::equals(url::encode("123"), "123")
  assert::equals(url::encode("-_.~"), "-_.~")

test "encode special chars" =
  assert::equals(url::encode(" "), "%20")
  assert::equals(url::encode("/"), "%2F")
  assert::equals(url::encode("?"), "%3F")
  assert::equals(url::encode("="), "%3D")
  assert::equals(url::encode("&"), "%26")
  assert::equals(url::encode("+"), "%2B")

test "encode mixed string" =
  assert::equals(url::encode("hello world"), "hello%20world")
  assert::equals(url::encode("foo=bar&baz=qux"), "foo%3Dbar%26baz%3Dqux")

test "decode percent sequences" =
  assert::equals(url::decode("%20"), " ")
  assert::equals(url::decode("%2F"), "/")
  assert::equals(url::decode("hello%20world"), "hello world")

test "decode plus as space" =
  assert::equals(url::decode("hello+world"), "hello world")
  assert::equals(url::decode("a+b+c"), "a b c")

test "decode invalid passthrough" =
  assert::equals(url::decode("%ZZ"), "%ZZ")
  assert::equals(url::decode("%2"), "%2")

test "decode lowercase hex" =
  assert::equals(url::decode("%2f"), "/")
  assert::equals(url::decode("%3d"), "=")

test "roundtrip" =
  let s = "hello world! foo=bar&baz=123"

  assert::equals(url::decode(url::encode(s)), s)

test "encode_query both keys present" =
  let m = collections::HashMap[string, string].make(4)

  m.set("b", "2")
  m.set("a", "1")
  let qs = url::encode_query(m)

  assert::ok(strings::index_of(qs, "a=1") >= 0)
  assert::ok(strings::index_of(qs, "b=2") >= 0)

test "encode_query keys sorted" =
  let m = collections::HashMap[string, string].make(4)

  m.set("z", "last")
  m.set("a", "first")
  m.set("m", "mid")
  let qs = url::encode_query(m)
  let ai = strings::index_of(qs, "a=")
  let mi = strings::index_of(qs, "m=")
  let zi = strings::index_of(qs, "z=")

  assert::ok(ai < mi)
  assert::ok(mi < zi)

test "encode_query encodes special chars in values" =
  let m = collections::HashMap[string, string].make(4)

  m.set("q", "hello world")
  let qs = url::encode_query(m)

  assert::equals(qs, "q=hello%20world")

test "encode_query empty map" =
  let m = collections::HashMap[string, string].make(4)

  assert::equals(url::encode_query(m), "")

test "parse_query basic" =
  let m = url::parse_query("q=hello+world&page=2&empty=")

  assert::equals(m.get("q"), "hello world")
  assert::equals(m.get("page"), "2")
  assert::equals(m.get("empty"), "")
  assert::equals(m.get("missing"), "")

test "parse_query empty string" =
  let m = url::parse_query("")

  assert::equals(m.len(), 0)

test "parse_query single pair" =
  let m = url::parse_query("key=value")

  assert::equals(m.get("key"), "value")
  assert::equals(m.len(), 1)

test "parse_query percent encoded" =
  let m = url::parse_query("q=hello%20world&x=%2B")

  assert::equals(m.get("q"), "hello world")
  assert::equals(m.get("x"), "+")

test "parse_query no value" =
  let m = url::parse_query("flag")

  assert::equals(m.get("flag"), "")
  assert::equals(m.len(), 1)

test "parse_query round trip" =
  let m = collections::HashMap[string, string].make(4)

  m.set("hello world", "a b")
  m.set("x", "100%25")
  let qs = url::encode_query(m)
  let m2 = url::parse_query(qs)

  assert::equals(m2.get("hello world"), "a b")
  assert::equals(m2.get("x"), "100%25")
