// stdlib_usage.tin — demonstrates using the standard library modules.
//
// The stdlib modules (io, math, mem, os, str) are pre-compiled and bundled
// with the tin compiler. They are available via `use <name>`.
//
// Build:   tin build examples/stdlib_usage.tin -lm
// Run:     tin run   examples/stdlib_usage.tin -lm
// Test:    tin test  examples/stdlib_usage.tin -lm

use io
use math
use str
use assert

// Print a greeting via io::puts (wraps C puts, adds newline).
io::puts("=== stdlib_usage example ===")

// Math: compute sqrt(2) and floor/ceil it.
let root2 = math::sqrt(2.0)
io::printf("sqrt(2) = %f\n", root2)
io::printf("floor   = %f\n", math::floor(root2))
io::printf("ceil    = %f\n", math::ceil(root2))

// str: measure string length and compare two strings.
let hello = "Hello, world!"
let n i64 = str::strlen(hello)
io::printf("len(\"%s\") = %lld\n", hello, n)

let cmp i32 = str::strcmp("abc", "abc")
io::printf("strcmp(\"abc\",\"abc\") = %d\n", cmp)

test "math stdlib" =
  assert::equals_f64(math::floor(math::sqrt(2.0)), 1.0)
  assert::equals_f64(math::ceil(math::sqrt(2.0)), 2.0)
  assert::ok(math::sqrt(2.0) > 1.4)
  assert::ok(math::sqrt(2.0) < 1.5)

test "str stdlib" =
  assert::equals(str::strlen("Hello, world!"), 13)
  assert::equals(str::strlen(""), 0)
  assert::equals(str::strcmp("abc", "abc") as i64, 0)
  assert::ok(str::strcmp("abc", "xyz") < 0)
