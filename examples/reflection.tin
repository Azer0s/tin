// reflection.tin - demonstrates typeof, traitof, fieldnames, fieldtypes,
//                  getfield, setfield (including runtime dispatch via `any`)
//
// Build:  tin build examples/reflection.tin
// Run:    tin run   examples/reflection.tin

use io

// Traits

trait labeled =
  fn label(this labeled) string = virtual

trait sized =
  fn size(this sized) i64 = virtual

// Structs

struct point(labeled, sized) =
  x i64
  y i64

  fn label(this point) string =
    return "point"

  fn size(this point) i64 =
    return 2

struct color =
  r i64
  g i64
  b i64

// typeof (concrete)

let p = point { x: 10, y: 20 }
let c = color { r: 255, g: 128, b: 0 }

io::printf("typeof(p)    = %s\n", typeof(p))
io::printf("typeof(c)    = %s\n", typeof(c))
io::printf("typeof(42)   = %s\n", typeof(42))
io::printf("typeof(3.14) = %s\n", typeof(3.14))
io::printf("typeof(true) = %s\n", typeof(true))

// traitof (concrete)

let pt = traitof(p)
io::printf("traitof(p).len = %lld\n", pt.len)
for let i i64 in 0..pt.len :
  io::printf("  trait[%lld] = %s\n", i, pt[i])

let ct = traitof(c)
io::printf("traitof(c).len = %lld\n", ct.len)

// fieldnames (concrete)

let pf = fieldnames(p)
io::printf("fieldnames(p).len = %lld\n", pf.len)
for let i i64 in 0..pf.len :
  io::printf("  field[%lld] = %s\n", i, pf[i])

// fieldtypes (concrete)

let pfty = fieldtypes(p)
io::printf("fieldtypes(p).len = %lld\n", pfty.len)
for let i i64 in 0..pfty.len :
  io::printf("  ftype[%lld] = %s\n", i, pfty[i])

// getfield / setfield (concrete)

let vx = getfield(p, "x")    // vx is any
echo vx                       // prints the actual i64 value
setfield(p, "x", 99)
io::printf("after setfield x=99: p.x = %lld\n", p.x)

// typeof / traitof / fieldnames on `any`

let a1 any = p
let a2 any = c

io::printf("typeof(a1 any=point) = %s\n", typeof(a1))
io::printf("typeof(a2 any=color) = %s\n", typeof(a2))

let at1 = traitof(a1)
io::printf("traitof(a1).len = %lld\n", at1.len)
for let i i64 in 0..at1.len :
  io::printf("  trait[%lld] = %s\n", i, at1[i])

let af1 = fieldnames(a1)
io::printf("fieldnames(a1).len = %lld\n", af1.len)
for let i i64 in 0..af1.len :
  io::printf("  field[%lld] = %s\n", i, af1[i])

let aft1 = fieldtypes(a1)
io::printf("fieldtypes(a1).len = %lld\n", aft1.len)
for let i i64 in 0..aft1.len :
  io::printf("  ftype[%lld] = %s\n", i, aft1[i])

// getfield on `any`

let ag any = p
let gx = getfield(ag, "x")    // gx is any
echo gx

// typeof on pointers and arrays

let pv = p
let ptr_p = &pv
io::printf("typeof(&p)    = %s\n", typeof(ptr_p))

let arr = [1, 2, 3]
io::printf("typeof([1,2,3])= %s\n", typeof(arr))

use assert

test "typeof primitives" =
  assert::equals_str(typeof(42),   "i64")
  assert::equals_str(typeof(true), "bool")

test "fieldnames on point" =
  let p2 = point{x: 1, y: 2}
  let names = fieldnames(p2)
  assert::equals(len(names), 2)
  assert::equals_str(names[0], "x")
  assert::equals_str(names[1], "y")

test "getfield and setfield on point" =
  let p3 = point{x: 10, y: 20}
  let vx = getfield(p3, "x") as i64
  assert::equals(vx, 10)
  setfield(p3, "x", 99)
  assert::equals(p3.x, 99)
