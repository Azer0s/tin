// malloc_dispatch.tin - allocate structs with mem::malloc and use dynamic dispatch.
//
// Demonstrates:
//   - sizeof(T) returning the correct byte size of any type
//   - data types have a 1-byte tag prepended: sizeof(maybe[i64]) == 9 > 8
//   - heap-allocating a struct via mem::malloc(sizeof(animal))
//   - casting *void -> *animal and initialising fields through the pointer
//   - wrapping the heap pointer in a speak fat-pointer for dynamic dispatch
//
// Build:  tin build examples/malloc_dispatch.tin
// Run:    tin run   examples/malloc_dispatch.tin

use io
use mem

// Data type

data maybe[t] = t | None

// Trait

trait speak =
  fn sound(this speak) string = virtual
  fn label(this speak) string = virtual

// Structs

struct dog(speak) =
  tag i64

  fn sound(this dog) string =
    return "Woof!"

  fn label(this dog) string =
    return "dog"

struct cat(speak) =
  tag i64

  fn sound(this cat) string =
    return "Meow!"

  fn label(this cat) string =
    return "cat"

// Generic constrained dispatch
// Monomorphized at each call site - no fat-pointer overhead for stack values.

fn describe[t](a t) where t is speak =
  io::printf("%s says: %s\n", a.label(), a.sound())

// sizeof sanity-check

io::printf("sizeof(dog)        = %lld\n", sizeof(dog))
io::printf("sizeof(cat)        = %lld\n", sizeof(cat))
io::printf("sizeof(speak)      = %lld\n", sizeof(speak))
io::printf("sizeof(i64)        = %lld\n", sizeof(i64))
io::printf("sizeof(i32)        = %lld\n", sizeof(i32))
// data types: { i32 type_id, i8 variant_tag, [8 x i8] payload } = 16 (aligned)
io::printf("sizeof(maybe[i64]) = %lld\n", sizeof(maybe[i64]))

// Stack dispatch (constrained generic)

let stack_d = dog { tag: 1 }
let stack_c = cat { tag: 2 }
describe(stack_d)
describe(stack_c)

// Heap allocation + fat-pointer dynamic dispatch

// Allocate a dog on the heap and initialise it through the pointer.
let raw_dog = mem::malloc(sizeof(dog))
let dp = raw_dog as *dog
(*dp).tag = 42

// Wrap the heap *dog directly in the speak fat-pointer for runtime dispatch.
let hd speak = dp
io::printf("heap %s says: %s\n", hd.label(), hd.sound())

// Same for cat.
let raw_cat = mem::malloc(sizeof(cat))
let cp = raw_cat as *cat
(*cp).tag = 99

let hc speak = cp
io::printf("heap %s says: %s\n", hc.label(), hc.sound())

// Free heap memory.
mem::free(raw_dog)
mem::free(raw_cat)

use assert

test "heap dog dispatch" =
  let raw = mem::malloc(sizeof(dog))
  let dp = raw as *dog
  (*dp).tag = 1
  let hd speak = dp
  assert::equals_str(hd.sound(), "Woof!")
  assert::equals_str(hd.label(), "dog")
  mem::free(raw)

test "heap cat dispatch" =
  let raw = mem::malloc(sizeof(cat))
  let cp = raw as *cat
  (*cp).tag = 2
  let hc speak = cp
  assert::equals_str(hc.sound(), "Meow!")
  assert::equals_str(hc.label(), "cat")
  mem::free(raw)

test "sizeof data type includes tag" =
  assert::ok(sizeof(maybe[i64]) > 8)
