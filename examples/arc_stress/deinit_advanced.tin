// ARC stress: advanced deinit scenarios

struct tracked =
  name string

  fn init(this tracked) =
    echo "init:{this.name}"

  fn deinit(this tracked) =
    echo "deinit:{this.name}"

struct outer =
  inner tracked

  fn deinit(this outer) =
    echo "deinit:outer"

// Deinit on overwrite: old value deinit'd, new value lives on
fn overwrite_test() =
  let t = tracked{name: "v1"}
  echo "alive"
  // t out of scope: deinit:v1

// Return: deinit fires at caller scope exit, not inside the function
fn make_tracked(n string) tracked =
  return tracked{name: n}

fn return_test() =
  let t = make_tracked("returned")
  echo "got: {t.name}"
  // deinit:returned here

// Nested struct: outer deinit fires first, then inner fields released (calls inner deinit)
fn nested_test() =
  let o = outer{inner: tracked{name: "inner"}}
  echo "outer alive"
  // deinit:outer then deinit:inner

// Deinit when struct has string fields (must not double-free)
struct stringy =
  label string

  fn deinit(this stringy) =
    echo "deinit:{this.label}"

fn string_deinit_test() =
  let s1 = stringy{label: "A" ++ "B"}
  let s2 = stringy{label: "C" ++ "D"}
  echo s1.label
  echo s2.label
  // deinit:CD then deinit:AB

overwrite_test()
return_test()
nested_test()
string_deinit_test()
