// ARC stress: any boxing/unboxing
// Boxing allocates an RC heap block; releasing the any must release that block

fn box_string() =
  let s = "hello" ++ " world"
  let a any = s
  // a released here - RC block freed

fn box_int() =
  let n = 42
  let a any = n

  echo a

fn box_and_pass(a any) =
  echo a

fn repeated_boxing() =
  let s1 = "foo" ++ "bar"

  box_and_pass(s1)
  let s2 = "baz" ++ "qux"

  box_and_pass(s2)

fn box_in_loop() =
  let vals = [1, 2, 3, 4, 5]
  let a any = vals[0]
  let b any = vals[4]

  echo a
  echo b

box_string()
box_int()
repeated_boxing()
box_in_loop()
