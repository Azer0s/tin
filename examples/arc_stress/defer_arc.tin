// ARC stress: defer + ARC interaction
// Deferred functions run before scope releases - strings allocated before defer
// must survive until defer executes.
// Note: defer only works with function calls, not bare echo.

use assert

fn make_greeting(name string) string =
  return "hello, " ++ name

fn defer_with_rc(name string) string =
  let msg = make_greeting(name)
  return msg

fn chain_with_defer() =
  let a = "hello" ++ " world"
  let b = a ++ "!"
  echo b

fn multi_alloc_scope() =
  let s1 = "first" ++ ""
  let s2 = "second" ++ ""
  let s3 = s1 ++ " " ++ s2
  echo s3

let r = defer_with_rc("arc")
echo r
chain_with_defer()
multi_alloc_scope()
