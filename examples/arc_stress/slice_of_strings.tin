// ARC stress: slice of strings
// Tests slices that store string values.
// Known limitation: slice elements are not RC-retained on insertion or
// RC-released when the slice data block is freed. This test documents
// current behavior with immortal literals (no leak because literals are
// static) and will catch regressions.

fn slice_strings_basic() =
  let words = ["hello", "world", "foo", "bar"]

  echo words[0]
  echo words[1]

fn slice_concat_strings() =
  let a = ["x", "y"]
  let b = ["z", "w"]
  let c = a ++ b

  echo c[0]
  echo c[3]

fn slice_strings_returned() [string] =
  return ["alpha", "beta", "gamma"]

fn iterate_strings() =
  let words = ["one", "two", "three"]

  for let w string in words:
    echo w

let r = slice_strings_returned()

echo r[0]

slice_strings_basic()
slice_concat_strings()
iterate_strings()
