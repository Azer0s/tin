// examples/arc_stress/fiber_arc.tin
//
// Spawns many fibers that allocate strings and pass them through a channel.
// Validates that no memory is leaked (run under valgrind).

use sync

var result_ch sync::Channel[string]

fn{#async} make_string(n i64) =
  let s = "fiber-{n}"
  await result_ch.send(s)

fn main() =
  let n i64 = 1000
  result_ch = sync::Channel[string].make(n)

  let i i64 = 0
  for i < n:
    spawn make_string(i)
    i = i + 1

  let collected i64 = 0
  for collected < n:
    await result_ch.recv()
    collected = collected + 1

  echo "arc_stress fiber: OK, collected {collected} strings"
