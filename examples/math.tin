// Math utilities: GCD, power, abs
use assert

fn gcd(a i64, b i64) i64 =
  where b == 0: a
  where _: gcd(b, a % b)

fn pow(base i64, exp i64) i64 =
  where exp == 0: 1
  where _: base * pow(base, exp - 1)

fn abs(n i64) i64 =
  where n < 0: 0 - n
  where _: n

echo gcd(48, 18)
echo gcd(100, 75)
echo gcd(17, 5)

echo pow(2, 10)
echo pow(3, 5)
echo pow(10, 3)

echo abs(0 - 42)
echo abs(7)

test "gcd" =
  assert::equals(gcd(48, 18), 6)
  assert::equals(gcd(100, 75), 25)
  assert::equals(gcd(17, 5), 1)
  assert::equals(gcd(0, 5), 5)

test "pow" =
  assert::equals(pow(2, 10), 1024)
  assert::equals(pow(3, 5), 243)
  assert::equals(pow(10, 3), 1000)
  assert::equals(pow(5, 0), 1)

test "abs" =
  assert::equals(abs(0 - 42), 42)
  assert::equals(abs(7), 7)
  assert::equals(abs(0), 0)
