use assert

// Commutative swap: primitive lhs + struct rhs should rewrite to
// rhs.add(lhs). Only commutative ops (+, *, ==, !=) trigger this.

struct Vec3(add[f64, Vec3]) =
  x f64
  y f64
  z f64

  fn ::add(this Vec3, k f64) Vec3 =
    return Vec3{x: this.x + k, y: this.y + k, z: this.z + k}

test "f64 + Vec3 swaps to Vec3.add(f64)" =
  let v = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let r = 10.0 + v

  assert::equals(11.0, r.x)
  assert::equals(12.0, r.y)
  assert::equals(13.0, r.z)
