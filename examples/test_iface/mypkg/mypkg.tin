use io
use mem

fn{#async} my_read_impl(fd i32, buf *byte, n i64) i64 =
  return 7

struct MyReader (io::AsyncReader) =
  fd i32

  fn AsyncReader::read(this MyReader, buf *byte, n i64) Future[i64] =
    let p = &this as *byte
    echo "[read] this addr={p as i64} fd={this.fd}"
    return spawn my_read_impl(this.fd, buf, n)

fn{#async} call_iface(r io::AsyncReader) i64 =
  echo "[call_iface] BEFORE"
  let buf = mem::malloc(16) as *byte
  let rd = await r.read(buf, 16)
  mem::free(buf as *void)
  return rd

export { MyReader, call_iface } as mypkg
