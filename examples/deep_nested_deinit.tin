use assert

// 10-level deep value-nested struct, deepest level owns RC fields (string +
// dynamic array). Verifies that emitRelease recurses through every level and
// frees the leaf RC fields. Run under valgrind.

struct Leaf =
  s string
  arr [i64]

struct L9 =
  inner Leaf
struct L8 =
  inner L9
struct L7 =
  inner L8
struct L6 =
  inner L7
struct L5 =
  inner L6
struct L4 =
  inner L5
struct L3 =
  inner L4
struct L2 =
  inner L3
struct L1 =
  inner L2
struct L0 =
  inner L1

fn build() L0 =
  let s = "hello" ++ "_world"
  let a = [1, 2, 3, 4, 5]

  return L0{inner: L1{inner: L2{inner: L3{inner: L4{inner: L5{
    inner: L6{inner: L7{inner: L8{inner: L9{
      inner: Leaf{s: s, arr: a},
    }}}}}}}}}}

test "10-level nested struct: build and drop" =
  let v = build()

  assert::equals("hello_world", v.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.s)
  assert::equals(5, len(v.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.arr))

test "10-level reassign frees prior leaf" =
  let v = build()
  v = build()

  assert::equals("hello_world", v.inner.inner.inner.inner.inner.inner.inner.inner.inner.inner.s)
