// examples/test_os.tin - tests for the os stdlib file, stat, and dir ops.
//
// Run:  tin test examples/test_os.tin

use os
use assert

const TMP = "/tmp/tin_test_os"

fn tmp(name string) string = return TMP ++ "/" ++ name

fn setup() =
  let _ = os::mkdir(TMP)

fn post_test() =
  let _ = os::rmdir(TMP)

// -------------------------------------------------------------------------
// File write / read

test "write_file and read_file round-trip" =
  setup()

  defer post_test()
  let path = tmp("rw.txt")
  let we = os::write_file(path, "hello\n")

  assert::ok(!we.is_err())
  let content = os::read_file(path).unwrap_or("")
  assert::equals(content, "hello\n")
  os::remove(path)

test "write_file creates file" =
  setup()

  defer post_test()
  let path = tmp("create.txt")
  let we = os::write_file(path, "created")

  assert::ok(!we.is_err())
  assert::ok(os::exists(path))
  os::remove(path)

test "write_file truncates existing file" =
  setup()

  defer post_test()
  let path = tmp("trunc.txt")

  let _ = os::write_file(path, "long content here")
  let _ = os::write_file(path, "short")
  let content = os::read_file(path).unwrap_or("")
  assert::equals(content, "short")
  os::remove(path)

test "append_file" =
  setup()

  defer post_test()
  let path = tmp("append.txt")

  let _ = os::write_file(path, "line1\n")
  let _ = os::append_file(path, "line2\n")
  let _ = os::append_file(path, "line3\n")
  let content = os::read_file(path).unwrap_or("")
  assert::equals(content, "line1\nline2\nline3\n")
  os::remove(path)

test "append_file creates file if missing" =
  setup()

  defer post_test()
  let path = tmp("append_new.txt")
  let ae = os::append_file(path, "first\n")

  assert::ok(!ae.is_err())
  let content = os::read_file(path).unwrap_or("")
  assert::equals(content, "first\n")
  os::remove(path)

test "read_file error on missing file" =
  assert::ok(os::read_file(tmp("no_such_file_xyz.txt")).is_err())

test "write_file_bytes and read_file_bytes round-trip" =
  setup()

  defer post_test()
  let path = tmp("bytes.bin")
  // byte is i8 (signed), so 0xFF = -1; use values that round-trip cleanly
  let data = [1 as byte, 2 as byte, 3 as byte, -1 as byte, 0 as byte]
  let we = os::write_file_bytes(path, data)

  assert::ok(!we.is_err())
  match os::read_file_bytes(path):
    case Ok(got):
      assert::equals(len(got) as i64, 5)
      assert::equals(got[0] as i64, 1)
      assert::equals(got[3] as i64, -1)
      assert::equals(got[4] as i64, 0)
    case Err(_):
      assert::fails("expected read_file_bytes to succeed")
  os::remove(path)

test "empty file round-trip" =
  setup()

  defer post_test()
  let path = tmp("empty.txt")

  let _ = os::write_file(path, "")
  let content = os::read_file(path).unwrap_or("MISSING")
  assert::equals(content, "")
  assert::equals(os::file_size(path), 0)
  os::remove(path)

// -------------------------------------------------------------------------
// stat / exists / is_dir / file_size

test "exists returns true for a file" =
  setup()

  defer post_test()
  let path = tmp("ex_file.txt")

  let _ = os::write_file(path, "x")
  assert::ok(os::exists(path))
  os::remove(path)

test "exists returns false for missing path" =
  assert::ok(!os::exists(tmp("no_such_path_xyz")))

test "exists returns true for a directory" =
  setup()

  defer post_test()
  assert::ok(os::exists(TMP))

test "is_dir returns false for a file" =
  setup()

  defer post_test()
  let path = tmp("notdir.txt")

  let _ = os::write_file(path, "y")
  assert::ok(!os::is_dir(path))
  os::remove(path)

test "is_dir returns true for a directory" =
  setup()

  defer post_test()
  assert::ok(os::is_dir(TMP))

test "file_size" =
  setup()

  defer post_test()
  let path = tmp("size.txt")

  let _ = os::write_file(path, "12345")
  assert::equals(os::file_size(path), 5)
  os::remove(path)

test "file_size returns -1 for missing file" =
  assert::equals(os::file_size(tmp("missing_xyz.txt")), -1 as i64)

test "stat on a file" =
  setup()

  defer post_test()
  let path = tmp("stat_file.txt")

  let _ = os::write_file(path, "hello!")
  match os::stat(path):
    case Ok(info):
      assert::ok(!info.is_directory)
      assert::equals(info.size, 6)
    case Err(_):
      assert::fails("stat should succeed")
  os::remove(path)

test "stat on a directory" =
  setup()

  defer post_test()
  match os::stat(TMP):
    case Ok(info): assert::ok(info.is_directory)
    case Err(_):   assert::fails("stat should succeed on dir")

test "stat error on missing path" =
  assert::ok(os::stat(tmp("no_such_stat_xyz")).is_err())

// -------------------------------------------------------------------------
// mkdir / rmdir / rename / remove

test "mkdir creates nested directories" =
  setup()

  defer post_test()
  let dir = tmp("mkdir_test/a/b")
  let me = os::mkdir(dir)

  assert::ok(!me.is_err())
  assert::ok(os::is_dir(dir))
  let _ = os::rmdir(dir)
  let _ = os::rmdir(tmp("mkdir_test/a"))
  let _ = os::rmdir(tmp("mkdir_test"))

test "mkdir succeeds on existing directory" =
  setup()

  defer post_test()
  let me = os::mkdir(TMP)

  assert::ok(!me.is_err())

test "rmdir removes empty directory" =
  setup()
  let dir = tmp("rmdir_test")

  let _ = os::mkdir(dir)
  let re = os::rmdir(dir)

  assert::ok(!re.is_err())
  assert::ok(!os::exists(dir))
  post_test()

test "rmdir error on missing directory" =
  let re = os::rmdir(tmp("no_such_dir_xyz"))

  assert::ok(re.is_err())

test "remove deletes a file" =
  setup()

  defer post_test()
  let path = tmp("remove_me.txt")

  let _ = os::write_file(path, "bye")
  let re = os::remove(path)

  assert::ok(!re.is_err())
  assert::ok(!os::exists(path))

test "remove error on missing file" =
  let re = os::remove(tmp("no_such_remove_xyz.txt"))

  assert::ok(re.is_err())

test "rename moves a file" =
  setup()

  defer post_test()
  let src = tmp("rename_src.txt")
  let dst = tmp("rename_dst.txt")

  let _ = os::write_file(src, "moved")
  let re = os::rename(src, dst)

  assert::ok(!re.is_err())
  assert::ok(!os::exists(src))
  assert::ok(os::exists(dst))
  let content = os::read_file(dst).unwrap_or("")
  assert::equals(content, "moved")
  os::remove(dst)

test "rename error on missing source" =
  let re = os::rename(tmp("no_src_xyz.txt"), tmp("no_dst_xyz.txt"))

  assert::ok(re.is_err())
