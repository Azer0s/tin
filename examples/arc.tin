// arc.tin - Automatic Reference Counting (ARC) semantics
//
// ARC is applied to three kinds of values:
//   - strings       {i8* data, i64 len}   - heap-allocated byte buffer
//   - dynamic arrays {T* data, i64 len}   - heap-allocated element buffer
//   - any           {i8* ptr, i32 typeID} - heap-allocated box
//
// Every assignment that reads from an existing variable causes a retain.
// Every variable that goes out of scope causes a release.
// When the reference count drops to zero the backing memory is freed.
//
// ARC does NOT apply to:
//   - plain structs  (stack/register values unless they contain RC fields)
//   - integers, floats, booleans, pointers, atoms, enums
//
// Build: tin build examples/arc.tin
// Run:   tin run   examples/arc.tin

use assert

// String ARC

test "string copy retains" =
  let a = "hello"
  let b = a        // retain: both reference the same buffer

  assert::equals(a, "hello")
  assert::equals(b, "hello")
  // on scope exit: b released, then a released - buffer freed when rc -> 0

test "string concatenation is a new allocation" =
  let a = "foo"
  let b = "bar"
  let c = a ++ b   // new allocation for "foobar"

  assert::equals(c, "foobar")
  assert::equals(a, "foo")   // original untouched

test "string passed to function" =
  fn greet(name string) string =
    return "hello " ++ name
  let s = greet("world")

  assert::equals(s, "hello world")

struct labeled =
  tag string
  val i64

test "string field in struct" =
  let x = labeled{tag: "count", val: 42}
  let y = x           // copies struct; retains tag string

  assert::equals(y.tag, "count")
  assert::equals(y.val, 42)

// Dynamic array ARC

test "array copy retains" =
  let a = [1, 2, 3]
  let b = a        // retain

  assert::equals(b.len, 3)
  assert::equals(b[0], 1)

test "array append does not alias" =
  let a = [1, 2, 3]
  let b = a
  b ++= 4

  // b now has length 4; a is unaffected (append reallocates)
  assert::equals(a.len, 3)
  assert::equals(b.len, 4)

test "array of strings" =
  let words = ["one", "two", "three"]
  let copy = words

  assert::equals(copy.len, 3)
  assert::equals(copy[0], "one")

// `any` boxing ARC

test "string boxed to any and unboxed" =
  let s = "tin"
  let a any = s          // boxes s into a heap allocation
  let s2 = a as string   // unbox back to string

  assert::equals(s2, "tin")

test "i64 boxed to any and unboxed" =
  let n i64 = 99
  let a any = n as any
  let n2 = a as i64

  assert::equals(n2, 99)

test "value boxed to any" =
  let n i64 = 7
  let a any = n as any

  assert::equals(a as i64, 7)

// Scope and lifetime

test "multiple string variables in scope" =
  let a = "alpha"
  let b = "beta"
  let c = a ++ " " ++ b

  assert::equals(c, "alpha beta")

test "string returned from function keeps value" =
  fn make_str(n i64) string =
    if n > 0 :
      return "positive"
    return "non-positive"

  let r1 = make_str(5)
  let r2 = make_str(-1)

  assert::equals(r1, "positive")
  assert::equals(r2, "non-positive")
