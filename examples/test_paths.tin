// examples/test_paths.tin - tests for the paths stdlib.
//
// Pure-Tin path utilities: join, basename, dirname, ext.
// No system calls; no linker flags needed.
//
// Run: tin test examples/test_paths.tin

use paths
use assert

// -------------------------------------------------------------------------
// join

test "join: simple" =
  assert::equals_str(paths::join("foo", "bar"), "foo/bar")

test "join: trailing slash on left" =
  assert::equals_str(paths::join("foo/", "bar"), "foo/bar")

test "join: leading slash on right" =
  assert::equals_str(paths::join("foo", "/bar"), "foo/bar")

test "join: both slashes" =
  assert::equals_str(paths::join("foo/", "/bar"), "foo/bar")

test "join: empty left" =
  assert::equals_str(paths::join("", "bar"), "bar")

test "join: empty right" =
  assert::equals_str(paths::join("foo", ""), "foo")

test "join: absolute paths" =
  assert::equals_str(paths::join("/usr", "local"), "/usr/local")

test "join: multi-segment" =
  assert::equals_str(paths::join("a/b/c", "d/e"), "a/b/c/d/e")

test "join: preserves extensions" =
  assert::equals_str(paths::join("dir", "file.txt"), "dir/file.txt")

// -------------------------------------------------------------------------
// basename

test "basename: simple" =
  assert::equals_str(paths::basename("foo.txt"), "foo.txt")

test "basename: with directory" =
  assert::equals_str(paths::basename("/foo/bar/baz.txt"), "baz.txt")

test "basename: trailing slash" =
  assert::equals_str(paths::basename("/foo/bar/"), "bar")

test "basename: root" =
  assert::equals_str(paths::basename("/"), "/")

test "basename: no directory" =
  assert::equals_str(paths::basename("file.txt"), "file.txt")

test "basename: empty" =
  assert::equals_str(paths::basename(""), "")

test "basename: double trailing slash" =
  assert::equals_str(paths::basename("foo//"), "foo")

// -------------------------------------------------------------------------
// dirname

test "dirname: simple" =
  assert::equals_str(paths::dirname("/foo/bar/baz.txt"), "/foo/bar")

test "dirname: one level" =
  assert::equals_str(paths::dirname("/foo/bar"), "/foo")

test "dirname: trailing slash" =
  assert::equals_str(paths::dirname("/foo/bar/"), "/foo")

test "dirname: no directory" =
  assert::equals_str(paths::dirname("file.txt"), ".")

test "dirname: relative path" =
  assert::equals_str(paths::dirname("foo/bar"), "foo")

test "dirname: root" =
  assert::equals_str(paths::dirname("/"), "/")

test "dirname: empty" =
  assert::equals_str(paths::dirname(""), ".")

test "dirname: just filename in subdir" =
  assert::equals_str(paths::dirname("dir/file"), "dir")

// -------------------------------------------------------------------------
// ext

test "ext: simple" =
  assert::equals_str(paths::ext("foo.tin"), ".tin")

test "ext: last extension only" =
  assert::equals_str(paths::ext("archive.tar.gz"), ".gz")

test "ext: no extension" =
  assert::equals_str(paths::ext("Makefile"), "")

test "ext: hidden file (leading dot)" =
  assert::equals_str(paths::ext(".gitignore"), "")

test "ext: empty string" =
  assert::equals_str(paths::ext(""), "")

test "ext: dot in directory, no ext on file" =
  assert::equals_str(paths::ext("foo.bar/baz"), "")

test "ext: dot in directory, ext on file" =
  assert::equals_str(paths::ext("foo.bar/baz.txt"), ".txt")

test "ext: multiple dots" =
  assert::equals_str(paths::ext("a.b.c.d"), ".d")

test "ext: just extension" =
  assert::equals_str(paths::ext(".txt"), "")
