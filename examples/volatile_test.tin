// Volatile pointer smoke tests.
//
// `addr(int_literal)` returns `volatile *char`; `addr(arr[i])` (in
// `do{#unsafe}:`) returns `volatile *T`.  Volatile pointers live in
// LLVM addrspace(1); the rc machinery treats them as opaque and
// emits no retain/release, so binding them to a let and dropping
// out of scope is well-defined for bogus addresses too.

use assert
use mem

test "addr(hex) yields volatile *char" =
  do{#unsafe}:
    let p volatile *char = addr(0xDEADBEEF)
    let n i64 = p as i64
    assert::equals(n, 0xDEADBEEF)

test "addr(arr[i]) yields volatile *T (warns)" =
  do{#unsafe}:
    let xs [i64] = [10, 20, 30]
    let q volatile *i64 = addr(xs[1])
    assert::ok((q as i64) != 0)

// Regression for the build_argv-style segfault: `int as *T` must
// produce a volatile pointer so the rc-balanced store skips the
// release-of-old-slot probe at `*slotp = p`.  On Linux glibc the
// freed page's preceding bytes are unmapped, so probing
// `(slot_value) - sizeof(TinRCHdr)` for the magic header faults;
// macOS keeps freed pages mapped so the bug stayed invisible.  The
// fix flows `int as *T` -> `volatile *T` and the rc-balanced store
// short-circuits when the lvalue is volatile.
test "int->ptr cast over freshly-malloc'd buffer stores cleanly" =
  let argc i64 = 3
  let arr = mem::malloc((argc + 1) * 8) as **char
  let i i64 = 0

  for i < argc:
    let bufp = mem::malloc(8) as *char
    let slot  = (arr as i64) + i * 8
    let slotp = slot as **char

    *slotp = bufp
    i = i + 1
  // Read back to confirm the stores landed without crashing on
  // uninit-slot release_ptr.
  let j i64 = 0

  for j < argc:
    let s     = (arr as i64) + j * 8
    let sp    = s as **char
    let p     = *sp

    assert::ok((p as i64) != 0)

    mem::free(p as *void)
    j = j + 1

  mem::free(arr as *void)

// Regression for the [volatile *char] element-array release path.
// Storing borrowed raw pointers (e.g. `c_str_data(args[i])` style)
// into a `[volatile *char]` must not retain on assignment, AND the
// outer array's scope-exit release must drop only the buffer's rc
// without walking elements through `_tin_release`.  Walking would
// decrement the rc of whatever owning string each slot aliases into,
// producing a use-after-free at the original owner's next access.
fn fill_argv(args [string]) i64 =
  let n = len(args)
  let argv [volatile *char] = [nil as volatile *char] * n
  do{#unsafe}:
    let i i64 = 0
    for i < n:
      argv[i] = addr(args[i][0])
      i = i + 1
  return n

test "borrowed *char into [volatile *char] preserves owner string" =
  let id i64 = 42
  let k = "vol-elem:{id}"
  let _ = fill_argv(["A", k, "B"])
  // If element-walk had decremented k's rc, the bytes would be freed
  // and overwritten by the allocator's free-list metadata.
  assert::equals(len(k), 11)
  assert::equals(k, "vol-elem:42")
