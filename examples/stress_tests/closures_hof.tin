// stress_tests/closures_hof.tin
//
// Tests: complex closure and higher-order function patterns
//   - Functions that return closures (environment capture)
//   - Closures capturing mutable outer variables (by reference)
//   - Closures passed as arguments, returned, stored in arrays
//   - Deeply nested closure definitions
//   - Closures as struct fields (via fn type fields)
//   - Higher-order functions that take and return other HOFs
//   - Partial application via closure wrapping
//   - Closure identity: capturing the same variable in two closures
//
// Compiler paths exercised:
//   - Environment struct generation for each closure
//   - Correct capture of variables at time-of-definition vs time-of-call
//   - fn type fields in structs
//   - Returning fn types from generic functions

use assert

// ---------------------------------------------------------------------------
// 1. Function returning a closure that captures its argument
// ---------------------------------------------------------------------------

fn make_adder(n i64) fn(i64) i64 =
  return fn(x i64) i64 = return x + n

fn make_multiplier(n i64) fn(i64) i64 =
  return fn(x i64) i64 = return x * n

// ---------------------------------------------------------------------------
// 2. Closures sharing a captured mutable variable
//    Both closures capture the same binding - tests environment aliasing.
// ---------------------------------------------------------------------------

fn make_counter() fn() i64 =
  let count i64 = 0
  return fn() i64 =
    count = count + 1
    return count

// ---------------------------------------------------------------------------
// 3. Function returning a closure that itself returns a closure (currying)
// ---------------------------------------------------------------------------

fn curry_add(a i64) fn(i64) fn(i64) i64 =
  return fn(b i64) fn(i64) i64 =
    return fn(c i64) i64 = return a + b + c

// ---------------------------------------------------------------------------
// 4. Array of closures - all closures captured differently
// ---------------------------------------------------------------------------

fn make_pow_fns() [fn(i64) i64] =
  let fns [fn(i64) i64] = []
  // Each fn captures its own copy of `exp`
  let exp0 = fn(x i64) i64 = return 1          // x^0
  let exp1 = fn(x i64) i64 = return x          // x^1
  let exp2 = fn(x i64) i64 = return x * x      // x^2
  let exp3 = fn(x i64) i64 = return x * x * x  // x^3
  fns ++= [exp0]
  fns ++= [exp1]
  fns ++= [exp2]
  fns ++= [exp3]

  return fns

// ---------------------------------------------------------------------------
// 5. Higher-order function that composes N closures from an array
// ---------------------------------------------------------------------------

fn compose_all(fns [fn(i64) i64], init i64) i64 =
  let acc i64 = init

  for let f fn(i64) i64 in fns:
    acc = f(acc)

  return acc

// ---------------------------------------------------------------------------
// 6. Generic HOF: takes a predicate, returns a "filter-counter"
// ---------------------------------------------------------------------------

fn count_matching[t](pred fn(t) bool) fn([t]) i64 =
  return fn(arr [t]) i64 =
    let n i64 = 0

    for let v t in arr:
      if pred(v):
        n = n + 1

    return n

// ---------------------------------------------------------------------------
// 7. Partial application: fix left argument via closure
// ---------------------------------------------------------------------------

fn partial_left(f fn(i64, i64) i64, a i64) fn(i64) i64 =
  return fn(b i64) i64 = return f(a, b)

fn partial_right(f fn(i64, i64) i64, b i64) fn(i64) i64 =
  return fn(a i64) i64 = return f(a, b)

// ---------------------------------------------------------------------------
// 8. Deeply nested inline closure definition
// ---------------------------------------------------------------------------

fn deep_nest(n i64) i64 =
  let f1 = fn(a i64) i64 =
    let f2 = fn(b i64) i64 =
      let f3 = fn(c i64) i64 =
        return a + b + c
      return f3(a)

    return f2(a + 1)

  return f1(n)

// ---------------------------------------------------------------------------
// 9. Struct with fn-type field acting as a method table
// ---------------------------------------------------------------------------

struct handler =
  transform fn(i64) i64
  validate  fn(i64) bool

fn make_positive_handler() handler =
  return handler{
    transform: fn(x i64) i64 = return x * 2 + 1,
    validate: fn(x i64) bool = return x > 0,
  }

fn make_bounded_handler(lo i64, hi i64) handler =
  return handler{
    transform: fn(x i64) i64 =
      if x < lo:
        return lo
      if x > hi:
        return hi
      return x,
    validate: fn(x i64) bool = return x >= lo && x <= hi,
  }

fn run_handler(h handler, x i64) i64 =
  if h.validate(x):
    return h.transform(x)
  return 0 - 1

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

test "make_adder captures arg" =
  let add5 = make_adder(5)
  let add10 = make_adder(10)

  assert::equals(add5(3), 8)
  assert::equals(add10(3), 13)
  assert::equals(add5(0), 5)

test "make_multiplier captures arg" =
  let double = make_multiplier(2)
  let triple = make_multiplier(3)

  assert::equals(double(7), 14)
  assert::equals(triple(7), 21)

test "counter closure increments" =
  let c = make_counter()

  assert::equals(c(), 1)
  assert::equals(c(), 2)
  assert::equals(c(), 3)

test "two independent counters" =
  let c1 = make_counter()
  let c2 = make_counter()

  assert::equals(c1(), 1)
  assert::equals(c1(), 2)
  assert::equals(c2(), 1)  // c2 independent of c1
  assert::equals(c1(), 3)

test "curry_add three args" =
  let f = curry_add(1)
  let g = f(2)

  assert::equals(g(3), 6)
  assert::equals(curry_add(10)(20)(30), 60)

test "array of power functions" =
  let fns = make_pow_fns()

  assert::equals(fns[0](99), 1)
  assert::equals(fns[1](5), 5)
  assert::equals(fns[2](4), 16)
  assert::equals(fns[3](3), 27)

test "compose_all pipeline" =
  // double then add5 then square
  let double = make_multiplier(2)
  let add5 = make_adder(5)
  let square = fn(x i64) i64 = return x * x
  let pipeline [fn(i64) i64] = [double, add5, square]

  // start=3: double->6, add5->11, square->121
  assert::equals(compose_all(pipeline, 3), 121)

test "count_matching with integer predicate" =
  let count_evens = count_matching(fn(n i64) bool = return n % 2 == 0)

  assert::equals(count_evens([1, 2, 3, 4, 5, 6]), 3)
  assert::equals(count_evens([1, 3, 5]), 0)

test "partial_left fixes first arg" =
  let add = fn(a i64, b i64) i64 = return a + b
  let add10 = partial_left(add, 10)

  assert::equals(add10(5), 15)
  assert::equals(add10(0), 10)

test "partial_right fixes second arg" =
  let sub = fn(a i64, b i64) i64 = return a - b
  let sub3 = partial_right(sub, 3)

  assert::equals(sub3(10), 7)
  assert::equals(sub3(3), 0)

test "deeply nested closure" =
  // f1(n): f2(n+1): f3(n) = n + (n+1) + n = 3n+1
  assert::equals(deep_nest(4), 13)
  assert::equals(deep_nest(0), 1)

test "handler struct with fn fields - positive" =
  let h = make_positive_handler()

  assert::equals(run_handler(h, 5), 11)
  assert::equals(run_handler(h, 0 - 1), 0 - 1)

test "handler struct with fn fields - bounded" =
  let h = make_bounded_handler(0, 10)

  assert::equals(run_handler(h, 5), 5)     // in range, identity
  assert::equals(run_handler(h, 0 - 3), 0 - 1)  // below lo, validate fails
  assert::equals(run_handler(h, 15), 0 - 1)    // above hi, validate fails
