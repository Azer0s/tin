// stress_tests/spawn_complex_args.tin
//
// Tests: spawn with complex argument expressions that must be evaluated in
// the caller before the fiber is created. This stresses the argument
// materialization pass and ensures temporaries are correctly placed in the
// environment struct passed to the new fiber.
//
// Patterns tested:
//   - spawn with struct literal as argument
//   - spawn with array literal as argument
//   - spawn with closure as argument
//   - spawn with result of another function call as argument
//   - spawn with arithmetic expression as argument
//   - spawn do: block that captures many locals
//   - spawn inside a generic function
//   - spawn with multiple complex arguments
//   - spawn inside a loop with loop-variable-dependent args

use assert
use sync

struct work_item =
  id     i64
  factor i64
  label  string

fn{#async} process_item(item work_item) i64 =
  return item.id * item.factor

fn{#async} process_with_transform(vals [i64], f fn(i64) i64) i64 =
  let total i64 = 0

  for let v i64 in vals:
    total = total + f(v)

  return total

fn{#async} add_two(a i64, b i64) i64 =
  return a + b

fn{#async} sum_array(arr [i64]) i64 =
  let acc i64 = 0

  for let v i64 in arr:
    acc = acc + v

  return acc

fn make_work_item(id i64) work_item =
  return work_item{id: id, factor: id * 2, label: "item_{id}"}

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

test "spawn with struct literal argument" =
  let f = spawn process_item(work_item{id: 5, factor: 3, label: "x"})
  let r = await f

  assert::equals(r, 15)

test "spawn with struct built by function call" =
  let f = spawn process_item(make_work_item(4))
  let r = await f

  // id=4, factor=8
  assert::equals(r, 32)

test "spawn with array literal argument" =
  let f = spawn sum_array([10, 20, 30, 40])
  let r = await f

  assert::equals(r, 100)

test "spawn with closure argument" =
  let f = spawn process_with_transform([1, 2, 3, 4, 5], fn(n i64) i64 = return n * n)
  let r = await f

  // 1+4+9+16+25 = 55
  assert::equals(r, 55)

test "spawn with arithmetic expression as argument" =
  let base i64 = 6
  let f = spawn add_two(base * base, base + 1)
  let r = await f

  // 36 + 7 = 43
  assert::equals(r, 43)

test "spawn with result of nested function calls as argument" =
  let f = spawn sum_array(
    [1 * 1, 2 * 2, 3 * 3, 4 * 4]  // array of expressions
  )
  let r = await f

  assert::equals(r, 30)

test "spawn with two complex struct args" =
  // process_item gets struct; add_two gets results of two spawns
  let f1 = spawn process_item(work_item{id: 3, factor: 7, label: "a"})
  let f2 = spawn process_item(work_item{id: 2, factor: 6, label: "b"})
  let r1 = await f1
  let r2 = await f2
  let f3 = spawn add_two(r1, r2)
  let r3 = await f3

  // 21 + 12 = 33
  assert::equals(r3, 33)

test "spawn inside loop with loop-index-dependent args" =
  let ch = sync::Channel[i64].make(5)
  let i i64 = 0

  for i < 5:
    let n = i + 1  // capture by value, not by reference

    spawn do:
      await ch.send(n * n)
    i = i + 1

  let total i64 = 0
  let j i64 = 0

  for j < 5:
    total = total + await ch.recv()
    j = j + 1

  // 1+4+9+16+25 = 55
  assert::equals(total, 55)

test "spawn do: block captures many locals" =
  let a i64 = 10
  let b i64 = 20
  let c i64 = 30
  let d i64 = 40
  let e i64 = 50
  let label string = "test"
  let ch = sync::Channel[i64].make(1)
  let f = spawn do:
    let sum = a + b + c + d + e

    await ch.send(sum)

  await f
  let result = await ch.recv()

  assert::equals(result, 150)

// Hoisted to module scope: generic `fn{#async}` cannot be a lambda
// because lambdas don't carry their own type-param list.  The test
// below calls this as a normal package-level fn.
fn{#async} spawn_transform[t](arr [t], f fn(t) i64, ch sync::Channel[i64]) =
  for let v t in arr:
    let fib = spawn do:
      await ch.send(f(v))

    await fib

test "spawn in generic function" =
  let ch = sync::Channel[i64].make(3)
  let f = spawn spawn_transform(
    ["a", "bb", "ccc"],
    fn(s string) i64 = return len(s),
    ch,
  )

  await f
  let r1 = await ch.recv()
  let r2 = await ch.recv()
  let r3 = await ch.recv()

  assert::equals(r1 + r2 + r3, 6)
