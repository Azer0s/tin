// stress_tests/short_circuit.tin
//
// Tests: && and || actually short-circuit. The RHS must NOT evaluate
// when the LHS already determines the result. Regression for the bug
// where genLogicalAnd/Or emitted `select` and eagerly evaluated both
// operands, causing OOB reads in patterns like `n > 0 && a[n-1] == x`.

use assert
use mem

// Side-effect counter to detect whether RHS ran.

var hits i64 = 0

fn bump() bool =
  hits = hits + 1
  return true

fn bump_false() bool =
  hits = hits + 1
  return false

// Identity helper: returns its bool argument unchanged. Wrapping the
// LHS in a function call hides it from the De Morgan / bool-fold pass
// so the && / || codegen actually runs at runtime.

fn id(b bool) bool = return b

// && short-circuit: false LHS -> RHS skipped.

fn check_and_short() i64 =
  hits = 0
  if id(false) && bump():
    return -1
  return hits

// && evaluates RHS when LHS is true.

fn check_and_runs() i64 =
  hits = 0
  if id(true) && bump():
    return hits
  return -1

// || short-circuit: true LHS -> RHS skipped.

fn check_or_short() i64 =
  hits = 0
  if id(true) || bump():
    return hits
  return -1

// || evaluates RHS when LHS is false.

fn check_or_runs() i64 =
  hits = 0
  if id(false) || bump():
    return hits
  return -1

// Real-world pattern that previously OOB-read: guard array access by length.

fn safe_last_eq(p *byte, n i64, want byte) bool =
  return n > 0 && p[n-1] == want

fn check_safe_empty() bool =
  let buf = mem::malloc(8) as *byte
  buf[0] = 0
  let r = safe_last_eq(buf, 0, 0)  // n==0 -> RHS must not read p[-1]
  mem::free(buf as *void)
  return r

fn check_safe_match() bool =
  let buf = mem::malloc(8) as *byte
  buf[0] = 42 as byte
  let r = safe_last_eq(buf, 1, 42 as byte)
  mem::free(buf as *void)
  return r

// Triple-chained && also short-circuits (left-to-right).

fn triple_and(a bool, b bool, c bool) i64 =
  hits = 0
  if a && b && bump():
    return 100 + hits
  return hits

// Mixed chains: a && (b || c).

fn mixed_chain(a bool) i64 =
  hits = 0
  if a && (bump_false() || bump()):
    return 100 + hits
  return hits

test "and short-circuits when LHS is false" =
  assert::equals(check_and_short(), 0)

test "and evaluates RHS when LHS is true" =
  assert::equals(check_and_runs(), 1)

test "or short-circuits when LHS is true" =
  assert::equals(check_or_short(), 0)

test "or evaluates RHS when LHS is false" =
  assert::equals(check_or_runs(), 1)

test "guarded array access does not read OOB on empty" =
  assert::equals(check_safe_empty(), false)

test "guarded array access reads correct element on non-empty" =
  assert::equals(check_safe_match(), true)

test "triple and short-circuits at first false" =
  // a=false: bump never runs -> hits=0
  assert::equals(triple_and(false, true, true), 0)
  // a=true, b=false: bump never runs -> hits=0
  assert::equals(triple_and(true, false, true), 0)
  // a=true, b=true: bump runs once -> hits=1, returns 101
  assert::equals(triple_and(true, true, true), 101)

test "mixed and-or evaluates only what is needed" =
  // a=false: nothing on RHS runs -> hits=0
  assert::equals(mixed_chain(false), 0)
  // a=true: bump_false runs (hits=1, returns false), then bump runs (hits=2, returns true) -> 102
  assert::equals(mixed_chain(true), 102)
