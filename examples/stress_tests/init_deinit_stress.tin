// stress_tests/init_deinit_stress.tin
//
// Tests: struct init/deinit lifecycle hooks in complex scenarios:
//   - init called on construction even inside arrays
//   - deinit called when variable goes out of scope (end of block)
//   - deinit called on early return
//   - deinit ordering: LIFO among variables in the same scope
//   - structs with both init and deinit nested inside another struct
//   - deinit not called for heap-allocated structs (malloc)
//   - Interaction of defer + deinit: correct ordering
//
// Compiler paths exercised:
//   - Scope-end code injection for deinit
//   - Early-return path patching for deinit
//   - Nested struct deinit ordering
//   - deinit vs defer ordering at function exit

use assert
use mem

// Structs with observable init/deinit via shared log

// We use a global [string] to record events.
// In real test code the log would be a module-level var.
var event_log [string]

fn log_event(msg string) =
  event_log ++= [msg]
struct resource =
  id     i64
  active bool

  fn init(this resource) =
    log_event("init:{this.id}")
    this.active = true

  fn deinit(this resource) =
    log_event("deinit:{this.id}")

// 1. Basic init/deinit ordering within a block

fn scope_order_test() =
  event_log = []
  let a = resource{id: 1}
  let b = resource{id: 2}
  let c = resource{id: 3}
  // end of scope: c deinit first (LIFO), then b, then a

// 2. deinit on early return

fn early_return_test(n i64) i64 =
  event_log = []
  let a = resource{id: 10}

  if n < 0:
    return 0 - 1  // deinit a must fire here
  let b = resource{id: 11}

  return n  // deinit b then a

// 3. deinit with nested struct (field struct also has deinit)

struct outer_resource =
  inner resource
  outer_id i64

  fn init(this outer_resource) =
    log_event("outer_init:{this.outer_id}")

  fn deinit(this outer_resource) =
    log_event("outer_deinit:{this.outer_id}")
    // inner.deinit is called automatically after outer.deinit

// 4. Verify that deinit is NOT called for heap-allocated structs

fn heap_no_deinit_test() =
  event_log = []
  let p *resource = mem::calloc(1, sizeof(resource)).(*resource)

  (*p).id = 99
  // p goes out of scope but deinit should NOT be called for heap pointer
  // (caller is responsible for freeing; the compiler doesn't auto-deinit
  // through raw pointers)
  mem::free(p)

// 5. Interaction of defer + deinit
//    Defers run before deinit for the same scope.

fn defer_vs_deinit() =
  event_log = []
  let r = resource{id: 5}

  defer do:
    log_event("deferred")
  // At end of scope: defer fires first, then r.deinit. event_log
  // (a global) is read after the call to observe both events; we
  // can't return event_log directly because Tin fat arrays capture
  // (ptr, len) at return time, freezing the snapshot before defer
  // and deinit run.

// Tests

test "init called on construction" =
  event_log = []
  let r = resource{id: 42}

  assert::equals(len(event_log), 1)
  assert::equals(event_log[0], "init:42")

test "deinit called at end of block LIFO" =
  scope_order_test()
  // init: 1, 2, 3; deinit: 3, 2, 1
  assert::equals(len(event_log), 6)
  assert::equals(event_log[0], "init:1")
  assert::equals(event_log[1], "init:2")
  assert::equals(event_log[2], "init:3")
  assert::equals(event_log[3], "deinit:3")
  assert::equals(event_log[4], "deinit:2")
  assert::equals(event_log[5], "deinit:1")

test "deinit called on early return (only a)" =
  let result = early_return_test(0 - 5)

  // init:10 (a), early return taken, deinit:10 (a)
  // b was never constructed
  assert::equals(result, 0 - 1)
  assert::equals(len(event_log), 2)
  assert::equals(event_log[0], "init:10")
  assert::equals(event_log[1], "deinit:10")

test "deinit called on normal return (b then a)" =
  let result = early_return_test(7)

  // init:10 (a), init:11 (b), return 7: deinit:11, deinit:10
  assert::equals(result, 7)
  assert::equals(len(event_log), 4)
  assert::equals(event_log[0], "init:10")
  assert::equals(event_log[1], "init:11")
  assert::equals(event_log[2], "deinit:11")
  assert::equals(event_log[3], "deinit:10")

test "heap allocation does not trigger deinit" =
  heap_no_deinit_test()
  // No init or deinit events should have been logged
  assert::equals(len(event_log), 0)

test "defer fires before deinit" =
  defer_vs_deinit()
  // Expected: init:5, then at end of scope: defer fires ("deferred"), then deinit:5
  assert::ok(len(event_log) >= 3)
  assert::equals(event_log[0], "init:5")
  assert::equals(event_log[1], "deferred")
  assert::equals(event_log[2], "deinit:5")
