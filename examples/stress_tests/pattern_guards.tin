// stress_tests/pattern_guards.tin
//
// Tests: complex pattern matching with guards (where clauses) and tagged
// union type dispatch combined with conditionals. Exercises:
//   - where-clause functions with many overlapping guard conditions
//   - is-binding guards combined with further conditions on the bound value
//   - match on tagged union then further match inside a case
//   - where dispatch that recurses
//   - Guard expressions that call other functions
//   - Atom-based dispatch mixed with numeric guards
//
// Compiler paths exercised:
//   - Guard evaluation order and short-circuit in where arms
//   - Correct SSA after tagged union type dispatch + re-use of bound variable
//   - Recursive where-dispatch (self-call inside a where arm)

use assert

type expr_val = i64 | f64 | string | bool

// 1. where dispatch with numeric range guards

fn grade(score i64) string =
  where score >= 90: "A"
  where score >= 80: "B"
  where score >= 70: "C"
  where score >= 60: "D"
  where _: "F"

fn classify_temp(t f64) atom =
  where t < 0.0:   'freezing
  where t < 10.0:  'cold
  where t < 20.0:  'cool
  where t < 30.0:  'warm
  where _:         'hot

// 2. where dispatch that recurses

fn collatz(n i64) i64 =
  where n == 1: 0
  where n % 2 == 0: 1 + collatz(n / 2)
  where _: 1 + collatz(n * 3 + 1)

// 3. Tagged union dispatch with further branching in each case

fn describe_val(v expr_val) string =
  match v.(type):
    case n i64:
      if n < 0:
        return "negative integer {n}"
      if n == 0:
        return "zero"

      return "positive integer {n}"
    case x f64:
      if x < 0.0:
        return "negative float"
      return "positive float"
    case s string:
      if len(s) == 0:
        return "empty string"
      return "string: {s}"
    case b bool:
      if b:
        return "true"
      return "false"

// 4. is-binding guard combined with further condition on bound value

fn process_maybe_num(v expr_val) i64 =
  if v is n i64:
    if n > 0:
      return n * 2
    return 0 - n

  if v is x f64:
    if x > 0.0:
      return 1
    return 0 - 1

  return 0

// 5. Chained is-checks on the same variable

fn type_priority(v expr_val) i64 =
  if v is _ i64:
    return 4
  if v is _ f64:
    return 3
  if v is _ string:
    return 2
  if v is _ bool:
    return 1

  return 0

// 6. where dispatch on atom with fallthrough to a guarded default

fn atom_guard(a atom, n i64) string =
  where a == 'special && n > 100: "special and large"
  where a == 'special:            "special but small"
  where a == 'normal && n == 0:   "normal zero"
  where a == 'normal:             "normal {n}"
  where _:                        "unknown"

// 7. Nested match: outer on tagged union, inner on enum

enum i32 priority =
  low:    0
  medium: 1
  high:   2

type task_result = i64 | string

fn evaluate_task(res task_result, prio priority) string =
  match res.(type):
    case n i64:
      match prio:
        case priority.high:
          return "high priority result: {n * 2}"
        case priority.medium:
          return "medium priority result: {n}"
        default:
          return "low priority result: {n / 2}"
    case msg string:
      match prio:
        case priority.high:
          return "urgent: {msg}"
        default:
          return "message: {msg}"

// Tests

test "grade where guards" =
  assert::equals(grade(95), "A")
  assert::equals(grade(85), "B")
  assert::equals(grade(75), "C")
  assert::equals(grade(65), "D")
  assert::equals(grade(55), "F")
  assert::equals(grade(90), "A")
  assert::equals(grade(80), "B")

test "classify_temp atom guards" =
  assert::ok(classify_temp(0 - 5.0) == 'freezing)
  assert::ok(classify_temp(5.0) == 'cold)
  assert::ok(classify_temp(15.0) == 'cool)
  assert::ok(classify_temp(25.0) == 'warm)
  assert::ok(classify_temp(35.0) == 'hot)

test "collatz recursive where dispatch" =
  // collatz(1)=0, collatz(2)=1, collatz(4)=2, collatz(6)=8
  assert::equals(collatz(1), 0)
  assert::equals(collatz(2), 1)
  assert::equals(collatz(4), 2)

test "describe_val tagged union dispatch" =
  assert::equals(describe_val(42 as expr_val), "positive integer 42")
  assert::equals(describe_val((0 - 5) as expr_val), "negative integer -5")
  assert::equals(describe_val(0 as expr_val), "zero")
  assert::equals(describe_val(3.14 as expr_val), "positive float")
  assert::equals(describe_val("hi" as expr_val), "string: hi")
  assert::equals(describe_val("" as expr_val), "empty string")
  assert::equals(describe_val(true as expr_val), "true")
  assert::equals(describe_val(false as expr_val), "false")

test "process_maybe_num with is binding" =
  assert::equals(process_maybe_num(5 as expr_val), 10)
  assert::equals(process_maybe_num((0 - 3) as expr_val), 3)
  assert::equals(process_maybe_num(2.0 as expr_val), 1)
  assert::equals(process_maybe_num("x" as expr_val), 0)

test "type_priority" =
  assert::equals(type_priority(0 as expr_val), 4)
  assert::equals(type_priority(1.0 as expr_val), 3)
  assert::equals(type_priority("s" as expr_val), 2)
  assert::equals(type_priority(true as expr_val), 1)

test "atom_guard with numeric condition" =
  assert::equals(atom_guard('special, 200), "special and large")
  assert::equals(atom_guard('special, 50), "special but small")
  assert::equals(atom_guard('normal, 0), "normal zero")
  assert::equals(atom_guard('normal, 7), "normal 7")
  assert::equals(atom_guard('other, 0), "unknown")

test "evaluate_task nested match" =
  assert::equals(evaluate_task(10 as task_result, priority.high), "high priority result: 20")
  assert::equals(evaluate_task(10 as task_result, priority.medium), "medium priority result: 10")
  assert::equals(evaluate_task(10 as task_result, priority.low), "low priority result: 5")
  assert::equals(evaluate_task("alert" as task_result, priority.high), "urgent: alert")
  assert::equals(evaluate_task("info" as task_result, priority.low), "message: info")
