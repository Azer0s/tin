// stress_tests/return_closures.tin
//
// Tests: functions that return closures with non-trivial captured environments,
// functions whose return TYPE is itself a function type, returning closures
// from generic functions, returning closures that themselves return closures,
// and storing/calling returned closures through various intermediate steps.
//
// Compiler paths exercised:
//   - Environment struct lifetime for returned closures (heap vs. stack)
//   - fn-type return type lowering
//   - Generic function returning fn type (monomorphization of return type)
//   - Closure returned from one frame, called in another frame
//   - Multi-level fn-returning-fn type signatures

use assert

// ---------------------------------------------------------------------------
// 1. Return a closure that closes over a primitive
// ---------------------------------------------------------------------------

fn make_threshold_check(threshold i64) fn(i64) bool =
  return fn(x i64) bool = return x > threshold

fn make_range_check(lo i64, hi i64) fn(i64) bool =
  return fn(x i64) bool = return x >= lo && x <= hi

// ---------------------------------------------------------------------------
// 2. Return a closure that closes over an array (heap lifetime)
// ---------------------------------------------------------------------------

fn make_lookup(table [string]) fn(i64) string =
  return fn(idx i64) string =
    if idx < 0 || idx >= len(table):
      return ""
    return table[idx]

// ---------------------------------------------------------------------------
// 3. Return a closure from a generic function
// ---------------------------------------------------------------------------

fn make_default_returner[t](default_val t) fn() t =
  return fn() t = return default_val

fn make_mapper[t, r](f fn(t) r) fn([t]) [r] =
  return fn(arr [t]) [r] =
    let out [r] = []
    for let v t in arr:
      out ++= f(v)
    return out

// ---------------------------------------------------------------------------
// 4. Function returning a closure that returns a closure
//    (produces a fn type whose return type is also a fn type)
// ---------------------------------------------------------------------------

fn make_adder_factory() fn(i64) fn(i64) i64 =
  return fn(base i64) fn(i64) i64 =
    return fn(delta i64) i64 = return base + delta

fn make_multiplier_factory() fn(i64) fn(i64) i64 =
  return fn(factor i64) fn(i64) i64 =
    return fn(x i64) i64 = return factor * x

// ---------------------------------------------------------------------------
// 5. Closure returned from a method on a struct
// ---------------------------------------------------------------------------

struct scaler =
  factor i64

  fn get_scale_fn(this scaler) fn(i64) i64 =
    return fn(x i64) i64 = return x * this.factor

  fn get_offset_fn(this scaler, offset i64) fn(i64) i64 =
    return fn(x i64) i64 = return x * this.factor + offset

// ---------------------------------------------------------------------------
// 6. Return closure that mutates captured state
//    (tests that heap-allocated env survives across multiple calls)
// ---------------------------------------------------------------------------

fn make_accumulator(start i64) fn(i64) i64 =
  let acc i64 = start
  return fn(delta i64) i64 =
    acc = acc + delta
    return acc

// ---------------------------------------------------------------------------
// 7. Array of returned closures - all with different captured environments
// ---------------------------------------------------------------------------

fn make_offset_checks(thresholds [i64]) [fn(i64) bool] =
  let fns [fn(i64) bool] = []
  for let t i64 in thresholds:
    fns ++= make_threshold_check(t)
  return fns

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

test "threshold check returns correct bool" =
  let above10 = make_threshold_check(10)
  assert::ok(above10(11))
  assert::not_ok(above10(10))
  assert::not_ok(above10(5))

test "range check closure" =
  let in_range = make_range_check(5, 15)
  assert::ok(in_range(5))
  assert::ok(in_range(15))
  assert::ok(in_range(10))
  assert::not_ok(in_range(4))
  assert::not_ok(in_range(16))

test "lookup closure with array env" =
  let lookup = make_lookup(["zero", "one", "two", "three"])
  assert::equals_str(lookup(0), "zero")
  assert::equals_str(lookup(2), "two")
  assert::equals_str(lookup(5), "")   // out of bounds

test "generic default returner i64" =
  let get42 = make_default_returner(42)
  assert::equals(get42(), 42)
  assert::equals(get42(), 42)

test "generic default returner string" =
  let get_hello = make_default_returner("hello")
  assert::equals_str(get_hello(), "hello")

test "generic mapper closure" =
  let double_all = make_mapper(fn(n i64) i64 = return n * 2)
  let out = double_all([1, 2, 3, 4, 5])
  assert::equals(out[0], 2)
  assert::equals(out[4], 10)

test "adder factory double closure" =
  let factory = make_adder_factory()
  let add5 = factory(5)
  let add10 = factory(10)
  assert::equals(add5(3), 8)
  assert::equals(add10(3), 13)
  // Same factory can generate multiple independent closures
  assert::equals(add5(0), 5)
  assert::equals(add10(0), 10)

test "multiplier factory double closure" =
  let factory = make_multiplier_factory()
  let double = factory(2)
  let triple = factory(3)
  assert::equals(double(7), 14)
  assert::equals(triple(7), 21)

test "scaler struct returns closure capturing this" =
  let s = scaler{factor: 4}
  let scale4 = s.get_scale_fn()
  assert::equals(scale4(5), 20)
  assert::equals(scale4(0), 0)

test "scaler struct returns offset closure" =
  let s = scaler{factor: 3}
  let fn_ = s.get_offset_fn(10)
  assert::equals(fn_(5), 25)

test "accumulator state persists across calls" =
  let acc = make_accumulator(100)
  assert::equals(acc(5), 105)
  assert::equals(acc(10), 115)
  assert::equals(acc(0 - 15), 100)

test "two independent accumulators" =
  let a = make_accumulator(0)
  let b = make_accumulator(1000)
  assert::equals(a(1), 1)
  assert::equals(b(1), 1001)
  assert::equals(a(1), 2)
  assert::equals(b(1), 1002)

test "array of returned closures with different thresholds" =
  let checks = make_offset_checks([0, 5, 10, 20])
  // checks[0]: x > 0
  assert::ok(checks[0](1))
  assert::not_ok(checks[0](0))
  // checks[1]: x > 5
  assert::ok(checks[1](6))
  assert::not_ok(checks[1](5))
  // checks[3]: x > 20
  assert::ok(checks[3](21))
  assert::not_ok(checks[3](20))
