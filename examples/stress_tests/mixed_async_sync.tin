// stress_tests/mixed_async_sync.tin
//
// Tests: interleaving synchronous and asynchronous calls in the same function,
// calling sync functions from async functions, passing sync closures to async
// functions, using sync utility functions to prepare args for spawn, and
// awaiting multiple heterogeneous futures.
//
// Compiler paths exercised:
//   - Call lowering differences between #async and regular functions
//   - Stack discipline across yield/resume when sync helpers are inlined
//   - Return value passing between async and sync call frames
//   - Mix of Future[T] and plain T values in the same scope

use assert
use sync

// ---------------------------------------------------------------------------
// Sync helpers (regular functions)
// ---------------------------------------------------------------------------

fn{#pure} square(n i64) i64 =
  return n * n

fn{#pure} clamp(v i64, lo i64, hi i64) i64 =
  if v < lo:
    return lo
  if v > hi:
    return hi

  return v

fn{#pure} sum_arr(arr [i64]) i64 =
  let acc i64 = 0

  for let v i64 in arr:
    acc = acc + v

  return acc

// ---------------------------------------------------------------------------
// Async functions that call sync helpers internally
// ---------------------------------------------------------------------------

fn{#async} async_square(n i64) i64 =
  // sync call inside async function
  return square(n)

fn{#async} async_pipeline(vals [i64], lo i64, hi i64) i64 =
  // 1. sync: clamp each value
  let clamped [i64] = []

  for let v i64 in vals:
    clamped ++= [clamp(v, lo, hi)]
  // 2. spawn sub-fibers for expensive work (simulated)
  let futures [Future[i64]] = []

  for let c i64 in clamped:
    futures ++= [spawn async_square(c)]
  // 3. await all and sum - interleaves async awaits with sync accumulation
  let total i64 = 0
  let i i64 = 0

  for i < len(futures):
    let sq = await futures[i]

    total = total + sq   // sync addition after async await
    i = i + 1

  return total

// ---------------------------------------------------------------------------
// Async function that uses a sync closure to transform data before spawning
// ---------------------------------------------------------------------------

fn{#async} async_with_sync_transform(n i64) i64 =
  let transform = fn(x i64) i64 = return x * 3 + 1  // sync closure
  let prepared = transform(n)                          // sync call
  let doubled = await spawn async_square(prepared)     // async

  return doubled + sum_arr([1, 2, 3])                  // sync after async

// ---------------------------------------------------------------------------
// Sync function that uses the result of an awaited call
// (main() is sync; it calls into async territory via spawn/await)
// ---------------------------------------------------------------------------

fn process_results(a i64, b i64, c i64) i64 =
  // pure sync aggregation
  return sum_arr([a, b, c])

// ---------------------------------------------------------------------------
// Mixed: async function that calls another async function directly (no spawn)
// In Tin an #async function can call another #async function directly - it
// runs synchronously in the same fiber rather than spawning a new one.
// ---------------------------------------------------------------------------

fn{#async} direct_async_call_chain(n i64) i64 =
  let a = await spawn async_square(n)
  let b = await spawn async_square(a)  // spawning from inside async
  // sync work between awaits
  let mid = clamp(b, 0, 10000)
  let c = await spawn async_square(mid)

  return c

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

test "sync function called from async" =
  let r = await spawn async_square(7)

  assert::equals(r, 49)

test "async pipeline with sync steps" =
  // vals=[0-5, 3, 15], clamped to [1,10]: [1,3,10]
  // squares: 1+9+100=110
  let r = await spawn async_pipeline([0 - 5, 3, 15], 1, 10)

  assert::equals(r, 110)

test "async with sync transform" =
  // n=2: transform(2)=7, square(7)=49, sum([1,2,3])=6 -> 55
  let r = await spawn async_with_sync_transform(2)

  assert::equals(r, 55)

test "sync aggregation of async results" =
  let fa = spawn async_square(3)
  let fb = spawn async_square(4)
  let fc = spawn async_square(5)
  let a = await fa
  let b = await fb
  let c = await fc
  let total = process_results(a, b, c)

  assert::equals(total, 50)

test "direct async call chain" =
  // n=2: sq(2)=4, sq(4)=16, clamp(16,0,10000)=16, sq(16)=256
  let r = await spawn direct_async_call_chain(2)

  assert::equals(r, 256)

test "interleaved sync/async in main scope" =
  // Prepare args with sync functions, use async to compute
  let prepared = clamp(square(3), 5, 100)  // sync: square(3)=9, clamp->9
  let r = await spawn async_square(prepared)

  assert::equals(r, 81)

test "concurrent fibers with sync post-processing" =
  let ch = sync::Channel[i64].make(4)
  let i i64 = 0

  for i < 4:
    let n = i  // capture by value

    spawn do:
      let s = square(n + 1)  // sync inside spawn do:

      await ch.send(s)

    i = i + 1

  let total i64 = 0
  let j i64 = 0

  for j < 4:
    total = total + await ch.recv()
    j = j + 1

  // squares of 1,2,3,4 = 1+4+9+16 = 30
  assert::equals(total, 30)
