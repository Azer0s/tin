// stress_tests/async_channel_patterns.tin
//
// Tests: advanced channel usage patterns that stress fiber scheduling and
// IR generation for async code with complex channel interactions:
//   - Fan-out: one producer, many consumers
//   - Fan-in: many producers, one consumer
//   - Pipeline: chain of fibers each reading from and writing to channels
//   - Select-like pattern: first result wins (via buffered channel + check)
//   - Channel passed as argument to generic async function
//   - Recursive fan-out (divide and conquer via channels)
//   - Fiber that reads from two channels alternately
//
// Compiler paths exercised:
//   - await ch.send / await ch.recv in complex control flow
//   - Channel types as generic parameters to #async functions
//   - Many concurrent fibers all interacting with shared channels

use assert
use sync

fn{#async} producer(ch sync::Channel[i64], vals [i64]) =
  for let v i64 in vals:
    await ch.send(v)

fn{#async} consumer(ch sync::Channel[i64], n i64, out sync::Channel[i64]) =
  let total i64 = 0
  let i i64 = 0

  for i < n:
    total = total + await ch.recv()
    i = i + 1

  await out.send(total)

fn{#async} pipeline_stage(in_ch sync::Channel[i64], out_ch sync::Channel[i64], f fn(i64) i64, n i64) =
  let i i64 = 0

  for i < n:
    let v = await in_ch.recv()

    await out_ch.send(f(v))
    i = i + 1

fn{#async} sum_range_async(lo i64, hi i64, out sync::Channel[i64]) =
  let acc i64 = 0
  let i i64 = lo

  for i < hi:
    acc = acc + i
    i = i + 1

  await out.send(acc)

// ---------------------------------------------------------------------------
// Tests
// ---------------------------------------------------------------------------

test "fan-out: one producer, multiple consumers" =
  // Producer sends 6 values; 3 consumers each read 2
  let ch  = sync::Channel[i64].make(6)
  let out = sync::Channel[i64].make(3)

  let p = spawn producer(ch, [10, 20, 30, 40, 50, 60])
  let c1 = spawn consumer(ch, 2, out)
  let c2 = spawn consumer(ch, 2, out)
  let c3 = spawn consumer(ch, 2, out)

  await p
  await c1
  await c2
  await c3

  let t1 = await out.recv()
  let t2 = await out.recv()
  let t3 = await out.recv()

  assert::equals(t1 + t2 + t3, 210)

test "fan-in: multiple producers, one consumer" =
  let ch  = sync::Channel[i64].make(9)
  let out = sync::Channel[i64].make(1)

  let p1 = spawn producer(ch, [1, 2, 3])
  let p2 = spawn producer(ch, [4, 5, 6])
  let p3 = spawn producer(ch, [7, 8, 9])

  await p1
  await p2
  await p3

  let c = spawn consumer(ch, 9, out)

  await c

  let total = await out.recv()

  assert::equals(total, 45)

test "pipeline: two stages transform data" =
  let stage1_in  = sync::Channel[i64].make(5)
  let stage1_out = sync::Channel[i64].make(5)
  let results    = sync::Channel[i64].make(5)

  // stage 1: double each value
  // stage 2: add 1 to each value
  let s1 = spawn pipeline_stage(stage1_in, stage1_out, fn(x i64) i64 = return x * 2, 5)
  let s2 = spawn pipeline_stage(stage1_out, results, fn(x i64) i64 = return x + 1, 5)
  let p  = spawn producer(stage1_in, [1, 2, 3, 4, 5])

  await p
  await s1
  await s2

  let total i64 = 0
  let i i64 = 0

  for i < 5:
    total = total + await results.recv()
    i = i + 1

  // (1*2+1)+(2*2+1)+(3*2+1)+(4*2+1)+(5*2+1) = 3+5+7+9+11 = 35
  assert::equals(total, 35)

test "divide and conquer sum via fibers" =
  // Split [1..8] into two halves, sum each in a fiber, combine
  let out = sync::Channel[i64].make(2)

  let f1 = spawn sum_range_async(1, 5, out)   // 1+2+3+4 = 10
  let f2 = spawn sum_range_async(5, 9, out)   // 5+6+7+8 = 26

  await f1
  await f2

  let a = await out.recv()
  let b = await out.recv()

  assert::equals(a + b, 36)

test "chained await-recv in expression" =
  let ch = sync::Channel[i64].make(3)
  let p = spawn producer(ch, [100, 200, 300])

  await p
  let total = (await ch.recv()) + (await ch.recv()) + (await ch.recv())

  assert::equals(total, 600)

test "many small fibers writing to channel" =
  let ch = sync::Channel[i64].make(20)
  let i i64 = 0

  for i < 20:
    let n = i + 1

    spawn do:
      await ch.send(n)
    i = i + 1

  let sum i64 = 0
  let j i64 = 0

  for j < 20:
    sum = sum + await ch.recv()
    j = j + 1

  // sum of 1..20 = 210
  assert::equals(sum, 210)

test "channel close and drain" =
  let ch = sync::Channel[i64].make(5)
  let p = spawn do:
    let k i64 = 0

    for k < 5:
      await ch.send(k * 10)
      k = k + 1

    ch.close()

  await p

  let total i64 = 0
  let running bool = true

  for running:
    if ch.is_closed_empty():
      running = false
    else:
      total = total + await ch.recv()

  // 0+10+20+30+40 = 100
  assert::equals(total, 100)
