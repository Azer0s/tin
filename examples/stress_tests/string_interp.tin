// stress_tests/string_interp.tin
//
// Tests: string interpolation with complex, deeply nested expressions
//   - Interpolation of function call results
//   - Interpolation of arithmetic expressions
//   - Interpolation of struct fields (chained field access)
//   - Interpolation of closures called inline
//   - Interpolation of array element access
//   - Interpolation of ternary-style conditional expressions
//   - Multiple interpolations in one string
//   - Interpolated string inside another interpolated string (nesting)
//   - Interpolation of boolean expressions
//   - Interpolation with string concatenation (++)
//
// Compiler paths exercised:
//   - Expression evaluation inside string template lowering
//   - Correct scoping and SSA for temporaries inside interpolation
//   - Multiple consecutive interpolation slots in a single string constant

use assert

struct point3d =
  x f64
  y f64
  z f64

  fn magnitude(this point3d) f64 =
    // simplified: just sum of squares, not sqrt
    return this.x * this.x + this.y * this.y + this.z * this.z

fn sign_str(n i64) string =
  if n > 0:
    return "positive"
  if n < 0:
    return "negative"

  return "zero"

fn repeat_str(s string, n i64) string =
  let out string = ""
  let i i64 = 0

  for i < n:
    out = out ++ s
    i = i + 1

  return out

// Tests

test "interpolate function call result" =
  let n i64 = 5
  let s = "sign of {n} is {sign_str(n)}"

  assert::equals(s, "sign of 5 is positive")

test "interpolate arithmetic expression" =
  let a i64 = 3
  let b i64 = 4
  let s = "hypotenuse squared: {a * a + b * b}"

  assert::equals(s, "hypotenuse squared: 25")

test "interpolate struct field chain" =
  let p = point3d{x: 1.0, y: 2.0, z: 3.0}
  let s = "x={p.x} y={p.y} z={p.z}"

  assert::equals(s, "x=1.000000 y=2.000000 z=3.000000")

test "interpolate method call on struct" =
  let p = point3d{x: 3.0, y: 4.0, z: 0.0}
  let s = "magnitude squared: {p.magnitude()}"

  assert::equals(s, "magnitude squared: 25.000000")

test "interpolate closure called inline" =
  let square = fn(n i64) i64 = return n * n
  let n i64 = 7
  let s = "{n} squared is {square(n)}"

  assert::equals(s, "7 squared is 49")

test "interpolate array element" =
  let labels [string] = ["alpha", "beta", "gamma"]
  let s = "first={labels[0]} last={labels[2]}"

  assert::equals(s, "first=alpha last=gamma")

test "multiple interpolations in one string" =
  let a i64 = 10
  let b i64 = 3
  let s = "{a} + {b} = {a + b}, {a} * {b} = {a * b}, {a} % {b} = {a % b}"

  assert::equals(s, "10 + 3 = 13, 10 * 3 = 30, 10 % 3 = 1")

test "interpolated string inside interpolation" =
  let inner string = "world"
  let outer = "hello {inner}!"
  let wrapped = "message: {outer}"

  assert::equals(wrapped, "message: hello world!")

test "interpolation with boolean" =
  let x bool = true
  let s = "flag={x}"

  assert::equals(s, "flag=true")

test "interpolation with string concatenation" =
  let prefix = "pre"
  let suffix = "fix"
  let s = "word={prefix ++ suffix}"

  assert::equals(s, "word=prefix")

test "interpolation of negative arithmetic" =
  let n i64 = 5
  let s = "negated: {0 - n}"

  assert::equals(s, "negated: -5")

test "interpolation with repeat_str call" =
  let s = "bar={repeat_str("x", 4)}"

  assert::equals(s, "bar=xxxx")

test "interpolation with chained function calls" =
  let arr [i64] = [1, 2, 3, 4, 5]
  let s = "len={len(arr)} first={arr[0]} last={arr[len(arr) - 1]}"

  assert::equals(s, "len=5 first=1 last=5")

test "consecutive empty and non-empty slots" =
  let a string = ""
  let b string = "B"
  let s = "start:{a}mid:{b}end"

  assert::equals(s, "start:mid:Bend")

test "deep chain of struct field access in interpolation" =
  struct inner_s =
    v i64
  struct outer_s =
    child inner_s
  let o = outer_s{child: inner_s{v: 42}}
  let s = "deep={o.child.v}"

  assert::equals(s, "deep=42")
