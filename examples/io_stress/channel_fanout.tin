// examples/io_stress/channel_fanout.tin
//
// I/O stress: fan-out channel pattern.
// N consumer fibers each receive one message from a shared buffered channel.
// Tests string ARC across concurrent channel boundaries under fan-out load.
//
// Compiler paths exercised:
//   - Channel send/recv with string values (ARC through channel boundary)
//   - Concurrent fiber scheduling under high spawn count
//   - String interpolation in concurrent context

use assert
use sync

test "channel fanout 50 consumers" =
  let n i64 = 50
  let ch   = sync::Channel[string].make(n)
  let done = sync::Channel[i64].make(n)
  let i i64 = 0
  for i < n:
    let id = i
    spawn do:
      let msg = await ch.recv()
      let _ = "consumer-{id}: got [{msg}]"
      await done.send(id)
    i = i + 1
  let j i64 = 0
  for j < n:
    await ch.send("item-{j}")
    j = j + 1
  let received i64 = 0
  for received < n:
    await done.recv()
    received = received + 1
  assert::equals(received, n)

test "channel fanout 200 consumers" =
  let n i64 = 200
  let ch   = sync::Channel[string].make(n)
  let done = sync::Channel[i64].make(n)
  let i i64 = 0
  for i < n:
    let id = i
    spawn do:
      let msg = await ch.recv()
      let _ = "consumer-{id}: got [{msg}]"
      await done.send(id)
    i = i + 1
  let j i64 = 0
  for j < n:
    await ch.send("payload-{j}-data")
    j = j + 1
  let received i64 = 0
  for received < n:
    await done.recv()
    received = received + 1
  assert::equals(received, n)
