// examples/io_stress/string_pipeline.tin
//
// I/O stress: 3-stage pipeline carrying strings through channels.
// Stage 1 (generator) produces raw strings; stage 2 (transformer) enriches
// them and forwards; stage 3 (sink) receives and counts. Tests string ARC
// through multiple channel hops and concurrent stage execution.
//
// Compiler paths exercised:
//   - Multi-hop string ownership transfer across channel boundaries
//   - Concurrent fiber pipeline with backpressure-free buffered channels
//   - String interpolation in each stage (new string allocated per hop)

use assert
use sync

test "3-stage string pipeline 100 items" =
  let n i64 = 100
  let raw    = sync::Channel[string].make(n)
  let cooked = sync::Channel[string].make(n)
  let fin    = sync::Channel[i64].make(3)
  spawn do:
    let i i64 = 0
    for i < n:
      await raw.send("raw-{i}")
      i = i + 1
    await fin.send(0)
  spawn do:
    let i i64 = 0
    for i < n:
      let s = await raw.recv()
      await cooked.send("xformed[{i}]={s}+tag")
      i = i + 1
    await fin.send(1)
  spawn do:
    let count i64 = 0
    for count < n:
      let _ = await cooked.recv()
      count = count + 1
    await fin.send(count)
  let i i64 = 0
  let total i64 = 0
  for i < 3:
    total = total + await fin.recv()
    i = i + 1
  // fin receives: 0 (gen) + 1 (xform) + n (sink count) = n + 1
  assert::equals(total, n + 1)

test "3-stage string pipeline 500 items" =
  let n i64 = 500
  let raw    = sync::Channel[string].make(n)
  let cooked = sync::Channel[string].make(n)
  let fin    = sync::Channel[i64].make(3)
  spawn do:
    let i i64 = 0
    for i < n:
      await raw.send("raw-{i}")
      i = i + 1
    await fin.send(0)
  spawn do:
    let i i64 = 0
    for i < n:
      let s = await raw.recv()
      await cooked.send("xformed[{i}]={s}+tag")
      i = i + 1
    await fin.send(1)
  spawn do:
    let count i64 = 0
    for count < n:
      let _ = await cooked.recv()
      count = count + 1
    await fin.send(count)
  let i i64 = 0
  let total i64 = 0
  for i < 3:
    total = total + await fin.recv()
    i = i + 1
  assert::equals(total, n + 1)
