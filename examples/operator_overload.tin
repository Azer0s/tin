use assert

struct Vec3(add[Vec3, Vec3], sub[Vec3, Vec3], neg[Vec3], comp[Vec3]) =
  x f64
  y f64
  z f64

  fn ::add(this Vec3, other Vec3) Vec3 =
    return Vec3{x: this.x + other.x, y: this.y + other.y, z: this.z + other.z}

  fn ::sub(this Vec3, other Vec3) Vec3 =
    return Vec3{x: this.x - other.x, y: this.y - other.y, z: this.z - other.z}

  fn ::neg(this Vec3) Vec3 =
    return Vec3{x: -this.x, y: -this.y, z: -this.z}

  fn ::comp(this Vec3, other Vec3) bool =
    return this.x == other.x && this.y == other.y && this.z == other.z

test "binary +" =
  let a = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let b = Vec3{x: 4.0, y: 5.0, z: 6.0}
  let c = a + b
  assert::equals(5.0, c.x)
  assert::equals(7.0, c.y)
  assert::equals(9.0, c.z)

test "binary -" =
  let a = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let b = Vec3{x: 4.0, y: 5.0, z: 6.0}
  let d = b - a
  assert::equals(3.0, d.x)
  assert::equals(3.0, d.y)
  assert::equals(3.0, d.z)

test "unary -" =
  let a = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let e = -a
  assert::equals(-1.0, e.x)
  assert::equals(-2.0, e.y)
  assert::equals(-3.0, e.z)

test "comparison" =
  let a = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let a_clone = Vec3{x: 1.0, y: 2.0, z: 3.0}
  let b = Vec3{x: 4.0, y: 5.0, z: 6.0}
  assert::equals(true, a == a_clone)
  assert::equals(true, a != b)
