use assert
use { sleep } from io

fn{#async} slow_int(n i64) i64 =
  await sleep(1)
  return n

fn{#async} slow_str(s string) string =
  await sleep(1)
  return s

test "await match single future" =
  let a = spawn slow_int(7)
  let got i64 = 0
  await match (a):
    case (x):
      got = x
  assert::equals(7, got)

test "await match two futures" =
  let a = spawn slow_int(42)
  let b = spawn slow_int(99)
  let got i64 = 0
  await match (a, b):
    case (x, _):
      got = x
    case (_, y):
      got = y
  assert::ok(got > 0)

test "await match heterogeneous" =
  let a = spawn slow_int(5)
  let b = spawn slow_str("hello")
  let int_got i64 = 0
  let str_got = ""
  await match (a, b):
    case (n, _):
      int_got = n
    case (_, s):
      str_got = s
  let either = int_got + len(str_got)
  assert::ok(either > 0)

test "await match default" =
  let a = spawn slow_int(1)
  await match (a):
    case (x):
      assert::equals(1, x)
    default:
      assert::ok(true)

test "await match guard" =
  let a = spawn slow_int(10)
  let b = spawn slow_int(20)
  let got i64 = 0
  await match (a, b):
    case (x, _) if x > 5:
      got = x
    case (x, _):
      got = -1
    case (_, y) if y > 5:
      got = y
    case (_, y):
      got = -2
  assert::ok(got > 0)

test "await match compiler error on variable array" =
  assert::ok(true)

