// examples/udp_echo_server - UDP datagram echo server.
//
// Listens on UDP port 8082 and echoes every received datagram back
// to the sender.
//
// Usage:
//   ./tin build examples/udp_echo_server/udp_echo_server.tin -lm -o /tmp/udp_echo_server
//   /tmp/udp_echo_server &
//   echo "hello" | nc -u 127.0.0.1 8082
//   kill %1

use { loop, async } from macros
use net::udp
use ioutil
use errors
use result

async handle_conn(c udp::Conn) =
  let line = await ioutil::read_string(c)

  await ioutil::write_string(c, line)
  c.close()

fn{#async} main() =
  match udp::listen(8082):
    case Err(e): panic(e.message())
    case Ok(srv):
      echo "udp echo listening on :8082"

      loop:
        let r = await srv.accept()

        match r:
          case Ok(c):  spawn handle_conn(c)
          case Err(e): echo "udp: accept dropped: {e.message()}"
