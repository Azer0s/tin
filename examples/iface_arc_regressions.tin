// examples/iface_arc_regressions.tin -- regression tests for ARC bugs
// found while migrating errors::new to the value-form Err iface.  Each
// test exercises a specific code path; run under `tin test --leaks` to
// catch over-retains / under-releases by zero-leak budget.
//
// The bugs ranged from compile-time codegen errors (extra retains in
// ADT-variant construction) to runtime corruption (releasing
// match-bound iface bindings the scrutinee still owned).

use assert
use { Result } from result
use errors
use strings
use sync

// 1. Match-bound iface from a borrow scrutinee.
//
// `match r: case Err(e): use e` where `r` is a let-binding (borrow
// scrutinee) must NOT retain `e` -- and consequently the binding's
// scope-exit release must skip too.  Without the matched gate, the
// release decremented an rc the binding never bumped, freed the iface
// block while the scrutinee still referenced it, and the next allocator
// reuse tripped on a dangling pointer (SIGBUS on the macOS allocator).

fn read_msg(r Result[i64, errors::Err]) string =
  match r:
    case Ok(_):  return "ok"
    case Err(e): return e.message()

test "match Err(e) on borrow scrutinee does not over-release iface" =
  let r Result[i64, errors::Err] = Err(errors::new("boom"))
  let m = read_msg(r)

  assert::equals("boom", m)

// 2. try.ok extracts a string success: ok_value's entry retain + match
// binding retain on the success string pair up with one data_release_val,
// netting +1 -- the try lowering's tempStorage release balances it so
// the let-binding holding the extracted string still owns rc=1.

fn label_or_propagate(r Result[i64, errors::Err]) Result[string, errors::Err] =
  let s = try r.map(fn(x i64) string = return "label-{x}")

  return Ok(s ++ "!")

test "try-ok on Result[string,_] does not leak the extracted success" =
  let r Result[i64, errors::Err] = Ok(5)

  match label_or_propagate(r):
    case Ok(v):  assert::equals("label-5!", v)
    case Err(_): assert::ok(false)

// 3. try.err propagates without leaking the iface payload.  Symmetric
// to (2) -- err_value's `return this` skips its scope release while
// the entry retain bumped the iface's data rc; the try lowering's
// tempStorage release on the err path closes the +1.

test "try-err propagates the original Err without leaking iface block" =
  let r Result[i64, errors::Err] = Err(errors::new("upstream"))

  match label_or_propagate(r):
    case Ok(_):  assert::ok(false)
    case Err(e): assert::equals("upstream", e.message())

// 4. Value-form iface release walks the inner concrete struct's RC
// fields.  Pre-fix, `errors::wrap(inner, ctx)` returned a value Err
// whose data ptr backed a StringErr with a heap-allocated msg --
// raw `_tin_release` on the iface data ptr decremented the block's
// rc but never released msg.  The dispatch must go through the
// vtable's data-release thunk so StringErr__release_ptr cascades.

test "value-form errors::wrap drops the inner heap msg on release" =
  let inner = errors::new("disk full")
  let outer = errors::wrap(inner, "saving config")

  assert::equals("saving config: disk full", outer.message())

// 5. Constructing `Err(NullaryVariant)` widens the variant into an
// errors::Err iface via coerceToTrait -- a fresh rc=1 backing block.
// wrapDataVariant used to treat the coerced iface as a borrowed
// Identifier and retain it again (rc=2 with only one matching
// release at consumer drop, leaking the variant block).

data DemoErr(errors::Err, print) =
  EmptyKind
  WithMsg(text string)

  fn errors::Err::message(this DemoErr) string =
    match this:
      case EmptyKind:      return "demo: empty"
      case WithMsg(t):     return "demo: {t}"

  fn ::print(this DemoErr) string = return this.message()

fn fail_empty() Result[i64, errors::Err] =
  return Err(EmptyKind)

test "Err(nullary variant) widening does not leak the iface backing" =
  match fail_empty():
    case Ok(_):  assert::ok(false)
    case Err(e): assert::equals("demo: empty", e.message())

// 6. Explicit `X as errors::Err` cast as Err's argument exercises the
// same retain-on-coerced-iface bug but through AsExpr's coerceToTrait
// path -- the value arriving at wrapDataVariant has already been
// widened (preCoerceType == expected) so the fresh-iface check needs
// the AST-shape exemption in addition to the type-change exemption.

fn fail_with_msg(s string) Result[i64, errors::Err] =
  return Err(WithMsg(s) as errors::Err)

test "Err(X as errors::Err) does not leak the iface backing" =
  match fail_with_msg("io"):
    case Ok(_):  assert::ok(false)
    case Err(e): assert::equals("demo: io", e.message())

// 7. parse_int's Err(StringsError variant) flows through map_err's
// lambda producing an AppError struct with a heap text field, then
// through try.err propagation.  Combines (1), (3), (4), and (5):
// match-bound iface borrow + value-form release with heap field +
// try.err temp release + Err(coerced) construction.  This is the
// real-world shape that revealed the chain of bugs.

struct AppError =
  code i64
  text string

fn parse_int_doubled(s string) Result[i64, AppError] =
  let v = try strings::parse_int(s).map_err(fn(e errors::Err) AppError =
    return AppError{code: 1, text: e.message()})

  return Ok(v * 2)

test "try+map_err over heap-fielded error round-trip is leak-clean" =
  match parse_int_doubled("not-a-number"):
    case Ok(_):  assert::ok(false)
    case Err(e): assert::equals(1, e.code)

  match parse_int_doubled("21"):
    case Ok(v):  assert::equals(42, v)
    case Err(_): assert::ok(false)

// 8. Local `[errors::Err; N]` array of iface values must walk each slot
// at scope exit.  Pre-fix the scope-release short-circuited on ArrayType
// and leaked one heap block per slot (4 × 64 bytes on the original
// repro).  emitFixedArrayRelease + elemNeedsRelease recursion close it.

test "fixed-size array of value-form Err scope-releases each slot" =
  let xs [errors::Err; 4] = [
    errors::new("one"),
    errors::new("two"),
    errors::new("three"),
    errors::new("four"),
  ]
  let i i64 = 0
  for i < len(xs):
    assert::ok(len(xs[i].message()) > 0)
    i = i + 1

// 9. Same array embedded as a struct field: walkRCStructFieldsEx now
// dispatches to emitFixedArrayRelease for `[T; N]` field types, and
// elemNeedsRelease reports true for any struct whose fields recurse
// through an array of releasable elements.

struct ErrHolder =
  xs [errors::Err; 3]

test "struct field [errors::Err; N] cascades release through walker" =
  let h = ErrHolder{xs: [
    errors::new("a"),
    errors::new("b"),
    errors::new("c"),
  ]}
  assert::equals("a", h.xs[0].message())
  assert::equals("b", h.xs[1].message())
  assert::equals("c", h.xs[2].message())

// 10. Pass-through wrapper that returns a freshly-coerced iface value
// from a callee.  Pre-fix the unconditional trait fat-ptr retain in
// genReturn over-bumped rc by 1 (no `.iface_data_*` scope entry exists
// in the wrapper to balance it), leaking on every call.  The
// hasLiveIfaceDataScopeEntry gate fixes it.

fn rewrap(msg string) errors::Err = return errors::new(msg)

test "wrapper that returns callee's iface does not over-retain" =
  let _ = rewrap("just propagate")

// 11. `*(rawvoid as *T)` move out of an opaque scratch buffer (the
// channel.recv pattern).  Pre-fix the isCopyExpr-driven retain in
// genReturn fired even though no scope cleanup decrements the *void
// binding, leaking every received value.  isDerefOfRawVoidPtrCast
// recognises the shape and skips the retain.
//
// Exercises both `recv` (single value) and a recv loop, including the
// case where the channel buffer is drained completely so subsequent
// `_tin_channel_free` finds no slots to release.

test "channel recv of value-form Err is leak-clean" =
  let ch = sync::Channel[errors::Err].make(4)
  await ch.send(errors::new("one"))
  await ch.send(errors::new("two"))
  let e1 = await ch.recv()
  let e2 = await ch.recv()

  assert::equals("one", e1.message())
  assert::equals("two", e2.message())

// 12. Function as a non-capturing struct field, invoked via the
// `(a.f)(...)` form so the field-access doubles as the receiver.  Field
// retain/release on fat-fn-ptr struct fields go through
// walkRCStructFields whose copy semantics must stay balanced.

fn _arc_add_one(x i64) i64 = return x + 1

struct IntOp =
  f fn(i64) i64

test "non-capturing fn struct field, direct invoke" =
  let a = IntOp{f: _arc_add_one}

  assert::equals(42, (a.f)(41))

// 13. Capturing closure (i64 capture) stored in a struct field.  The
// closure env is a fat-fn-ptr {fn*, env*}; the env block is rc-tracked
// and walked by emitStructFieldRetain.  Verifies multiple call sites
// don't double-release the env.

fn _arc_make_adder(base i64) IntOp =
  return IntOp{f: fn(x i64) i64 = return x + base}

test "i64-capturing closure in struct field, multiple invocations" =
  let a = _arc_make_adder(100)

  assert::equals(105, (a.f)(5))
  assert::equals(110, (a.f)(10))

// 14. Capturing closure with a string capture.  The env now owns a
// string heap block whose RC must survive every invocation but free
// exactly once when the holding struct drops.

struct StrOp =
  f fn(string) string

fn _arc_make_greeter(prefix string) StrOp =
  return StrOp{f: fn(name string) string = return prefix ++ ": " ++ name}

test "string-capturing closure in struct field" =
  let g = _arc_make_greeter("hello")

  assert::equals("hello: world", (g.f)("world"))
  assert::equals("hello: again",  (g.f)("again"))

// 15. Channel transporting non-capturing function values.  The
// channel's rc_kind is TIN_RC_FN so rc_retain/release_slot dispatch
// through _tin_release_closure on the env (null for named fns, but the
// path still has to be balanced).  Inline `fn(...)` in the type-arg
// position also exercises the parser's TypeRefNode lift.

fn _arc_neg(x i64) i64 = return 0 - x

test "channel of non-capturing fn values is leak-clean" =
  let ch = sync::Channel[fn(i64) i64].make(4)
  await ch.send(_arc_add_one)
  await ch.send(_arc_neg)
  let f1 = await ch.recv()
  let f2 = await ch.recv()

  assert::equals(11, f1(10))
  assert::equals(-10, f2(10))

// 16. Channel transporting capturing closures.  Each send retains the
// env; each recv transfers the slot's rc into the scratch buffer; the
// receiver's let-binding owns rc=1 and releases on scope exit.

fn _arc_make_mul(by i64) fn(i64) i64 =
  return fn(x i64) i64 = return x * by

test "channel of capturing closures is leak-clean" =
  let ch = sync::Channel[fn(i64) i64].make(4)
  await ch.send(_arc_make_mul(3))
  await ch.send(_arc_make_mul(7))
  let g1 = await ch.recv()
  let g2 = await ch.recv()

  assert::equals(30, g1(10))
  assert::equals(70, g2(10))

// 17. Inline `fn{#async}(args) ret` in the type-arg position.  The
// canonical-key encoding has to distinguish async from sync (so that
// Channel[fn(i64)i64] and Channel[fn{#async}(i64)i64] don't collide),
// and the parser's TypeRefNode has to lift the async marker through.

fn{#async} _arc_add_async(x i64) i64 = return x + 1

test "channel of fn{#async} non-capturing is leak-clean" =
  let ch = sync::Channel[fn{#async}(i64) i64].make(4)
  await ch.send(_arc_add_async)
  let f fn{#async}(i64) i64 = await ch.recv()
  let r = await spawn f(41)

  assert::equals(42, r)
