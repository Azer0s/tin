// Dynamic dispatch via constrained generic functions.
//
// Generic functions are monomorphized at each call site for the concrete type,
// with the constraint checked at compile time. The method call inside the
// function body dispatches statically to the concrete implementation.
use assert

trait speaker =
  fn speak(this speaker) string = virtual

trait strider =
  fn stride(this strider) string = virtual

struct dog(speaker, strider) =
  name string

  fn speaker::speak(this dog) string =
    return "Woof! I am {this.name}"

  fn strider::stride(this dog) string =
    return "{this.name} runs"

struct cat(speaker, strider) =
  name string

  fn speaker::speak(this cat) string =
    return "Meow! I am {this.name}"

  fn strider::stride(this cat) string =
    return "{this.name} slinks"

struct robot(speaker) =
  id string

  fn speaker::speak(this robot) string =
    return "Beep boop, I am {this.id}"

// Generic functions constrained by traits - monomorphized at each call site.
fn make_speak[t](s t) where t is speaker =
  echo s.speak()

fn make_stride[t](m t) where t is strider =
  echo m.stride()

let d = dog{name: "Rex"}
let c = cat{name: "Whiskers"}
let r = robot{id: "R2D2"}

make_speak(d)
make_speak(c)
make_speak(r)

make_stride(d)
make_stride(c)

test "speak methods" =
  let d = dog{name: "Rex"}
  let c = cat{name: "Whiskers"}
  let r = robot{id: "R2D2"}

  assert::equals(d.speak(), "Woof! I am Rex")
  assert::equals(c.speak(), "Meow! I am Whiskers")
  assert::equals(r.speak(), "Beep boop, I am R2D2")

test "stride methods" =
  let d = dog{name: "Rex"}
  let c = cat{name: "Whiskers"}

  assert::equals(d.stride(), "Rex runs")
  assert::equals(c.stride(), "Whiskers slinks")
