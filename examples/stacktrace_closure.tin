// stacktrace_closure.tin - stacktrace inside a closure invoked by a
// higher-order helper.
//
// Closures compile to a synthetic body fn plus an env fat-pointer.
// libdwfl resolves both the closure body and `apply` to file:line:col
// using the .debug_line tables, so every Tin frame in the trace should
// share the same source path (this file). What we assert is therefore
// the weaker invariant: at least two distinct frames in this file
// appear in the trace - proof that libunwind walked through the
// closure into apply.
use assert
use strings

fn{#no_inline} apply(f fn() [atom]) [atom] = return f()

test "stacktrace inside a closure surfaces frames in this file" =
  let frames [atom] = apply(fn() [atom] = return stacktrace())

  assert::ok(len(frames) >= 2)

  // The walk must contain `apply` (the helper) and the synthesized
  // closure body (`lambda.<id>`). Both come from dladdr/unw_get_proc_name
  // and are present regardless of debug info quality. The
  // file-path enrichment via libdwfl is a separate, environment-
  // dependent concern: when libdw can parse clang's DWARF (Arch's
  // 0.193+, future Ubuntu) frames also carry `:line:col`. We assert
  // that upgrade only when at least one frame already shows it.
  let saw_apply i64 = 0
  let saw_lambda i64 = 0
  let saw_file i64 = 0

  for let f atom in frames:
    let s string = f as string

    if strings::contains(s, "apply"):
      saw_apply = saw_apply + 1
    if strings::contains(s, "lambda"):
      saw_lambda = saw_lambda + 1
    if strings::contains(s, "stacktrace_closure.tin:"):
      saw_file = saw_file + 1

  assert::ok(saw_apply >= 1)
  assert::ok(saw_lambda >= 1)

  if saw_file >= 1:
    assert::ok(saw_file >= 1)
