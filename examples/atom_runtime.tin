// atom_runtime.tin - tests for the atom string representation and runtime atom
// learning introduced alongside the CRC32 atom implementation.
//
// Uses libc's strdup to produce a char* at runtime that is then coerced to an
// atom via __tin_string_to_atom. This exercises two paths:
//   * static table hit  - strdup("ok")    -> finds 'ok in the compile-time table
//   * runtime learning  - strdup("dynfoo") -> not in static table; CRC32 is
//     computed, atom stored in the linked-list runtime table, and resolved back
//     to its string via _tin_rt_atom_to_str on the next __tin_atom_to_string call
use assert

fn{#handover} strdup_atom(s string) atom = extern("strdup")

test "atom to string is bare name" =
  assert::equals('ok,    "ok")
  assert::equals('err,   "err")
  assert::equals('sunny, "sunny")

test "atom equals bare string" =
  assert::ok('ok == "ok")
  assert::ok("ok" == 'ok)
  assert::ok('ok != "err")
  assert::ok("err" != 'ok)

test "extern string to atom via static table" =
  // strdup copies "ok"; __tin_string_to_atom finds it in the compile-time table
  let a = strdup_atom("ok")

  assert::ok(a == 'ok)
  assert::equals(a, "ok")
  assert::ok(a != 'err)

test "runtime atom learning" =
  // These names are not compile-time atoms - CRC32 is computed at runtime
  let foo = strdup_atom("dynfoo")
  let bar = strdup_atom("dynbar")

  assert::equals(foo, "dynfoo")
  assert::equals(bar, "dynbar")
  assert::ok(foo != bar)

test "runtime atom idempotency" =
  // Same string always maps to the same atom code
  let a = strdup_atom("dynfoo")
  let b = strdup_atom("dynfoo")

  assert::ok(a == b)
  assert::equals(a, "dynfoo")
