// geommain.tin - uses the geomlib package (structs + functions)
// Run: tin run geommain.tin  (geomlib.tin is found locally in the same directory)

use geomlib

let a = geomlib::make_point(3, 4)
let b = geomlib::make_point(6, 8)

echo a.show()                        // (3, 4)
echo b.show()                        // (6, 8)

let d = a.distance_sq(b)
echo d                               // 25

let m = geomlib::midpoint(a, b)
echo m.show()                        // (4, 6)
