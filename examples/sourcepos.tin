// sourcepos.tin - tests for the compile-time sourcepos() builtin.
// sourcepos(x) returns an atom of the form "<name>@<file>:<line>:<col>"
// for identifier args (the name is the bare identifier as written) or
// "<file>:<line>:<col>" for arbitrary expression args (no stable name
// to attach). Mirrors the runtime stacktrace() format.
use assert

fn helper(x i64) i64 = return x * 2
var counter i64 = 0

fn locate_helper() atom = return sourcepos(helper)
fn locate_counter() atom = return sourcepos(counter)
fn locate_arg(my_param i64) atom = return sourcepos(my_param)
fn locate_local() atom =
  let my_local i64 = 42
  return sourcepos(my_local)
fn locate_expr() atom = return sourcepos(1 + 2 * 3)

test "sourcepos(fn) resolves the function declaration line" =
  assert::equals(locate_helper(), '"helper@examples/sourcepos.tin:8:1")

test "sourcepos(top-level var) resolves the var declaration line" =
  assert::equals(locate_counter(), '"counter@examples/sourcepos.tin:9:1")

test "sourcepos(param) resolves the function header" =
  assert::equals(locate_arg(7), '"my_param@examples/sourcepos.tin:13:1")

test "sourcepos(local let) resolves the let declaration line" =
  assert::equals(locate_local(), '"my_local@examples/sourcepos.tin:15:3")

test "sourcepos(expression) resolves the expression site" =
  // Non-identifier args fall back to the containing-fn name as the
  // symbol prefix, matching the runtime stacktrace format. The BinExpr
  // position falls back to the sourcepos call site when the parser
  // doesn't tag the arithmetic node directly.
  assert::equals(locate_expr(), '"locate_expr@examples/sourcepos.tin:17:32")

test "sourcepos atoms are first-class equal" =
  let a atom = sourcepos(helper)
  let b atom = sourcepos(helper)
  assert::equals(a, b)

// Local binding shadowing a top-level fn must resolve to the LOCAL
// declaration, not the outer fn — same rule as ordinary identifier
// resolution. Without this, `sourcepos(name)` inside a region that
// rebinds `name` would lie about which definition the call site sees.
fn shadow_check() atom =
  let helper i64 = 99
  return sourcepos(helper)

test "sourcepos respects lexical shadow over outer fn" =
  // The let helper is on line 48; the outer fn helper is on line 8.
  // Lexical shadow says the let wins.
  assert::equals(shadow_check(), '"helper@examples/sourcepos.tin:48:3")

// for-in binds an iteration variable; sourcepos should report the for
// header position, not the use site inside the loop body.
fn locate_for_iter() atom =
  let xs [i64] = [10, 20, 30]
  let result atom = '""
  for let x i64 in xs:
    let p atom = sourcepos(x)
    return p
  return result

test "sourcepos(for-in iter var) resolves the for-loop line" =
  // for-in header is on line 61, with `for` at column 3.
  assert::equals(locate_for_iter(), '"x@examples/sourcepos.tin:61:3")
