use assert
use collections

// --- LinkedList[T] ---

test "list push_back and get i64" =
  let l = collections::LinkedList[i64].make()

  l.push_back(1)
  l.push_back(2)
  l.push_back(3)
  assert::equals(l.len(), 3)
  assert::equals(l.get(0), 1)
  assert::equals(l.get(1), 2)
  assert::equals(l.get(2), 3)

test "list push_back and get string" =
  let l = collections::LinkedList[string].make()

  l.push_back("hello")
  l.push_back("world")
  assert::equals(l.len(), 2)
  assert::equals(l.get(0), "hello")
  assert::equals(l.get(1), "world")

test "list push_front" =
  let l = collections::LinkedList[i64].make()

  l.push_front(3)
  l.push_front(2)
  l.push_front(1)
  assert::equals(l.get(0), 1)
  assert::equals(l.get(1), 2)
  assert::equals(l.get(2), 3)

test "list pop_front" =
  let l = collections::LinkedList[i64].make()

  l.push_back(10)
  l.push_back(20)
  assert::equals(l.pop_front(), 10)
  assert::equals(l.len(), 1)
  assert::equals(l.pop_front(), 20)
  assert::equals(l.len(), 0)

test "list pop_back" =
  let l = collections::LinkedList[i64].make()

  l.push_back(10)
  l.push_back(20)
  l.push_back(30)
  assert::equals(l.pop_back(), 30)
  assert::equals(l.len(), 2)
  assert::equals(l.pop_back(), 20)
  assert::equals(l.len(), 1)

test "list single element pop_back" =
  let l = collections::LinkedList[i64].make()

  l.push_back(42)
  assert::equals(l.pop_back(), 42)
  assert::equals(l.len(), 0)

test "list push and pop string values" =
  let l = collections::LinkedList[string].make()

  l.push_back("a")
  l.push_back("b")
  l.push_back("c")
  assert::equals(l.pop_front(), "a")
  assert::equals(l.pop_back(), "c")
  assert::equals(l.len(), 1)
  assert::equals(l.get(0), "b")

// --- HashMap[K,V] ---

test "hashmap string keys basic" =
  let m = collections::HashMap[string, i64].make(4)

  m.set("a", 1)
  m.set("b", 2)
  m.set("c", 3)
  assert::equals(m.len(), 3)
  assert::equals(m.get("a"), 1)
  assert::equals(m.get("b"), 2)
  assert::equals(m.get("c"), 3)
  assert::equals(m.get("missing"), 0)

test "hashmap has and delete" =
  let m = collections::HashMap[string, i64].make(4)

  m.set("key", 42)
  assert::ok(m.has("key"))
  assert::not_ok(m.has("missing"))
  m.delete("key")
  assert::not_ok(m.has("key"))

test "hashmap get_or" =
  let m = collections::HashMap[string, string].make(4)

  m.set("exists", "value")
  assert::equals(m.get_or("exists", "default"), "value")
  assert::equals(m.get_or("missing", "default"), "default")

test "hashmap overwrite key" =
  let m = collections::HashMap[string, i64].make(4)

  m.set("k", 1)
  m.set("k", 2)
  assert::equals(m.get("k"), 2)
  assert::equals(m.len(), 1)

test "hashmap integer keys" =
  let m = collections::HashMap[i64, string].make(8)

  m.set(1, "one")
  m.set(2, "two")
  m.set(100, "hundred")
  assert::equals(m.get(1), "one")
  assert::equals(m.get(2), "two")
  assert::equals(m.get(100), "hundred")
  assert::equals(m.get(999), "")

test "hashmap resize under load" =
  let m = collections::HashMap[string, i64].make(2)
  let i i64 = 0

  for i < 50:
    m.set("{i}", i)
    i = i + 1

  assert::equals(m.len(), 50)
  assert::equals(m.get("0"), 0)
  assert::equals(m.get("49"), 49)

test "hashmap keys returns all keys" =
  let m = collections::HashMap[string, i64].make(4)

  m.set("x", 1)
  m.set("y", 2)
  let ks = m.keys()

  assert::equals(len(ks), 2)

test "hashmap values returns all values" =
  let m = collections::HashMap[string, i64].make(4)

  m.set("x", 10)
  m.set("y", 20)
  let vs = m.values()

  assert::equals(len(vs), 2)
