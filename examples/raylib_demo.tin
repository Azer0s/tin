use raylib

raylib::init_window(800, 450, "Tin + Raylib")
raylib::set_target_fps(60)

for !raylib::window_should_close():
  raylib::begin_drawing()
  raylib::clear_background(raylib::RAYWHITE)
  raylib::draw_rectangle(50, 185, 20, 80, raylib::DARKGRAY)
  raylib::draw_circle(400, 225, 10.0, raylib::RED)
  raylib::draw_line(0, 225, 800, 225, raylib::LIGHTGRAY)
  raylib::draw_text("Hello from Tin!", 280, 20, 20, raylib::DARKGRAY)
  raylib::draw_fps(10, 10)
  raylib::end_drawing()

raylib::close_window()
