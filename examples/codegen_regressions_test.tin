test "codegen: ineffective-allow-drop flags i64-returning fn" =
  expect_warn_substr("ineffective_allow_drop_flags_i64_returning_fn_46.tin", "ineffective-allow-drop")

test "codegen: || continues across a leading newline" =
  expect_substr("continues_across_a_leading_newline_47.tin", "true")

test "codegen: || continues across a trailing newline" =
  expect_substr("continues_across_a_trailing_newline_48.tin", "true")

test "codegen: generic free-fn overload picks template by arity" =
  expect_substr("generic_free_fn_overload_picks_template_by_arity_49.tin", "two=99 one=42")

test "codegen: ADT struct payload preserves multi-field i64 values" =
