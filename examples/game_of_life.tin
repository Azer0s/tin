// examples/game_of_life.tin
//
// Conway's Game of Life rendered to stdout.
//
// A 60x24 toroidal grid is stored as a [[i64]] (2D nested array) and
// accessed with grid[row][col] syntax.  Three seed patterns are placed
// on the initial board:
//   - Glider         (top-left area)
//   - R-pentomino    (centre - chaotic, runs for ~1100 generations)
//   - Pulsar         (right side - period-3 oscillator)
//
// Usage:
//   ./tin build examples/game_of_life.tin -o /tmp/gol
//   /tmp/gol

use io

fn usleep(us i64) void = extern("usleep")

fn make_grid(h i64, w i64) [[i64]] =
  let g [[i64]] = []
  let r i64 = 0

  for r < h:
    let row [i64] = []
    let c i64 = 0

    for c < w:
      row ++= 0
      c = c + 1

    g ++= row
    r = r + 1

  return g

fn live_neighbors(g [[i64]], r i64, c i64, h i64, w i64) i64 =
  let n i64 = 0
  let dr i64 = -1

  for dr <= 1:
    let dc i64 = -1

    for dc <= 1:
      if dr != 0 || dc != 0:
        n = n + g[(r + dr + h) % h][(c + dc + w) % w]
      dc = dc + 1

    dr = dr + 1

  return n

fn step(cur [[i64]], h i64, w i64) [[i64]] =
  let nxt = make_grid(h, w)
  let r i64 = 0

  for r < h:
    let c i64 = 0

    for c < w:
      let alive = cur[r][c]
      let n     = live_neighbors(cur, r, c, h, w)

      if alive == 1 && (n == 2 || n == 3):
        nxt[r][c] = 1
      if alive == 0 && n == 3:
        nxt[r][c] = 1
      c = c + 1

    r = r + 1

  return nxt

fn main() =
  let w i64 = 60
  let h i64 = 24

  let g = make_grid(h, w)

  // --- Glider at (1, 2) ---
  g[1][3] = 1
  g[2][4] = 1
  g[3][2] = 1
  g[3][3] = 1
  g[3][4] = 1

  // --- R-pentomino at (10, 22) ---
  g[10][23] = 1
  g[10][24] = 1
  g[11][22] = 1
  g[11][23] = 1
  g[12][23] = 1

  // --- Pulsar (period-3 oscillator) centred around col 46 ---
  g[ 6][42] = 1  g[ 6][43] = 1  g[ 6][44] = 1
  g[ 6][48] = 1  g[ 6][49] = 1  g[ 6][50] = 1
  g[ 8][40] = 1  g[ 8][45] = 1  g[ 8][47] = 1  g[ 8][52] = 1
  g[ 9][40] = 1  g[ 9][45] = 1  g[ 9][47] = 1  g[ 9][52] = 1
  g[10][40] = 1  g[10][45] = 1  g[10][47] = 1  g[10][52] = 1
  g[11][42] = 1  g[11][43] = 1  g[11][44] = 1
  g[11][48] = 1  g[11][49] = 1  g[11][50] = 1
  g[13][42] = 1  g[13][43] = 1  g[13][44] = 1
  g[13][48] = 1  g[13][49] = 1  g[13][50] = 1
  g[14][40] = 1  g[14][45] = 1  g[14][47] = 1  g[14][52] = 1
  g[15][40] = 1  g[15][45] = 1  g[15][47] = 1  g[15][52] = 1
  g[16][40] = 1  g[16][45] = 1  g[16][47] = 1  g[16][52] = 1
  g[17][42] = 1  g[17][43] = 1  g[17][44] = 1
  g[17][48] = 1  g[17][49] = 1  g[17][50] = 1

  let gen i64 = 0

  for gen < 500:
    io::printf("\033[H")

    let r i64 = 0

    for r < h:
      let line string = ""
      let c i64 = 0

      for c < w:
        if g[r][c] == 1:
          line = line ++ "#"
        else:
          line = line ++ " "
        c = c + 1

      echo line
      r = r + 1

    io::printf("gen %-6lld\n", gen)
    io::fflush(nil)

    g = step(g, h, w)
    usleep(80000)
    gen = gen + 1
