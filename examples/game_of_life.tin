// examples/game_of_life.tin
//
// Conway's Game of Life rendered to stdout.
//
// A 60x24 toroidal grid is printed to the terminal using ANSI cursor
// positioning.  Three seed patterns are placed on the initial board:
//   - Glider         (top-left area)
//   - R-pentomino    (centre - chaotic, runs for ~1100 generations)
//   - Pulsar         (right side - period-3 oscillator)
//
// Usage:
//   ./tin build examples/game_of_life.tin -o /tmp/gol
//   /tmp/gol

use io

fn usleep(us i64) void = extern("usleep")

// Count live neighbors using toroidal (wrap-around) topology.
fn live_neighbors(grid [i64], x i64, y i64, w i64, h i64) i64 =
  let count i64 = 0
  let dy i64 = -1
  for dy <= 1:
    let dx i64 = -1
    for dx <= 1:
      if dy != 0 || dx != 0:
        let nx = (x + dx + w) % w
        let ny = (y + dy + h) % h
        count = count + grid[ny * w + nx]
      dx = dx + 1
    dy = dy + 1
  return count

fn set(grid [i64], row i64, col i64, w i64) =
  grid[row * w + col] = 1

fn main() =
  let w    i64 = 60
  let h    i64 = 24
  let size      = w * h

  // Build zero-initialized grid.
  let cur [i64] = []
  let i i64 = 0
  for i < size:
    cur ++= 0
    i = i + 1

  // --- Glider at (2, 1) ---
  //  .#.
  //  ..#
  //  ###
  set(cur, 1, 3, w)
  set(cur, 2, 4, w)
  set(cur, 3, 2, w)
  set(cur, 3, 3, w)
  set(cur, 3, 4, w)

  // --- R-pentomino at (10, 22) ---
  //  .##
  //  ##.
  //  .#.
  set(cur, 10, 23, w)
  set(cur, 10, 24, w)
  set(cur, 11, 22, w)
  set(cur, 11, 23, w)
  set(cur, 12, 23, w)

  // --- Pulsar (period-3 oscillator) centred at (12, 46) ---
  // Top half (rows 6..8, cols 40..52)
  set(cur,  6, 42, w)
  set(cur,  6, 43, w)
  set(cur,  6, 44, w)
  set(cur,  6, 48, w)
  set(cur,  6, 49, w)
  set(cur,  6, 50, w)
  set(cur,  8, 40, w)
  set(cur,  8, 45, w)
  set(cur,  8, 47, w)
  set(cur,  8, 52, w)
  set(cur,  9, 40, w)
  set(cur,  9, 45, w)
  set(cur,  9, 47, w)
  set(cur,  9, 52, w)
  set(cur, 10, 40, w)
  set(cur, 10, 45, w)
  set(cur, 10, 47, w)
  set(cur, 10, 52, w)
  set(cur, 11, 42, w)
  set(cur, 11, 43, w)
  set(cur, 11, 44, w)
  set(cur, 11, 48, w)
  set(cur, 11, 49, w)
  set(cur, 11, 50, w)
  // Bottom half (rows 13..17, mirror of top)
  set(cur, 13, 42, w)
  set(cur, 13, 43, w)
  set(cur, 13, 44, w)
  set(cur, 13, 48, w)
  set(cur, 13, 49, w)
  set(cur, 13, 50, w)
  set(cur, 14, 40, w)
  set(cur, 14, 45, w)
  set(cur, 14, 47, w)
  set(cur, 14, 52, w)
  set(cur, 15, 40, w)
  set(cur, 15, 45, w)
  set(cur, 15, 47, w)
  set(cur, 15, 52, w)
  set(cur, 16, 40, w)
  set(cur, 16, 45, w)
  set(cur, 16, 47, w)
  set(cur, 16, 52, w)
  set(cur, 17, 42, w)
  set(cur, 17, 43, w)
  set(cur, 17, 44, w)
  set(cur, 17, 48, w)
  set(cur, 17, 49, w)
  set(cur, 17, 50, w)

  let gen i64 = 0
  for gen < 500:
    io::printf("\033[H")

    let row i64 = 0
    for row < h:
      let line string = ""
      let col i64 = 0
      for col < w:
        if cur[row * w + col] == 1:
          line = line ++ "#"
        else:
          line = line ++ " "
        col = col + 1
      echo line
      row = row + 1

    io::printf("gen %-6lld\n", gen)
    io::fflush(nil)

    // Allocate next-generation grid.
    let nxt [i64] = []
    let k i64 = 0
    for k < size:
      nxt ++= 0
      k = k + 1

    // Apply Conway rules.
    let r i64 = 0
    for r < h:
      let c i64 = 0
      for c < w:
        let n     = live_neighbors(cur, c, r, w, h)
        let alive = cur[r * w + c]
        if alive == 1:
          if n == 2 || n == 3:
            nxt[r * w + c] = 1
        else:
          if n == 3:
            nxt[r * w + c] = 1
        c = c + 1
      r = r + 1

    cur = nxt
    usleep(80000)
    gen = gen + 1
