// Demonstrates spec traits: generic iter[t], function-alias display trait,
// and a forward-field trait with a default method (the "size" pattern).
//
// Functions now use generic constraints (`where t is Trait`) instead of
// trait types as direct parameters.

// Generic iterable trait

trait iter[t] =
  fn len(this iter[t]) i64 = virtual
  fn get(this iter[t], i i64) t = virtual

// Function-alias trait

trait display as fn() string

// Forward-field trait with a default method

trait labeled =
  tag string forward
  fn label(this labeled) string =
    return this.tag

// int_list: implements iter[i64] and display

struct int_list(iter[i64], display, labeled) =
  val i64
  count i64

  fn iter::len(this int_list) i64 =
    return this.count

  fn iter::get(this int_list, i i64) i64 =
    if i == 0:
      return this.val
    return 0

  fn ::display(this int_list) string =
    return "int_list({this.val}, len={this.count})"

// pair: implements iter[i64] with two values

struct pair(iter[i64], display, labeled) =
  a i64
  b i64

  fn iter::len(this pair) i64 =
    return 2

  fn iter::get(this pair, i i64) i64 =
    if i == 0:
      return this.a
    return this.b

  fn ::display(this pair) string =
    return "({this.a}, {this.b})"

// Generic functions using trait constraints
// Each is monomorphized at every call site with the concrete type.

fn first[t](it t) i64 where t is iter[i64] =
  return it.get(0)

fn last[t](it t) i64 where t is iter[i64] =
  return it.get(it.len() - 1)

fn show[t](d t) where t is display =
  echo d.display()

fn print_label[t](x t) where t is labeled =
  echo x.label()

fn sum_first_last[t](it t) i64 where t is iter[i64] =
  return it.get(0) + it.get(it.len() - 1)

// Demo

let item = int_list{val: 42, count: 1, tag: "my-list"}
echo first(item)          // 42
echo last(item)           // 42
show(item)                // int_list(42, len=1)
print_label(item)         // my-list

let p = pair{a: 10, b: 20, tag: "coords"}
echo first(p)             // 10
echo last(p)              // 20
show(p)                   // (10, 20)
print_label(p)            // coords

echo sum_first_last(item) // 84
echo sum_first_last(p)    // 30

use assert

test "int_list first and last" =
  let lst = int_list{val: 42, count: 1, tag: "t"}
  assert::equals(first(lst), 42)
  assert::equals(last(lst), 42)

test "pair first and last" =
  let p2 = pair{a: 10, b: 20, tag: "coords"}
  assert::equals(first(p2), 10)
  assert::equals(last(p2), 20)

test "sum_first_last" =
  let lst2 = int_list{val: 5, count: 1, tag: "t"}
  assert::equals(sum_first_last(lst2), 10)
  let p3 = pair{a: 3, b: 7, tag: "t"}
  assert::equals(sum_first_last(p3), 10)
