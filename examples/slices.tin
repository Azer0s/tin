// slices.tin - Array slice syntax: arr[start..end]
//
// A slice copies the [start, end) range into a fresh `_tin_rc_alloc`'d
// fat-array buffer.  The result is owned and freely mutable; writes to
// the slice do NOT touch the source.  Cap equals len, so the first
// `++=` triggers a grow.
//
// Bounds are required on both sides.  Use `len(arr)` for "to the end":
//   arr[1..len(arr)]   - from index 1 to end
//   arr[0..3]          - from start to (not including) index 3
//   arr[1..4]          - from index 1 to (not including) index 4
//
// Build: tin build examples/slices.tin
// Run:   tin run   examples/slices.tin

use assert

test "slice from index" =
  let arr = [1, 2, 3, 4, 5]
  let s = arr[1..len(arr)]

  assert::equals(s.len, 4)
  assert::equals(s[0], 2)
  assert::equals(s[3], 5)

test "slice to index" =
  let arr = [1, 2, 3, 4, 5]
  let s = arr[0..3]

  assert::equals(s.len, 3)
  assert::equals(s[0], 1)
  assert::equals(s[2], 3)

test "slice range" =
  let arr = [10, 20, 30, 40, 50]
  let s = arr[1..4]

  assert::equals(s.len, 3)
  assert::equals(s[0], 20)
  assert::equals(s[1], 30)
  assert::equals(s[2], 40)

test "full slice" =
  let arr = [1, 2, 3]
  let s = arr[0..3]

  assert::equals(s.len, 3)
  assert::equals(s[0], 1)
  assert::equals(s[2], 3)

test "single element slice" =
  let arr = [10, 20, 30]
  let s = arr[1..2]

  assert::equals(s.len, 1)
  assert::equals(s[0], 20)

test "slice from zero" =
  let arr = [7, 8, 9]
  let s = arr[0..len(arr)]

  assert::equals(s.len, 3)
  assert::equals(s[0], 7)

test "slice preserves element values" =
  let arr = [100, 200, 300, 400]
  let s = arr[2..len(arr)]

  assert::equals(s[0], 300)
  assert::equals(s[1], 400)

test "slice of string array" =
  let words = ["alpha", "beta", "gamma", "delta"]
  let s = words[1..3]

  assert::equals(s.len, 2)
  assert::equals(s[0], "beta")
  assert::equals(s[1], "gamma")

test "slice copies independently of source" =
  let a = [10, 20, 30, 40]
  let s = a[1..3]
  s[0] = 99

  assert::equals(a[1], 20)
  assert::equals(s[0], 99)
