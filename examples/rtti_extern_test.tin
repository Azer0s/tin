//!-lm
use assert
// rtti_extern_test.tin — Comprehensive RTTI tagging tests for:
//   1. Extern C functions returning primitives -> box to any -> typeof/echo
//   2. Extern C functions returning strings    -> box to any -> typeof
//   3. Extern C functions passed as function-pointer arguments
//   4. Tin functions returning structs via function pointers
//   5. Lambdas/closures returning structs      -> box to any -> typeof
//   6. Multi-level function pointer indirection
//   7. getfield/setfield on struct from fn return
//   8. typeof/traitof/fieldnames on any from higher-order fn
//   9. Edge cases: null/zero values, nested types, recursive fns

use io
use mem

// Traits and structs used throughout

trait drawable =
  fn draw(this drawable) string = virtual

trait resizable =
  fn resize(this resizable, factor i64) i64 = virtual

struct rect(drawable, resizable) =
  w i64
  h i64

  fn draw(this rect) string =
    return "rect"

  fn resize(this rect, factor i64) i64 =
    return this.w * factor * this.h * factor

struct point =
  x i64
  y i64

struct triple =
  a i64
  b i64
  c i64

// Extern C function declarations

fn c_abs(x i64)       i64    = extern("labs")
fn c_strlen(s string) i64    = extern("strlen")
fn c_sqrt(x f64)      f64    = extern("sqrt")
fn c_pow(x f64, y f64) f64   = extern("pow")
fn c_getenv(name string) string = extern("getenv")
fn c_atoi(s string) i32      = extern("atoi")
fn c_malloc(size i64) *void  = extern("malloc")
fn c_free(ptr *void)         = extern("free")

// §1 — Extern C functions returning primitives -> any boxing -> typeof

io::printf("=== §1 extern C primitives -> any ===\n")

let r1a = c_abs(-42)
io::printf("labs(-42) = %lld\n", r1a)
let a1a any = r1a
io::printf("typeof(labs result) = %s\n", typeof(a1a))
echo a1a

let r1b = c_sqrt(144.0)
io::printf("sqrt(144.0) = %f\n", r1b)
let a1b any = r1b
io::printf("typeof(sqrt result) = %s\n", typeof(a1b))
echo a1b

let r1c = c_atoi("1234")
let a1c any = r1c
io::printf("typeof(atoi result) = %s\n", typeof(a1c))

// §2 — Extern C functions returning string -> any boxing -> typeof

io::printf("=== §2 extern C string -> any ===\n")

let r2a = c_strlen("hello world")
io::printf("strlen = %lld\n", r2a)
let a2a any = r2a
io::printf("typeof(strlen result) = %s\n", typeof(a2a))

let r2b = c_getenv("PATH")
io::printf("typeof(getenv result) = %s\n", typeof(r2b))
let a2b any = r2b
io::printf("typeof(getenv any) = %s\n", typeof(a2b))

// §3 — Extern C functions passed as function-pointer arguments

io::printf("=== §3 extern fn as function-pointer arg ===\n")

fn apply_i64(f fn(i64) i64, x i64) i64 =
  return f(x)

fn apply_f64(f fn(f64) f64, x f64) f64 =
  return f(x)

let r3a = apply_i64(c_abs, -77)
io::printf("apply_i64(labs, -77) = %lld\n", r3a)
let a3a any = r3a
io::printf("typeof = %s\n", typeof(a3a))
echo a3a

let r3b = apply_f64(c_sqrt, 64.0)
io::printf("apply_f64(sqrt, 64.0) = %f\n", r3b)
let a3b any = r3b
io::printf("typeof = %s\n", typeof(a3b))
echo a3b

// Higher-order fn returning function pointer that calls extern
fn make_abs_fn() fn(i64) i64 =
  return c_abs

let abs_fn = make_abs_fn()
let r3c = abs_fn(-33)
io::printf("make_abs_fn()(-33) = %lld\n", r3c)
let a3c any = r3c
io::printf("typeof = %s\n", typeof(a3c))

// §4 — Tin functions returning structs via function pointers

io::printf("=== §4 struct from fn pointer ===\n")

fn make_rect(w i64, h i64) rect =
  return rect { w: w, h: h }

fn make_point(x i64, y i64) point =
  return point { x: x, y: y }

// Call through fn pointer variable
let rect_fn fn(i64, i64) rect = make_rect
let r4a = rect_fn(10, 20)
io::printf("rect_fn(10,20).w = %lld\n", r4a.w)
let a4a any = r4a
io::printf("typeof(rect from fn ptr) = %s\n", typeof(a4a))
io::printf("traitof len = %lld\n", traitof(a4a).len)
io::printf("fieldnames[0] = %s\n", fieldnames(a4a)[0])
io::printf("fieldtypes[0] = %s\n", fieldtypes(a4a)[0])

// fn pointer in a struct
let pt_fn fn(i64, i64) point = make_point
let r4b = pt_fn(3, 7)
io::printf("pt_fn(3,7).x = %lld\n", r4b.x)
let a4b any = r4b
io::printf("typeof(point from fn ptr) = %s\n", typeof(a4b))

// Higher-order fn that takes fn returning struct
fn apply_struct_fn(f fn(i64, i64) rect, w i64, h i64) any =
  let result = f(w, h)
  return result

let a4c = apply_struct_fn(make_rect, 5, 15)
io::printf("typeof(apply_struct_fn result) = %s\n", typeof(a4c))
io::printf("fieldnames len = %lld\n", fieldnames(a4c).len)

// §5 — Lambdas/closures returning structs -> box to any

io::printf("=== §5 lambda/closure returning struct ===\n")

let make_rect_lambda = fn(w i64, h i64) rect = return rect { w: w, h: h }
let r5a = make_rect_lambda(6, 9)
io::printf("lambda rect .w = %lld\n", r5a.w)
let a5a any = r5a
io::printf("typeof(lambda struct) = %s\n", typeof(a5a))

// Closure capturing outer variable
let scale i64 = 3
let scaled_rect_fn = fn(w i64) rect = return rect { w: w * scale, h: w * scale * 2 }
let r5b = scaled_rect_fn(4)
io::printf("closure rect .w = %lld, .h = %lld\n", r5b.w, r5b.h)
let a5b any = r5b
io::printf("typeof(closure struct) = %s\n", typeof(a5b))
io::printf("fieldnames len = %lld\n", fieldnames(a5b).len)

// Lambda passed to higher-order fn, returns struct
let r5c = apply_struct_fn(fn(w i64, h i64) rect = return rect { w: w + h, h: w - h }, 20, 8)
io::printf("typeof(lambda via HOF) = %s\n", typeof(r5c))

// §6 — Multi-level function pointer indirection

io::printf("=== §6 multi-level fn pointer ===\n")

fn wrap_rect_maker(f fn(i64, i64) rect) fn(i64, i64) rect =
  return f

fn double_wrap(f fn(i64, i64) rect) fn(i64, i64) rect =
  return wrap_rect_maker(f)

let f6a = double_wrap(make_rect)
let r6a = f6a(3, 4)
io::printf("double_wrap result .w = %lld\n", r6a.w)
let a6a any = r6a
io::printf("typeof(double-wrapped fn result) = %s\n", typeof(a6a))

// Compose extern fns
fn compose_i64(f fn(i64) i64, g fn(i64) i64) fn(i64) i64 =
  return fn(x i64) i64 = return f(g(x))

let neg_abs = compose_i64(fn(x i64) i64 = return x * -1, c_abs)
let r6b = neg_abs(-55)
io::printf("compose(negate, labs)(-55) = %lld\n", r6b)
let a6b any = r6b
io::printf("typeof = %s\n", typeof(a6b))

// §7 — getfield / setfield on struct from function returns

io::printf("=== §7 getfield/setfield from fn returns ===\n")

// getfield on struct from direct tin fn call
let r7a = make_rect(8, 16)
let gw = getfield(r7a, "w")
io::printf("getfield(make_rect(8,16), \"w\") = ")
echo gw

// getfield on struct from fn-pointer call
let r7b = rect_fn(12, 24)
let gh = getfield(r7b, "h")
io::printf("getfield(rect_fn(12,24), \"h\") = ")
echo gh

// getfield on struct boxed to any (uses type_id runtime dispatch)
let a7a any = r7b
let gw2 = getfield(a7a, "w")
io::printf("getfield(any=rect, \"w\") = ")
echo gw2

// setfield on struct from fn return
let r7c = make_point(10, 20)
setfield(r7c, "x", 999)
io::printf("after setfield(point, \"x\", 999): x = %lld\n", r7c.x)

// §8 — any boxing / typeof with all RTTI builtins through HOF

io::printf("=== §8 full reflection through HOF ===\n")

fn make_triple(a i64, b i64, c i64) triple =
  return triple { a: a, b: b, c: c }

fn transform_any(f fn(i64, i64, i64) triple, a i64, b i64, c i64) any =
  return f(a, b, c)

let a8a = transform_any(make_triple, 1, 2, 3)
io::printf("typeof = %s\n", typeof(a8a))

let fn8 = fieldnames(a8a)
io::printf("fieldnames.len = %lld\n", fn8.len)
for let i i64 in 0..fn8.len :
  io::printf("  field[%lld] = %s\n", i, fn8[i])

let ft8 = fieldtypes(a8a)
io::printf("fieldtypes.len = %lld\n", ft8.len)
for let i i64 in 0..ft8.len :
  io::printf("  type[%lld] = %s\n", i, ft8[i])

let ga = getfield(a8a, "a")
io::printf("getfield(triple, \"a\") = ")
echo ga

let gb = getfield(a8a, "b")
io::printf("getfield(triple, \"b\") = ")
echo gb

// §9 — Edge cases

io::printf("=== §9 edge cases ===\n")

// typeof on pointer to struct
let r9a = make_point(5, 6)
let ptr9 = &r9a
io::printf("typeof(*point ptr) = %s\n", typeof(ptr9))

// typeof on array of structs
let arr9 = [make_point(1, 2), make_point(3, 4)]
io::printf("typeof([point] array) = %s\n", typeof(arr9))
io::printf("arr9.len = %lld\n", arr9.len)

// Recursive fn returning struct
fn fib_pair(n i64) point =
  if n <= 1 :
    return point { x: n, y: 1 }
  let prev = fib_pair(n - 1)
  return point { x: prev.x + prev.y, y: prev.x }

let r9c = fib_pair(7)
io::printf("fib_pair(7).x = %lld .y = %lld\n", r9c.x, r9c.y)
let a9c any = r9c
io::printf("typeof(recursive struct) = %s\n", typeof(a9c))

// Zero-value struct
let r9d = point { x: 0, y: 0 }
let a9d any = r9d
io::printf("typeof(zero struct) = %s\n", typeof(a9d))

// Struct in data type (any boxing + typeof on data type)
data maybe_point = point | None

let mp1 maybe_point = make_point(10, 20)
let mp2 maybe_point = None
io::printf("typeof(data:point variant) = %s\n", typeof(mp1))
io::printf("typeof(data:None) = %s\n", typeof(mp2))

// typeof chained: extern -> fn ptr -> any -> typeof
fn make_len_fn() fn(string) i64 =
  return c_strlen

let len_fn = make_len_fn()
let r9e = len_fn("testing")
let a9e any = r9e
io::printf("typeof(strlen via fn-ptr chain) = %s\n", typeof(a9e))
echo a9e

// Function returning function returning struct
fn rect_factory(scale i64) fn(i64, i64) rect =
  return fn(w i64, h i64) rect = return rect { w: w * scale, h: h * scale }

let factory = rect_factory(2)
let r9f = factory(5, 3)
io::printf("rect_factory(2)(5,3).w = %lld\n", r9f.w)
let a9f any = r9f
io::printf("typeof(factory struct) = %s\n", typeof(a9f))
io::printf("traitof len = %lld\n", traitof(a9f).len)

// Tests

test "extern C primitives" =
  assert::equals(c_abs(-42), 42)
  assert::equals(c_abs(0), 0)
  assert::equals(c_abs(100), 100)
  assert::equals(c_strlen("hello world"), 11)
  assert::equals(c_strlen("") as i64, 0)
  assert::equals(c_atoi("1234") as i64, 1234)
  assert::equals(c_sqrt(144.0) as i64, 12)
  assert::equals(c_pow(2.0, 10.0) as i64, 1024)

test "typeof with any boxing" =
  let i i64 = 42
  let ia any = i
  assert::equals_str(typeof(ia), "i64")
  let f f64 = 3.14
  let fa any = f
  assert::equals_str(typeof(fa), "f64")
  let r = make_rect(1, 2)
  let ra any = r
  assert::equals_str(typeof(ra), "rect")
  let p = make_point(0, 0)
  let pa any = p
  assert::equals_str(typeof(pa), "point")

test "extern fn as fn-pointer arg" =
  assert::equals(apply_i64(c_abs, -77), 77)
  assert::equals(apply_i64(c_abs, 0), 0)
  assert::equals(apply_f64(c_sqrt, 64.0) as i64, 8)
  assert::equals(apply_f64(c_sqrt, 0.0) as i64, 0)
  let abs_fn = make_abs_fn()
  assert::equals(abs_fn(-33), 33)
  assert::equals(abs_fn(33), 33)

test "struct from fn pointer" =
  let rf fn(i64, i64) rect = make_rect
  let r = rf(10, 20)
  assert::equals(r.w, 10)
  assert::equals(r.h, 20)
  let ra any = r
  assert::equals_str(typeof(ra), "rect")
  assert::equals(traitof(ra).len, 2)
  assert::equals_str(fieldnames(ra)[0], "w")
  assert::equals_str(fieldtypes(ra)[0], "i64")
  let pf fn(i64, i64) point = make_point
  let p = pf(3, 7)
  assert::equals(p.x, 3)
  assert::equals(p.y, 7)
  let pa any = p
  assert::equals_str(typeof(pa), "point")

test "lambda and closure" =
  let mk = fn(w i64, h i64) rect = return rect { w: w, h: h }
  let r = mk(6, 9)
  assert::equals(r.w, 6)
  assert::equals(r.h, 9)
  let ra any = r
  assert::equals_str(typeof(ra), "rect")
  let sc i64 = 3
  let scaled = fn(w i64) rect = return rect { w: w * sc, h: w * sc * 2 }
  let sr = scaled(4)
  assert::equals(sr.w, 12)
  assert::equals(sr.h, 24)
  let r2 = apply_struct_fn(fn(w i64, h i64) rect = return rect { w: w + h, h: w - h }, 20, 8)
  assert::equals_str(typeof(r2), "rect")

test "multi-level fn pointer" =
  let f = double_wrap(make_rect)
  let r = f(3, 4)
  assert::equals(r.w, 3)
  assert::equals(r.h, 4)
  let ra any = r
  assert::equals_str(typeof(ra), "rect")
  let neg_abs = compose_i64(fn(x i64) i64 = return x * -1, c_abs)
  assert::equals(neg_abs(-55), -55)
  assert::equals(neg_abs(10), -10)

test "getfield and setfield" =
  let r = make_rect(8, 16)
  assert::equals(getfield(r, "w") as i64, 8)
  assert::equals(getfield(r, "h") as i64, 16)
  let rf fn(i64, i64) rect = make_rect
  let r2 = rf(12, 24)
  assert::equals(getfield(r2, "h") as i64, 24)
  let ra any = r2
  assert::equals(getfield(ra, "w") as i64, 12)
  let p = make_point(10, 20)
  setfield(p, "x", 999)
  assert::equals(p.x, 999)

test "HOF full reflection" =
  let a = transform_any(make_triple, 1, 2, 3)
  assert::equals_str(typeof(a), "triple")
  let fn8 = fieldnames(a)
  assert::equals(fn8.len, 3)
  assert::equals_str(fn8[0], "a")
  assert::equals_str(fn8[1], "b")
  assert::equals_str(fn8[2], "c")
  let ft8 = fieldtypes(a)
  assert::equals(ft8.len, 3)
  assert::equals_str(ft8[0], "i64")
  assert::equals(getfield(a, "a") as i64, 1)
  assert::equals(getfield(a, "b") as i64, 2)
  assert::equals(getfield(a, "c") as i64, 3)

test "edge cases" =
  let r = fib_pair(7)
  assert::equals(r.x, 21)
  assert::equals(r.y, 13)
  let arr = [make_point(1, 2), make_point(3, 4)]
  assert::equals(arr.len, 2)
  assert::equals(arr[0].x, 1)
  assert::equals(arr[1].y, 4)
  let len_fn = make_len_fn()
  assert::equals(len_fn("testing"), 7)
  let factory = rect_factory(2)
  let rf = factory(5, 3)
  assert::equals(rf.w, 10)
  assert::equals(rf.h, 6)
  let rfa any = rf
  assert::equals_str(typeof(rfa), "rect")
  assert::equals(traitof(rfa).len, 2)
