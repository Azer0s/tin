// External C functions: fat-pointer unwrapping / wrapping.
//
// When a Tin extern function takes `string` or `[]T` parameters, the compiler
// automatically unwraps the fat-pointer to a raw C pointer before the call.
// When it returns `string`, the result is wrapped back into a fat-pointer using
// C's strlen to determine the length.
//
// Build/test with -lm for the math functions:
//   tin build extern.tin -lm
//   tin test  extern.tin -lm
use assert

// ── String functions ──────────────────────────────────────────────────────────

fn strlen(s string) i64 = extern("strlen")
fn strcmp(a string, b string) i32 = extern("strcmp")
fn puts(s string) = extern("puts")

// ── Env / OS ──────────────────────────────────────────────────────────────────

fn getenv(name string) string = extern("getenv")

// ── Math (requires -lm at link time) ─────────────────────────────────────────

fn sqrt(x f64) f64 = extern("sqrt")
fn pow(x f64, y f64) f64 = extern("pow")

// ── use extern() alternative syntax ──────────────────────────────────────────

use extern (
  printf as fn(string, ...),
)

// ── Main ─────────────────────────────────────────────────────────────────────

puts("hello from extern!")

let msg string = "world"
echo strlen(msg)

echo strcmp("abc", "abc")
echo strcmp("abc", "xyz")

let home string = getenv("HOME")
printf("HOME = %s\n", home)

echo sqrt(144.0)
echo pow(2.0, 8.0)

test "string length" =
  assert::equals(strlen("hello"), 5)
  assert::equals(strlen(""), 0)
  assert::equals(strlen("Hello, world!"), 13)

test "strcmp" =
  assert::equals(strcmp("abc", "abc") as i64, 0)
  assert::ok(strcmp("abc", "xyz") < 0)
  assert::ok(strcmp("xyz", "abc") > 0)

test "math functions" =
  assert::equals_f64(sqrt(144.0), 12.0)
  assert::equals_f64(pow(2.0, 8.0), 256.0)
  assert::equals_f64(pow(3.0, 3.0), 27.0)
