// examples/move_errors_test.tin
//
// Negative tests for `move`: each fixture must fail to compile with a
// specific diagnostic.  All compile errors fire deterministically at
// codegen (or parse) time -- no runtime check is involved.

use assert
use "./fixtures/run_compiler"

fn expect_diagnostic(fixture string, needle string) =
  let r = run_tin("run", "examples/fixtures/move_errors/" ++ fixture)

  assert::ok(r.exit_code != 0 as i32)
  assert::ok(contains_text(r.stderr, needle))

test "use after move: subsequent read is a compile error" =
  expect_diagnostic("use_after_move.tin", "use of moved value")

test "move of function parameter rejected with fix-it" =
  expect_diagnostic("move_parameter.tin", "cannot move `s` (parameter")

test "move of for-loop iterator binding rejected with fix-it" =
  expect_diagnostic("move_iterator.tin", "cannot move `item` (iterator binding")

test "move of undefined name is a clean error" =
  expect_diagnostic("move_undefined.tin", "cannot move `not_a_thing`")

test "move of a field expression is rejected by the parser" =
  expect_diagnostic("move_field.tin", "partial moves")
