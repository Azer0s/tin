// ++= on a borrowed-view slice (cap < 0) is the canonical
// append-cap runtime check.  fieldnames() returns an immortal
// [atom] with cap=-1; with append-cap on, `fields ++= ['_extra]`
// panics with "borrowed view".  With append-cap off, it silently
// allocates a fresh owned buffer the caller never sees -- the
// program exits 0 either way (because the panic-checked `++=` was
// the only side effect).
struct probe =
  x i64
  y i64

fn main() =
  let p = probe{x: 1, y: 2}
  let fields = fieldnames(p)
  fields ++= ['_extra]
