use collections
use http

fn main() =
  let c = http::Client::new()

  c.set_header("X-Foo", "bar\r\nEvil-Header: pwn")

  let req = http::Request{
    method: "GET", url: "http://example.com/",
    headers: collections::HashMap[string, string]::make(1), body: ""
  }

  let _ = await http::send(c, req)
