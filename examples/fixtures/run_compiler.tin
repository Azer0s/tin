// examples/fixtures/run_compiler.tin -- helper for tests that
// shell out to the in-repo `./tin` binary to compile a fixture and
// check the diagnostic output.  Each tin test that wants to verify
// "compilation fails with this error" or "IR contains this snippet"
// runs the compiler in a child process via `os::start`, captures
// stderr / stdout, then asserts on the captured text.
//
// Imported via `use "./fixtures/run_compiler"` from the per-feature
// test file sitting in examples/.  The CWD when tests run is the
// repo root, so the relative `./tin` and `examples/fixtures/...`
// paths line up.

use io
use option
use os
use result
use { Result } from result
use strings
use sync

// CompileResult bundles everything a test wants to look at after
// invoking the compiler: the child's exit code, anything it wrote
// to stdout, anything it wrote to stderr (where compile errors and
// warnings land).  All three are populated together so a single
// access on the result is enough.
struct CompileResult =
  exit_code i32
  stdout    string
  stderr    string

// drain_pipe reads from an os::File pipe end until EOF and returns
// the concatenated bytes as a UTF-8 string.  Hardcoded 8 KiB read
// chunk - the compiler's diagnostics fit comfortably under that
// even for the noisier failure cases.
fn{#async} drain_pipe(f os::File) string =
  let out = ""
  let buf [byte; 8192]
  let pf = &f

  for true:
    let n = await pf.read(&buf[0], 8192)

    if n <= 0:
      break

    let chunk = buf[0..n] as string

    out = out ++ chunk

  return out

// drain_stream pulls every byte out of an Option[File] pipe end.
// Returns "" when the stdio slot was not requested as 'pipe (e.g.
// the caller only piped stderr).  Splits out from run_tin so the
// stdout / stderr legs use the same retry-on-empty contract.
fn{#async} drain_stream(stream Option[os::File]) string =
  if stream.is_none():
    return ""

  let f = stream.unwrap("drain_stream: stream not piped")
  let text = await spawn drain_pipe(f)

  f.close()

  return text

// run_tin spawns the in-repo compiler with `subcmd` (e.g. "run",
// "ir", "build-test") and the fixture path, plumbing stdout +
// stderr through pipes so the caller can assert on them.  Returns
// the captured result; panics only when the spawn itself can't
// fork (which would mean the test harness is broken, not the
// fixture).
fn run_tin(subcmd string, fixture_path string) CompileResult =
  return run_tin_argv(["./tin", subcmd, fixture_path], "")

// run_tin_flags is the variant for tests that need to pass extra
// flags after the fixture path (e.g. `-Wno-unused-match-arms`).
fn run_tin_flags(subcmd string, fixture_path string, flags [string]) CompileResult =
  let argv [string] = ["./tin", subcmd, fixture_path]
  let i i64 = 0

  for i < len(flags):
    argv = argv ++ [flags[i]]
    i = i + 1

  return run_tin_argv(argv, "")

// run_tin_stdin shells out to the compiler with a stdin payload --
// drives `tin repl` or other subcommands that read commands from
// stdin.  Passing an empty string is equivalent to /dev/null.
fn run_tin_stdin(subcmd string, stdin_text string) CompileResult =
  return run_tin_argv(["./tin", subcmd], stdin_text)

// run_tin_argv is the underlying spawn-and-capture helper.  Both
// stdout and stderr are piped; stdin is piped when `stdin_text` is
// non-empty so the child sees the script and an EOF, otherwise the
// child reads from /dev/null.
fn{#async} feed_stdin(f os::File, text string) =
  let bytes = text as [byte]
  let pf    = &f

  if len(bytes) > 0:
    let _ = await pf.write(&bytes[0], len(bytes))

  f.close()

fn run_tin_argv(argv [string], stdin_text string) CompileResult =
  return run_cmd(argv, stdin_text, [] as [string])

// run_cmd is the generic spawn-and-capture entry point.  Use this
// for tests that need to:
//   - invoke a binary other than ./tin (e.g. `nm`, `clang`),
//   - pass extra env vars (e.g. `TIN_PURE_FN_CACHE=1`).
// Env entries follow the `KEY=value` convention.  Empty env -> the
// child inherits the parent's environment.
fn run_cmd(argv [string], stdin_text string, env_vars [string]) CompileResult =
  let want_stdin atom = 'null

  if len(stdin_text as [byte]) > 0:
    want_stdin = 'pipe

  let env_opt Option[[string]] = None

  if len(env_vars) > 0:
    env_opt = Some(env_vars)

  let opts = os::SpawnOptions{
    env: env_opt, cwd: None,
    stdin: want_stdin, stdout: 'pipe, stderr: 'pipe,
  }
  let p = os::start(argv, opts).unwrap("run_cmd: spawn failed")

  if want_stdin == 'pipe:
    let stdin_f = p.stdin.unwrap("run_cmd: stdin not piped")
    let _       = await spawn feed_stdin(stdin_f, stdin_text)

  let stdout_text = await spawn drain_stream(p.stdout)
  let stderr_text = await spawn drain_stream(p.stderr)
  let mp          = &p
  let code        = mp.wait().unwrap("run_cmd: waitpid failed")

  return CompileResult{
    exit_code: code,
    stdout:    stdout_text,
    stderr:    stderr_text,
  }

// contains_text returns true when `haystack` contains `needle` as a
// substring.  Uses the strings package's index_of so the comparison
// matches the bash `grep` step in the legacy .sh tests.
fn contains_text(haystack string, needle string) bool =
  return strings::index_of(haystack, needle) >= 0
