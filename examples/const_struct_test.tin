// examples/const_struct_test.tin - top-level const initialization with
// struct literals.  Locked in by issue #22 -- before the fix
// `const BLACK = color{0, 0, 0, 255}` failed with both shapes:
//   - inferring: "requires either a type annotation or an initializer
//     with an obvious type"
//   - explicit: "has a non-compile-time initializer"

use assert

struct Color =
  r u8
  g u8
  b u8
  a u8

// Inferred type: the struct literal names its own type, so no
// annotation is needed.
const BLACK = Color{r: 0, g: 0, b: 0, a: 255}
const WHITE = Color{r: 255, g: 255, b: 255, a: 255}

// Positional shape works the same way.
const RED = Color{255, 0, 0, 255}

// Explicit annotation also works (regression for the "non-compile-time
// initializer" case).
const GREEN Color = Color{r: 0, g: 255, b: 0, a: 255}

struct Point =
  x i64
  y i64

const ORIGIN = Point{0, 0}
const FAR    = Point{x: 1000000, y: 2000000}

test "named-field struct const folds" =
  assert::equals(BLACK.r, 0 as u8)
  assert::equals(BLACK.g, 0 as u8)
  assert::equals(BLACK.b, 0 as u8)
  assert::equals(BLACK.a, 255 as u8)

test "named-field struct const with all 255" =
  assert::equals(WHITE.r, 255 as u8)
  assert::equals(WHITE.a, 255 as u8)

test "positional struct const folds" =
  assert::equals(RED.r, 255 as u8)
  assert::equals(RED.g, 0 as u8)
  assert::equals(RED.b, 0 as u8)
  assert::equals(RED.a, 255 as u8)

test "explicit type annotation on struct const" =
  assert::equals(GREEN.r, 0 as u8)
  assert::equals(GREEN.g, 255 as u8)
  assert::equals(GREEN.b, 0 as u8)
  assert::equals(GREEN.a, 255 as u8)

test "i64-field struct const" =
  assert::equals(ORIGIN.x, 0)
  assert::equals(ORIGIN.y, 0)
  assert::equals(FAR.x, 1000000)
  assert::equals(FAR.y, 2000000)
