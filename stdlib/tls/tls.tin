//!+tls_impl.c [linux] -- -I $TIN_RUNTIME
//!+tls_impl.c [darwin] -- -I $TIN_RUNTIME -I $(brew --prefix openssl@3)/include
//!-lssl
//!-lcrypto
//!-L$(brew --prefix openssl@3)/lib [darwin]
// stdlib/tls - async TLS client connections backed by OpenSSL.
//
// TlsConn wraps an existing TCP file descriptor with TLS.  It implements
// io::AsyncReader and io::AsyncWriter, so all ioutil functions work
// transparently:
//
//   let (conn, dial_err) = tcp::dial("example.com", 443)
//   if errors::is_err(dial_err): panic(dial_err.message())
//   let (tls_conn, tls_err) = await tls::connect("example.com", conn.fd)
//   if errors::is_err(tls_err): panic(tls_err.message())
//   let line = await ioutil::read_string(tls_conn)
//   await ioutil::write_string(tls_conn, "hello\n")
//   tls_conn.close()
//   conn.close()
//
// Ownership: the OpenSSL handle lives behind an *rc::Cell so copies of
// TlsConn share ownership instead of double-freeing on scope exit. Calling
// .close() is idempotent (sends close_notify + frees OpenSSL state, marks
// the handle inert); the cell's dtor at last drop frees the wrapper struct.
//
// SSL_CTX is initialized automatically via fn init() at program startup.
// To trust a custom CA (e.g. for testing with self-signed certs):
//   tls::set_ca_file("path/to/ca.pem")

use io
use rc
use errors
use result
use { Result } from result
use { loop } from macros

fn tin_tls_init_c()                                       = extern("_tin_tls_init")
fn tin_tls_set_ca_file_c(path string) i32                 = extern("_tin_tls_set_ca_file")
fn tin_tls_new_c(host string, fd i32) *void               = extern("_tin_tls_new")
fn tin_tls_do_handshake_c(handle *void) i64               = extern("_tin_tls_do_handshake")
fn tin_tls_read_c(handle *void, buf *byte, n i64) i64     = extern("_tin_tls_read")
fn tin_tls_write_c(handle *void, buf *byte, n i64) i64    = extern("_tin_tls_write")
fn tin_tls_shutdown_c(handle *void)                       = extern("_tin_tls_shutdown")
fn tin_tls_free_c(handle *void)                           = extern("_tin_tls_free")
fn tin_io_blocked_val_c() i64                             = extern("_tin_io_blocked_val")

// fn init runs once at program startup and initializes the global SSL_CTX.
fn init() =
  tin_tls_init_c()

// set_ca_file loads a PEM certificate file into the global SSL trust store.
// Call this before connect when using self-signed or custom CA certificates.
fn set_ca_file(path string) =
  tin_tls_set_ca_file_c(path)

// TlsConn is an async TLS connection over a connected TCP fd.
// Implements io::AsyncReader and io::AsyncWriter.
struct TlsConn (io::AsyncReader, io::AsyncWriter, io::Closeable) =
  _cell *rc::Cell[*void]
  fd    i32

  // read reads up to n bytes from the TLS stream.
  // Returns Future[i64] - use `await conn.read(buf, n)` or pass to ioutil.
  fn AsyncReader::read(this TlsConn, buf *byte, n i64) Future[i64] =
    return spawn tls_read_impl(this._cell.payload(), buf, n)

  // write writes up to n bytes to the TLS stream.
  // Returns Future[i64] - use `await conn.write(buf, n)` or pass to ioutil.
  fn AsyncWriter::write(this TlsConn, buf *byte, n i64) Future[i64] =
    return spawn tls_write_impl(this._cell.payload(), buf, n)

  // close sends a TLS close_notify alert and frees OpenSSL state. Idempotent:
  // safe to call multiple times. The underlying fd must still be closed by
  // the caller. The TinTLS wrapper struct itself is freed when the last
  // reference to the cell drops.
  fn Closeable::close(this TlsConn) =
    tin_tls_shutdown_c(this._cell.payload())

// TlsError enumerates the failure modes the tls stdlib can surface.
// Implements errors::Err so connect returns Result[TlsConn, errors::Err]
// and unifies with the typed-error ecosystem.
data TlsError(errors::Err, print) =
  CannotCreateState(host string)
  HandshakeFailed(host string)

  fn errors::Err::message(this TlsError) string =
    match this:
      case CannotCreateState(h): return "tls::connect: failed to create TLS state for " ++ h ++ " (CA bundle missing or empty hostname)"
      case HandshakeFailed(h):   return "tls::connect: TLS handshake failed for " ++ h ++ " (cert chain or hostname verification failed)"

  fn ::print(this TlsError) string = return this.message()

// connect wraps fd with TLS and performs the async handshake.
// host is used for SNI and certificate verification. Returns a
// Future yielding Result[TlsConn, errors::Err]; on Err the
// underlying TLS state has already been freed and there is no
// TlsConn to clean up.
fn connect(host string, fd i32) Future[Result[TlsConn, errors::Err]] =
  return spawn connect_impl(host, fd)

fn{#async} connect_impl(host string, fd i32) Result[TlsConn, errors::Err] =
  let handle  = tin_tls_new_c(host, fd)
  let blocked = tin_io_blocked_val_c()

  if handle == nil:
    return Err(CannotCreateState(host))

  loop:
    let r = tin_tls_do_handshake_c(handle)

    if r == 0:
      break
    if r != blocked:
      tin_tls_free_c(handle)
      return Err(HandshakeFailed(host))
    yield

  return Ok(TlsConn{_cell: rc::Cell[*void].new(handle, tin_tls_free_c), fd: fd})

fn{#async} tls_read_impl(handle *void, buf *byte, n i64) i64 =
  let blocked = tin_io_blocked_val_c()

  loop:
    let r = tin_tls_read_c(handle, buf, n)

    if r != blocked:
      return r
    yield

fn{#async} tls_write_impl(handle *void, buf *byte, n i64) i64 =
  let blocked = tin_io_blocked_val_c()

  loop:
    let r = tin_tls_write_c(handle, buf, n)

    if r != blocked:
      return r
    yield

export { TlsConn, TlsError, connect, set_ca_file } as tls
