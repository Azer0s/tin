use assert
use { Option } from option

test "Option Some/None via match" =
  let a Option[i64] = Some(7)
  let b Option[i64] = None

  match a:
    case Some(v): assert::equals(7, v)
    case None:    assert::fails("expected Some")

  match b:
    case Some(_): assert::fails("expected None")
    case None:    assert::ok(true)

test "is_some / is_none / unwrap_or" =
  let a Option[i64] = Some(10)
  let b Option[i64] = None

  assert::ok(a.is_some())
  assert::ok(b.is_none())
  assert::equals(10, a.unwrap_or(0))
  assert::equals(0,  b.unwrap_or(0))

test "map / and_then / or_else" =
  let a Option[i64] = Some(3)
  let b Option[i64] = None

  let m = a.map(fn(x i64) i64 = return x + 1)

  assert::equals(4, m.unwrap_or(0))
  assert::ok(b.map(fn(x i64) i64 = return x + 1).is_none())

  let f = fn(x i64) Option[i64] = return Some(x * 10)

  assert::equals(30, a.and_then(f).unwrap_or(0))
  assert::ok(b.and_then(f).is_none())

  let g = fn() Option[i64] = return Some(42)

  assert::equals(3,  a.or_else(g).unwrap_or(0))
  assert::equals(42, b.or_else(g).unwrap_or(0))

test "unwrap / unwrap-with-msg" =
  let a Option[i64] = Some(11)

  assert::equals(11, a.unwrap())
  assert::equals(11, a.unwrap("should be some"))
