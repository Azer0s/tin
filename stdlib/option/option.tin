// option - the standard Option ADT and its combinators.
//
// Option[t] represents either a value (`Some(v)`) or its absence (`None`).
//
// Typical usage:
//
//   fn first(xs [i64]) Option[i64] =
//     if len(xs) == 0: return None
//     return Some(xs[0])
//
//   match first(xs):
//     case Some(v): echo "got {v}"
//     case None:    echo "empty"
//
// Bare constructors (`Some(x)`, `None`) are inferred from the target type
// when it is known (let-annotations, function arguments, function returns);
// otherwise qualify explicitly, e.g. `Option[i64]::None`.

data Option[t](tryable[t, Option[_]]) =
  None
  Some(v t)

  fn tryable[t, Option[_]]::is_err(this Option[t]) bool =
    match this:
      case Some(_): return false
      case None:    return true

  fn tryable[t, Option[_]]::ok_value(this Option[t]) t =
    match this:
      case Some(v): return v
      case None:    panic("tryable::ok_value on None")

  fn tryable[t, Option[_]]::err_value(this Option[t]) Option[_] =
    match this:
      case Some(_): panic("tryable::err_value on Some")
      case None:    return this

// is_some reports whether the Option holds a value.
fn is_some[t](o Option[t]) bool =
  match o:
    case Some(_): return true
    case None:    return false

// is_none reports whether the Option is empty.
fn is_none[t](o Option[t]) bool =
  match o:
    case Some(_): return false
    case None:    return true

// unwrap_or returns the Some value or d when o is None.
fn unwrap_or[t](o Option[t], d t) t =
  match o:
    case Some(v): return v
    case None:    return d

// map applies f to the Some value, leaving None untouched.
fn map[t, u](o Option[t], f fn(t) u) Option[u] =
  match o:
    case Some(v): return Some(f(v))
    case None:    return None

// and_then chains an optional computation onto a Some value (flatMap).
fn and_then[t, u](o Option[t], f fn(t) Option[u]) Option[u] =
  match o:
    case Some(v): return f(v)
    case None:    return None

// or_else produces a fallback Option when o is None.
fn or_else[t](o Option[t], f fn() Option[t]) Option[t] =
  match o:
    case Some(v): return Some(v)
    case None:    return f()

// unwrap returns the Some value or panics on None.
fn unwrap[t](o Option[t]) t =
  match o:
    case Some(v): return v
    case None:    panic("option::unwrap on None")

// expect returns the Some value or panics with msg on None.
fn expect[t](o Option[t], msg string) t =
  match o:
    case Some(v): return v
    case None:    panic(msg)
