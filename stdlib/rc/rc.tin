// stdlib/rc - Refcounted wrapper for shared, owning handles to a single value.
//
// Cell[T] gives a Tin-managed reference count to a value that the
// compiler otherwise can't track -- typically a raw C pointer. Hold the
// cell as `*Cell[T]`: pointer copies retain, scope-exit releases, and
// the user-supplied destructor runs exactly once when the last reference
// drops. Atomic, Channel, Mutex, etc. wrap their C cells with Cell so
// `let b = a` for the containing struct shares ownership instead of
// double-freeing on scope exit.
//
// Usage:
//   fn close_fd(p i64) = posix::close(p)
//   let fd = posix::open("/etc/hosts", 0)
//   let cell *Cell[i64] = Cell[i64].alloc(fd, close_fd)
//   // copying *Cell[i64] retains; the last drop runs close_fd(fd).
//
// T must be a non-RC-tracked type (raw pointer, integer, opaque extern).
// For RC-tracked types (string, fat array, any, fn closure, *S) Tin's
// existing field-ARC handles ownership without needing Cell.

struct {#no_copy #closed} Cell[T] =
  _dtor    fn(T)
  _payload T

  // alloc constructs a heap-allocated cell with a single reference.
  // Tin's pointer-ARC takes over from there: copying *Cell[T] retains,
  // each scope exit releases, the cell is freed on the last drop and
  // dtor runs exactly once on the stored value.
  static fn alloc(value T, dtor fn(T)) *Cell[T] =
    return &Cell[T]{_dtor: dtor, _payload: value}

  // payload borrows the stored value. Reading does not change the RC.
  fn payload(this *Cell[T]) T =
    return this._payload

  // retain bumps the cell's refcount. Used when something outside Tin's
  // automatic field-ARC takes a fresh handle on the cell -- e.g. the
  // fiber spawn machinery copies a containing struct via raw frame
  // memcpy rather than a let-binding.
  fn retain(this *Cell[T]) =
    tin_rc_retain(this as *void)

  // deinit fires on the last release. Calling user dtor here means the
  // C-managed resource is cleaned up before the cell's heap block goes
  // back to the allocator.
  fn deinit(this Cell[T]) =
    this._dtor(this._payload)

fn tin_rc_retain(p *void) = extern("_tin_retain")
