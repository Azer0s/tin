// stdlib/hash/sha256 - SHA-256 (FIPS 180-4 section 6.2).
//
// Provides both a one-shot function (`sha256(data, len)`) and a streaming
// API (`Sha256.new()` / `write` / `sum` / `reset`) for incremental input.
//
// Output is a 32-byte digest; `sha256_hex` returns the lowercase hex form.
//
// ## Example (one-shot)
//
//   use hash::sha256
//
//   let h = sha256::sha256_hex("hello")
//
// ## Example (streaming)
//
//   let h = sha256::Sha256.new()
//
//   h.write_str("hello")
//   h.write_str(" world")
//
//   let digest = h.sum()
//   let hex    = sha256::hex_from_digest(digest)
//
// Note: SHA-256 is cryptographic but should be paired with HMAC for
// message authentication; see hash::hmac.

const BLOCK_SIZE  i64 = 64
const DIGEST_SIZE i64 = 32

// SHA-256 round constants K (FIPS 180-4 section 4.2.2).
fn round_constants() [u32; 64] =
  let k [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
  ]

  return k

fn rotr(x u32, n u32) u32 = return (x >> n) | (x << (32 - n))

fn read_u32_be(buf *u8, off i64) u32 =
  let b0 u32 = (buf[off] as u32) << 24
  let b1 u32 = (buf[off + 1] as u32) << 16
  let b2 u32 = (buf[off + 2] as u32) << 8
  let b3 u32 = buf[off + 3] as u32

  return b0 | b1 | b2 | b3

fn write_u32_be(out *u8, off i64, v u32) =
  out[off]     = ((v >> 24) & 0xff) as u8
  out[off + 1] = ((v >> 16) & 0xff) as u8
  out[off + 2] = ((v >> 8) & 0xff) as u8
  out[off + 3] = (v & 0xff) as u8

fn write_u64_be(out *u8, off i64, v u64) =
  out[off]     = ((v >> 56) & 0xff) as u8
  out[off + 1] = ((v >> 48) & 0xff) as u8
  out[off + 2] = ((v >> 40) & 0xff) as u8
  out[off + 3] = ((v >> 32) & 0xff) as u8
  out[off + 4] = ((v >> 24) & 0xff) as u8
  out[off + 5] = ((v >> 16) & 0xff) as u8
  out[off + 6] = ((v >> 8) & 0xff) as u8
  out[off + 7] = (v & 0xff) as u8

// process_block runs one 64-byte block through the SHA-256 compression
// function and returns the new chaining state.
fn process_block(block *u8, h0 u32, h1 u32, h2 u32, h3 u32, h4 u32, h5 u32, h6 u32, h7 u32) [u32; 8] =
  let k = round_constants()
  let w [u32; 64]
  let i i64 = 0

  for i < 16:
    w[i] = read_u32_be(block, i * 4)
    i = i + 1

  for i < 64:
    let s0 u32 = rotr(w[i - 15], 7 as u32) ^ rotr(w[i - 15], 18 as u32) ^ (w[i - 15] >> 3)
    let s1 u32 = rotr(w[i - 2], 17 as u32) ^ rotr(w[i - 2], 19 as u32) ^ (w[i - 2] >> 10)

    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1

  let a u32 = h0
  let b u32 = h1
  let c u32 = h2
  let d u32 = h3
  let e u32 = h4
  let f u32 = h5
  let g u32 = h6
  let h u32 = h7
  let r i64 = 0

  for r < 64:
    let s1 u32 = rotr(e, 6 as u32) ^ rotr(e, 11 as u32) ^ rotr(e, 25 as u32)
    let ch u32 = (e & f) ^ ((~e) & g)
    let t1 u32 = h + s1 + ch + k[r] + w[r]
    let s0 u32 = rotr(a, 2 as u32) ^ rotr(a, 13 as u32) ^ rotr(a, 22 as u32)
    let mj u32 = (a & b) ^ (a & c) ^ (b & c)
    let t2 u32 = s0 + mj

    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2

    r = r + 1

  let out [u32; 8] = [h0 + a, h1 + b, h2 + c, h3 + d, h4 + e, h5 + f, h6 + g, h7 + h]

  return out

// Sha256 is a streaming SHA-256 hasher.  Construct with new(), feed via
// write/write_str, and read the digest with sum().
//
// State invariants:
//   h0..h7    = current chaining values
//   buf       = unprocessed tail bytes (0..63 of them)
//   buf_len   = count of valid bytes in buf
//   total_len = total bytes written so far (used for the length pad)
struct Sha256 =
  h0 u32
  h1 u32
  h2 u32
  h3 u32
  h4 u32
  h5 u32
  h6 u32
  h7 u32
  buf [u8; 64]
  buf_len i64
  total_len i64

  static fn new() Sha256 =
    let s = Sha256{
      h0: 0x6a09e667,
      h1: 0xbb67ae85,
      h2: 0x3c6ef372,
      h3: 0xa54ff53a,
      h4: 0x510e527f,
      h5: 0x9b05688c,
      h6: 0x1f83d9ab,
      h7: 0x5be0cd19,
      buf_len: 0,
      total_len: 0,
    }

    return s

  fn reset(this *Sha256) =
    this.h0 = 0x6a09e667
    this.h1 = 0xbb67ae85
    this.h2 = 0x3c6ef372
    this.h3 = 0xa54ff53a
    this.h4 = 0x510e527f
    this.h5 = 0x9b05688c
    this.h6 = 0x1f83d9ab
    this.h7 = 0x5be0cd19
    this.buf_len = 0
    this.total_len = 0

  fn size(this Sha256) i64 = return DIGEST_SIZE
  fn block_size(this Sha256) i64 = return BLOCK_SIZE

  // write feeds raw bytes into the hasher.
  fn write(this *Sha256, data *u8, n i64) =
    if n <= 0:
      return
    this.total_len = this.total_len + n
    let i i64 = 0

    // Top up the partial buffer if there is one.  If the top-up does
    // not fill a full 64-byte block, the entire input has been
    // absorbed; return early so the residue-stash below does not
    // clobber buf_len.
    if this.buf_len > 0:
      let take = 64 - this.buf_len

      if take > n:
        take = n
      let j i64 = 0

      for j < take:
        this.buf[this.buf_len + j] = data[j]
        j = j + 1

      this.buf_len = this.buf_len + take
      i = take

      if this.buf_len < 64:
        return

      let s = process_block(&this.buf[0], this.h0, this.h1, this.h2, this.h3, this.h4, this.h5, this.h6, this.h7)

      this.h0 = s[0]
      this.h1 = s[1]
      this.h2 = s[2]
      this.h3 = s[3]
      this.h4 = s[4]
      this.h5 = s[5]
      this.h6 = s[6]
      this.h7 = s[7]
      this.buf_len = 0

    // Process full 64-byte blocks straight from the input.
    for i + 64 <= n:
      let s = process_block(&data[i], this.h0, this.h1, this.h2, this.h3, this.h4, this.h5, this.h6, this.h7)

      this.h0 = s[0]
      this.h1 = s[1]
      this.h2 = s[2]
      this.h3 = s[3]
      this.h4 = s[4]
      this.h5 = s[5]
      this.h6 = s[6]
      this.h7 = s[7]
      i = i + 64

    // Stash the residue.
    let rem = n - i
    let j i64 = 0

    for j < rem:
      this.buf[j] = data[i + j]
      j = j + 1

    this.buf_len = rem

  // write_str is a convenience wrapper around write for string inputs.
  fn write_str(this *Sha256, s string) =
    let n = len(s)

    if n == 0:
      return
    this.write(&s[0], n)

  // sum finalizes the hash and returns the 32-byte digest.  The hasher
  // is left in a finalized state; call reset() before reusing.  Calling
  // sum() twice without reset returns the same digest each time, since
  // the appended padding happens on a saved copy of the state.
  fn sum(this *Sha256) [u8; 32] =
    // Snapshot state so a caller can keep writing or call sum() again
    // without observing the padding side-effects.
    let h0 = this.h0
    let h1 = this.h1
    let h2 = this.h2
    let h3 = this.h3
    let h4 = this.h4
    let h5 = this.h5
    let h6 = this.h6
    let h7 = this.h7
    let pad [u8; 128]
    let plen = this.buf_len
    let i i64 = 0

    for i < plen:
      pad[i] = this.buf[i]
      i = i + 1

    pad[plen] = 0x80 as u8

    let bit_len u64 = (this.total_len as u64) * 8
    let off i64 = 56

    if plen >= 56:
      off = 120
    write_u64_be(&pad[0], off, bit_len)

    let s = process_block(&pad[0], h0, h1, h2, h3, h4, h5, h6, h7)

    h0 = s[0]
    h1 = s[1]
    h2 = s[2]
    h3 = s[3]
    h4 = s[4]
    h5 = s[5]
    h6 = s[6]
    h7 = s[7]

    if plen >= 56:
      let s2 = process_block(&pad[64], h0, h1, h2, h3, h4, h5, h6, h7)

      h0 = s2[0]
      h1 = s2[1]
      h2 = s2[2]
      h3 = s2[3]
      h4 = s2[4]
      h5 = s2[5]
      h6 = s2[6]
      h7 = s2[7]

    let digest [u8; 32]

    write_u32_be(&digest[0], 0, h0)
    write_u32_be(&digest[0], 4, h1)
    write_u32_be(&digest[0], 8, h2)
    write_u32_be(&digest[0], 12, h3)
    write_u32_be(&digest[0], 16, h4)
    write_u32_be(&digest[0], 20, h5)
    write_u32_be(&digest[0], 24, h6)
    write_u32_be(&digest[0], 28, h7)

    return digest

// sha256 is the one-shot one-call form: hash data[0..len] and return the
// 32-byte digest.  Equivalent to new() + write + sum.
fn sha256(data *u8, n i64) [u8; 32] =
  let h = Sha256.new()

  h.write(data, n)

  return h.sum()

// hex_from_digest converts a 32-byte SHA-256 digest into 64 lowercase
// hex characters.
fn hex_from_digest(digest [u8; 32]) string =
  let buf [char; 64]
  let i i64 = 0

  for i < 32:
    let b u8 = digest[i]
    let hi u8 = (b >> 4) & 0x0f
    let lo u8 = b & 0x0f

    if hi < 10:
      buf[i * 2] = (0x30 as u8 + hi) as char
    else:
      buf[i * 2] = (0x57 as u8 + hi) as char
    if lo < 10:
      buf[i * 2 + 1] = (0x30 as u8 + lo) as char
    else:
      buf[i * 2 + 1] = (0x57 as u8 + lo) as char
    i = i + 1

  return buf as string

fn sha256_hex(data *u8, n i64) string =
  return hex_from_digest(sha256(data, n))

// Overload: sha256(string) computes SHA-256 over the string bytes and
// returns the 64-char lowercase hex digest.  Empty string is handled by
// taking the streaming path so we do not need a valid pointer.
fn sha256(s string) string =
  if len(s) == 0:
    let h = Sha256.new()

    return hex_from_digest(h.sum())

  return sha256_hex(&s[0], len(s))

export {
  Sha256, sha256, sha256_hex, hex_from_digest,
  BLOCK_SIZE, DIGEST_SIZE,
} as sha256
