use assert
use hash::sha256

test "sha256 empty string" =
  // FIPS 180-4 known answer: SHA-256("")
  assert::equals(sha256::sha256(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

test "sha256 abc" =
  // FIPS 180-4 known answer: SHA-256("abc")
  assert::equals(sha256::sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

test "sha256 56-char input crosses padding boundary" =
  // 56 chars: pad must spill into a second block (length goes at byte 120).
  let s = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"

  assert::equals(sha256::sha256(s), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

test "sha256 multi-block input" =
  // Million 'a's would be ideal but slow; use 1000 'a's instead.
  let s = ""
  let i i64 = 0

  for i < 1000:
    s = s ++ "a"
    i = i + 1

  // Known: SHA-256("a" * 1000)
  assert::equals(sha256::sha256(s), "41edece42d63e8d9bf515a9ba6932e1c20cbc9f5a5d134645adb5db1b9737ea3")

test "sha256 streaming matches one-shot" =
  let h = sha256::Sha256.new()

  h.write_str("abc")
  let stream_hex = sha256::hex_from_digest(h.sum())

  assert::equals(stream_hex, sha256::sha256("abc"))

test "sha256 streaming with byte-by-byte writes" =
  let h = sha256::Sha256.new()

  h.write_str("a")
  h.write_str("b")
  h.write_str("c")

  assert::equals(sha256::hex_from_digest(h.sum()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

test "sha256 streaming with chunk straddling block boundary" =
  // First chunk leaves 30 bytes in buf; second chunk crosses.
  let h = sha256::Sha256.new()
  let part_a = "abcdefghijklmnopqrstuvwxyz0123"
  let part_b = "456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz!"

  h.write_str(part_a)
  h.write_str(part_b)

  let one_shot = sha256::sha256(part_a ++ part_b)
  let streamed = sha256::hex_from_digest(h.sum())

  assert::equals(streamed, one_shot)

test "sha256 sum is idempotent" =
  let h = sha256::Sha256.new()

  h.write_str("hello")
  let a = sha256::hex_from_digest(h.sum())
  let b = sha256::hex_from_digest(h.sum())

  assert::equals(a, b)

test "sha256 reset reuses hasher" =
  let h = sha256::Sha256.new()

  h.write_str("foo")
  let _ = h.sum()

  h.reset()
  h.write_str("abc")

  assert::equals(sha256::hex_from_digest(h.sum()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")

test "sha256 size and block_size constants" =
  let h = sha256::Sha256.new()

  assert::equals(h.size(), 32)
  assert::equals(h.block_size(), 64)
  assert::equals(sha256::DIGEST_SIZE, 32)
  assert::equals(sha256::BLOCK_SIZE, 64)
