use assert
use hash::sha512

test "sha512 empty string" =
  // FIPS 180-4 known answer: SHA-512("")
  assert::equals(sha512::sha512(""), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")

test "sha512 abc" =
  // FIPS 180-4 known answer: SHA-512("abc")
  assert::equals(sha512::sha512("abc"), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

test "sha512 long input crossing padding boundary" =
  // 112 chars: edge case for 128-byte block + 16-byte length, requires 2-block padding.
  let s = "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu"

  assert::equals(sha512::sha512(s), "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909")

test "sha512 streaming matches one-shot" =
  let h = sha512::Sha512.new()

  h.write_str("abc")

  assert::equals(sha512::hex_from_512(h.sum_512()), sha512::sha512("abc"))

test "sha512 streaming with byte-by-byte writes" =
  let h = sha512::Sha512.new()

  h.write_str("a")
  h.write_str("b")
  h.write_str("c")

  assert::equals(sha512::hex_from_512(h.sum_512()), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")

test "sha384 empty string" =
  // FIPS 180-4 known answer: SHA-384("")
  assert::equals(sha512::sha384(""), "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b")

test "sha384 abc" =
  // FIPS 180-4 known answer: SHA-384("abc")
  assert::equals(sha512::sha384("abc"), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")

test "sha384 streaming with byte-by-byte writes" =
  let h = sha512::Sha512.new_384()

  h.write_str("a")
  h.write_str("b")
  h.write_str("c")

  assert::equals(sha512::hex_from_384(h.sum_384()), "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")

test "sha512 digest size and block size constants" =
  let h = sha512::Sha512.new()

  assert::equals(h.block_size(), 128)
  assert::equals(sha512::BLOCK_SIZE, 128)
  assert::equals(sha512::SHA512_DIGEST_SIZE, 64)
  assert::equals(sha512::SHA384_DIGEST_SIZE, 48)
