// stdlib/hash/sha512 - SHA-512 and SHA-384 (FIPS 180-4 section 6.4 / 6.5).
//
// SHA-512 produces a 64-byte digest; SHA-384 is the same compression
// function with different initial values and output truncated to 48
// bytes.  Both share a 128-byte block size and a 1024-bit length field
// that is stored as a big-endian 128-bit value (the high 64 bits are
// always zero for inputs under 2^61 bytes -- which is everything in
// practice).
//
// Streaming and one-shot APIs mirror the SHA-256 module.
//
// Import: use hash::sha512

const BLOCK_SIZE         i64 = 128
const SHA512_DIGEST_SIZE i64 = 64
const SHA384_DIGEST_SIZE i64 = 48

// SHA-512 round constants (FIPS 180-4 section 4.2.3).
fn round_constants() [u64; 80] =
  let k [u64; 80] = [
    0x428a2f98d728ae22, 0x7137449123ef65cd,
    0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019,
    0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe,
    0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1,
    0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3,
    0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483,
    0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210,
    0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725,
    0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926,
    0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8,
    0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001,
    0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910,
    0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53,
    0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb,
    0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60,
    0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9,
    0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207,
    0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6,
    0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493,
    0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a,
    0x5fcb6fab3ad6faec, 0x6c44198c4a475817,
  ]

  return k

fn rotr(x u64, n u64) u64 = return (x >> n) | (x << (64 - n))

fn read_u64_be(buf *u8, off i64) u64 =
  let b0 u64 = (buf[off]     as u64) << 56
  let b1 u64 = (buf[off + 1] as u64) << 48
  let b2 u64 = (buf[off + 2] as u64) << 40
  let b3 u64 = (buf[off + 3] as u64) << 32
  let b4 u64 = (buf[off + 4] as u64) << 24
  let b5 u64 = (buf[off + 5] as u64) << 16
  let b6 u64 = (buf[off + 6] as u64) << 8
  let b7 u64 =  buf[off + 7] as u64

  return b0 | b1 | b2 | b3 | b4 | b5 | b6 | b7

fn write_u64_be(out *u8, off i64, v u64) =
  out[off]     = ((v >> 56) & 0xff) as u8
  out[off + 1] = ((v >> 48) & 0xff) as u8
  out[off + 2] = ((v >> 40) & 0xff) as u8
  out[off + 3] = ((v >> 32) & 0xff) as u8
  out[off + 4] = ((v >> 24) & 0xff) as u8
  out[off + 5] = ((v >> 16) & 0xff) as u8
  out[off + 6] = ((v >> 8)  & 0xff) as u8
  out[off + 7] = (v & 0xff) as u8

// process_block runs one 128-byte block through the SHA-512 / SHA-384
// compression function.  Both algorithms share this transform.
fn process_block(block *u8, h0 u64, h1 u64, h2 u64, h3 u64, h4 u64, h5 u64, h6 u64, h7 u64) [u64; 8] =
  let k = round_constants()
  let w [u64; 80]
  let i i64 = 0

  for i < 16:
    w[i] = read_u64_be(block, i * 8)
    i = i + 1

  for i < 80:
    let s0 u64 = rotr(w[i - 15], 1 as u64) ^ rotr(w[i - 15], 8 as u64) ^ (w[i - 15] >> 7)
    let s1 u64 = rotr(w[i - 2], 19 as u64) ^ rotr(w[i - 2], 61 as u64) ^ (w[i - 2] >> 6)

    w[i] = w[i - 16] + s0 + w[i - 7] + s1
    i = i + 1

  let a u64 = h0
  let b u64 = h1
  let c u64 = h2
  let d u64 = h3
  let e u64 = h4
  let f u64 = h5
  let g u64 = h6
  let h u64 = h7
  let r i64 = 0

  for r < 80:
    let S1 u64 = rotr(e, 14 as u64) ^ rotr(e, 18 as u64) ^ rotr(e, 41 as u64)
    let ch u64 = (e & f) ^ ((~e) & g)
    let t1 u64 = h + S1 + ch + k[r] + w[r]
    let S0 u64 = rotr(a, 28 as u64) ^ rotr(a, 34 as u64) ^ rotr(a, 39 as u64)
    let mj u64 = (a & b) ^ (a & c) ^ (b & c)
    let t2 u64 = S0 + mj

    h = g
    g = f
    f = e
    e = d + t1
    d = c
    c = b
    b = a
    a = t1 + t2

    r = r + 1

  let out [u64; 8] = [h0 + a, h1 + b, h2 + c, h3 + d, h4 + e, h5 + f, h6 + g, h7 + h]

  return out

// Sha512 is a streaming SHA-512 hasher.  See SHA-256's docstring for
// the buf/buf_len/total_len invariants -- they apply identically here
// with a 128-byte block size.
struct Sha512 =
  h0 u64
  h1 u64
  h2 u64
  h3 u64
  h4 u64
  h5 u64
  h6 u64
  h7 u64
  buf [u8; 128]
  buf_len i64
  total_len i64

  static fn new() Sha512 =
    let s = Sha512{
      h0: 0x6a09e667f3bcc908,
      h1: 0xbb67ae8584caa73b,
      h2: 0x3c6ef372fe94f82b,
      h3: 0xa54ff53a5f1d36f1,
      h4: 0x510e527fade682d1,
      h5: 0x9b05688c2b3e6c1f,
      h6: 0x1f83d9abfb41bd6b,
      h7: 0x5be0cd19137e2179,
      buf_len: 0,
      total_len: 0,
    }

    return s

  // new_384 returns a streaming hasher seeded with the SHA-384 IVs.
  // The compression and padding are identical to SHA-512; sum_384
  // truncates the output to 48 bytes.
  static fn new_384() Sha512 =
    let s = Sha512{
      h0: 0xcbbb9d5dc1059ed8,
      h1: 0x629a292a367cd507,
      h2: 0x9159015a3070dd17,
      h3: 0x152fecd8f70e5939,
      h4: 0x67332667ffc00b31,
      h5: 0x8eb44a8768581511,
      h6: 0xdb0c2e0d64f98fa7,
      h7: 0x47b5481dbefa4fa4,
      buf_len: 0,
      total_len: 0,
    }

    return s

  fn reset_512(this *Sha512) =
    this.h0 = 0x6a09e667f3bcc908
    this.h1 = 0xbb67ae8584caa73b
    this.h2 = 0x3c6ef372fe94f82b
    this.h3 = 0xa54ff53a5f1d36f1
    this.h4 = 0x510e527fade682d1
    this.h5 = 0x9b05688c2b3e6c1f
    this.h6 = 0x1f83d9abfb41bd6b
    this.h7 = 0x5be0cd19137e2179
    this.buf_len = 0
    this.total_len = 0

  fn reset_384(this *Sha512) =
    this.h0 = 0xcbbb9d5dc1059ed8
    this.h1 = 0x629a292a367cd507
    this.h2 = 0x9159015a3070dd17
    this.h3 = 0x152fecd8f70e5939
    this.h4 = 0x67332667ffc00b31
    this.h5 = 0x8eb44a8768581511
    this.h6 = 0xdb0c2e0d64f98fa7
    this.h7 = 0x47b5481dbefa4fa4
    this.buf_len = 0
    this.total_len = 0

  fn block_size(this Sha512) i64 = return BLOCK_SIZE

  fn write(this *Sha512, data *u8, n i64) =
    if n <= 0:
      return
    this.total_len = this.total_len + n
    let i i64 = 0

    if this.buf_len > 0:
      let take = BLOCK_SIZE - this.buf_len

      if take > n:
        take = n
      let j i64 = 0

      for j < take:
        this.buf[this.buf_len + j] = data[j]
        j = j + 1

      this.buf_len = this.buf_len + take
      i = take

      if this.buf_len < BLOCK_SIZE:
        return

      let s = process_block(&this.buf[0], this.h0, this.h1, this.h2, this.h3, this.h4, this.h5, this.h6, this.h7)

      this.h0 = s[0]
      this.h1 = s[1]
      this.h2 = s[2]
      this.h3 = s[3]
      this.h4 = s[4]
      this.h5 = s[5]
      this.h6 = s[6]
      this.h7 = s[7]
      this.buf_len = 0

    for i + BLOCK_SIZE <= n:
      let s = process_block(&data[i], this.h0, this.h1, this.h2, this.h3, this.h4, this.h5, this.h6, this.h7)

      this.h0 = s[0]
      this.h1 = s[1]
      this.h2 = s[2]
      this.h3 = s[3]
      this.h4 = s[4]
      this.h5 = s[5]
      this.h6 = s[6]
      this.h7 = s[7]
      i = i + BLOCK_SIZE

    let rem = n - i
    let j i64 = 0

    for j < rem:
      this.buf[j] = data[i + j]
      j = j + 1

    this.buf_len = rem

  fn write_str(this *Sha512, s string) =
    let n = len(s)

    if n == 0:
      return
    this.write(&s[0], n)

  // sum_internal finalizes the chaining state into eight 64-bit words.
  // Both the 512 and 384 sums share the padding logic; only the output
  // truncation differs.  Returns the eight final h0..h7 values.
  fn sum_internal(this *Sha512) [u64; 8] =
    let h0 = this.h0
    let h1 = this.h1
    let h2 = this.h2
    let h3 = this.h3
    let h4 = this.h4
    let h5 = this.h5
    let h6 = this.h6
    let h7 = this.h7
    // 256 bytes is enough: the worst case is a single block of residue
    // (up to 127 bytes) plus padding (1 byte) plus the 16-byte length
    // field, which can spill into a second 128-byte block.
    let pad [u8; 256]
    let plen = this.buf_len
    let i i64 = 0

    for i < plen:
      pad[i] = this.buf[i]
      i = i + 1

    pad[plen] = 0x80 as u8

    // Length is 128 bits big-endian, stored in the trailing 16 bytes.
    // Tin's u64 caps total_len * 8 to 64 bits, so the high 64 are
    // always zero and we only need to write the low half.
    let bit_len u64 = (this.total_len as u64) * 8
    let off i64 = 112  // length goes in last 16 bytes of the final block

    if plen >= 112:
      off = 240  // pad spills to a second block; length lives at byte 240
    write_u64_be(&pad[0], off, 0 as u64)
    write_u64_be(&pad[0], off + 8, bit_len)

    let s = process_block(&pad[0], h0, h1, h2, h3, h4, h5, h6, h7)

    h0 = s[0]
    h1 = s[1]
    h2 = s[2]
    h3 = s[3]
    h4 = s[4]
    h5 = s[5]
    h6 = s[6]
    h7 = s[7]

    if plen >= 112:
      let s2 = process_block(&pad[BLOCK_SIZE], h0, h1, h2, h3, h4, h5, h6, h7)

      h0 = s2[0]
      h1 = s2[1]
      h2 = s2[2]
      h3 = s2[3]
      h4 = s2[4]
      h5 = s2[5]
      h6 = s2[6]
      h7 = s2[7]

    let result [u64; 8] = [h0, h1, h2, h3, h4, h5, h6, h7]

    return result

  // sum_512 returns a 64-byte SHA-512 digest.  Caller must have used
  // the SHA-512 IVs (Sha512.new()).
  fn sum_512(this *Sha512) [u8; 64] =
    let s = this.sum_internal()
    let digest [u8; 64]

    write_u64_be(&digest[0], 0,  s[0])
    write_u64_be(&digest[0], 8,  s[1])
    write_u64_be(&digest[0], 16, s[2])
    write_u64_be(&digest[0], 24, s[3])
    write_u64_be(&digest[0], 32, s[4])
    write_u64_be(&digest[0], 40, s[5])
    write_u64_be(&digest[0], 48, s[6])
    write_u64_be(&digest[0], 56, s[7])

    return digest

  // sum_384 returns a 48-byte SHA-384 digest (truncated SHA-512).
  // Caller must have used the SHA-384 IVs (Sha512.new_384()).
  fn sum_384(this *Sha512) [u8; 48] =
    let s = this.sum_internal()
    let digest [u8; 48]

    write_u64_be(&digest[0], 0,  s[0])
    write_u64_be(&digest[0], 8,  s[1])
    write_u64_be(&digest[0], 16, s[2])
    write_u64_be(&digest[0], 24, s[3])
    write_u64_be(&digest[0], 32, s[4])
    write_u64_be(&digest[0], 40, s[5])

    return digest

// One-shot SHA-512 over data[0..n].
fn sha512(data *u8, n i64) [u8; 64] =
  let h = Sha512.new()

  h.write(data, n)

  return h.sum_512()

// One-shot SHA-384 over data[0..n].
fn sha384(data *u8, n i64) [u8; 48] =
  let h = Sha512.new_384()

  h.write(data, n)

  return h.sum_384()

fn hex_digit(v u8) char =
  if v < 10:
    return (0x30 as u8 + v) as char

  return (0x57 as u8 + v) as char

// hex_from_512 converts a 64-byte SHA-512 digest to 128 lowercase hex chars.
fn hex_from_512(d [u8; 64]) string =
  let buf [char; 128]
  let i i64 = 0

  for i < 64:
    let b = d[i]

    buf[i * 2]     = hex_digit((b >> 4) & 0x0f)
    buf[i * 2 + 1] = hex_digit(b & 0x0f)
    i = i + 1

  return buf as string

// hex_from_384 converts a 48-byte SHA-384 digest to 96 lowercase hex chars.
fn hex_from_384(d [u8; 48]) string =
  let buf [char; 96]
  let i i64 = 0

  for i < 48:
    let b = d[i]

    buf[i * 2]     = hex_digit((b >> 4) & 0x0f)
    buf[i * 2 + 1] = hex_digit(b & 0x0f)
    i = i + 1

  return buf as string

fn sha512_hex(data *u8, n i64) string =
  return hex_from_512(sha512(data, n))

fn sha384_hex(data *u8, n i64) string =
  return hex_from_384(sha384(data, n))

// String overloads.
fn sha512(s string) string =
  if len(s) == 0:
    let h = Sha512.new()

    return hex_from_512(h.sum_512())

  return sha512_hex(&s[0], len(s))

fn sha384(s string) string =
  if len(s) == 0:
    let h = Sha512.new_384()

    return hex_from_384(h.sum_384())

  return sha384_hex(&s[0], len(s))

export {
  Sha512,
  sha512, sha384, sha512_hex, sha384_hex, hex_from_512, hex_from_384,
  BLOCK_SIZE, SHA512_DIGEST_SIZE, SHA384_DIGEST_SIZE,
} as sha512
