// stdlib/hash/sha1.tin - SHA-1 160-bit digest (FIPS 180-4)
//
// Pure Tin implementation. 5x u32 state, 80 rounds.
// Not cryptographically safe - use for checksums and legacy compatibility only.

// sha1_rotl: rotate left a 32-bit value by n bits.
fn sha1_rotl(x u32, n u32) u32 =
  return (x << n) | (x >> (32 - n))

// sha1_read_u32_be: read a big-endian u32 from buf at byte offset off.
fn sha1_read_u32_be(buf *u8, off i64) u32 =
  let b0 u32 = (buf[off] as u32) << 24
  let b1 u32 = (buf[off + 1] as u32) << 16
  let b2 u32 = (buf[off + 2] as u32) << 8
  let b3 u32 = buf[off + 3] as u32

  return b0 | b1 | b2 | b3

// sha1_write_be: write a u32 as 4 big-endian bytes into out at offset off.
fn sha1_write_be(out *u8, off i64, v u32) =
  out[off]     = ((v >> 24) & 0xff) as u8
  out[off + 1] = ((v >> 16) & 0xff) as u8
  out[off + 2] = ((v >> 8) & 0xff) as u8
  out[off + 3] = (v & 0xff) as u8

// sha1_write_be64: write a u64 as 8 big-endian bytes into out at offset off.
fn sha1_write_be64(out *u8, off i64, v u64) =
  out[off]     = ((v >> 56) & 0xff) as u8
  out[off + 1] = ((v >> 48) & 0xff) as u8
  out[off + 2] = ((v >> 40) & 0xff) as u8
  out[off + 3] = ((v >> 32) & 0xff) as u8
  out[off + 4] = ((v >> 24) & 0xff) as u8
  out[off + 5] = ((v >> 16) & 0xff) as u8
  out[off + 6] = ((v >> 8) & 0xff) as u8
  out[off + 7] = (v & 0xff) as u8

// sha1_process_block: run one 64-byte block through SHA-1 compression.
// Returns [h0, h1, h2, h3, h4] + input state.
fn sha1_process_block(block *u8, h0 u32, h1 u32, h2 u32, h3 u32, h4 u32) [u32; 5] =
  // Expand 16 message words into 80 (stored in a [u32; 80] schedule).
  let w [u32; 80]
  let i i64 = 0

  for i < 16:
    w[i] = sha1_read_u32_be(block, i * 4)
    i = i + 1

  for i < 80:
    w[i] = sha1_rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1)
    i = i + 1

  // Initialize working variables.
  let a u32 = h0
  let b u32 = h1
  let c u32 = h2
  let d u32 = h3
  let e u32 = h4

  // 80 rounds.
  i = 0

  for i < 80:
    let f u32 = 0
    let k u32 = 0

    if i < 20:
      f = (b & c) | ((~b) & d)
      k = 0x5a827999
    else if i < 40:
      f = b ^ c ^ d
      k = 0x6ed9eba1
    else if i < 60:
      f = (b & c) | (b & d) | (c & d)
      k = 0x8f1bbcdc
    else:
      f = b ^ c ^ d
      k = 0xca62c1d6

    let temp u32 = sha1_rotl(a, 5) + f + e + k + w[i]

    e = d
    d = c
    c = sha1_rotl(b, 30)
    b = a
    a = temp
    i = i + 1

  let out [u32; 5] = [h0 + a, h1 + b, h2 + c, h3 + d, h4 + e]
  return out

// sha1: compute SHA-1 digest (returns 20-byte array).
fn sha1(data *u8, len i64) [u8; 20] =
  // Initial hash values (FIPS 180-4 section 5.3.1).
  let h0 u32 = 0x67452301
  let h1 u32 = 0xefcdab89
  let h2 u32 = 0x98badcfe
  let h3 u32 = 0x10325476
  let h4 u32 = 0xc3d2e1f0

  // Process all complete 64-byte blocks.
  let i i64 = 0

  for i + 64 <= len:
    let s [u32; 5] = sha1_process_block(addr(data[i]), h0, h1, h2, h3, h4)

    h0 = s[0]
    h1 = s[1]
    h2 = s[2]
    h3 = s[3]
    h4 = s[4]
    i = i + 64

  // Build the final padded block(s).
  let buf [u8; 128]
  let remaining i64 = len - i
  let j i64 = 0

  for j < remaining:
    buf[j] = data[i + j]
    j = j + 1

  buf[remaining] = 0x80 as u8

  // Bit length as u64 big-endian, placed at byte 56 of the last block
  // (or byte 120 of a two-block padding when remaining >= 56).
  let bit_len u64 = (len as u64) * 8
  let off i64 = 56

  if remaining >= 56:
    off = 120
  sha1_write_be64(addr(buf[0]), off, bit_len)

  // Process the final block(s).
  let s [u32; 5] = sha1_process_block(addr(buf[0]), h0, h1, h2, h3, h4)

  h0 = s[0]
  h1 = s[1]
  h2 = s[2]
  h3 = s[3]
  h4 = s[4]

  if remaining >= 56:
    let s2 [u32; 5] = sha1_process_block(addr(buf[64]), h0, h1, h2, h3, h4)

    h0 = s2[0]
    h1 = s2[1]
    h2 = s2[2]
    h3 = s2[3]
    h4 = s2[4]

  // Write digest as 20 big-endian bytes.
  let digest [u8; 20]

  sha1_write_be(addr(digest[0]), 0, h0)
  sha1_write_be(addr(digest[0]), 4, h1)
  sha1_write_be(addr(digest[0]), 8, h2)
  sha1_write_be(addr(digest[0]), 12, h3)
  sha1_write_be(addr(digest[0]), 16, h4)

  return digest

// sha1_hex_from_digest: convert a 20-byte SHA-1 digest to a 40-char hex string.
fn sha1_hex_from_digest(digest [u8; 20]) string =
  let buf [char; 40]
  let i i64 = 0

  for i < 20:
    let byte u8 = digest[i]
    let hi u8 = (byte >> 4) & 0x0f
    let lo u8 = byte & 0x0f

    if hi < 10:
      buf[i * 2] = (0x30 as u8 + hi) as char
    else:
      buf[i * 2] = (0x57 as u8 + hi) as char
    if lo < 10:
      buf[i * 2 + 1] = (0x30 as u8 + lo) as char
    else:
      buf[i * 2 + 1] = (0x57 as u8 + lo) as char
    i = i + 1

  return buf as string

fn sha1_hex(data *u8, len i64) string =
  return sha1_hex_from_digest(sha1(data, len))

// Overload: sha1(string) - convenience overload accepting a string directly.
fn sha1(s string) string =
  return sha1_hex(addr(s[0]), len(s))

export {
  sha1, sha1_hex, sha1_hex_from_digest
} as sha1
