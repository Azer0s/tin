// stdlib/db - typed CRUD over any SQL driver.
//
// Drivers expose:
//   trait Conn  - exec (no-row) and query (rows)
//   struct RowSet - concrete per-row accessor, drivers build via to_rowset
//
// CRUD generics use compile-time reflection (fieldnames / fieldtypes /
// fieldtag / getfield / setfield) to translate any struct T into SQL:
//
//   db::insert[T](c, value)
//   db::find_by_id[T](c, id)
//   db::all[T](c)
//   db::update[T](c, value)
//   db::delete[T](c, id)
//
// Default table name = struct name (typeof(v) as string).  The
// `*_in` variants take an explicit table name if you want to override.
//
// Field tags follow the json package's convention:
//   @"db:column"  - rename the column     (default: field name)
//   @"db:-"       - skip the field
//
// The PK is the field named `id` (after tag remapping).  find_by_id /
// update / delete all WHERE on it.  Multi-column PKs, joins, and
// transactions are deliberately out of scope for v1.

use rc
use str
use errors
use result
use { Result } from result

// Value: driver-agnostic param.  data-ADT with implicit lifts so call
// sites can pass bare primitives:  `c.exec("...", [id, name])`.
// Variants are prefixed (IntVal etc) so they don't collide with
// driver-side variants of the same shape (e.g. sqlite's SqlValue.Int).
data Value (implicit[i64], implicit[f64], implicit[string]) =
  IntVal(v i64)
  RealVal(v f64)
  TextVal(v string)
  NullVal

  static fn ::implicit(v i64) Value    = return IntVal(v)
  static fn ::implicit(v f64) Value    = return RealVal(v)
  static fn ::implicit(s string) Value = return TextVal(s)

// RowSet: materialised SELECT result, indexed by (row, col).
//
// Conceptually a small trait, but implemented as a concrete struct
// with function pointers.  The reason: Tin's trait fat pointer does
// not currently survive being returned inside a generic data type
// (i.e. Result[Trait, ...] discards the vtable in transit).  By
// boxing the vtable into the struct itself we sidestep the issue
// without losing the per-driver polymorphism.
//
// Drivers build a RowSet by populating `handle` with an rc-owned
// opaque buffer and `count_fn` / `get_*_fn` with their per-type
// accessors.  See sqlite::Rows::to_rowset for the canonical example.
struct RowSet =
  cell        *rc::Cell[*void]   // rc-owned driver buffer
  count_fn    fn(*void) i64
  cols_fn     fn(*void) i64
  get_i64_fn  fn(*void, i64, i64) i64
  get_f64_fn  fn(*void, i64, i64) f64
  get_str_fn  fn(*void, i64, i64) string
  is_null_fn  fn(*void, i64, i64) bool

  fn count(this RowSet) i64                            = return this.count_fn(this.cell.payload())
  fn cols(this RowSet) i64                             = return this.cols_fn(this.cell.payload())
  fn get_i64(this RowSet, row i64, col i64) i64        = return this.get_i64_fn(this.cell.payload(), row, col)
  fn get_f64(this RowSet, row i64, col i64) f64        = return this.get_f64_fn(this.cell.payload(), row, col)
  fn get_string(this RowSet, row i64, col i64) string  = return this.get_str_fn(this.cell.payload(), row, col)
  fn is_null(this RowSet, row i64, col i64) bool       = return this.is_null_fn(this.cell.payload(), row, col)

// Conn: driver connection.  exec returns sqlite-style changes() (or
// -error); query returns a RowSet trait object on success.
trait Conn =
  fn exec(this *Conn, sql string, params [Value]) i64                            = virtual
  fn query(this *Conn, sql string, params [Value]) Result[RowSet, errors::Err]   = virtual

// db_column maps a struct field to its SQL column.  An untagged field
// uses its own name; an @"db:..." tag overrides it; @"db:-" skips.
fn db_column(field_name string, tag string) string =
  if len(tag) == 0:
    return field_name
  if len(tag) <= 3 || str::strncmp(tag, "db:", 3) != 0:
    return field_name
  if len(tag) == 4 && tag[3] == @'-':
    return ""
  let key = ""
  let i i64 = 3
  for i < len(tag):
    key = key ++ tag[i]
    i = i + 1
  return key

// value_of promotes a getfield-returned `any` to a Value.  Width-
// classed integers all land in Int; floats in Real; strings in Text;
// the unit/none type maps to SQL NULL.
fn value_of(v any) Value =
  let t = typeof(v)
  if t == 'i64 || t == 'i32 || t == 'i16 || t == 'i8:
    return IntVal(v as i64)
  if t == 'f64 || t == 'f32:
    return RealVal(v as f64)
  if t == 'string:
    return TextVal(v as string)
  if t == 'none:
    return NullVal
  return NullVal

// table_for returns the default table name for T = the struct name.
fn table_for[T](v T) string = return typeof(v) as string

// row_into[T] materialises row `r` of `rows` into a fresh T using
// fieldtypes-driven dispatch.  Skipped (@"db:-") fields stay at zero.
// Column order matches the SELECT order built by build_select_cols.
fn row_into[T](rows RowSet, r i64, col_field_names [string], col_field_types [atom]) T =
  let out T
  let nf i64 = len(col_field_names)
  let c i64 = 0
  for c < nf:
    let fname string = col_field_names[c]
    let ft    atom   = col_field_types[c]
    if !rows.is_null(r, c):
      if ft == 'i64 || ft == 'i32 || ft == 'i16 || ft == 'i8:
        setfield(out, fname, rows.get_i64(r, c))
      else if ft == 'f64 || ft == 'f32:
        setfield(out, fname, rows.get_f64(r, c))
      else if ft == 'string:
        setfield(out, fname, rows.get_string(r, c))
    c = c + 1
  return out

// build_select_cols walks fieldnames once, returns:
//   col_list      - "col1, col2, ..." for SELECT / INSERT
//   field_names   - matching field-name list for row_into dispatch
fn build_select_cols[T](v T) (string, [string], [atom]) =
  let fields = fieldnames(v)
  let ftypes = fieldtypes(v)
  let nf = len(fields)
  let col_list = ""
  let field_names [string] = []
  let field_types [atom]   = []
  let written i64 = 0
  let i i64 = 0
  for i < nf:
    let fname string = fields[i] as string
    let col = db_column(fname, fieldtag(v, fname))
    if len(col) > 0:
      if written > 0:
        col_list = col_list ++ ", "
      col_list = col_list ++ col
      field_names ++= [fname]
      field_types ++= [ftypes[i]]
      written = written + 1
    i = i + 1
  return (col_list, field_names, field_types)

// pk_col returns the SQL column name of the PK (field named "id").
// Honors @"db:..." renames; returns "id" if there is no id field.
fn pk_col[T](v T) string =
  let fields = fieldnames(v)
  let i i64 = 0
  for i < len(fields):
    let fname_pk string = fields[i] as string
    if str::strcmp(fname_pk, "id") == 0:
      let col = db_column("id", fieldtag(v, "id"))
      if len(col) > 0:
        return col
      return "id"
    i = i + 1
  return "id"

// insert_into runs INSERT against an explicit table.
fn insert_into[T](c Conn, table string, v T) i64 =
  let fields = fieldnames(v)
  let nf = len(fields)
  let cols = ""
  let placeholders = ""
  let params [Value] = []
  let written i64 = 0
  let i i64 = 0
  for i < nf:
    let fname string = fields[i] as string
    let col = db_column(fname, fieldtag(v, fname))
    if len(col) > 0:
      if written > 0:
        cols = cols ++ ", "
        placeholders = placeholders ++ ", "
      cols = cols ++ col
      placeholders = placeholders ++ "?"
      params ++= [value_of(getfield(v, fname))]
      written = written + 1
    i = i + 1
  let sql = "INSERT INTO " ++ table ++ " (" ++ cols ++ ") VALUES (" ++ placeholders ++ ")"
  return c.exec(sql, params)

// insert uses table_for[T] (the struct name) as the table.
fn insert[T](c Conn, v T) i64 = return insert_into[T](c, table_for[T](v), v)

// find_by_id_in selects WHERE pk = id from an explicit table, parses
// row 0 into a T.  Returns Err on driver error or "not found".
fn find_by_id_in[T](c Conn, table string, id i64) Result[T, errors::Err] =
  let probe T
  let cf = build_select_cols[T](probe)
  let col_list    = cf.a
  let field_names = cf.b
  let field_types = cf.c
  let pk = pk_col[T](probe)
  let sql = "SELECT " ++ col_list ++ " FROM " ++ table ++ " WHERE " ++ pk ++ " = ? LIMIT 1"
  match c.query(sql, [IntVal(id)]):
    case Err(e): return Err(e)
    case Ok(rows):
      if rows.count() == 0:
        return Err(errors::new("db: not found"))
      return Ok(row_into[T](rows, 0, field_names, field_types))

// find_by_id resolves the table from the struct name.
fn find_by_id[T](c Conn, id i64) Result[T, errors::Err] =
  let probe T
  return find_by_id_in[T](c, table_for[T](probe), id)

// all_in returns every row of the table, in driver order.
fn all_in[T](c Conn, table string) Result[[T], errors::Err] =
  let probe T
  let cf = build_select_cols[T](probe)
  let col_list    = cf.a
  let field_names = cf.b
  let field_types = cf.c
  let sql = "SELECT " ++ col_list ++ " FROM " ++ table
  match c.query(sql, []):
    case Err(e): return Err(e)
    case Ok(rows):
      let n = rows.count()
      let out [T] = []
      let r i64 = 0
      for r < n:
        out ++= [row_into[T](rows, r, field_names, field_types)]
        r = r + 1
      return Ok(out)

// all uses table_for[T].
fn all[T](c Conn) Result[[T], errors::Err] =
  let probe T
  return all_in[T](c, table_for[T](probe))

// update_in runs UPDATE table SET col=?,... WHERE pk = ? against an
// explicit table.  The PK column is excluded from the SET list.
fn update_in[T](c Conn, table string, v T) i64 =
  let fields = fieldnames(v)
  let nf = len(fields)
  let pk = pk_col[T](v)
  let sets = ""
  let params [Value] = []
  let written i64 = 0
  let i i64 = 0
  for i < nf:
    let fname string = fields[i] as string
    let col = db_column(fname, fieldtag(v, fname))
    if len(col) > 0 && str::strcmp(col, pk) != 0:
      if written > 0:
        sets = sets ++ ", "
      sets = sets ++ col ++ " = ?"
      params ++= [value_of(getfield(v, fname))]
      written = written + 1
    i = i + 1
  params ++= [value_of(getfield(v, "id"))]
  let sql = "UPDATE " ++ table ++ " SET " ++ sets ++ " WHERE " ++ pk ++ " = ?"
  return c.exec(sql, params)

// update uses table_for[T].
fn update[T](c Conn, v T) i64 = return update_in[T](c, table_for[T](v), v)

// delete_in runs DELETE FROM table WHERE pk = ? against an explicit
// table.  Cheap PK-only delete; bulk delete is intentionally absent.
fn delete_in[T](c Conn, table string, id i64) i64 =
  let probe T
  let pk = pk_col[T](probe)
  let sql = "DELETE FROM " ++ table ++ " WHERE " ++ pk ++ " = ?"
  return c.exec(sql, [IntVal(id)])

// delete uses table_for[T].
fn delete[T](c Conn, id i64) i64 =
  let probe T
  return delete_in[T](c, table_for[T](probe), id)

export {
  Value, RowSet, Conn,
  db_column, value_of, table_for,
  insert, insert_into,
  find_by_id, find_by_id_in,
  all, all_in,
  update, update_in,
  delete, delete_in,
} as db
