use assert
use errors

// A custom error type that implements errors::Err and carries a
// structured kind, so we can exercise both polymorphic dispatch and
// downcast-style inspection.
data demo_kind =
  Empty
  Tag(value i64)

struct demo_err(errors::Err) =
  _kind demo_kind

  fn errors::Err::message(this demo_err) string =
    match this._kind:
      case Empty:    return "demo: empty"
      case Tag(v):   return "demo: tag {v}"

  fn kind(this demo_err) demo_kind = return this._kind

// --- value-form API ---------------------------------------------------------

test "errors::new returns a value-form Err with the given message" =
  let e = errors::new("boom")

  assert::equals("boom", e.message())
  assert::equals("boom", errors::message(e))

test "errors::wrap prepends context (value form)" =
  let inner = errors::new("disk full")
  let outer = errors::wrap(inner, "saving config")

  assert::equals("saving config: disk full", outer.message())

test "errors::equals matches by rendered message (value form)" =
  let a = errors::new("io error")
  let b = errors::new("io error")
  let c = errors::new("not the same")

  assert::ok(errors::equals(a, b))
  assert::ok(!errors::equals(a, c))

// --- pointer-form overloads (back-compat) ----------------------------------

test "errors::wrap pointer-form handles a nil inner" =
  let n *errors::Err = nil
  let e = errors::wrap(n, "lonely")

  assert::equals("lonely", (*e).message())

test "errors::is_err detects nil and non-nil pointer-form errors" =
  let n *errors::Err = nil
  let e = &errors::new("real")

  assert::ok(!errors::is_err(n))
  assert::ok(errors::is_err(e))

test "errors::equals pointer-form treats both-nil as equal" =
  let n1 *errors::Err = nil
  let n2 *errors::Err = nil

  assert::ok(errors::equals(n1, n2))

test "errors::equals pointer-form nil vs non-nil is not equal" =
  let n *errors::Err = nil
  let e = &errors::new("real")

  assert::ok(!errors::equals(n, e))
  assert::ok(!errors::equals(e, n))

test "errors::message pointer-form returns empty for nil" =
  let n *errors::Err = nil

  assert::equals("", errors::message(n))

// --- domain error widening + downcast --------------------------------------

test "domain error widens to *Err and dispatches via message()" =
  let de = &demo_err{_kind: Tag(42)}
  let as_err = de as *errors::Err

  assert::equals("demo: tag 42", errors::message(as_err))

test "domain error retains its kind for inspection" =
  let de = &demo_err{_kind: Tag(7)}

  match de.kind():
    case Tag(v): assert::equals(7, v)
    case Empty:  assert::fails("expected Tag")

test "*errors::Err downcasts back to the concrete struct" =
  // After widening a domain error to *errors::Err, callers can recover
  // the original concrete pointer with `as *demo_err` and re-read the
  // typed kind.  The cast is unchecked: it only makes sense inside the
  // matching arm of a typed Result, where the producer's signature
  // pins the dynamic type.
  let de = &demo_err{_kind: Tag(99)}
  let widened *errors::Err = de
  let back = widened as *demo_err

  match (*back).kind():
    case Tag(v): assert::equals(99, v)
    case Empty:  assert::fails("expected Tag")
