// stdlib/ioutil - high-level I/O utilities.
//
// All functions are overloaded to accept either a raw file descriptor (i32) or
// any io::AsyncReader / io::AsyncWriter. The fd overloads delegate through
// FdReader / FdWriter adapters so there is only one implementation per operation.
//
//   let line = await ioutil::read_string(conn)
//   await ioutil::write_string(conn, "response\n")
//
// All internal buffers are heap-allocated so they survive coroutine suspension.
// Reads are done in 4096-byte chunks for efficiency.

use io
use mem
use sync
use { loop } from macros

// C helpers (private runtime operations with no stdlib equivalent)
fn tin_string_data_c(s string) *byte             = extern("_tin_string_data")
fn tin_bytes_from_buf_c(ptr *byte, n i64) [byte] = extern("_tin_bytes_from_buf")

// ---------------------------------------------------------------------------
// Adapters: wrap a raw fd so it works with AsyncReader / AsyncWriter overloads.
// ---------------------------------------------------------------------------

struct FdReader (io::AsyncReader) =
  fd i32

  fn AsyncReader::read(this FdReader, buf *byte, n i64) Future[i64] =
    return spawn io::async_read(this.fd, buf, n)

struct FdWriter (io::AsyncWriter) =
  fd i32

  fn AsyncWriter::write(this FdWriter, buf *byte, n i64) Future[i64] =
    return spawn io::async_write(this.fd, buf, n)

// ---------------------------------------------------------------------------
// Internal {#async} implementations
// ---------------------------------------------------------------------------

fn{#async} read_string_until_impl(r io::AsyncReader, delim byte) string =
  let tmp  = mem::malloc(4096) as *byte
  let out  = mem::malloc(256) as *byte
  let cap  i64 = 256
  let n    i64 = 0
  let done = false

  loop:
    if done: break
    let rd = await r.read(tmp, 4096)
    if rd <= 0: break
    let i i64 = 0
    loop:
      if i >= rd: break
      if n >= cap:
        cap = cap * 2
        out = mem::realloc(out as *void, cap) as *byte
      out[n] = tmp[i]
      n = n + 1
      if delim != 0 && tmp[i] == delim:
        done = true
        break
      i = i + 1

  if delim != 0 && n > 0 && out[n-1] == delim: n = n - 1
  if delim != 0 && n > 0 && out[n-1] == @'\r': n = n - 1
  let s string = tin_bytes_from_buf_c(out, n) as string
  mem::free(tmp as *void)
  mem::free(out as *void)
  return s

fn{#async} write_string_impl(w io::AsyncWriter, s string) =
  let ptr  = tin_string_data_c(s)
  let n    = len(s)
  let sent i64 = 0

  loop:
    if sent >= n: break
    let r = await w.write(ptr + sent, n - sent)
    if r <= 0: break
    sent = sent + r

fn{#async} read_bytes_impl(r io::AsyncReader, n i64) [byte] =
  let tmp = mem::malloc(n) as *byte
  let got i64 = 0

  loop:
    if got >= n: break
    let rd = await r.read(tmp + got, n - got)
    if rd <= 0: break
    got = got + rd

  let result = tin_bytes_from_buf_c(tmp, got)
  mem::free(tmp as *void)
  return result

fn{#async} read_bytes_until_impl(r io::AsyncReader, delim byte) [byte] =
  let tmp  = mem::malloc(4096) as *byte
  let out  = mem::malloc(256) as *byte
  let cap  i64 = 256
  let n    i64 = 0
  let done = false

  loop:
    if done: break
    let rd = await r.read(tmp, 4096)
    if rd <= 0: break
    let i i64 = 0
    loop:
      if i >= rd: break
      if n >= cap:
        cap = cap * 2
        out = mem::realloc(out as *void, cap) as *byte
      out[n] = tmp[i]
      n = n + 1
      if delim != 0 && tmp[i] == delim:
        done = true
        break
      i = i + 1

  if delim != 0 && n > 0 && out[n-1] == delim: n = n - 1
  let result = tin_bytes_from_buf_c(out, n)
  mem::free(tmp as *void)
  mem::free(out as *void)
  return result

fn{#async} write_bytes_impl(w io::AsyncWriter, data [byte]) =
  let n = len(data)
  if n == 0:
    return
  let ptr  = &data[0]
  let sent i64 = 0

  loop:
    if sent >= n: break
    let r = await w.write(ptr + sent, n - sent)
    if r <= 0: break
    sent = sent + r

// ---------------------------------------------------------------------------
// Public API
// ---------------------------------------------------------------------------

// read_string_until reads from fd until delim is seen (or EOF).
// Pass 0 as delim to read until EOF.
fn read_string_until(fd i32, delim byte) Future[string] =
  return read_string_until(FdReader{fd: fd}, delim)

// read_string_until reads from an AsyncReader until delim is seen (or EOF).
fn read_string_until(r io::AsyncReader, delim byte) Future[string] =
  return spawn read_string_until_impl(r, delim)

// read_string reads a line (until newline or EOF) from a raw file descriptor.
fn read_string(fd i32) Future[string] =
  return read_string(FdReader{fd: fd})

// read_string reads a line (until newline or EOF) from any AsyncReader.
fn read_string(r io::AsyncReader) Future[string] =
  return spawn read_string_until_impl(r, @'\n')

// write_string writes s to a raw file descriptor.
fn write_string(fd i32, s string) Future[sync::Unit] =
  return write_string(FdWriter{fd: fd}, s)

// write_string writes s to any AsyncWriter.
fn write_string(w io::AsyncWriter, s string) Future[sync::Unit] =
  return spawn write_string_impl(w, s)

// read_bytes reads exactly n bytes from a raw file descriptor.
fn read_bytes(fd i32, n i64) Future[[byte]] =
  return read_bytes(FdReader{fd: fd}, n)

// read_bytes reads exactly n bytes from any AsyncReader.
fn read_bytes(r io::AsyncReader, n i64) Future[[byte]] =
  return spawn read_bytes_impl(r, n)

// read_bytes_until reads bytes from a raw file descriptor until delim (or EOF).
// The delimiter is not included in the returned slice.
fn read_bytes_until(fd i32, delim byte) Future[[byte]] =
  return read_bytes_until(FdReader{fd: fd}, delim)

// read_bytes_until reads bytes from any AsyncReader until delim (or EOF).
fn read_bytes_until(r io::AsyncReader, delim byte) Future[[byte]] =
  return spawn read_bytes_until_impl(r, delim)

// write_bytes writes a byte slice to a raw file descriptor.
fn write_bytes(fd i32, data [byte]) Future[sync::Unit] =
  return write_bytes(FdWriter{fd: fd}, data)

// write_bytes writes a byte slice to any AsyncWriter.
fn write_bytes(w io::AsyncWriter, data [byte]) Future[sync::Unit] =
  return spawn write_bytes_impl(w, data)

export {
  read_string, read_string_until, write_string,
  read_bytes, read_bytes_until, write_bytes,
} as ioutil
