// stdlib/rand - random number generation.
//
// Two tiers:
//   - `Rng` (xoshiro256**) for fast, deterministic non-cryptographic use.
//     Seedable, fork-able, ~5 ns per u64. Use for shuffling, jitter,
//     property-based tests, simulations.
//   - `secure_*` functions backed by libc `getentropy` for cryptographic
//     random bytes (keys, tokens, nonces). Slower but unguessable.
//
// ## Usage
//
//   use rand
//
//   let r = rand::new(42)              // deterministic
//   echo r.next_u64()
//   echo r.range_i64(1, 100)           // [1, 100)
//   echo r.f64()                       // [0.0, 1.0)
//
//   let r2 = rand::new_from_time()     // wall-clock seed
//
//   let key [byte; 32]
//   rand::secure_bytes(&key[0], 32)    // crypto-strength random bytes
//
// xoshiro256** is the algorithm by Blackman & Vigna (2018). State is four
// u64 words; period is 2^256 - 1. Splitmix64 expands a single user seed
// into the four state words so adjacent seeds produce uncorrelated streams.

use time

fn getentropy(buf *byte, n i64) i32 = extern("getentropy")

// Rng holds the xoshiro256** state.
struct Rng =
  s0 u64
  s1 u64
  s2 u64
  s3 u64

  // next_u64 advances the state and returns the next 64 random bits.
  fn next_u64(this *Rng) u64 =
    let result u64 = rotl(this.s1 * 5, 7) * 9
    let t u64 = this.s1 << 17
    this.s2 = this.s2 ^ this.s0
    this.s3 = this.s3 ^ this.s1
    this.s1 = this.s1 ^ this.s2
    this.s0 = this.s0 ^ this.s3
    this.s2 = this.s2 ^ t
    this.s3 = rotl(this.s3, 45)
    return result

  // next_i64 returns the next 64 random bits reinterpreted as a signed i64.
  fn next_i64(this *Rng) i64 =
    return this.next_u64() as i64

  // range_i64 returns a uniform integer in [lo, hi). Panics if hi <= lo.
  fn range_i64(this *Rng, lo i64, hi i64) i64 =
    if hi <= lo:
      panic("rand::range_i64: hi ({hi}) must be greater than lo ({lo})")
    let span u64 = (hi - lo) as u64
    let raw u64 = this.next_u64()
    let off u64 = raw % span
    return lo + (off as i64)

  // f64 returns a uniform double in [0.0, 1.0). Uses the top 53 bits of
  // a u64 so every representable double in the range is reachable.
  fn f64(this *Rng) f64 =
    let raw u64 = this.next_u64()
    let bits u64 = raw >> 11
    let f f64 = bits as f64
    return f * 1.1102230246251565e-16

  // bool returns true or false with equal probability.
  fn bool(this *Rng) bool =
    return (this.next_u64() & 1) == 1

  // fill writes n random bytes into buf. Faster than calling next_u64 in a
  // loop because it consumes 8 bytes per state advance.
  fn fill(this *Rng, buf *byte, n i64) =
    let off i64 = 0
    for off + 8 <= n:
      let v u64 = this.next_u64()
      buf[off + 0] = (v & 0xff) as byte
      buf[off + 1] = ((v >> 8) & 0xff) as byte
      buf[off + 2] = ((v >> 16) & 0xff) as byte
      buf[off + 3] = ((v >> 24) & 0xff) as byte
      buf[off + 4] = ((v >> 32) & 0xff) as byte
      buf[off + 5] = ((v >> 40) & 0xff) as byte
      buf[off + 6] = ((v >> 48) & 0xff) as byte
      buf[off + 7] = ((v >> 56) & 0xff) as byte
      off = off + 8
    if off < n:
      let v u64 = this.next_u64()
      let tail i64 = 0
      for off + tail < n:
        buf[off + tail] = ((v >> (tail * 8)) & 0xff) as byte
        tail = tail + 1

// rotl rotates x left by k bits.
fn rotl(x u64, k u64) u64 =
  return (x << k) | (x >> (64 - k))

// splitmix64 mixes a 64-bit seed deterministically. Used by `new` to expand
// a single user seed into four uncorrelated state words.
fn splitmix64(state *u64) u64 =
  *state = *state + 0x9E3779B97F4A7C15
  let z u64 = *state
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9
  z = (z ^ (z >> 27)) * 0x94D049BB133111EB
  return z ^ (z >> 31)

// new returns an Rng seeded with the given u64.
fn new(seed u64) Rng =
  let s u64 = seed
  let s0 = splitmix64(&s)
  let s1 = splitmix64(&s)
  let s2 = splitmix64(&s)
  let s3 = splitmix64(&s)
  return Rng{s0: s0, s1: s1, s2: s2, s3: s3}

// new_from_time returns an Rng seeded from the current wall-clock nanoseconds.
// Suitable for casual use; do NOT use this for crypto - the seed is guessable
// from a sufficiently accurate clock.
fn new_from_time() Rng =
  return new(time::now().ns as u64)

// new_secure returns an Rng seeded with cryptographically-strong entropy.
// The Rng itself is still xoshiro256** (not crypto-secure), but its initial
// state cannot be predicted from external observation.
fn new_secure() Rng =
  let buf [byte; 32]
  if getentropy(&buf[0], 32) != 0:
    panic("rand::new_secure: getentropy failed")
  let s0 u64 = read_u64_le(&buf[0])
  let s1 u64 = read_u64_le(&buf[8])
  let s2 u64 = read_u64_le(&buf[16])
  let s3 u64 = read_u64_le(&buf[24])
  return Rng{s0: s0, s1: s1, s2: s2, s3: s3}

// read_u64_le reads a little-endian u64 from p.
fn read_u64_le(p *byte) u64 =
  let v u64 = 0
  let i i64 = 0
  for i < 8:
    v = v | ((p[i] as u64) << (i * 8))
    i = i + 1
  return v

// secure_bytes fills buf with n cryptographically-strong random bytes via
// libc getentropy(3). Returns true on success, false on syscall failure
// (rare; typically only happens on extremely constrained kernels).
//
// getentropy fills at most 256 bytes per call, so larger requests loop.
fn secure_bytes(buf *byte, n i64) bool =
  let off i64 = 0
  for off < n:
    let chunk i64 = n - off
    if chunk > 256:
      chunk = 256
    if getentropy(&buf[off], chunk) != 0:
      return false
    off = off + chunk
  return true

// secure_u64 returns one cryptographically-strong random u64. Panics on
// underlying syscall failure; callers who need to recover gracefully should
// use secure_bytes directly.
fn secure_u64() u64 =
  let buf [byte; 8]
  if !secure_bytes(&buf[0], 8):
    panic("rand::secure_u64: getentropy failed")
  return read_u64_le(&buf[0])

export {
  Rng,
  new,
  new_from_time,
  new_secure,
  secure_bytes,
  secure_u64,
} as rand
