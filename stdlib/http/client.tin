// stdlib/http/client.tin - HTTP/1.x async client.
//
// Two usage patterns:
//
//   // Default client (no setup needed):
//   let resp = await http::get("https://httpbin.org/get")
//
//   // Custom client (reusable headers, future: pooling):
//   let c = http::Client::new()
//   c.set_header("authorization", "Bearer token")
//   let resp = await http::get(c, "https://httpbin.org/get")
//   c.free()
//
//   // Explicit request:
//   let req = http::Request{method: "PUT", url: "...", body: "data"}
//   let resp = await http::send(req)
//   let resp2 = await http::send(c, req)

use strings
use collections
use ioutil
use net::tcp
use tls
use io
use result
use { loop } from macros
use "./http_parser"

// Client holds per-client configuration applied to every request it makes.
struct Client =
  headers collections::HashMap[string, string]

  static fn new() Client =
    return Client{
      headers: collections::HashMap[string, string]::make(4),
    }

  fn set_header(this *Client, k string, v string) =
    this.headers.set(k, v)

// Request describes an outgoing HTTP request.
struct Request =
  method  string
  url     string
  headers collections::HashMap[string, string]
  body    string

// parse_url splits a URL into (use_tls, host, port, path).
// Defaults: http -> port 80, https -> port 443, path -> "/".
fn parse_url(url string) (bool, string, i32, string) =
  let use_tls = false
  let port i32 = 80
  let rest = url

  if strings::has_prefix(url, "https://"):
    use_tls = true
    port = 443
    rest = strings::substr(url, 8, len(url))
  else if strings::has_prefix(url, "http://"):
    rest = strings::substr(url, 7, len(url))

  let slash = strings::index_of(rest, "/")
  let host_part = rest
  let path = "/"

  if slash >= 0:
    host_part = strings::substr(rest, 0, slash)
    path = strings::substr(rest, slash, len(rest))

  let host = host_part
  let colon = strings::index_of(host_part, ":")

  if colon >= 0:
    host = strings::substr(host_part, 0, colon)
    let port_str = strings::substr(host_part, colon + 1, len(host_part))
    let (p, perr) = strings::parse_int32(port_str)

    if perr == nil && p > 0:
      port = p

  return (use_tls, host, port, path)

// header_value_safe rejects any byte that could be used to terminate a
// header line and inject a second one, plus any other byte RFC 7230
// forbids in a field-value.  RFC 7230 sec 3.2.6 limits field-value
// characters to VCHAR / SP / HTAB; CR (0x0D), LF (0x0A), NUL (0x00),
// the rest of the C0 control range (0x01-0x1F minus HTAB 0x09), and
// DEL (0x7F) are all illegal.  Some intermediaries terminate parsing
// at any C0 byte and produce surprising downstream behaviour.  Used
// to gate caller-supplied keys, values, host, and path before they
// are spliced into the wire format.  Returns true when the value is
// safe to emit.
fn header_value_safe(s string) bool =
  let i i64 = 0

  for i < len(s):
    let c = s[i] as byte
    let cb = c as i64

    // Allow SP (0x20) through 0x7E, plus HTAB (0x09).  Reject every
    // other control byte and DEL.
    if c == @'\t':
      i = i + 1
    else if cb < 0x20 || cb == 0x7F:
      return false
    else:
      i = i + 1

  return true

// build_request serializes a request to HTTP/1.1 wire format.
// client_hdrs are applied first; request hdrs override them on conflict.
// Panics on any header / method / path / host that contains CR, LF, or
// NUL -- that combination would let an attacker who controls a single
// field smuggle a second request or split the response.
fn build_request(method string, host string, path string, client_hdrs collections::HashMap[string, string], req_hdrs collections::HashMap[string, string], body string) string =
  if !header_value_safe(method): panic("http: method contains CR/LF/NUL")
  if !header_value_safe(host):   panic("http: host contains CR/LF/NUL")
  if !header_value_safe(path):   panic("http: path contains CR/LF/NUL")

  // Request line and fixed headers.
  let req = method ++ " " ++ path ++ " HTTP/1.1\r\n"
  req = req ++ "Host: " ++ host ++ "\r\n"
  req = req ++ "Connection: close\r\n"

  if len(body) > 0:
    req = req ++ "Content-Length: {len(body)}\r\n"

  // Client-level headers (skipped if the request overrides them).
  let cks = client_hdrs.keys()
  let i i64 = 0

  for i < len(cks):
    let k = cks[i]

    if !req_hdrs.has(k):
      let v = client_hdrs.get(k)

      if !header_value_safe(k) || !header_value_safe(v):
        panic("http: header contains CR/LF/NUL")
      req = req ++ k ++ ": " ++ v ++ "\r\n"
    i = i + 1

  // Per-request headers.
  let rks = req_hdrs.keys()
  let j i64 = 0

  for j < len(rks):
    let k = rks[j]
    let v = req_hdrs.get(k)

    if !header_value_safe(k) || !header_value_safe(v):
      panic("http: header contains CR/LF/NUL")
    req = req ++ k ++ ": " ++ v ++ "\r\n"
    j = j + 1

  req = req ++ "\r\n"

  if len(body) > 0:
    req = req ++ body

  return req

// parse_hex parses a lowercase or uppercase hex string to a non-negative
// i64.  Stops at the first non-hex character (chunk size extensions).
// Returns -1 if the parsed value would exceed i64::MAX (overflow) or if
// the string contains no leading hex digit; callers must reject the
// chunk in that case rather than treating it as size 0.
fn parse_hex_checked(s string) i64 =
  let result i64 = 0
  let i i64 = 0
  let saw = false

  for i < len(s):
    let c = s[i] as byte
    let d i64 = -1

    if c >= @'0' && c <= @'9':
      d = (c - @'0') as i64
    else if c >= @'a' && c <= @'f':
      d = ((c - @'a') as i64) + 10
    else if c >= @'A' && c <= @'F':
      d = ((c - @'A') as i64) + 10
    else:
      break

    saw = true

    // i64::MAX / 16 = 576460752303423487
    if result > 576460752303423487:
      return -1
    result = result * 16 + d
    i = i + 1

  if !saw:
    return -1

  return result

// decode_chunked decodes a Transfer-Encoding: chunked body.  Returns
// "" on any malformed chunk header so a hostile server can't either
// (a) force an overflowed-then-truncated chunk size that drives an
// out-of-bounds substr, or (b) silently terminate the response early
// with garbage data.
fn decode_chunked(data string) string =
  let result = ""
  let i i64 = 0
  let n = len(data)

  loop:
    let j = i

    for j < n - 1:
      if data[j] == @'\r' && data[j+1] == @'\n':
        break
      j = j + 1

    if j >= n - 1:
      break
    let chunk_size = parse_hex_checked(strings::substr(data, i, j))

    if chunk_size < 0:
      // Malformed chunk header (overflow or no hex digits).  Drop the
      // partial result rather than returning an attacker-controllable
      // truncation.
      return ""
    if chunk_size == 0:
      // RFC 7230 chunk-end marker.
      break
    i = j + 2

    if i + chunk_size > n:
      break
    result = result ++ strings::substr(data, i, i + chunk_size)
    i = i + chunk_size + 2

  return result

// read_all reads all bytes from r until EOF, returning them as a string.
fn{#async} read_all(r io::AsyncReader) string =
  let acc = ""

  loop:
    let chunk = await ioutil::read_bytes(r, 4096)

    if len(chunk) == 0:
      break
    let s string = chunk as string

    acc = acc ++ s

  return acc

// do_with_client dials the server, merges client + request headers,
// sends the request, reads the full response, and closes the connection.
// On dial / TLS-handshake failure surfaces a 5xx HttpResponse rather
// than a Result; the public API contract is that callers always get
// a response object.
//
// The match-arm-assign pattern below would be cleaner as `try`, but
// `try` inside an {#async} function whose return type is HttpResponse
// (not Result) requires wildcard mono with a non-Result target — that
// path is not wired up. For now, match.
fn{#async} do_with_client(client Client, r Request) HttpResponse =
  let (use_tls, host, port, path) = parse_url(r.url)
  let req_str = build_request(r.method, host, path, client.headers, r.headers, r.body)

  let conn tcp::Conn = tcp::Conn{_fd_cell: nil}
  match tcp::dial(host, port):
    case Ok(c): conn = c
    case Err(_):
      return HttpResponse{
        status:  500 as HttpStatus,
        headers: collections::HashMap[string, string]::make(1),
      }

  let raw = ""

  if use_tls:
    let tls_res = await tls::connect(host, conn.fd())
    match tls_res:
      case Ok(tls_conn):
        await ioutil::write_string(tls_conn, req_str)
        raw = await spawn read_all(tls_conn)
        tls_conn.close()
      case Err(_):
        // Surface the handshake failure as a 502 Bad Gateway -- the
        // upstream is unreachable from this client's perspective and
        // the user already gets the error text via the response.  Pre-
        // fix tls::connect panicked the whole program on a cert /
        // SNI / chain failure, which is wrong for any client that
        // intends to retry, fall back, or report the issue.
        conn.close()
        return HttpResponse{
          status:  502 as HttpStatus,
          headers: collections::HashMap[string, string]::make(1),
        }
  else:
    await ioutil::write_string(conn, req_str)
    raw = await spawn read_all(conn)

  conn.close()

  // Parse response and handle chunked transfer encoding.
  let resp = parse_response(raw)
  let te = strings::to_lower(resp.headers.get_or("transfer-encoding", ""))

  if strings::contains(te, "chunked"):
    return HttpResponse{
      version: resp.version,
      status:  resp.status,
      reason:  resp.reason,
      headers: resp.headers,
      body:    decode_chunked(resp.body),
    }

  return resp

// empty_client returns a zero-header Client without allocation.
fn empty_client() Client =
  return Client{headers: collections::HashMap[string, string]::make(1)}

// send performs the request r using the default client.
fn send(r Request) Future[HttpResponse] =
  return spawn do_with_client(empty_client(), r)

// send performs the request r using the provided client's configuration.
fn send(client Client, r Request) Future[HttpResponse] =
  return spawn do_with_client(client, r)

// get performs an HTTP GET using the default client.
fn get(url string) Future[HttpResponse] =
  let req = Request{method: "GET", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(empty_client(), req)

// get performs an HTTP GET using the provided client.
fn get(client Client, url string) Future[HttpResponse] =
  let req = Request{method: "GET", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(client, req)

// post performs an HTTP POST using the default client.
fn post(url string, body string) Future[HttpResponse] =
  let req = Request{method: "POST", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(empty_client(), req)

// post performs an HTTP POST using the provided client.
fn post(client Client, url string, body string) Future[HttpResponse] =
  let req = Request{method: "POST", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(client, req)

// post_json performs an HTTP POST with a JSON body using the default client.
fn post_json(url string, body string) Future[HttpResponse] =
  let hdrs = collections::HashMap[string, string]::make(2)

  hdrs.set("content-type", "application/json")
  let req = Request{method: "POST", url: url, headers: hdrs, body: body}

  return spawn do_with_client(empty_client(), req)

// post_json performs an HTTP POST with a JSON body using the provided client.
fn post_json(client Client, url string, body string) Future[HttpResponse] =
  let hdrs = collections::HashMap[string, string]::make(2)

  hdrs.set("content-type", "application/json")
  let req = Request{method: "POST", url: url, headers: hdrs, body: body}

  return spawn do_with_client(client, req)

// put performs an HTTP PUT using the default client.
fn put(url string, body string) Future[HttpResponse] =
  let req = Request{method: "PUT", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(empty_client(), req)

// put performs an HTTP PUT using the provided client.
fn put(client Client, url string, body string) Future[HttpResponse] =
  let req = Request{method: "PUT", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(client, req)

// patch performs an HTTP PATCH using the default client.
fn patch(url string, body string) Future[HttpResponse] =
  let req = Request{method: "PATCH", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(empty_client(), req)

// patch performs an HTTP PATCH using the provided client.
fn patch(client Client, url string, body string) Future[HttpResponse] =
  let req = Request{method: "PATCH", url: url, headers: collections::HashMap[string, string]::make(1), body: body}
  return spawn do_with_client(client, req)

// delete performs an HTTP DELETE using the default client.
fn delete(url string) Future[HttpResponse] =
  let req = Request{method: "DELETE", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(empty_client(), req)

// delete performs an HTTP DELETE using the provided client.
fn delete(client Client, url string) Future[HttpResponse] =
  let req = Request{method: "DELETE", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(client, req)

// head performs an HTTP HEAD using the default client.
fn head(url string) Future[HttpResponse] =
  let req = Request{method: "HEAD", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(empty_client(), req)

// head performs an HTTP HEAD using the provided client.
fn head(client Client, url string) Future[HttpResponse] =
  let req = Request{method: "HEAD", url: url, headers: collections::HashMap[string, string]::make(1), body: ""}
  return spawn do_with_client(client, req)
