// stdlib/http/http_parser.tin - HTTP/1.x request and response parser.
//
// Provides:
//   HttpStatus         - i32 enum of common HTTP status codes
//   HttpRequest        - parsed HTTP request
//   HttpResponse       - parsed HTTP response
//   headers_complete   - scan for end-of-headers, return body start offset or -1
//   parse_request      - parse a full HTTP request from a buffer
//   parse_response     - parse a full HTTP response from a buffer
//
// Header keys are lowercased and trimmed. Values are trimmed.
// Body is sliced from the body-start offset; if Content-Length is present its
// value caps the body length (excess bytes are ignored).

use strings
use collections

// HttpStatus holds common HTTP status codes as named i32 constants.
enum i32 HttpStatus =
  // 1xx Informational
  continue_100:            100
  switching_protocols:     101
  // 2xx Success
  ok:                      200
  created:                 201
  accepted:                202
  no_content:              204
  partial_content:         206
  // 3xx Redirection
  moved_permanently:       301
  found:                   302
  not_modified:            304
  temporary_redirect:      307
  permanent_redirect:      308
  // 4xx Client Error
  bad_request:             400
  unauthorized:            401
  forbidden:               403
  not_found:               404
  method_not_allowed:      405
  not_acceptable:          406
  request_timeout:         408
  conflict:                409
  gone:                    410
  length_required:         411
  payload_too_large:       413
  uri_too_long:            414
  unsupported_media_type:  415
  too_many_requests:       429
  // 5xx Server Error
  internal_server_error:   500
  not_implemented:         501
  bad_gateway:             502
  service_unavailable:     503
  gateway_timeout:         504

struct HttpRequest =
  method  string
  path    string
  version string
  headers collections::HashMap[string, string]
  body    string

struct HttpResponse =
  version string
  status  HttpStatus
  reason  string
  headers collections::HashMap[string, string]
  body    string

// headers_complete scans buf for the end-of-headers separator.
// Returns the byte offset of the first body byte, or -1 if not found.
// Recognises both \r\n\r\n (HTTP/1.x standard) and \n\n (lenient).
fn headers_complete(buf string) i64 =
  let n = len(buf)
  let i i64 = 0

  for i < n - 3:
    if buf[i] == @'\r' && buf[i+1] == @'\n' &&
       buf[i+2] == @'\r' && buf[i+3] == @'\n':
      return i + 4

    i = i + 1

  i = 0

  for i < n - 1:
    if buf[i] == @'\n' && buf[i+1] == @'\n':
      return i + 2
    i = i + 1

  return -1

// line_end returns the index of the first \r or \n at or after pos,
// capped at limit.
fn line_end(buf string, pos i64, limit i64) i64 =
  let i = pos

  for i < limit:
    if buf[i] == @'\r' || buf[i] == @'\n':
      return i
    i = i + 1

  return limit

// skip_newline advances past the \r\n or \n at pos.
fn skip_newline(buf string, pos i64, limit i64) i64 =
  if pos < limit && buf[pos] == @'\r' && pos + 1 < limit && buf[pos+1] == @'\n':
    return pos + 2
  if pos < limit && buf[pos] == @'\n':
    return pos + 1

  return pos

// parse_headers parses header lines from buf[start..end_pos) into a HashMap.
// end_pos is the start of the blank line (i.e. the \r\n before \r\n, not
// including the separator itself).
fn parse_headers(buf string, start i64, end_pos i64) collections::HashMap[string, string] =
  let headers = collections::HashMap[string, string]::make(16)
  let i = start

  for i < end_pos:
    let eol = line_end(buf, i, end_pos)

    if eol > i:
      let line = strings::substr(buf, i, eol)
      let colon = strings::index_of(line, ":")

      if colon > 0:
        let k = strings::to_lower(strings::trim(strings::substr(line, 0, colon)))
        let v = strings::trim(strings::substr(line, colon + 1, len(line)))

        headers.set(k, v)

    i = skip_newline(buf, eol, end_pos)

    if i == eol:
      i = eol + 1

  return headers

// clip_body returns at most content_length bytes from body, or body itself
// if content_length is negative (no Content-Length header).
fn clip_body(body string, content_length i64) string =
  if content_length < 0:
    return body
  let blen = len(body)

  if content_length >= blen:
    return body

  return strings::substr(body, 0, content_length)

// content_length reads the "content-length" header value, or returns -1.
fn content_length(headers collections::HashMap[string, string]) i64 =
  if !headers.has("content-length"):
    return -1
  let (v, err) = strings::parse_int(headers.get("content-length"))

  if err != nil:
    return -1

  return v

// parse_request parses an HTTP/1.x request from buf.
// Returns a zero-value HttpRequest if the request line is malformed.
fn parse_request(buf string) HttpRequest =
  let body_start = headers_complete(buf)
  let header_zone = buf
  let body_raw    = ""

  if body_start >= 0:
    header_zone = strings::substr(buf, 0, body_start)
    body_raw    = strings::substr(buf, body_start, len(buf))

  // First line: METHOD path version
  let n = len(header_zone)
  let eol = line_end(header_zone, 0, n)
  let first = strings::substr(header_zone, 0, eol)
  let parts = strings::split(first, " ")

  let method  = ""
  let path    = ""
  let version = ""

  if len(parts) >= 1:
    method = parts[0]
  if len(parts) >= 2:
    path = parts[1]
  if len(parts) >= 3:
    version = parts[2]

  // Headers: start after the first-line newline; parse up to end of header_zone.
  let hdr_start = skip_newline(header_zone, eol, n)
  let headers = parse_headers(header_zone, hdr_start, n)

  let cl = content_length(headers)
  let body = clip_body(body_raw, cl)

  return HttpRequest{
    method:  method,
    path:    path,
    version: version,
    headers: headers,
    body:    body
  }

// parse_response parses an HTTP/1.x response from buf.
// Returns a zero-value HttpResponse if the status line is malformed.
fn parse_response(buf string) HttpResponse =
  let body_start = headers_complete(buf)
  let header_zone = buf
  let body_raw    = ""

  if body_start >= 0:
    header_zone = strings::substr(buf, 0, body_start)
    body_raw    = strings::substr(buf, body_start, len(buf))

  // First line: HTTP/version STATUS reason phrase
  let n = len(header_zone)
  let eol = line_end(header_zone, 0, n)
  let first = strings::substr(header_zone, 0, eol)

  // Split on first space: version | rest; split rest on first space: code | reason
  let sp1 = strings::index_of(first, " ")
  let version = ""
  let status_code i32 = 0
  let reason = ""

  if sp1 >= 0:
    version = strings::substr(first, 0, sp1)
    let rest = strings::substr(first, sp1 + 1, len(first))
    let sp2 = strings::index_of(rest, " ")

    if sp2 >= 0:
      let (code, _) = strings::parse_int32(strings::substr(rest, 0, sp2))
      status_code = code
      reason = strings::trim(strings::substr(rest, sp2 + 1, len(rest)))
    else:
      let (code, _) = strings::parse_int32(rest)
      status_code = code

  let hdr_start = skip_newline(header_zone, eol, n)
  let headers = parse_headers(header_zone, hdr_start, n)

  let cl = content_length(headers)
  let body = clip_body(body_raw, cl)

  return HttpResponse{
    version: version,
    status:  status_code as HttpStatus,
    reason:  reason,
    headers: headers,
    body:    body
  }
