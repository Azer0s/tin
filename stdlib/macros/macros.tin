// stdlib/macros - Standard macro library
//
// Import with: use macros
// Selective import: use { loop, min!, max! } from macros
//
// #no_parens macros require selective import: use { loop } from macros
// Regular macros work with selective import: use { min! } from macros

// loop - infinite loop via literal token substitution.
// #no_parens means bare `loop` expands to `for true` in the token stream.
macro{#no_parens #no_excl} loop() = `for true`

// async - shorthand for `fn{#async}`.
// Write `async foo(x i32) i32 =` instead of `fn{#async} foo(x i32) i32 =`.
macro{#no_parens #no_excl} async() = `fn{#async}`

// discard - explicitly ignore the value of an expression.  Expands to
// `let _ =`, so `discard make()` reads as a deliberate drop and side-
// steps the awkwardness of repeating `let _ =` (or burning fresh names
// like `_2`, `_3`) when several throwaway calls sit next to each other.
macro{#no_parens #no_excl} discard() = `let _ =`

// unsafe - shorthand for `do{#unsafe}` block prefix.
// `unsafe:` expands to `do{#unsafe}:` so the rest of the indented body
// inherits the unsafe context (pointer arithmetic, addr(int)).
macro{#no_parens #no_excl} unsafe() = `do{#unsafe}`

// todo!() - panic with "not yet implemented" at the call site.
macro todo!() = `panic("not yet implemented")`

// unreachable!() - panic indicating code should never be reached.
macro unreachable!() = `panic("unreachable")`

// min!(a, b) - minimum of two comparable values.
macro min!(a, b) = return a < b ? a : b

// max!(a, b) - maximum of two comparable values.
macro max!(a, b) = return a > b ? a : b

// abs!(x) - absolute value.
macro abs!(x) = return x < 0 ? -x : x

// clamp!(x, lo, hi) - clamp x to [lo, hi].
macro clamp!(x, lo, hi) = return x < lo ? lo : (x > hi ? hi : x)

// dbg!(x) - identity: returns x unchanged (placeholder for debug tracing).
macro dbg!(x) = `x`

// run is an alias for `await spawn`
macro{#no_parens #no_excl} run() = `await spawn`

// try!(r) - Rust-style early-return for Result[t, e]. Inside a function whose
// return type is Result[u, e], `let v = try!(r)` evaluates r once: on Ok(v) it
// binds the inner value and continues, on Err it propagates `Err(e)` up by
// returning from the enclosing function.
//
//   fn double(s string) Result[i64, string] =
//     let n i64 = try!(parse_pos(s))
//     return Ok(n * 2)
macro try!(r) = `match {r}:
  case Ok(v):  v
  case Err(e): return Err(e)`

// try_some!(o) - Option[t] analog of try!. On Some(v) yields v; on None
// returns from the enclosing function with None.
//
//   fn first_doubled(xs [i64]) Option[i64] =
//     let n i64 = try_some!(first(xs))
//     return Some(n * 2)
macro try_some!(o) = `match {o}:
  case Some(v): v
  case None:    return None`

export {
  loop, async, discard, unsafe,
  todo!, unreachable!,
  min!, max!, abs!, clamp!,
  dbg!,
  try!, try_some!
} as macros
