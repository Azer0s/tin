// stdlib/limits - minimum and maximum values for all Tin numeric types.
//
// Integer min/max follow two's-complement semantics.
// Float "MAX" is the largest finite value; "MIN_POS" is the smallest positive
// normal value (not the most negative).
//
// Usage:
//   use limits
//   echo limits::I64_MAX   // 9223372036854775807
//   echo limits::U128_MAX  // 340282366920938463463374607431768211455

// i8 / u8

const I8_MIN  i8 = -128
const I8_MAX  i8 = 127
const U8_MIN  u8 = 0
const U8_MAX  u8 = -1 as u8   // 0xFF = 255

// i16 / u16

const I16_MIN i16 = -32768
const I16_MAX i16 = 32767
const U16_MIN u16 = 0
const U16_MAX u16 = -1 as u16  // 0xFFFF = 65535

// i32 / u32

const I32_MIN i32 = -2147483648
const I32_MAX i32 = 2147483647
const U32_MIN u32 = 0
const U32_MAX u32 = -1 as u32  // 0xFFFFFFFF = 4294967295

// i64 / u64
//
// Note: the literal 9223372036854775808 overflows int64, so I64_MIN is
// expressed as -(max) - 1 to avoid the overflow at parse time.

const I64_MIN i64 = -9223372036854775807 - 1
const I64_MAX i64 = 9223372036854775807
const U64_MIN u64 = 0
const U64_MAX u64 = -1 as u64  // 0xFFFFFFFF_FFFFFFFF

// i128 / u128
//
// I128_MIN = -2^127: set only the sign bit via left-shift.
// I128_MAX = 2^127 - 1: bitwise NOT of I128_MIN.
// U128_MAX = 2^128 - 1: bitwise NOT of 0.

const I128_MIN i128 = 1 as i128 << 127
const I128_MAX i128 = ~(1 as i128 << 127)
const U128_MIN u128 = 0 as u128
const U128_MAX u128 = ~(0 as u128)

// f32 / f64
//
// MAX is the largest finite value.
// MIN_POS is the smallest positive normal value (not -MAX).

const F32_MAX     f32 = 3.40282347e+38
const F32_MIN_POS f32 = 1.17549435e-38
const F64_MAX     f64 = 1.7976931348623157e+308
const F64_MIN_POS f64 = 2.2250738585072014e-308

export {
  I8_MIN,  I8_MAX,
  U8_MIN,  U8_MAX,
  I16_MIN, I16_MAX,
  U16_MIN, U16_MAX,
  I32_MIN, I32_MAX,
  U32_MIN, U32_MAX,
  I64_MIN, I64_MAX,
  U64_MIN, U64_MAX,
  I128_MIN, I128_MAX,
  U128_MIN, U128_MAX,
  F32_MAX, F32_MIN_POS,
  F64_MAX, F64_MIN_POS
} as limits
