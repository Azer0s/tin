//!+udp.c -- -I ../../runtime
// stdlib/udp - UDP socket types.
//
// Mirrors the tcp package but uses datagrams instead of streams:
//
//   let srv = udp::listen(8082)
//   let (c, ok) = await srv.accept(65536)
//   await c.write(c.data)                 // echo the received datagram back
//
// For a connected client:
//   let c = udp::dial("127.0.0.1", 8082)
//   await c.write(buf, n)
//   let got = await ioutil::read_bytes(c, 4096)

use { loop } from macros
use io
use sync

// C helpers (private)
fn _tin_udp_listen_c(port i32) i32                                                     = extern("_tin_udp_listen")
fn _tin_udp_connect_c(host string, port i32) i32                                       = extern("_tin_udp_connect")
fn _tin_udp_recvfrom_c(fd i32, buf *byte, n i64, host_out *string, port_out *i32) i64  = extern("_tin_udp_recvfrom")
fn _tin_udp_sendto_c(fd i32, buf *byte, n i64, host string, port i32) i64              = extern("_tin_udp_sendto")
fn _tin_io_blocked_val_c() i64                                                         = extern("_tin_io_blocked_val")
fn _tin_bytes_from_buf_c(ptr *byte, n i64) [byte]                                      = extern("_tin_bytes_from_buf")

// Internal async implementations

fn{#async} recv_from_impl(fd i32) ([byte], string, i32) =
  let blocked      = _tin_io_blocked_val_c()
  let buf [byte; 65536]
  let host         = ""
  let port i32     = 0
  loop:
    let r = _tin_udp_recvfrom_c(fd, &buf[0], 65536, &host, &port)
    if r != blocked:
      let sz = r
      if sz < 0: sz = 0
      let data = _tin_bytes_from_buf_c(&buf[0], sz)
      return (data, host, port)
    yield

fn{#async} accept_impl(fd i32) (Conn, bool) =
  let (data, host, port) = await spawn recv_from_impl(fd)
  if len(data) == 0:
    return (Conn{fd: fd, host: "", port: 0, data: [], owns_fd: false}, false)
  return (Conn{fd: fd, host: host, port: port, data: data, owns_fd: false}, true)

fn{#async} send_to_raw_impl(fd i32, buf *byte, n i64, host string, port i32) i64 =
  let blocked = _tin_io_blocked_val_c()
  loop:
    let r = _tin_udp_sendto_c(fd, buf, n, host, port)
    if r != blocked:
      return r
    yield

fn{#async} send_to_impl(fd i32, data [byte], host string, port i32) i64 =
  if len(data) == 0:
    return 0
  return await spawn send_to_raw_impl(fd, &data[0], len(data), host, port)

// Conn is a UDP connection returned by either Server.accept or udp::dial.
// For accept-based Conn, c.data holds the received datagram; write sends back to the sender.
// For dial-based Conn, implements io::AsyncReader and io::AsyncWriter.
struct Conn (io::AsyncReader, io::AsyncWriter) =
  fd      i32
  host    string
  port    i32
  data    [byte]  // datagram received during accept (empty for dial-based Conn)
  owns_fd bool    // false for accept-based (server fd is shared); true for dial-based

  fn read(this Conn, buf *byte, n i64) Future[i64] =
    return spawn io::async_read(this.fd, buf, n)

  // write sends buf[0..n] to the peer (AsyncWriter interface).
  fn write(this Conn, buf *byte, n i64) Future[i64] =
    return spawn send_to_raw_impl(this.fd, buf, n, this.host, this.port)

  // write sends data to the peer (slice convenience overload).
  fn write(this Conn, data [byte]) Future[i64] =
    return spawn send_to_impl(this.fd, data, this.host, this.port)

  fn close(this Conn) =
    if this.owns_fd:
      io::close(this.fd)

  fn valid(this Conn) bool =
    return this.fd >= 0

// Server listens for incoming UDP datagrams.
// Create with udp::listen(port).
struct Server =
  fd i32

  // accept waits for the next datagram and returns a Conn to the sender.
  fn accept(this Server) Future[(Conn, bool)] =
    return spawn accept_impl(this.fd)

  fn close(this Server) =
    io::close(this.fd)

// listen creates a bound UDP socket on the given port.
// Panics if the port cannot be bound.
fn listen(port i32) Server =
  let fd = _tin_udp_listen_c(port)
  if fd < 0:
    panic("udp::listen: failed to bind port {port}")
  return Server{fd: fd}

// dial creates a connected UDP socket to host:port.
// Panics on failure.
fn dial(host string, port i32) Conn =
  let fd = _tin_udp_connect_c(host, port)
  if fd < 0:
    panic("udp::dial: failed to connect to {host}:{port}")
  return Conn{fd: fd, host: host, port: port, data: [], owns_fd: true}

export { Server, Conn, listen, dial } as udp
