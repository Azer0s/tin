// stdlib/units/si - base + common SI literal suffixes.
//
// Lengths are normalised to metres, masses to grams, currents to amps,
// temperatures to kelvin, amounts to moles, luminous intensities to
// candelas.  Output type is f64.
//
//   use { km, m, mm, kg, mg, A, mA, K, mol, cd } from units::si
//
//   let dist = 5.0_km            // 5000.0
//   let mass = 250_mg            // 0.25 (f64)

macro{#suffix@float #no_excl #no_parens} m(n)   = `{n}`
macro{#suffix@float #no_excl #no_parens} mm(n)  = `{n * 0.001}`
macro{#suffix@float #no_excl #no_parens} cm(n)  = `{n * 0.01}`
macro{#suffix@float #no_excl #no_parens} km(n)  = `{n * 1000.0}`

macro{#suffix@int #suffix@float #no_excl #no_parens} g(n)   = `{n} as f64`
macro{#suffix@int #suffix@float #no_excl #no_parens} mg(n)  = `({n} as f64) * 0.001`
macro{#suffix@int #suffix@float #no_excl #no_parens} ug(n)  = `({n} as f64) * 0.000001`
macro{#suffix@int #suffix@float #no_excl #no_parens} kg(n)  = `({n} as f64) * 1000.0`

macro{#suffix@float #no_excl #no_parens} A(n)   = `{n}`
macro{#suffix@float #no_excl #no_parens} mA(n)  = `{n * 0.001}`

macro{#suffix@float #no_excl #no_parens} K(n)   = `{n}`
macro{#suffix@float #no_excl #no_parens} mol(n) = `{n}`
macro{#suffix@float #no_excl #no_parens} cd(n)  = `{n}`

export {
  m, mm, cm, km,
  g, mg, ug, kg,
  A, mA,
  K, mol, cd,
} as si
