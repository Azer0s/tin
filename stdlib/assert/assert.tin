// stdlib/assert - test assertion helpers for use with `test` blocks
//
// abort is the only native primitive: it prints "FAILED", writes msg to
// stderr, then longjmps back to the test runner (or exit(1) standalone)
// All assertion logic is implemented in Tin

fn abort(msg string) = extern("_tin_assert_abort")

fn ok(cond bool) =
  if !cond :
    abort("assertion failed: expected true")

fn not_ok(cond bool) =
  if cond :
    abort("assertion failed: expected false")

fn equals[t](expected t, actual t) where t is comp =
  if expected != actual :
    abort("expected {expected}, got {actual}")

fn not_equals(a i64, b i64) =
  if a == b :
    abort("expected values to differ, both were {a}")

fn fails(msg string) =
  abort(msg)

fn panics(f fn() void) =
  let did_panic bool = false

  defer do:
    let msg string = recover()

    if len(msg) > 0 :
      did_panic = true

  f()

  if !did_panic :
    abort("expected panic but none occurred")

// panics_with is like panics but additionally checks that the panic
// message contains `want_substr`. Used to lock down the wording of a
// specific panic so a refactor that silently changes the surface text
// fails the test.
fn panics_with(f fn() void, want_substr string) =
  let did_panic bool = false
  let captured string = ""

  defer do:
    let msg string = recover()

    if len(msg) > 0 :
      did_panic = true
      captured = msg

  f()

  if !did_panic :
    abort("expected panic but none occurred")

  let found = false
  let i i64 = 0
  let n = len(captured)
  let m = len(want_substr)

  for i + m <= n:
    let j i64 = 0
    let hit = true

    for j < m:
      if captured[i + j] != want_substr[j]:
        hit = false

        break
      j = j + 1

    if hit:
      found = true

      break
    i = i + 1

  if !found:
    abort("expected panic to contain {want_substr}, got: {captured}")

export {
  ok, not_ok, equals, not_equals,
  fails, panics, panics_with
} as assert
