// stdlib/assert - test assertion helpers for use with `test` blocks
//
// abort is the only native primitive: it prints "FAILED", writes msg to
// stderr, then longjmps back to the test runner (or exit(1) standalone)
// All assertion logic is implemented in Tin

fn abort(msg string) = extern("_tin_assert_abort")

fn ok(cond bool) =
  if !cond :
    abort("assertion failed: expected true")

fn not_ok(cond bool) =
  if cond :
    abort("assertion failed: expected false")

fn equals(expected i64, actual i64) =
  if expected != actual :
    abort("expected {expected}, got {actual}")

fn not_equals(a i64, b i64) =
  if a == b :
    abort("expected values to differ, both were {a}")

fn equals_str(expected string, actual string) =
  if expected != actual :
    abort("expected \"{expected}\", got \"{actual}\"")

fn equals_f64(expected f64, actual f64) =
  if expected != actual :
    abort("expected {expected}, got {actual}")

fn equals_i128(expected i128, actual i128) =
  if expected != actual :
    abort("i128 mismatch: {expected} != {actual}")

fn equals_u128(expected u128, actual u128) =
  if expected != actual :
    abort("u128 mismatch: {expected} != {actual}")

fn equals_f128(expected f128, actual f128) =
  if expected != actual :
    abort("f128 mismatch: {expected} != {actual}")

fn fails(msg string) =
  abort(msg)

fn panics(f fn() void) =
  let did_panic bool = false
  defer do:
    let msg string = recover()
    if len(msg) > 0 :
      did_panic = true
  f()
  if !did_panic :
    abort("expected panic but none occurred")

export {
  ok, not_ok, equals, not_equals, equals_str, equals_f64,
  equals_i128, equals_u128, equals_f128,
  fails, panics
} as assert
