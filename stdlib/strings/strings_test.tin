// stdlib/strings/strings_test.tin
//
// Tests for the strings stdlib.
// Run with: tin test stdlib/strings/strings_test.tin

use assert
use strings
use errors
use result
use { unwrap_or, is_err } from result

// ----- replace ---------------------------------------------------------------

test "replace all occurrences" =
  let result = strings::replace("foo bar foo baz foo", "foo", "qux")

  assert::equals(result, "qux bar qux baz qux")

test "replace no occurrence returns original" =
  let result = strings::replace("hello world", "xyz", "abc")

  assert::equals(result, "hello world")

test "replace single occurrence" =
  let result = strings::replace("hello world", "world", "tin")

  assert::equals(result, "hello tin")

test "replace with empty new string deletes" =
  let result = strings::replace("aXbXcX", "X", "")

  assert::equals(result, "abc")

test "replace old same as new is no-op" =
  let result = strings::replace("hello", "hello", "hello")

  assert::equals(result, "hello")

test "replace adjacent occurrences" =
  let result = strings::replace("aabbaabb", "aa", "X")

  assert::equals(result, "XbbXbb")

test "replace empty string input" =
  let result = strings::replace("", "x", "y")

  assert::equals(result, "")

test "replace spaces" =
  let result = strings::replace("hello world foo", " ", "_")

  assert::equals(result, "hello_world_foo")

test "replace empty old returns s unchanged" =
  let result = strings::replace("hello", "", "X")

  assert::equals(result, "hello")

// ----- substr ----------------------------------------------------------------

test "substr full string" =
  assert::equals(strings::substr("hello", 0, 5), "hello")

test "substr prefix" =
  assert::equals(strings::substr("hello", 0, 3), "hel")

test "substr suffix" =
  assert::equals(strings::substr("hello", 3, 5), "lo")

test "substr middle" =
  assert::equals(strings::substr("abcdef", 2, 4), "cd")

test "substr empty range" =
  assert::equals(strings::substr("hello", 2, 2), "")

// ----- contains --------------------------------------------------------------

test "contains present" =
  assert::equals(strings::contains("hello world", "world"), true)

test "contains absent" =
  assert::equals(strings::contains("hello world", "xyz"), false)

test "contains empty needle" =
  assert::equals(strings::contains("hello", ""), true)

test "contains empty haystack" =
  assert::equals(strings::contains("", "x"), false)

test "contains full match" =
  assert::equals(strings::contains("abc", "abc"), true)

// ----- count -----------------------------------------------------------------

test "count no occurrences" =
  assert::equals(strings::count("hello", "x"), 0)

test "count single occurrence" =
  assert::equals(strings::count("hello world", "world"), 1)

test "count multiple occurrences" =
  assert::equals(strings::count("aaa", "a"), 3)

test "count non-overlapping" =
  assert::equals(strings::count("aaaa", "aa"), 2)

test "count empty sub returns len+1" =
  assert::equals(strings::count("abc", ""), 4)

// ----- has_prefix / has_suffix -----------------------------------------------

test "has_prefix true" =
  assert::equals(strings::has_prefix("hello world", "hello"), true)

test "has_prefix false" =
  assert::equals(strings::has_prefix("hello world", "world"), false)

test "has_prefix empty prefix" =
  assert::equals(strings::has_prefix("hello", ""), true)

test "has_prefix longer than s" =
  assert::equals(strings::has_prefix("hi", "hello"), false)

test "has_suffix true" =
  assert::equals(strings::has_suffix("hello world", "world"), true)

test "has_suffix false" =
  assert::equals(strings::has_suffix("hello world", "hello"), false)

test "has_suffix empty suffix" =
  assert::equals(strings::has_suffix("hello", ""), true)

test "has_suffix longer than s" =
  assert::equals(strings::has_suffix("hi", "hello"), false)

// ----- index_of / last_index_of ----------------------------------------------

test "index_of found" =
  assert::equals(strings::index_of("hello world", "world"), 6)

test "index_of not found" =
  assert::equals(strings::index_of("hello world", "xyz"), -1)

test "index_of empty needle" =
  assert::equals(strings::index_of("hello", ""), 0)

test "index_of first of multiple" =
  assert::equals(strings::index_of("abcabc", "bc"), 1)

test "index_of full match" =
  assert::equals(strings::index_of("abc", "abc"), 0)

test "last_index_of found" =
  assert::equals(strings::last_index_of("abcabc", "bc"), 4)

test "last_index_of not found" =
  assert::equals(strings::last_index_of("hello", "xyz"), -1)

test "last_index_of empty needle returns len" =
  assert::equals(strings::last_index_of("hello", ""), 5)

test "last_index_of single occurrence" =
  assert::equals(strings::last_index_of("hello world", "world"), 6)

// ----- split -----------------------------------------------------------------

test "split basic" =
  let parts = strings::split("a,b,c", ",")

  assert::equals(len(parts), 3)
  assert::equals(parts[0], "a")
  assert::equals(parts[1], "b")
  assert::equals(parts[2], "c")

test "split no separator in string" =
  let parts = strings::split("hello", ",")

  assert::equals(len(parts), 1)
  assert::equals(parts[0], "hello")

test "split trailing separator" =
  let parts = strings::split("a,b,", ",")

  assert::equals(len(parts), 3)
  assert::equals(parts[2], "")

test "split leading separator" =
  let parts = strings::split(",a,b", ",")

  assert::equals(len(parts), 3)
  assert::equals(parts[0], "")

test "split empty string" =
  let parts = strings::split("", ",")

  assert::equals(len(parts), 1)
  assert::equals(parts[0], "")

test "split multi-char separator" =
  let parts = strings::split("aXXbXXc", "XX")

  assert::equals(len(parts), 3)
  assert::equals(parts[0], "a")
  assert::equals(parts[1], "b")
  assert::equals(parts[2], "c")

test "split empty separator returns bytes" =
  let parts = strings::split("abc", "")

  assert::equals(len(parts), 3)
  assert::equals(parts[0], "a")
  assert::equals(parts[1], "b")
  assert::equals(parts[2], "c")

// ----- join ------------------------------------------------------------------

test "join basic" =
  let parts [string] = ["a", "b", "c"]

  assert::equals(strings::join(parts, ","), "a,b,c")

test "join empty sep" =
  let parts [string] = ["hello", " ", "world"]

  assert::equals(strings::join(parts, ""), "hello world")

test "join single element" =
  let parts [string] = ["only"]

  assert::equals(strings::join(parts, ","), "only")

test "join empty array" =
  let parts [string] = []

  assert::equals(strings::join(parts, ","), "")

test "join multi-char sep" =
  let parts [string] = ["a", "b", "c"]

  assert::equals(strings::join(parts, " | "), "a | b | c")

// ----- repeat ----------------------------------------------------------------

test "repeat basic" =
  assert::equals(strings::repeat("ab", 3), "ababab")

test "repeat zero times" =
  assert::equals(strings::repeat("ab", 0), "")

test "repeat once" =
  assert::equals(strings::repeat("hello", 1), "hello")

// ----- to_lower / to_upper ---------------------------------------------------

test "to_lower basic" =
  assert::equals(strings::to_lower("Hello World"), "hello world")

test "to_lower already lower" =
  assert::equals(strings::to_lower("hello"), "hello")

test "to_lower all upper" =
  assert::equals(strings::to_lower("ABCXYZ"), "abcxyz")

test "to_lower preserves non-alpha" =
  assert::equals(strings::to_lower("ABC 123!"), "abc 123!")

test "to_upper basic" =
  assert::equals(strings::to_upper("Hello World"), "HELLO WORLD")

test "to_upper already upper" =
  assert::equals(strings::to_upper("HELLO"), "HELLO")

test "to_upper all lower" =
  assert::equals(strings::to_upper("abcxyz"), "ABCXYZ")

test "to_upper preserves non-alpha" =
  assert::equals(strings::to_upper("abc 123!"), "ABC 123!")

// ----- trim / trim_left / trim_right -----------------------------------------

test "trim both sides" =
  assert::equals(strings::trim("  hello  "), "hello")

test "trim tabs and newlines" =
  assert::equals(strings::trim("\t\nhello\r\n"), "hello")

test "trim no whitespace" =
  assert::equals(strings::trim("hello"), "hello")

test "trim all whitespace" =
  assert::equals(strings::trim("   "), "")

test "trim empty string" =
  assert::equals(strings::trim(""), "")

test "trim_left only left" =
  assert::equals(strings::trim_left("  hello  "), "hello  ")

test "trim_right only right" =
  assert::equals(strings::trim_right("  hello  "), "  hello")

// ----- round-trip: split then join -------------------------------------------

test "split-join round trip" =
  let s = "one,two,three"
  let parts = strings::split(s, ",")
  let rejoined = strings::join(parts, ",")

  assert::equals(rejoined, s)

// ----- parse_int -------------------------------------------------------------

test "parse_int positive" =
  assert::equals(unwrap_or(strings::parse_int("42"), 0), 42)

test "parse_int negative" =
  assert::equals(unwrap_or(strings::parse_int("-7"), 0), 0 - 7)

test "parse_int with plus sign" =
  assert::equals(unwrap_or(strings::parse_int("+5"), 0), 5)

test "parse_int empty string is error" =
  assert::ok(is_err(strings::parse_int("")))

test "parse_int sign only is error" =
  assert::ok(is_err(strings::parse_int("-")))

test "parse_int invalid char is error" =
  assert::ok(is_err(strings::parse_int("12x")))

// ----- parse_int32 -----------------------------------------------------------

test "parse_int32 basic" =
  assert::equals(unwrap_or(strings::parse_int32("100"), 0 as i32) as i64, 100)

test "parse_int32 invalid is error" =
  assert::ok(is_err(strings::parse_int32("abc")))

// ----- parse_float -----------------------------------------------------------

test "parse_float positive" =
  assert::equals(unwrap_or(strings::parse_float("3.14"), 0.0), 3.14)

test "parse_float negative" =
  assert::equals(unwrap_or(strings::parse_float("-2.5"), 0.0), 0.0 - 2.5)

test "parse_float integer" =
  assert::equals(unwrap_or(strings::parse_float("10"), 0.0), 10.0)

test "parse_float exponent" =
  assert::equals(unwrap_or(strings::parse_float("1.5e2"), 0.0), 150.0)

test "parse_float empty is error" =
  assert::ok(is_err(strings::parse_float("")))

test "parse_float invalid is error" =
  assert::ok(is_err(strings::parse_float("abc")))
