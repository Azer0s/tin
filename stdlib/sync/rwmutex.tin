//!+sync_helpers.c -- -lpthread

// stdlib/sync - RWMutex (reader-writer lock backed by pthread_rwlock_t)

fn _tin_rwmutex_new() *void          = extern("_tin_rwmutex_new")
fn _tin_rwmutex_rlock(m *void)       = extern("_tin_rwmutex_rlock")
fn _tin_rwmutex_runlock(m *void)     = extern("_tin_rwmutex_runlock")
fn _tin_rwmutex_lock(m *void)        = extern("_tin_rwmutex_lock")
fn _tin_rwmutex_unlock(m *void)      = extern("_tin_rwmutex_unlock")
fn _tin_rwmutex_free(m *void)        = extern("_tin_rwmutex_free")

struct RWMutex =
  _ptr *void

  static fn make() RWMutex =
    return RWMutex{_ptr: _tin_rwmutex_new()}

  fn read_lock(this RWMutex) =
    _tin_rwmutex_rlock(this._ptr)

  fn read_unlock(this RWMutex) =
    _tin_rwmutex_runlock(this._ptr)

  fn lock(this RWMutex) =
    _tin_rwmutex_lock(this._ptr)

  fn unlock(this RWMutex) =
    _tin_rwmutex_unlock(this._ptr)

  fn deinit(this RWMutex) =
    _tin_rwmutex_free(this._ptr)

export { RWMutex } as sync
