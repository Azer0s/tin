//!+sync_helpers.c

// stdlib/sync - RWMutex (reader-writer lock, fiber-aware).
// rc::Cell wraps the C lock cell so struct copies share ownership.

use rc

fn tin_frwmutex2_new() *void                     = extern("_tin_frwmutex2_new")
fn tin_frwmutex2_free(m *void)                   = extern("_tin_frwmutex2_free")

fn tin_frwmutex2_rlock_try(m *void, pid i64) i32 = extern("_tin_frwmutex2_rlock_try")
fn tin_frwmutex2_runlock(m *void)                = extern("_tin_frwmutex2_runlock")

fn tin_frwmutex2_lock_try(m *void, pid i64) i32  = extern("_tin_frwmutex2_lock_try")
fn tin_frwmutex2_unlock(m *void)                 = extern("_tin_frwmutex2_unlock")

fn tin_current_pid_rw() i64 = extern("_tin_current_pid")

struct RWMutex =
  _cell *rc::Cell[*void]

  fn ptr(this RWMutex) *void = return this._cell.payload()

  static fn new() RWMutex =
    return RWMutex{_cell: rc::Cell[*void].alloc(tin_frwmutex2_new(), tin_frwmutex2_free)}

  fn{#async #no_autoyield} read_lock(this RWMutex) =
    let pid = tin_current_pid_rw()
    for true:
      if tin_frwmutex2_rlock_try(this.ptr(), pid) != 0:
        return
      yield

  fn read_unlock(this RWMutex) =
    tin_frwmutex2_runlock(this.ptr())

  fn{#async #no_autoyield} lock(this RWMutex) =
    let pid = tin_current_pid_rw()
    for true:
      if tin_frwmutex2_lock_try(this.ptr(), pid) != 0:
        return
      yield

  fn unlock(this RWMutex) =
    tin_frwmutex2_unlock(this.ptr())
