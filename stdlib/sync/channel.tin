//!+channel_arc.c -- -lpthread

// stdlib/sync - Channel[T]: a bounded, thread-safe FIFO channel.
//
// Channel[T] is a thin wrapper around an opaque heap-allocated C control block
// (TinChannel*). Copying the Tin struct copies only the pointer, so all copies
// share the same ring buffer and mutex - giving Go-style reference semantics
// within Tin's value-type system.
//
// Both send() and recv() are fiber-aware: they spawn a background coroutine
// that retries with yield() rather than blocking the OS worker thread.
//
// Usage:
//   let ch = Channel[i64].make(16)   // buffered channel, capacity 16
//   await ch.send(42)                // wait for send to complete
//   let v = await ch.recv()          // wait for a value
//
// Fire-and-forget send (no await):
//   ch.send(42)                      // spawns send_fiber, returns Future[Unit]
//
//   Without await the send happens asynchronously - the value will eventually
//   be enqueued, but the caller does not wait. Use this when:
//     * you don't need backpressure (channel has plenty of headroom), and
//     * nothing depends on the send completing before the next statement.
//
//   WARNING: sending to a closed channel always panics, even fire-and-forget.
//   If the channel may be closed before the send_fiber runs, use await so the
//   panic is synchronous and traceable, or ensure the channel outlives all
//   in-flight sends.

use "./future"
use mem

fn tin_channel_new(cap i64, elem_size i64, is_rc i32) *void = extern("_tin_channel_new")
fn tin_channel_free(ch *void)                               = extern("_tin_channel_free")
fn tin_channel_retain(ch *void)                             = extern("_tin_channel_retain")

fn tin_channel_send_try(ch *void, val *void, elem_size i64, is_rc i32) i32         = extern("_tin_channel_send_try")
fn tin_channel_recv_try(ch *void) *void                                             = extern("_tin_channel_recv_park")
fn tin_channel_recv_blocked_val() i64                                               = extern("_tin_channel_recv_blocked_val")
fn tin_channel_send_blocking(ch *void, val *void, elem_size i64, is_rc i32, pid i64) i32 = extern("_tin_channel_send_blocking")
fn tin_channel_recv_blocking(ch *void, pid i64) *void                              = extern("_tin_channel_recv_blocking")

fn tin_channel_close(ch *void)             = extern("_tin_channel_close")
fn tin_channel_is_closed_empty(ch *void) i32 = extern("_tin_channel_is_closed_empty")

fn tin_current_pid_c() i64 = extern("_tin_current_pid")

struct Channel[T] =
  _ptr *void

  static fn make(cap i64) Channel[T] =
    return Channel[T]{_ptr: tin_channel_new(cap, sizeof(T), isrc(T))}

  // send parks the calling fiber directly when the channel is full.
  // Use `await ch.send(v)` to send inline; `spawn ch.send(v)` to fire-and-forget.
  // #no_autoyield: the loop already yields explicitly for the blocked case.
  fn{#async #no_autoyield} send(this *Channel[T], val T) =
    let pid = tin_current_pid_c()
    for true:
      let r i32 = tin_channel_send_blocking(this._ptr, &val, sizeof(T), isrc(T), pid)
      if r == -1:
        panic("send on closed channel")
      if r == 0:
        return
      yield

  // recv parks the calling fiber directly when the channel is empty.
  // Use `await ch.recv()` to receive inline.
  // #no_autoyield: the loop already yields explicitly for the blocked case.
  fn{#async #no_autoyield} recv(this *Channel[T]) T =
    let blocked = tin_channel_recv_blocked_val()
    let pid = tin_current_pid_c()
    for true:
      let r *void = tin_channel_recv_blocking(this._ptr, pid)
      if r == 0 as *void:
        panic("recv on closed channel")
      if (r as i64) != blocked:
        return *(r as *T)
      yield

  fn close(this *Channel[T]) =
    tin_channel_close(this._ptr)

  fn is_closed_empty(this *Channel[T]) bool =
    return tin_channel_is_closed_empty(this._ptr) != 0

  fn deinit(this Channel[T]) =
    tin_channel_free(this._ptr)

  // _fiber_retain is called by the compiler's ramp block when this channel is
  // passed as a named parameter to a spawned async function. It increments the
  // internal reference count so the fiber's copy remains valid even after the
  // caller's local variable is released. The matching release is the deinit
  // called when the fiber's parameter goes out of scope.
  fn _fiber_retain(this Channel[T]) =
    tin_channel_retain(this._ptr)
