//!+sync_helpers.c

// stdlib/sync - Cond (condition variable, fiber-aware).
// rc::Cell wraps the C condition cell so struct copies share ownership.

use "./mutex"
use rc

fn tin_fcond2_new() *void                        = extern("_tin_fcond2_new")
fn tin_fcond2_free(c *void)                      = extern("_tin_fcond2_free")

fn tin_fcond2_add_waiter(c *void, pid i64)       = extern("_tin_fcond2_add_waiter")
fn tin_fcond2_signal(c *void)                    = extern("_tin_fcond2_signal")
fn tin_fcond2_broadcast(c *void)                 = extern("_tin_fcond2_broadcast")

fn tin_current_pid_cond() i64                    = extern("_tin_current_pid")
fn tin_fmutex2_try_lock_c(m *void, pid i64) i32  = extern("_tin_fmutex2_try_lock")

struct Cond =
  _cell *rc::Cell[*void]

  fn ptr(this Cond) *void = return this._cell.payload()

  static fn new() Cond =
    return Cond{_cell: rc::Cell[*void].new(tin_fcond2_new(), tin_fcond2_free)}

  // wait returns a Future[Unit] that resolves once the cond has been
  // signalled and the mutex is reacquired. Typical use:
  //   await cond.wait(mu)
  // The outer wrapper is plain sync; the inner #async helper carries
  // the park/yield loop.
  fn wait(this Cond, mu Mutex) Future[Unit] =
    return spawn this.wait_impl(mu)

  fn{#async #no_autoyield} wait_impl(this Cond, mu Mutex) =
    let pid = tin_current_pid_cond()

    tin_fcond2_add_waiter(this.ptr(), pid)
    mu.unlock()
    yield

    for true:
      if tin_fmutex2_try_lock_c(mu.ptr(), pid) != 0:
        return
      yield

  fn signal(this Cond) =
    tin_fcond2_signal(this.ptr())

  fn broadcast(this Cond) =
    tin_fcond2_broadcast(this.ptr())
