//!+sync_helpers.c

// stdlib/sync - Atomic[t]: thread-safe single-cell storage.
//
// One generic struct, two implementations selected at instantiation time
// by the where guards on each method:
//
//   * `t is primitive` (i*, u*, f*, bool): lock-free C11 __atomic
//     builtins. Storage is a heap i64 slot; load/store reinterpret t as
//     i64. add/cas additionally require `t is numeric` (no bool).
//
//   * `t is not primitive` (any other t): mutex-protected heap copy.
//     load/store memcpy under a TinFastMutex. add/cas are not exposed —
//     they have no meaning on arbitrary structs.
//
// Calling cas/add on Atomic[bool] (or any non-numeric primitive) is a
// compile-time error: the methods are dead-stripped from the concrete
// struct at instantiation, and the call site emits a diagnostic
// pointing at the failing `where t is numeric` guard.
//
// Type-equality bounds (`t is i64`) match only the literal primitive
// type and cannot be satisfied by a user struct that happens to
// implement an `ord` trait — so the constraint is an actual gate, not
// an opt-in. Likewise `t is primitive` only holds for the listed
// primitives below.

// numeric is the gate for `add` (integer arithmetic only) — atomic
// integer add on the bit pattern of a float is meaningless, so floats
// are excluded.
type numeric = i64 | u64 | i32 | u32 | i16 | u16 | i8 | u8

// primitive is the gate for load/store/new/cas/deinit. Includes floats
// (bit-pattern atomic load/store works fine) and bool. cas via bit-
// pattern compare-and-swap is well-defined for every primitive.
type primitive = i64 | u64 | i32 | u32 | i16 | u16 | i8 | u8 | f64 | f32 | bool

// Lock-free 64-bit primitives (existing C runtime). Bytewise variants
// for sub-64-bit types — load/store memcpy `sizeof(t)` bytes between
// the user's value slot and the i64 atomic slot's low bytes, so
// floats round-trip via bit pattern (not value conversion).
fn tin_atomic_new_64(v i64) *void                       = extern("_tin_atomic_new_i64")
fn tin_atomic_free_64(a *void)                          = extern("_tin_atomic_free_i64")
fn tin_atomic_load_64(a *void) i64                      = extern("_tin_atomic_load_i64")
fn tin_atomic_store_64(a *void, v i64)                  = extern("_tin_atomic_store_i64")
fn tin_atomic_add_64(a *void, d i64) i64                = extern("_tin_atomic_add_i64")
fn tin_atomic_cas_64(a *void, old i64, nw i64) i64      = extern("_tin_atomic_cas_i64")
fn tin_atomic_load_bits(a *void, out *void, sz i64)     = extern("_tin_atomic_load_bits")
fn tin_atomic_store_bits(a *void, src *void, sz i64)    = extern("_tin_atomic_store_bits")

// Mutex-backed object slot (new C runtime helpers).
fn tin_atomic_obj_new(size i64) *void               = extern("_tin_atomic_obj_new")
fn tin_atomic_obj_free(p *void)                     = extern("_tin_atomic_obj_free")
fn tin_atomic_obj_load(p *void, out *void)          = extern("_tin_atomic_obj_load")
fn tin_atomic_obj_store(p *void, src *void)          = extern("_tin_atomic_obj_store")

struct Atomic[t] =
  _ptr *void

  // new: two impls. Compile-time selected by t.

  static fn new(v t) Atomic[t] where t is primitive =
    let p = tin_atomic_new_64(0)
    let vp *void = &v as *void
    tin_atomic_store_bits(p, vp, sizeof(t))
    return Atomic[t]{_ptr: p}

  static fn new(v t) Atomic[t] where t is not primitive =
    let p = tin_atomic_obj_new(sizeof(t))
    tin_atomic_obj_store(p, &v as *void)
    return Atomic[t]{_ptr: p}

  // load / store: bit-reinterpret via memcpy of sizeof(t) bytes so
  // floats round-trip correctly (a value-cast `as i64` would convert
  // 3.14 to 3 instead of preserving the bit pattern).

  fn load(this Atomic[t]) t where t is primitive =
    let out t
    let outp *void = &out as *void
    tin_atomic_load_bits(this._ptr, outp, sizeof(t))
    return out

  fn load(this Atomic[t]) t where t is not primitive =
    let out t  // zero-initialized stack slot
    let outp *void = &out as *void
    tin_atomic_obj_load(this._ptr, outp)
    return out

  fn store(this Atomic[t], v t) where t is primitive =
    let vp *void = &v as *void
    tin_atomic_store_bits(this._ptr, vp, sizeof(t))

  fn store(this Atomic[t], v t) where t is not primitive =
    let vp *void = &v as *void
    tin_atomic_obj_store(this._ptr, vp)

  // add: integer types only. Atomic float-add isn't a hardware
  // primitive and integer-add on float bits would corrupt the value.

  fn add(this Atomic[t], d t) t where t is numeric =
    return tin_atomic_add_64(this._ptr, d as i64) as t

  // cas: integer compare-and-swap. Returns the previous value
  // (so the caller can branch on prev == old to detect success).
  // Restricted to integer types — atomic float CAS via bit pattern
  // is well-defined but requires a different C helper; revisit if
  // needed.

  fn cas(this Atomic[t], old t, nw t) t where t is numeric =
    return tin_atomic_cas_64(this._ptr, old as i64, nw as i64) as t

  // deinit: same dual-impl pattern; chooses the right free.

  fn deinit(this Atomic[t]) where t is primitive =
    tin_atomic_free_64(this._ptr)

  fn deinit(this Atomic[t]) where t is not primitive =
    tin_atomic_obj_free(this._ptr)
