//!+sync_helpers.c -- -lpthread

// stdlib/sync - Mutex (exclusive lock backed by pthread_mutex_t)

fn _tin_mutex_new() *void         = extern("_tin_mutex_new")
fn _tin_mutex_lock(m *void)       = extern("_tin_mutex_lock")
fn _tin_mutex_unlock(m *void)     = extern("_tin_mutex_unlock")
fn _tin_mutex_free(m *void)       = extern("_tin_mutex_free")

struct Mutex =
  _ptr *void

  static fn make() Mutex =
    return Mutex{_ptr: _tin_mutex_new()}

  fn lock(this Mutex) =
    _tin_mutex_lock(this._ptr)

  fn unlock(this Mutex) =
    _tin_mutex_unlock(this._ptr)

  fn deinit(this Mutex) =
    _tin_mutex_free(this._ptr)

export { Mutex } as sync
