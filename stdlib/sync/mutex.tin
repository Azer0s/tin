//!+sync_helpers.c

// stdlib/sync - Mutex (exclusive lock, fiber-aware via TinFastMutex)

fn _tin_fmutex2_new() *void                    = extern("_tin_fmutex2_new")
fn _tin_fmutex2_try_lock(m *void, pid i64) i32 = extern("_tin_fmutex2_try_lock")
fn _tin_fmutex2_unlock(m *void)                = extern("_tin_fmutex2_unlock")
fn _tin_fmutex2_free(m *void)                  = extern("_tin_fmutex2_free")
fn _tin_current_pid_mx() i64                   = extern("_tin_current_pid")

struct Mutex =
  _ptr *void

  static fn make() Mutex =
    return Mutex{_ptr: _tin_fmutex2_new()}

  fn{#async #no_autoyield} lock(this Mutex) =
    let pid = _tin_current_pid_mx()
    for true:
      if _tin_fmutex2_try_lock(this._ptr, pid) != 0:
        return
      yield

  fn unlock(this Mutex) =
    _tin_fmutex2_unlock(this._ptr)

  fn deinit(this Mutex) =
    _tin_fmutex2_free(this._ptr)

export { Mutex } as sync
