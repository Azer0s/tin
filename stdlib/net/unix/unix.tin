//!+unix.c -- -I $TIN_RUNTIME
// stdlib/net/unix - Unix domain socket connection and server types.
//
// Mirrors the tcp package but uses AF_UNIX paths instead of ports:
//
//   let (srv, err) = unix::listen("/tmp/myapp.sock")
//   if errors::is_err(err): panic(err.message())
//   let (c, aerr) = srv.accept()
//
//   let (c, err) = unix::dial("/tmp/myapp.sock")
//   if errors::is_err(err): panic(err.message())
//   await ioutil::write_string(c, "hello\n")
//
// Ownership: the fd lives behind an *rc::Cell so copies of Conn / Server
// share ownership and io::close runs exactly once at last drop.  The .fd
// field is cached at construction; reads are zero-cost.

use io
use rc
use errors
use result
use { Result } from result

// C helpers
fn tin_unix_listen_c(path string) i32  = extern("_tin_unix_listen")
fn tin_unix_accept_c(fd i32) i32       = extern("_tin_unix_accept")
fn tin_unix_connect_c(path string) i32 = extern("_tin_unix_connect")

// UnixError enumerates the failures the net::unix stdlib can
// surface. Implements errors::Err so calls return
// Result[T, errors::Err] and unify with the typed-error ecosystem.
data UnixError(errors::Err, print) =
  AcceptFailed
  CannotBind(path string)
  CannotConnect(path string)

  fn errors::Err::message(this UnixError) string =
    match this:
      case AcceptFailed:      return "unix: accept failed"
      case CannotBind(p):     return "unix: failed to bind " ++ p
      case CannotConnect(p):  return "unix: failed to connect to " ++ p

  fn ::print(this UnixError) string = return this.message()

// Conn is a connected Unix domain socket.
// Implements io::AsyncReader and io::AsyncWriter so it works with ioutil.
struct Conn (io::AsyncReader, io::AsyncWriter, io::Closeable) =
  fd   i32
  cell *rc::Cell[i32]

  // read reads up to n bytes from the connection into buf.
  // Returns Future[i64] - use `await conn.read(buf, n)`.
  fn AsyncReader::read(this Conn, buf *byte, n i64) Future[i64] =
    return spawn io::async_read(this.fd, buf, n)

  // write writes up to n bytes from buf to the connection.
  // Returns Future[i64] - use `await conn.write(buf, n)`.
  fn AsyncWriter::write(this Conn, buf *byte, n i64) Future[i64] =
    return spawn io::async_write(this.fd, buf, n)

  fn Closeable::close(this Conn) = io::close(this.fd)

  fn valid(this Conn) bool = return this.fd >= 0

// Server listens for incoming Unix domain socket connections.
struct Server (io::Closeable) =
  fd   i32
  cell *rc::Cell[i32]

  // accept waits for the next connection.
  fn accept(this Server) Result[Conn, errors::Err] =
    let fd = tin_unix_accept_c(this.fd)

    if fd < 0:
      return Err(AcceptFailed)

    return Ok(Conn{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

  fn Closeable::close(this Server) = io::close(this.fd)

// listen creates a Unix domain socket server at path. Removes any
// stale socket file before bind.
fn listen(path string) Result[Server, errors::Err] =
  let fd = tin_unix_listen_c(path)

  if fd < 0:
    return Err(CannotBind(path))

  return Ok(Server{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

// dial connects to a Unix domain socket at path.
fn dial(path string) Result[Conn, errors::Err] =
  let fd = tin_unix_connect_c(path)

  if fd < 0:
    return Err(CannotConnect(path))

  return Ok(Conn{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

export { Conn, Server, UnixError, listen, dial } as unix
