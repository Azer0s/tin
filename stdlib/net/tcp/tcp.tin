//!+tcp.c -- -I $TIN_RUNTIME
// stdlib/net/tcp - higher-level TCP connection and server types.
//
// Wraps the raw file-descriptor async I/O from stdlib/io into ergonomic
// Conn and Server structs. Conn implements io::AsyncReader and io::AsyncWriter,
// so its read/write methods return Future[i64] and can be awaited directly:
//
//   let n = await conn.read(&buf[0], 4096)
//   await conn.write(&buf[0], n)
//
// Ownership: the fd lives behind an *rc::Cell so copies of Conn / Server
// share ownership and io::close runs exactly once at last drop.  The .fd
// field is cached at construction; reads are zero-cost.

use io
use rc
use errors
use result
use { Result } from result

// C helpers
fn tin_tcp_listen_c(port i32) i32          = extern("_tin_tcp_listen")
fn tin_tcp_accept_c(fd i32) i32            = extern("_tin_tcp_accept")
fn tin_tcp_dial_c(host string, port i32) i32 = extern("_tin_tcp_dial")

// TcpError enumerates the failures the tcp stdlib can surface.
// Implements errors::Err so calls return Result[T, errors::Err] and
// unify with the typed-error ecosystem.
data TcpError(errors::Err, print) =
  AcceptFailed
  CannotBind(port i32)
  DialFailed(host string, port i32)

  fn errors::Err::message(this TcpError) string =
    match this:
      case AcceptFailed:     return "tcp: accept failed"
      case CannotBind(p):    return "tcp: failed to bind port {p}"
      case DialFailed(h, p): return "tcp: dial {h}:{p} failed"

  fn ::print(this TcpError) string = return this.message()

struct Conn (io::AsyncReader, io::AsyncWriter, io::Closeable) =
  fd   i32                    // cached at construction; zero-cost reads
  cell *rc::Cell[i32]         // io::close at last drop

  // read reads up to n bytes from the connection into buf.
  // Returns Future[i64] - use `await conn.read(buf, n)`.
  fn AsyncReader::read(this Conn, buf *byte, n i64) Future[i64] =
    return spawn io::async_read(this.fd, buf, n)

  // write writes up to n bytes from buf to the connection.
  // Returns Future[i64] - use `await conn.write(buf, n)`.
  fn AsyncWriter::write(this Conn, buf *byte, n i64) Future[i64] =
    return spawn io::async_write(this.fd, buf, n)

  fn Closeable::close(this Conn) = io::close(this.fd)

  fn valid(this Conn) bool = return this.fd >= 0

struct Server (io::Closeable) =
  fd   i32
  cell *rc::Cell[i32]

  // accept waits for the next connection.
  fn accept(this Server) Result[Conn, errors::Err] =
    let fd = tin_tcp_accept_c(this.fd)

    if fd < 0:
      return Err(AcceptFailed)

    return Ok(Conn{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

  fn Closeable::close(this Server) = io::close(this.fd)

// listen creates a TCP server on the given port.
fn listen(port i32) Result[Server, errors::Err] =
  let fd = tin_tcp_listen_c(port)

  if fd < 0:
    return Err(CannotBind(port))

  return Ok(Server{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

// dial connects to host:port via TCP.
fn dial(host string, port i32) Result[Conn, errors::Err] =
  let fd = tin_tcp_dial_c(host, port)

  if fd < 0:
    return Err(DialFailed(host, port))

  return Ok(Conn{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

export { Conn, Server, TcpError, listen, dial } as tcp
