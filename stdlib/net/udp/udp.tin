//!+udp.c -- -I $TIN_RUNTIME
// stdlib/net/udp - UDP socket types.
//
// Mirrors the tcp package but uses datagrams instead of streams:
//
//   match udp::listen(8082):
//     case Ok(srv):
//       match await srv.accept():
//         case Ok(c):  ...
//         case Err(e): echo e.message()
//     case Err(e): echo e.message()
//
// For a connected client:
//   match udp::dial("127.0.0.1", 8082):
//     case Ok(c): await ioutil::write_string(c, "hello\n")
//     case Err(e): echo e.message()
//
// Ownership: the fd lives behind an *rc::Cell so copies of Conn / Server
// share ownership.  Dial-based Conn / Server use io::close as the cell
// dtor; accept-based Conn shares the Server's fd and uses no_close so
// the Server's own cell owns the close.  The .fd field is cached at
// construction; reads are zero-cost.

use { loop } from macros
use io
use rc
use sync
use errors
use result
use { Result } from result

// UdpError enumerates the failure modes the udp stdlib can surface.
data UdpError(errors::Err, print) =
  CannotBind(port i32)
  CannotConnect(host string, port i32)
  AcceptFailed

  fn errors::Err::message(this UdpError) string =
    match this:
      case CannotBind(p):       return "udp: failed to bind port {p}"
      case CannotConnect(h, p): return "udp: failed to connect to {h}:{p}"
      case AcceptFailed:        return "udp: accept failed"

  fn ::print(this UdpError) string = return this.message()

// C helpers
fn tin_udp_listen_c(port i32) i32                                                     = extern("_tin_udp_listen")
fn tin_udp_connect_c(host string, port i32) i32                                       = extern("_tin_udp_connect")
fn tin_udp_recvfrom_c(fd i32, buf *byte, n i64, host_out *string, port_out *i32) i64  = extern("_tin_udp_recvfrom")
fn tin_udp_sendto_c(fd i32, buf *byte, n i64, host string, port i32) i64              = extern("_tin_udp_sendto")
fn tin_io_blocked_val_c() i64                                                         = extern("_tin_io_blocked_val")

// no_close is the cell dtor for accept-based Conns whose fd is owned by
// the parent Server; dropping the Conn must NOT close the shared fd.
fn no_close(fd i32) = pass

// Internal async implementations

fn{#async} recv_from_impl(fd i32) ([byte], string, i32) =
  let blocked      = tin_io_blocked_val_c()
  let buf [byte; 65536]
  let host         = ""
  let port i32     = 0

  loop:
    let r = tin_udp_recvfrom_c(fd, &buf[0], 65536, &host, &port)

    if r == blocked:
      yield
    else if r > 0:
      return (buf[0..r], host, port)
    else if r < 0:
      // Hard error from recvfrom; surface as zero-length so accept_impl
      // can return an Err to the caller.
      return (buf[0..0], host, port)
    // r == 0: empty datagram.  Skip it (some kernels deliver them,
    // some don't; either way an empty payload is meaningless to the
    // echo-style API) and continue the recv loop without producing a
    // Conn.  Without this, an empty datagram from a hostile client
    // breaks the accept loop on amd64 GitHub runners (heap corruption
    // in glibc's tcache on subsequent free).

// read_buf_impl copies bytes from a received datagram into out, advancing
// the cursor.  Returns 0 when all bytes have been consumed (signals EOF
// to AsyncReader callers).  cursor is shared across Conn copies via the
// Atomic's inner rc::Cell.
fn{#async} read_buf_impl(data [byte], cursor sync::Atomic[i64], out *byte, n i64) i64 =
  let p     = cursor.load()
  let total = len(data)

  if p >= total:
    return 0
  let avail = total - p

  if n < avail: avail = n
  let i i64 = 0

  loop:
    if i >= avail: break
    out[i] = data[p + i]
    i = i + 1

  cursor.store(p + avail)

  return avail

fn{#async} accept_impl(fd i32) Result[Conn, errors::Err] =
  let (data, host, port) = await spawn recv_from_impl(fd)

  if len(data) == 0:
    return Err(AcceptFailed)

  return Ok(Conn{
    fd:       fd,
    cell:     rc::Cell[i32].new(fd, no_close),
    cursor:   sync::Atomic[i64].new(0),
    host:     host,
    port:     port,
    data_buf: data,
  })

fn{#async} send_to_raw_impl(fd i32, buf *byte, n i64, host string, port i32) i64 =
  let blocked = tin_io_blocked_val_c()

  loop:
    let r = tin_udp_sendto_c(fd, buf, n, host, port)

    if r != blocked:
      return r
    yield

fn{#async} send_to_impl(fd i32, data [byte], host string, port i32) i64 =
  if len(data) == 0:
    return 0
  return await spawn send_to_raw_impl(fd, &data[0], len(data), host, port)

// Conn is a UDP connection returned by either Server.accept or udp::dial.
//
// Accept-based Conn implements io::AsyncReader: reading consumes the received
// datagram bytes and signals EOF when exhausted. Use ioutil.read_string or
// ioutil.read_bytes_until to read the payload.
//
// Dial-based Conn reads from the connected UDP socket directly.
//
// .close() is optional; the fd is auto-closed at the cell's last drop
// (only for dial-based Conns; accept-based share the Server's fd).
struct Conn (io::AsyncReader, io::AsyncWriter, io::Closeable) =
  fd       i32                       // cached at construction; zero-cost reads
  cell     *rc::Cell[i32]            // dial: io::close at last drop; accept: no_close
  cursor   sync::Atomic[i64]         // accept-only read cursor; 0 for dial
  host     string
  port     i32
  data_buf [byte]                    // received datagram (accept); empty for dial

  // read implements io::AsyncReader.
  // Accept-based: serves bytes from the received datagram, returns 0 at EOF.
  // Dial-based: reads from the connected UDP socket.
  fn AsyncReader::read(this Conn, buf *byte, n i64) Future[i64] =
    if len(this.data_buf) > 0:
      return spawn read_buf_impl(this.data_buf, this.cursor, buf, n)
    return spawn io::async_read(this.fd, buf, n)

  // write sends buf[0..n] to the peer (AsyncWriter interface).
  fn AsyncWriter::write(this Conn, buf *byte, n i64) Future[i64] =
    return spawn send_to_raw_impl(this.fd, buf, n, this.host, this.port)

  // write sends data to the peer (slice convenience overload).
  fn write(this Conn, data [byte]) Future[i64] =
    return spawn send_to_impl(this.fd, data, this.host, this.port)

  fn Closeable::close(this Conn) = io::close(this.fd)

  fn valid(this Conn) bool = return this.fd >= 0

// Server listens for incoming UDP datagrams.
// Create with udp::listen(port).
struct Server (io::Closeable) =
  fd   i32
  cell *rc::Cell[i32]

  // accept waits for the next datagram and returns a Conn to the sender.
  fn accept(this Server) Future[Result[Conn, errors::Err]] =
    return spawn accept_impl(this.fd)

  fn Closeable::close(this Server) = io::close(this.fd)

// listen creates a bound UDP socket on the given port.
fn listen(port i32) Result[Server, errors::Err] =
  let fd = tin_udp_listen_c(port)

  if fd < 0:
    return Err(CannotBind(port))

  return Ok(Server{fd: fd, cell: rc::Cell[i32].new(fd, io::close)})

// dial creates a connected UDP socket to host:port.
fn dial(host string, port i32) Result[Conn, errors::Err] =
  let fd = tin_udp_connect_c(host, port)

  if fd < 0:
    return Err(CannotConnect(host, port))

  return Ok(Conn{
    fd:       fd,
    cell:     rc::Cell[i32].new(fd, io::close),
    cursor:   sync::Atomic[i64].new(0),
    host:     host,
    port:     port,
    data_buf: [],
  })

export { Server, Conn, UdpError, listen, dial } as udp
