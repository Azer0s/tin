use assert
use result
use { Result } from result

test "Result Ok/Err via match" =
  let a Result[i32, string] = Ok(42)
  let b Result[i32, string] = Err("nope")

  match a:
    case Ok(v):  assert::equals(42, v)
    case Err(_): assert::fails("expected Ok")

  match b:
    case Ok(_):  assert::fails("expected Err")
    case Err(e): assert::equals("nope", e)

test "is_ok / is_err" =
  let a Result[i32, string] = Ok(1)
  let b Result[i32, string] = Err("e")

  assert::ok(a.is_ok())
  assert::not_ok(b.is_ok())
  assert::ok(b.is_err())
  assert::not_ok(a.is_err())

test "unwrap_or" =
  let a Result[i64, string] = Ok(5)
  let b Result[i64, string] = Err("e")

  assert::equals(5,  a.unwrap_or(99))
  assert::equals(99, b.unwrap_or(99))

test "Result map / map_err" =
  let a Result[i64, string] = Ok(3)
  let b Result[i64, string] = Err("e")
  let m1 = result::map(a, fn(x i64) i64 = return x * 2)
  let m2 = result::map(b, fn(x i64) i64 = return x * 2)

  assert::equals(6, m1.unwrap_or(0))
  assert::ok(m2.is_err())

  let n1 = result::map_err(a, fn(s string) string = return "wrapped: {s}")
  let n2 = result::map_err(b, fn(s string) string = return "wrapped: {s}")

  assert::ok(n1.is_ok())

  match n2:
    case Ok(_):  assert::fails("expected Err")
    case Err(s): assert::equals("wrapped: e", s)

test "Result and_then / or_else" =
  let a Result[i64, string] = Ok(4)
  let b Result[i64, string] = Err("bad")
  let f = fn(x i64) Result[i64, string] = return Ok(x + 1)

  assert::equals(5, result::and_then(a, f).unwrap_or(0))
  assert::ok(result::and_then(b, f).is_err())

  let g = fn(s string) Result[i64, string] = return Ok(99)

  assert::equals(4,  result::or_else(a, g).unwrap_or(0))
  assert::equals(99, result::or_else(b, g).unwrap_or(0))

test "Result or_else_value" =
  let a Result[i64, string] = Ok(4)
  let b Result[i64, string] = Err("bad")
  let fb Result[i64, string] = Ok(99)

  assert::equals(4,  a.or_else_value(fb).unwrap_or(0))
  assert::equals(99, b.or_else_value(fb).unwrap_or(0))

  // Method form: same dispatch via the ADT's own method table.
  assert::equals(4,  a.or_else_value(fb).unwrap_or(0))
  assert::equals(99, b.or_else_value(fb).unwrap_or(0))

test "Result unwrap / unwrap-with-msg / to_option" =
  use option
  let a Result[i64, string] = Ok(7)

  assert::equals(7, a.unwrap())
  assert::equals(7, a.unwrap("should be ok"))
  // to_option lives as a top-level helper (return-type Option[t] would
  // otherwise force eager Option[Option[...]] monomorphization).
  assert::ok(result::to_option(a).is_some())
  let b Result[i64, string] = Err("e")

  assert::ok(result::to_option(b).is_none())
