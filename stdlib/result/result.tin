// result - the standard Result ADT.
//
// Result[t, e] represents either a successful value (`Ok(v)`) or a failure
// (`Err(msg)`).
//
// Typical usage:
//
//   fn parse_i64(s string) Result[i64, string] = ...
//
//   match parse_i64("42"):
//     case Ok(n):  echo "got {n}"
//     case Err(e): echo "error: {e}"
//
//   let n = unwrap_or(parse_i64("??"), -1)
//
// Bare constructors (`Ok(x)`, `Err(m)`) are inferred from the target type
// when it is known (let-annotations, function arguments, function returns);
// otherwise qualify explicitly, e.g. `Result[i64,string]::Ok(42)`.
//
// Option (Some/None) lives in stdlib/option.

use option

data Result[t, e](tryable[t, Result[_, e]]) =
  Ok(v t)
  Err(msg e)

  fn tryable[t, Result[_, e]]::is_err(this Result[t, e]) bool =
    match this:
      case Ok(_):  return false
      case Err(_): return true

  fn tryable[t, Result[_, e]]::ok_value(this Result[t, e]) t =
    match this:
      case Ok(v):  return v
      case Err(_): panic("tryable::ok_value on Err")

  fn tryable[t, Result[_, e]]::err_value(this Result[t, e]) Result[_, e] =
    match this:
      case Ok(_):  panic("tryable::err_value on Ok")
      case Err(_): return this

// is_ok reports whether the Result is an Ok value.
fn is_ok[t, e](r Result[t, e]) bool =
  match r:
    case Ok(_):  return true
    case Err(_): return false

// is_err reports whether the Result is an Err value.
fn is_err[t, e](r Result[t, e]) bool =
  match r:
    case Ok(_):  return false
    case Err(_): return true

// unwrap_or returns the Ok value or d when r is Err.
fn unwrap_or[t, e](r Result[t, e], d t) t =
  match r:
    case Ok(v):  return v
    case Err(_): return d

// map applies f to the Ok value, leaving Err untouched.
fn map[t, u, e](r Result[t, e], f fn(t) u) Result[u, e] =
  match r:
    case Ok(v):  return Ok(f(v))
    case Err(m): return Err(m)

// map_err applies g to the Err value, leaving Ok untouched.
fn map_err[t, e, f](r Result[t, e], g fn(e) f) Result[t, f] =
  match r:
    case Ok(v):  return Ok(v)
    case Err(m): return Err(g(m))

// and_then chains a fallible computation onto an Ok value (flatMap).
fn and_then[t, u, e](r Result[t, e], f fn(t) Result[u, e]) Result[u, e] =
  match r:
    case Ok(v):  return f(v)
    case Err(m): return Err(m)

// or_else recovers from Err by applying g to produce a new Result.
fn or_else[t, e, f](r Result[t, e], g fn(e) Result[t, f]) Result[t, f] =
  match r:
    case Ok(v):  return Ok(v)
    case Err(m): return g(m)

// unwrap returns the Ok value or panics on Err.
fn unwrap[t, e](r Result[t, e]) t =
  match r:
    case Ok(v):  return v
    case Err(_): panic("result::unwrap on Err")

// expect returns the Ok value or panics with msg on Err.
fn expect[t, e](r Result[t, e], msg string) t =
  match r:
    case Ok(v):  return v
    case Err(_): panic(msg)

// to_option converts a Result into an Option, discarding any error.
fn to_option[t, e](r Result[t, e]) Option[t] =
  match r:
    case Ok(v):  return Some(v)
    case Err(_): return None
