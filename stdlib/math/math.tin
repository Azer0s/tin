// stdlib/math — Mathematical functions
//
// Wraps standard C math.h functions
// Requires linking with libm: pass -lm when building
//   tin build myfile.tin -lm
//   tin run   myfile.tin -lm

// Basic arithmetic

// fabs returns the absolute value of x
fn fabs(x f64) f64 = extern("fabs")

// fmod returns the floating-point remainder of x / y
fn fmod(x f64, y f64) f64 = extern("fmod")

// Powers and roots

// sqrt returns the square root of x
fn sqrt(x f64) f64 = extern("sqrt")

// cbrt returns the cube root of x
fn cbrt(x f64) f64 = extern("cbrt")

// pow returns x raised to the power y
fn pow(x f64, y f64) f64 = extern("pow")

// hypot returns sqrt(x*x + y*y)
fn hypot(x f64, y f64) f64 = extern("hypot")

// Exponential / logarithmic

// exp returns e raised to the power x
fn exp(x f64) f64 = extern("exp")

// exp2 returns 2 raised to the power x
fn exp2(x f64) f64 = extern("exp2")

// log returns the natural logarithm of x
fn log(x f64) f64 = extern("log")

// log2 returns the base-2 logarithm of x
fn log2(x f64) f64 = extern("log2")

// log10 returns the base-10 logarithm of x
fn log10(x f64) f64 = extern("log10")

// Trigonometric

// sin returns the sine of x (radians)
fn sin(x f64) f64 = extern("sin")

// cos returns the cosine of x (radians)
fn cos(x f64) f64 = extern("cos")

// tan returns the tangent of x (radians)
fn tan(x f64) f64 = extern("tan")

// asin returns the arc-sine of x (result in radians)
fn asin(x f64) f64 = extern("asin")

// acos returns the arc-cosine of x
fn acos(x f64) f64 = extern("acos")

// atan returns the arc-tangent of x
fn atan(x f64) f64 = extern("atan")

// atan2 returns the arc-tangent of y/x, using the signs to determine the quadrant
fn atan2(y f64, x f64) f64 = extern("atan2")

// Rounding

// floor rounds x down to the nearest integer
fn floor(x f64) f64 = extern("floor")

// ceil rounds x up to the nearest integer
fn ceil(x f64) f64 = extern("ceil")

// round rounds x to the nearest integer, rounding halfway away from zero
fn round(x f64) f64 = extern("round")

// trunc rounds x towards zero
fn trunc(x f64) f64 = extern("trunc")

// Min / max

// fmin returns the smaller of x and y
fn fmin(x f64, y f64) f64 = extern("fmin")

// fmax returns the larger of x and y
fn fmax(x f64, y f64) f64 = extern("fmax")

// Constants

// PI is the ratio of a circle's circumference to its diameter
const PI f64 = 3.14159265358979323846

// E is Euler's number (the base of natural logarithm)
const E f64 = 2.71828182845904523536

export {
  fabs, fmod,
  sqrt, cbrt, pow, hypot,
  exp, exp2, log, log2, log10,
  sin, cos, tan, asin, acos, atan, atan2,
  floor, ceil, round, trunc,
  fmin, fmax,
  PI, E
} as math
