// os_files - high-level file read/write operations.
//
// Loaded via use "./os_files" in os.tin; all symbols are embedded directly
// into the os package scope. Do not add an export declaration to this file.

use io
use mem
use errors
use sync
use { Unit } from sync
use result
use { Result } from result

// C runtime helpers for string/byte conversions (already in the runtime).
fn tin_str_from_bytes(ptr *byte, n i64) string = extern("_tin_string_from_bytes")
fn tin_str_data(s string) *byte                = extern("_tin_string_data")

// OsError is the typed error every os function returns through. With
// ADTs implementing traits directly (Workstream A), the variant set
// and the trait impl collapse into a single ADT - no separate
// XxxErrorKind data + XxxError wrapper struct.
data OsError(errors::Err, print) =
  CannotOpen(op string, path string)
  CannotRead(op string, path string)
  CannotWrite(op string, path string)
  CannotMkdir(path string)
  CannotRemove(path string)
  CannotRmdir(path string)
  CannotRename(src string, dst string)
  StatFailed(path string)

  fn errors::Err::message(this OsError) string =
    match this:
      case CannotOpen(op, path):   return op ++ ": cannot open: " ++ path
      case CannotRead(op, path):   return op ++ ": cannot read: " ++ path
      case CannotWrite(op, path):  return op ++ ": cannot write: " ++ path
      case CannotMkdir(path):      return "mkdir: cannot create: " ++ path
      case CannotRemove(path):     return "remove: cannot delete: " ++ path
      case CannotRmdir(path):      return "rmdir: cannot remove: " ++ path
      case CannotRename(src, dst): return "rename: cannot move " ++ src ++ " -> " ++ dst
      case StatFailed(path):       return "stat: failed for: " ++ path

  fn ::print(this OsError) string = return this.message()

// read_file reads the entire contents of path and returns it as a string.
fn read_file(path string) Result[string, errors::Err] =
  let f = io::fopen(path, "rb")

  if f == nil:
    return Err(CannotOpen("read_file", path))
  io::fseek(f, 0, 2)
  let sz = io::ftell(f)

  io::fseek(f, 0, 0)
  let buf = mem::malloc(sz + 1) as *byte
  let n = io::fread(buf as *void, 1, sz, f)

  io::fclose(f)
  let s = buf[0..n] as string

  mem::free(buf as *void)

  return Ok(s)

// read_file_bytes reads the entire contents of path as a byte slice.
fn read_file_bytes(path string) Result[[byte], errors::Err] =
  let f = io::fopen(path, "rb")

  if f == nil:
    return Err(CannotOpen("read_file_bytes", path))

  io::fseek(f, 0, 2)
  let sz = io::ftell(f)

  io::fseek(f, 0, 0)
  let buf = mem::malloc(sz + 1) as *byte
  let n = io::fread(buf as *void, 1, sz, f)

  io::fclose(f)
  let bytes = buf[0..n]

  mem::free(buf as *void)

  return Ok(bytes)

// write_file writes content to path, creating or truncating the file.
fn write_file(path string, content string) Result[Unit, errors::Err] =
  let f = io::fopen(path, "wb")

  if f == nil:
    return Err(CannotOpen("write_file", path))
  let ptr = tin_str_data(content)
  let n = len(content)

  io::fwrite(ptr as *void, 1, n, f)
  io::fclose(f)

  return Ok(Unit{_unit: 0})

// write_file_bytes writes data to path, creating or truncating the file.
fn write_file_bytes(path string, data [byte]) Result[Unit, errors::Err] =
  let f = io::fopen(path, "wb")

  if f == nil:
    return Err(CannotOpen("write_file_bytes", path))
  let n = len(data)

  if n > 0:
    let ptr = &data[0]

    io::fwrite(ptr as *void, 1, n, f)

  io::fclose(f)

  return Ok(Unit{_unit: 0})

// append_file appends content to path, creating it if it does not exist.
fn append_file(path string, content string) Result[Unit, errors::Err] =
  let f = io::fopen(path, "ab")

  if f == nil:
    return Err(CannotOpen("append_file", path))
  let ptr = tin_str_data(content)
  let n = len(content)

  io::fwrite(ptr as *void, 1, n, f)
  io::fclose(f)

  return Ok(Unit{_unit: 0})
