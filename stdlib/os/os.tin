// stdlib/os — Operating-system interface
//
// Wraps standard C stdlib.h / unistd.h process and environment functions
// No extra linker flags required (all in libc)

// -- Process control

// exit terminates the process with the given status code
// Conventionally 0 = success, non-zero = failure
fn exit(code i32) = extern("exit")

// abort terminates the process abnormally (raises SIGABRT)
fn abort() = extern("abort")

// system runs the given shell command and returns the exit status
fn system(cmd string) i32 = extern("system")

// -- Environment

// getenv retrieves the value of the environment variable named name
// Returns the value as a string, or an empty string if not set
fn getenv(name string) string = extern("getenv")

// setenv sets the environment variable name to value
// If overwrite is non-zero, an existing variable is overwritten
// Returns 0 on success, -1 on error (POSIX)
fn setenv(name string, value string, overwrite i32) i32 = extern("setenv")

// unsetenv removes the environment variable name
fn unsetenv(name string) i32 = extern("unsetenv")

// -- Process information

// getpid returns the process ID of the calling process
fn getpid() i32 = extern("getpid")

// getppid returns the parent process ID
fn getppid() i32 = extern("getppid")

export {
  exit, abort, system,
  getenv, setenv, unsetenv,
  getpid, getppid
} as os
