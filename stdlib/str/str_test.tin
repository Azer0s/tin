// stdlib/str/str_test.tin
//
// Tests for the str stdlib: strlen, strcmp, strncmp, strcasecmp,
// strstr, atoi, atol, atof, parse_int, parse_int32, parse_float.
// Run with: tin test stdlib/str/str_test.tin

use assert
use str
use errors

// strlen

test "strlen empty string" =
  assert::equals(str::strlen(""), 0)

test "strlen basic" =
  assert::equals(str::strlen("hello"), 5)

test "strlen with spaces" =
  assert::equals(str::strlen("hello world"), 11)

// strcmp

test "strcmp equal strings" =
  assert::equals(str::strcmp("abc", "abc") as i64, 0)

test "strcmp less than" =
  assert::ok(str::strcmp("abc", "abd") < 0)

test "strcmp greater than" =
  assert::ok(str::strcmp("abd", "abc") > 0)

test "strcmp empty vs non-empty" =
  assert::ok(str::strcmp("", "a") < 0)

test "strcmp both empty" =
  assert::equals(str::strcmp("", "") as i64, 0)

// strncmp

test "strncmp equal within n" =
  assert::equals(str::strncmp("abcXXX", "abcYYY", 3) as i64, 0)

test "strncmp differ within n" =
  assert::ok(str::strncmp("abcX", "abcY", 4) != 0)

// strcasecmp

test "strcasecmp equal case insensitive" =
  assert::equals(str::strcasecmp("Hello", "hello") as i64, 0)

test "strcasecmp equal mixed case" =
  assert::equals(str::strcasecmp("ABC", "abc") as i64, 0)

test "strcasecmp differ" =
  assert::ok(str::strcasecmp("abc", "xyz") != 0)

// strstr

// strstr returns a *char - tested via strchr which gives comparable results.
// Direct null-pointer comparison omitted as the null literal is context-specific.

// atoi / atol

test "atoi positive" =
  assert::equals(str::atoi("42") as i64, 42)

test "atoi negative" =
  assert::equals(str::atoi("-7") as i64, 0 - 7)

test "atoi zero" =
  assert::equals(str::atoi("0") as i64, 0)

test "atol positive" =
  assert::equals(str::atol("123456789"), 123456789)

test "atol negative" =
  assert::equals(str::atol("-1"), 0 - 1)

// atof

test "atof positive" =
  assert::equals(str::atof("3.14"), 3.14)

test "atof negative" =
  assert::equals(str::atof("-2.5"), 0.0 - 2.5)

test "atof integer string" =
  assert::equals(str::atof("10"), 10.0)

// parse_int

test "parse_int positive" =
  let (v, err) = str::parse_int("42")
  assert::ok(!errors::has(err))
  assert::equals(v, 42)

test "parse_int negative" =
  let (v, err) = str::parse_int("-7")
  assert::ok(!errors::has(err))
  assert::equals(v, 0 - 7)

test "parse_int with plus sign" =
  let (v, err) = str::parse_int("+5")
  assert::ok(!errors::has(err))
  assert::equals(v, 5)

test "parse_int empty string is error" =
  let (_, err) = str::parse_int("")
  assert::ok(errors::has(err))

test "parse_int sign only is error" =
  let (_, err) = str::parse_int("-")
  assert::ok(errors::has(err))

test "parse_int invalid char is error" =
  let (_, err) = str::parse_int("12x")
  assert::ok(errors::has(err))

// parse_int32

test "parse_int32 basic" =
  let (v, err) = str::parse_int32("100")
  assert::ok(!errors::has(err))
  assert::equals(v as i64, 100)

test "parse_int32 invalid is error" =
  let (_, err) = str::parse_int32("abc")
  assert::ok(errors::has(err))

// parse_float

test "parse_float positive" =
  let (v, err) = str::parse_float("3.14")
  assert::ok(!errors::has(err))
  assert::equals(v, 3.14)

test "parse_float negative" =
  let (v, err) = str::parse_float("-2.5")
  assert::ok(!errors::has(err))
  assert::equals(v, 0.0 - 2.5)

test "parse_float integer" =
  let (v, err) = str::parse_float("10")
  assert::ok(!errors::has(err))
  assert::equals(v, 10.0)

test "parse_float exponent" =
  let (v, err) = str::parse_float("1.5e2")
  assert::ok(!errors::has(err))
  assert::equals(v, 150.0)

test "parse_float empty is error" =
  let (_, err) = str::parse_float("")
  assert::ok(errors::has(err))

test "parse_float invalid is error" =
  let (_, err) = str::parse_float("abc")
  assert::ok(errors::has(err))
