//!+reflect.c -- -I ../../runtime

// stdlib/reflect - Type atom inspection
//
// The reflect package provides predicates and destructors for Tin type atoms
// Type atoms are the values returned by typeof(), fieldtypes(), etc
//
// Atom format:
//   'i64              -> primitive type
//   '*point           -> pointer type  (elem = 'point)
//   '[i64]            -> array type    (elem = 'i64)
//   'fn(i64)bool      -> function type (fn_arity=1, fn_param(0)='i64, fn_ret='bool)
//
// All functions accept atom values. Atoms coerce automatically to string/i8*
// when passed to extern functions since they share the same fat-pointer layout

// kind returns the category of the type atom:
// "ptr", "array", "fn", "primitive", or "struct"
fn kind(t atom) string = extern("_tin_reflect_kind")

// elem returns the inner type atom for pointer or array types
// For '*point returns 'point; for '[i64] returns 'i64
// Returns '' for all other types
fn elem(t atom) atom = extern("_tin_reflect_elem")

// fn_ret returns the return type atom for a function type atom
// For 'fn(i64,f64)bool returns 'bool
// Returns '' for non-function types
fn fn_ret(t atom) atom = extern("_tin_reflect_fn_ret")

// fn_params returns the list of parameter type atoms for a function type atom
// For 'fn(i64,f64)bool returns ['i64, 'f64]
// Returns [] for non-function types or zero-argument functions
fn fn_params(t atom) [atom] = extern("_tin_reflect_fn_params")

// is_ptr returns 1 if the atom denotes a pointer type (*T), 0 otherwise
fn is_ptr(t atom) i64 = extern("_tin_reflect_is_ptr")

// is_fn returns 1 if the atom denotes a function type (fn(...)), 0 otherwise
fn is_fn(t atom) i64 = extern("_tin_reflect_is_fn")

// is_array returns 1 if the atom denotes an array type ([T]), 0 otherwise
fn is_array(t atom) i64 = extern("_tin_reflect_is_array")

// is_primitive returns 1 if the atom denotes a primitive type, 0 otherwise
fn is_primitive(t atom) i64 = extern("_tin_reflect_is_primitive")

export {
  kind, elem, fn_ret, fn_params,
  is_ptr, is_fn, is_array, is_primitive
} as reflect
