// stdlib/source - parse the atom shapes that sourcepos() and stacktrace()
// emit into a typed SrcPos struct.
//
// The runtime emits seven shapes:
//   symbol@file:line:col          - sourcepos / stacktrace user-fn frame
//   file:line:col                 - sourcepos on a non-identifier expr
//   <lib>:symbol+0x<offset>       - stacktrace shared-lib frame
//   <lib>:symbol                  - shared-lib fn-entry frame (offset 0)
//   symbol+0x<offset>             - stacktrace symbol-only frame
//   symbol                        - sourcepos / stacktrace fn entry (offset 0)
//   ??+0x<addr>                   - stacktrace unresolved frame
// Each may be wrapped by a "<spawn-of>:" prefix (frames frozen at fiber spawn).
//
// Import:
//
//   use source
//   let p = source::parse_sourcepos(sourcepos(my_fn))
//   echo p.symbol  // my_fn
//   echo p.file    // src/...
//   echo p.line    // 42

use strings

// SrcPos is the parsed shape of a sourcepos() or stacktrace() atom.
// All fields are optional; absent ones stay zero/empty:
//   symbol    - "main" / "_tin_run_test" / "" if anonymous
//   file      - "src/server.tin" / "" if symbol-only frame
//   line, col - 1-based source position; 0 if absent
//   lib       - "libssl.so.3" basename for shared-lib frames; "" otherwise
//   offset    - byte offset within symbol; 0 for file:line:col-only frames
//   address   - raw IP for "??+0x<addr>" frames; 0 otherwise
//   spawn_of  - true for the "<spawn-of>:..." prefix that stacktrace()
//               emits on frames frozen at fiber-spawn time
struct SrcPos =
  symbol   string
  file     string
  line     i64
  col      i64
  lib      string
  offset   i64
  address  i64
  spawn_of bool

// parse_sourcepos parses a sourcepos / stacktrace atom into a SrcPos.
fn parse_sourcepos(a atom) SrcPos =
  let raw = a as string
  // Complex atoms come back wrapped in double quotes (lexer
  // round-trip). Strip them so the parser sees the bare contents.
  let s = strip_quotes(raw)

  // <spawn-of>: prefix is independent of the rest; peel it off first
  // so the inner shape can be parsed by the same code path.
  let from_spawn = false
  if strings::has_prefix(s, "<spawn-of>:"):
    from_spawn = true
    s = strings::substr(s, 11 as i64, len(s))

  let p = SrcPos{symbol: "", file: "", line: 0 as i64, col: 0 as i64, lib: "", offset: 0 as i64, address: 0 as i64, spawn_of: from_spawn}

  // ??+0x<addr> always renders unresolved frames; recognise the
  // sentinel up front so we don't mistake "??" for a symbol.
  if strings::has_prefix(s, "??+0x"):
    p.address = parse_hex(strings::substr(s, 5 as i64, len(s)))

    return p

  // symbol@file:line:col is the canonical "fully resolved" form.
  // Split on '@'; LHS is the symbol, RHS feeds into the file:line:col
  // path that's also used for the bare positional form.
  let at_ix = strings::index_of(s, "@")
  if at_ix >= 0:
    p.symbol = strings::substr(s, 0 as i64, at_ix)
    let rest = strings::substr(s, at_ix + 1, len(s))
    fill_file_line_col(&p, rest)

    return p

  // No '@'. Two possibilities left: <lib>:symbol+0x<offset>
  // (shared-lib symbol-only frame) or a standalone symbol(+0xN) /
  // file:line:col without a leading symbol prefix. Tell them apart
  // by looking for a '+0x' anywhere; that always indicates the
  // symbol+offset form. Otherwise treat as file:line:col.
  let plus_ix = strings::index_of(s, "+0x")
  if plus_ix >= 0:
    let lhs = strings::substr(s, 0 as i64, plus_ix)
    p.offset = parse_hex(strings::substr(s, plus_ix + 3, len(s)))
    // <lib>:symbol pattern: a colon LEFT of '+0x' splits lib from
    // symbol. Without the colon the whole prefix is the symbol.
    let colon_ix = strings::index_of(lhs, ":")
    if colon_ix >= 0:
      p.lib = strings::substr(lhs, 0 as i64, colon_ix)
      p.symbol = strings::substr(lhs, colon_ix + 1, len(lhs))
    else:
      p.symbol = lhs

    return p

  // No '@', no '+0x'. Three remaining shapes:
  //   1. file:line:col          - sourcepos on non-identifier expr
  //   2. <lib>:symbol           - shared-lib frame at fn entry (off=0)
  //   3. bare symbol            - sourcepos simple-atom for identifiers
  //
  // file:line:col has two trailing numeric segments separated by ':'.
  // <lib>:symbol has exactly one ':' AND the lhs ends in a shared-lib
  // suffix (.so / .so.<n> / .dylib). Bare symbol has neither.
  if has_trailing_pos(s):
    fill_file_line_col(&p, s)

    return p
  let colon_ix = strings::index_of(s, ":")
  if colon_ix > 0:
    let lhs = strings::substr(s, 0 as i64, colon_ix)
    if looks_like_shared_lib(lhs):
      p.lib = lhs
      p.symbol = strings::substr(s, colon_ix + 1, len(s))

      return p
  p.symbol = s

  return p

// looks_like_shared_lib mirrors runtime/stacktrace.c::is_shared_lib_path
// closely enough for parser disambiguation. Intentionally lenient: a
// false positive here just classifies a colon-bearing symbol as a
// lib-prefixed frame, which is wrong but cosmetic. Real shared libs
// always end in ".so", ".so.<digits>" (versioned), or ".dylib".
fn looks_like_shared_lib(name string) bool =
  if strings::has_suffix(name, ".so"): return true
  if strings::has_suffix(name, ".dylib"): return true
  // .so.<digits[.digits...]> versioned form
  let n = len(name)
  let i i64 = n - 1
  // walk backwards over digits and dots
  for i >= 0:
    let c = name[i]
    if c >= @'0' && c <= @'9': i = i - 1
    else if c == @'.': i = i - 1
    else: break
  if i < 2: return false
  if name[i - 2] == @'.' && name[i - 1] == @'s' && name[i] == @'o':
    return true

  return false

// strip_quotes removes one layer of leading + trailing double quotes
// if both are present. Used to normalise complex atoms (lexer
// round-trip) before parsing.
fn strip_quotes(s string) string =
  let n = len(s)
  if n < 2: return s
  if s[0] != @'\"': return s
  if s[n - 1] != @'\"': return s

  return strings::substr(s, 1 as i64, n - 1)

// fill_file_line_col splits "file:line:col" off the right side of
// `s` and writes the three parts into `p`. The file part may itself
// contain colons (shared-lib paths on Windows etc.) so the split
// works from the END: the last two `:` separate file from line:col.
fn fill_file_line_col(p *SrcPos, s string) =
  let last = strings::last_index_of(s, ":")
  if last < 0:
    p.file = s

    return
  let prev = strings::last_index_of(strings::substr(s, 0 as i64, last), ":")
  if prev < 0:
    p.file = strings::substr(s, 0 as i64, last)
    p.line = parse_int(strings::substr(s, last + 1, len(s)))

    return
  p.file = strings::substr(s, 0 as i64, prev)
  p.line = parse_int(strings::substr(s, prev + 1, last))
  p.col  = parse_int(strings::substr(s, last + 1, len(s)))

// has_trailing_pos returns true if s ends with ":<digits>:<digits>".
// Used to disambiguate "file:line:col" from a bare "symbol" atom.
fn has_trailing_pos(s string) bool =
  let last = strings::last_index_of(s, ":")
  if last < 0: return false
  if last == len(s) - 1: return false
  let tail = strings::substr(s, last + 1, len(s))
  if !is_digits(tail): return false
  let head = strings::substr(s, 0 as i64, last)
  let prev = strings::last_index_of(head, ":")
  if prev < 0: return false
  let mid = strings::substr(head, prev + 1, len(head))

  return is_digits(mid)

fn is_digits(s string) bool =
  let n = len(s)
  if n == 0: return false
  let i i64 = 0
  for i < n:
    let c = s[i]
    if c < @'0' || c > @'9': return false
    i = i + 1

  return true

fn parse_int(s string) i64 =
  let n = len(s)
  let v i64 = 0
  let i i64 = 0
  for i < n:
    let c = s[i]
    if c < @'0' || c > @'9': return v
    v = v * 10 + ((c - @'0') as i64)
    i = i + 1

  return v

fn parse_hex(s string) i64 =
  let n = len(s)
  let v i64 = 0
  let i i64 = 0
  for i < n:
    let c = s[i]
    let d i64 = 0
    if c >= @'0' && c <= @'9':
      d = (c - @'0') as i64
    else if c >= @'a' && c <= @'f':
      d = (c - @'a') as i64 + 10
    else if c >= @'A' && c <= @'F':
      d = (c - @'A') as i64 + 10
    else:
      return v
    v = v * 16 + d
    i = i + 1

  return v

// is_resolved reports whether the parser found ANY information
// (symbol or file). False only for raw "??+0x..." atoms after
// stripping the spawn-of prefix.
fn is_resolved(p SrcPos) bool =
  return p.symbol != "" || p.file != ""

// is_in_lib reports whether this frame belongs to a shared library
// (lib basename present). Useful for filtering libc / vendor frames.
fn is_in_lib(p SrcPos) bool = return p.lib != ""

// is_unknown reports whether the atom was the "??+0x<addr>" sentinel.
fn is_unknown(p SrcPos) bool =
  return p.symbol == "" && p.file == "" && p.address != 0 as i64

export {
  SrcPos, parse_sourcepos, is_resolved, is_in_lib, is_unknown
} as source
