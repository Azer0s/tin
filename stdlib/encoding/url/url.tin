// stdlib/encoding/url - URL percent-encoding (RFC 3986).
//
// Unreserved characters (A-Z a-z 0-9 - _ . ~) are passed through unchanged.
// All other bytes are percent-encoded as %XX where XX is the uppercase hex
// value of the byte.
//
// decode also handles application/x-www-form-urlencoded: '+' is treated as
// a space on decode (but spaces are encoded as %20, not '+', on encode).
//
// encode_query / parse_query handle full query strings backed by HashMaps.

use assert
use collections

fn hex_char(n i64) byte =
  if n < 10:
    return (n + 48) as byte   // '0' = 48
  return (n + 55) as byte     // 'A' - 10 = 55

// encode percent-encodes s for use in a URL.
// Unreserved chars (RFC 3986) are left as-is; everything else becomes %XX.
fn encode(s string) string =
  let result = ""
  let i i64 = 0
  let n = len(s)

  for i < n:
    let c = s[i] as byte
    let unreserved = (c >= @'A' && c <= @'Z') || (c >= @'a' && c <= @'z') || (c >= @'0' && c <= @'9') || c == @'-' || c == @'_' || c == @'.' || c == @'~'

    if unreserved:
      result = result ++ c
    else:
      let v = c as i64

      result = result ++ @'%'
      result = result ++ hex_char((v >> 4) & 0xF)
      result = result ++ hex_char(v & 0xF)

    i = i + 1

  return result

// encode_component is an alias for encode.  Both names are kept for API
// clarity at call sites; behavior is identical.
fn encode_component(s string) string =
  return encode(s)

fn from_hex(c byte) i64 =
  if c >= @'0' && c <= @'9':
    return (c - @'0') as i64
  if c >= @'A' && c <= @'F':
    return ((c - @'A') as i64) + 10
  if c >= @'a' && c <= @'f':
    return ((c - @'a') as i64) + 10

  return -1

// decode decodes a percent-encoded string.
// %XX sequences are decoded to the corresponding byte.
// '+' is decoded as a space (application/x-www-form-urlencoded compatibility).
// Invalid %XX sequences are passed through unchanged.
fn decode(s string) string =
  let result = ""
  let i i64 = 0
  let n = len(s)

  for i < n:
    let c = s[i] as byte

    if c == @'%' && i + 2 < n:
      let hi = from_hex(s[i + 1] as byte)
      let lo = from_hex(s[i + 2] as byte)

      if hi >= 0 && lo >= 0:
        result = result ++ (hi * 16 + lo) as byte
        i = i + 3
      else:
        result = result ++ c
        i = i + 1
    else if c == @'+':
      result = result ++ @' '
      i = i + 1
    else:
      result = result ++ c
      i = i + 1

  return result

// str_lt returns true if a is lexicographically less than b.
fn str_lt(a string, b string) bool =
  let na = len(a)
  let nb = len(b)
  let n = na

  if nb < na: n = nb
  let i i64 = 0

  for i < n:
    let ca = a[i] as i64
    let cb = b[i] as i64

    if ca < cb: return true
    if ca > cb: return false
    i = i + 1

  return na < nb

fn url_substr(s string, from i64, to i64) string =
  let out = ""
  let i i64 = from

  for i < to:
    out = out ++ s[i]
    i = i + 1

  return out

// encode_query encodes the key-value pairs in params as a URL query string.
// Keys are sorted lexicographically; both keys and values are percent-encoded
// so that `&`, `=`, `+`, `/` etc. are escaped.
fn encode_query(params collections::HashMap[string, string]) string =
  let ks = params.keys()
  let n = len(ks)

  // Sort keys lexicographically (insertion sort).
  let i i64 = 1

  for i < n:
    let key = ks[i]
    let j i64 = i - 1

    for j >= 0:
      if !str_lt(key, ks[j]):
        break
      ks[j + 1] = ks[j]
      j = j - 1

    ks[j + 1] = key
    i = i + 1

  let result = ""
  let k i64 = 0

  for k < n:
    if k > 0:
      result = result ++ "&"
    result = result ++ encode(ks[k]) ++ "=" ++ encode(params.get(ks[k]))
    k = k + 1

  return result

fn parse_segment(m *collections::HashMap[string, string], s string, from i64, to i64) =
  if to <= from: return
  let eq i64 = 0 - 1
  let j i64 = from

  for j < to:
    if s[j] as byte == @'=':
      eq = j
      break

    j = j + 1

  let key = ""
  let val = ""

  if eq < from:
    key = decode(url_substr(s, from, to))
  else:
    key = decode(url_substr(s, from, eq))
    val = decode(url_substr(s, eq + 1, to))

  if len(key) > 0:
    m.set(key, val)

// parse_query parses a URL query string (without leading `?`) into a
// HashMap[string,string].  Keys and values are percent-decoded; `+` is
// treated as a space.  Duplicate keys keep the last value.
fn parse_query(s string) collections::HashMap[string, string] =
  let m = collections::HashMap[string, string].make(8)
  let n = len(s)

  if n == 0:
    return m
  let start i64 = 0
  let i i64 = 0

  for i < n:
    if s[i] as byte == @'&':
      parse_segment(&m, s, start, i)
      start = i + 1

    i = i + 1

  parse_segment(&m, s, start, n)

  return m

test "encode unreserved chars unchanged" =
  assert::equals(encode("abc"), "abc")
  assert::equals(encode("ABC"), "ABC")
  assert::equals(encode("123"), "123")
  assert::equals(encode("-_.~"), "-_.~")

test "encode special chars" =
  assert::equals(encode(" "), "%20")
  assert::equals(encode("/"), "%2F")
  assert::equals(encode("?"), "%3F")
  assert::equals(encode("="), "%3D")
  assert::equals(encode("&"), "%26")
  assert::equals(encode("+"), "%2B")

test "encode mixed string" =
  assert::equals(encode("hello world"), "hello%20world")
  assert::equals(encode("foo=bar&baz=qux"), "foo%3Dbar%26baz%3Dqux")
  assert::equals(encode("https://example.com/path?q=1"), "https%3A%2F%2Fexample.com%2Fpath%3Fq%3D1")

test "encode_component is alias for encode" =
  assert::equals(encode_component("hello world"), encode("hello world"))
  assert::equals(encode_component("a&b=c"), encode("a&b=c"))

test "decode percent sequences" =
  assert::equals(decode("%20"), " ")
  assert::equals(decode("%2F"), "/")
  assert::equals(decode("%3F"), "?")
  assert::equals(decode("hello%20world"), "hello world")

test "decode plus as space" =
  assert::equals(decode("hello+world"), "hello world")
  assert::equals(decode("a+b+c"), "a b c")

test "decode invalid sequence passthrough" =
  assert::equals(decode("%ZZ"), "%ZZ")
  assert::equals(decode("%2"), "%2")

test "decode lowercase hex" =
  assert::equals(decode("%2f"), "/")
  assert::equals(decode("%3d"), "=")

test "encode then decode roundtrip" =
  let original = "hello world! foo=bar&baz=123"

  assert::equals(decode(encode(original)), original)

test "encode_query sorts keys lexicographically" =
  let m = collections::HashMap[string, string].make(4)

  m.set("b", "2")
  m.set("a", "1")
  m.set("c", "3")
  assert::equals(encode_query(m), "a=1&b=2&c=3")

test "encode_query escapes special characters" =
  let m = collections::HashMap[string, string].make(2)

  m.set("q", "hello world")
  m.set("p", "a&b")
  assert::equals(encode_query(m), "p=a%26b&q=hello%20world")

test "parse_query parses key=value pairs" =
  let m = parse_query("a=1&b=2&c=3")

  assert::equals(m.get("a"), "1")
  assert::equals(m.get("b"), "2")
  assert::equals(m.get("c"), "3")

test "parse_query decodes escapes and plus" =
  let m = parse_query("q=hello+world&p=a%26b")

  assert::equals(m.get("q"), "hello world")
  assert::equals(m.get("p"), "a&b")

test "parse_query handles bare keys without =" =
  let m = parse_query("flag&k=v")

  assert::equals(m.get("flag"), "")
  assert::equals(m.get("k"), "v")

test "parse_query duplicate key keeps last value" =
  let m = parse_query("k=1&k=2&k=3")

  assert::equals(m.get("k"), "3")

test "parse_query empty input" =
  let m = parse_query("")

  assert::equals(m.len(), 0)

test "encode_query / parse_query roundtrip" =
  let original = collections::HashMap[string, string].make(4)

  original.set("name", "alice & bob")
  original.set("age", "30")
  original.set("city", "New York")
  let q = encode_query(original)
  let parsed = parse_query(q)

  assert::equals(parsed.get("name"), "alice & bob")
  assert::equals(parsed.get("age"), "30")
  assert::equals(parsed.get("city"), "New York")

export { encode, encode_component, decode, encode_query, parse_query } as url
