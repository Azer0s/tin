use encoding::csv
use assert

// --- parse: basic shape ---

test "parse simple two-row file" =
  let rows = csv::parse("a,b,c\nd,e,f\n")

  assert::equals(2, len(rows))
  assert::equals(3, len(rows[0]))
  assert::equals("a", rows[0][0])
  assert::equals("b", rows[0][1])
  assert::equals("c", rows[0][2])
  assert::equals("d", rows[1][0])
  assert::equals("f", rows[1][2])

test "parse handles missing trailing newline" =
  let rows = csv::parse("a,b\nc,d")

  assert::equals(2, len(rows))
  assert::equals("c", rows[1][0])
  assert::equals("d", rows[1][1])

test "parse single empty input yields no rows" =
  let rows = csv::parse("")

  assert::equals(0, len(rows))

test "parse empty fields are kept" =
  let rows = csv::parse("a,,c\n,,\n")

  assert::equals(3, len(rows[0]))
  assert::equals("a", rows[0][0])
  assert::equals("",  rows[0][1])
  assert::equals("c", rows[0][2])
  assert::equals("",  rows[1][0])
  assert::equals("",  rows[1][1])
  assert::equals("",  rows[1][2])

// --- parse: quoting ---

test "parse quoted field with embedded comma" =
  let rows = csv::parse("\"a,b\",c\n")

  assert::equals(2, len(rows[0]))
  assert::equals("a,b", rows[0][0])
  assert::equals("c",   rows[0][1])

test "parse quoted field with escaped quote" =
  let rows = csv::parse("\"he said \"\"hi\"\"\",done\n")

  assert::equals("he said \"hi\"", rows[0][0])
  assert::equals("done",            rows[0][1])

test "parse quoted field with embedded newline" =
  let rows = csv::parse("\"line1\nline2\",end\n")

  assert::equals(1, len(rows))
  assert::equals("line1\nline2", rows[0][0])
  assert::equals("end",          rows[0][1])

// --- parse: line endings ---

test "parse handles CRLF line endings" =
  let rows = csv::parse("a,b\r\nc,d\r\n")

  assert::equals(2, len(rows))
  assert::equals("c", rows[1][0])

// --- parse: alt delimiter ---

test "parse_with handles tab delimiter" =
  let rows = csv::parse_with("a\tb\tc\n", @'\t')

  assert::equals(3, len(rows[0]))
  assert::equals("a", rows[0][0])
  assert::equals("c", rows[0][2])

// --- streaming Reader ---

test "Reader.next streams rows one at a time" =
  let r = csv::reader("x,1\ny,2\nz,3\n")
  let (row1, ok1) = r.next()
  let (row2, ok2) = r.next()
  let (row3, ok3) = r.next()
  let (_,    ok4) = r.next()

  assert::ok(ok1)
  assert::ok(ok2)
  assert::ok(ok3)
  assert::ok(!ok4)
  assert::equals("x", row1[0])
  assert::equals("y", row2[0])
  assert::equals("3", row3[1])

// --- encode ---

test "encode simple rows round-trips through parse" =
  let rows [[string]] = []
  rows ++= [["a", "b"] as [string]]
  rows ++= [["c", "d"] as [string]]
  let s = csv::encode(rows)

  assert::equals("a,b\nc,d\n", s)

test "encode quotes fields containing the delimiter" =
  assert::equals("\"a,b\"", csv::encode_field("a,b", @','))

test "encode quotes fields containing a quote and doubles it" =
  assert::equals("\"he said \"\"hi\"\"\"", csv::encode_field("he said \"hi\"", @','))

test "encode quotes fields containing newline" =
  assert::equals("\"line1\nline2\"", csv::encode_field("line1\nline2", @','))

test "encode leaves plain fields unchanged" =
  assert::equals("simple", csv::encode_field("simple", @','))

// --- Writer ---

test "Writer accumulates rows and renders to string" =
  let w = csv::writer()

  w.row(["name", "age"] as [string])
  w.row(["Alice", "30"] as [string])
  let out = w.to_string()

  assert::equals("name,age\nAlice,30\n", out)

// --- round-trip ---

test "encode then parse round-trips with quoting" =
  let original [[string]] = []
  original ++= [["plain", "has,comma", "has\"quote", "has\nnewline"] as [string]]
  let encoded = csv::encode(original)
  let decoded = csv::parse(encoded)

  assert::equals(1, len(decoded))
  assert::equals(4, len(decoded[0]))
  assert::equals("plain",        decoded[0][0])
  assert::equals("has,comma",    decoded[0][1])
  assert::equals("has\"quote",   decoded[0][2])
  assert::equals("has\nnewline", decoded[0][3])
