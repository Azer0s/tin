// stdlib/encoding/base64 - Base64 encoding and decoding.
//
// Standard and URL-safe variants. Decode handles both with or without padding.
//
// Variants:
//   encode             - standard alphabet (+ /), with = padding
//   encode_url         - URL-safe alphabet (- _), no padding
//   encode_url_no_pad  - explicit alias of encode_url
//   decode             - tolerant: any alphabet, padded or unpadded;
//                        unknown bytes are skipped silently
//   decode_strict      - rejects invalid bytes; returns (string, *Err)
//   decode_url_no_pad  - explicit alias of decode for URL-safe / unpadded inputs
//
// Import: use encoding::base64

use errors
use { Result } from result

fn b64_rev(c byte) i64 =
  if c >= @'A' && c <= @'Z':
    return (c - @'A') as i64
  if c >= @'a' && c <= @'z':
    return (c - @'a' + 26) as i64
  if c >= @'0' && c <= @'9':
    return (c - @'0' + 52) as i64
  if c == @'+' || c == @'-':
    return 62
  if c == @'/' || c == @'_':
    return 63

  return -1

fn encode_b64(s string, alpha string, pad bool) string =
  let n = len(s)

  if n == 0:
    return ""
  let result = ""
  let i i64 = 0

  // The `s[i] as i64` cast sign-extends tin's i8-shaped string
  // bytes, so any byte >= 0x80 turns negative and the bit-twiddling
  // below produces garbage in the upper sextets.  Mask with 0xFF to
  // recover unsigned semantics; required for callers that feed
  // raw signature/MAC bytes (HMAC tags, ed25519 sigs, ciphertext).
  for i + 2 < n:
    let b0 = (s[i]     as i64) & 0xFF
    let b1 = (s[i + 1] as i64) & 0xFF
    let b2 = (s[i + 2] as i64) & 0xFF

    result = result ++ alpha[(b0 >> 2) & 0x3F]
    result = result ++ alpha[((b0 << 4) | (b1 >> 4)) & 0x3F]
    result = result ++ alpha[((b1 << 2) | (b2 >> 6)) & 0x3F]
    result = result ++ alpha[b2 & 0x3F]
    i = i + 3

  let rem = n - i

  if rem == 1:
    let b0 = (s[i] as i64) & 0xFF

    result = result ++ alpha[(b0 >> 2) & 0x3F]
    result = result ++ alpha[(b0 << 4) & 0x3F]

    if pad:
      result = result ++ @'='
      result = result ++ @'='
  else if rem == 2:
    let b0 = (s[i]     as i64) & 0xFF
    let b1 = (s[i + 1] as i64) & 0xFF

    result = result ++ alpha[(b0 >> 2) & 0x3F]
    result = result ++ alpha[((b0 << 4) | (b1 >> 4)) & 0x3F]
    result = result ++ alpha[(b1 << 2) & 0x3F]

    if pad:
      result = result ++ @'='

  return result

// encode returns the standard Base64 encoding of s (with = padding).
fn encode(s string) string =
  return encode_b64(s, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true)

// encode_url returns the URL-safe Base64 encoding of s (no padding).
fn encode_url(s string) string =
  return encode_b64(s, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", false)

// encode_url_no_pad is an explicit alias for encode_url.  The two names
// document at the call site that the encoding does not produce trailing
// `=` padding; required for callers like JWT where the contract is
// "URL-safe, unpadded".
fn encode_url_no_pad(s string) string =
  return encode_url(s)

// decode decodes a Base64 string. Handles standard, URL-safe, padded or unpadded.
//
// LENIENT: any byte not in the base64 alphabet (and not `=`) is silently
// skipped.  This mirrors most legacy decoders but means malformed input
// can produce output that looks plausible.  Use `decode_strict` when the
// caller needs to reject invalid characters (auth tokens, signatures,
// anything where a wrong byte must surface as an error).
fn decode(s string) string =
  let n = len(s)

  if n == 0:
    return ""
  let result = ""
  let i i64 = 0
  let acc i64 = 0
  let bits i64 = 0

  for i < n:
    let c = s[i] as byte

    if c == @'=' || c == 0 as byte:
      i = n
    else:
      let v = b64_rev(c)

      if v >= 0:
        acc = (acc << 6) | v
        bits = bits + 6

        if bits >= 8:
          bits = bits - 8
          result = result ++ ((acc >> bits) & 0xFF) as byte

    i = i + 1

  return result

// decode_strict decodes a Base64 string, returning an error on any byte
// outside the standard or URL-safe alphabet (and outside the trailing
// `=` padding).  Required for auth-token / signature use cases where a
// silent skip of a malformed byte produces a wrong but plausible
// decoding.
fn decode_strict(s string) Result[string, errors::Err] =
  let n = len(s)

  if n == 0:
    return Ok("")
  let result = ""
  let i i64 = 0
  let acc i64 = 0
  let bits i64 = 0
  let saw_pad = false

  for i < n:
    let c = s[i] as byte

    if c == @'=':
      saw_pad = true
    else if saw_pad:
      // Anything after a `=` must itself be `=` or end-of-string.
      return Err(errors::new("base64::decode_strict: byte after padding"))
    else:
      // NUL was previously short-circuited as end-of-string; reject
      // it via the alphabet check instead so embedded NULs in user
      // input (auth tokens, signatures) cannot silently truncate
      // the decoded result -- which is the entire point of
      // decode_strict over decode.
      let v = b64_rev(c)

      if v < 0:
        return Err(errors::new("base64::decode_strict: invalid character"))
      acc = (acc << 6) | v
      bits = bits + 6

      if bits >= 8:
        bits = bits - 8
        result = result ++ ((acc >> bits) & 0xFF) as byte
    i = i + 1
  // Residual unused bits must be zero.  After consuming every
  // alphabet character, `bits` holds 0, 2, or 4 leftover low-order
  // bits in `acc`; for a well-formed encoding those bits are 0.  Non-
  // zero residue means the producer wrote a partial byte (e.g. "AB"
  // alone leaves 4 trailing bits).  Earlier versions silently dropped
  // the residue so the decoder accepted malformed truncations.
  if bits != 0:
    let mask = (1 << bits) - 1

    if (acc & mask) != 0:
      return Err(errors::new("base64::decode_strict: non-zero residual bits in last group"))

  return Ok(result)

// decode_url_no_pad is an explicit alias for decode that documents the
// expected URL-safe, unpadded input shape.  decode itself already
// accepts both alphabets and tolerates missing padding, so this is
// purely a naming hook for callers that want to be explicit.
fn decode_url_no_pad(s string) string =
  return decode(s)

export { encode, encode_url, encode_url_no_pad, decode, decode_strict, decode_url_no_pad } as base64
