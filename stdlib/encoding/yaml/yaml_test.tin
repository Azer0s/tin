// stdlib/yaml/yaml_test.tin
//
// Tests for the yaml stdlib: encoding, untyped parsing, and typed parsing.
// Run with: tin test stdlib/yaml/yaml_test.tin

use assert
use encoding::yaml

// Module-level structs used across multiple tests.

struct yt_point =
  x i64
  y i64

struct yt_tagged_user =
  id    i64    @"yaml:user_id"
  email string @"yaml:email_address"

struct yt_with_secret =
  name string
  pwd  string @"yaml:-"

struct yt_coord =
  x i64
  y i64

struct yt_api_user =
  id   i64    @"yaml:user_id"
  name string @"yaml:display_name"

struct yt_simple =
  x i64

struct yt_measure =
  val f64

struct yt_flags =
  enabled bool

struct yt_greeting =
  msg string

struct yt_rect =
  origin yt_point
  size   yt_point

// Encoding

test "encode bool true" =
  assert::equals(yaml::encode(true), "true\n")

test "encode bool false" =
  assert::equals(yaml::encode(false), "false\n")

test "encode i64 positive" =
  assert::equals(yaml::encode(42 as i64), "42\n")

test "encode i64 negative" =
  assert::equals(yaml::encode(0 - 7 as i64), "-7\n")

test "encode i64 zero" =
  assert::equals(yaml::encode(0 as i64), "0\n")

test "encode string plain" =
  assert::equals(yaml::encode("hello"), "hello\n")

test "encode string needs quoting - reserved word" =
  assert::equals(yaml::encode("null"), "\"null\"\n")

test "encode string needs quoting - colon" =
  assert::equals(yaml::encode("key: val"), "\"key: val\"\n")

test "encode string needs quoting - hash" =
  assert::equals(yaml::encode("hello # world"), "\"hello # world\"\n")

test "encode string needs quoting - newline" =
  assert::equals(yaml::encode("line1\nline2"), "\"line1\\nline2\"\n")

test "encode struct all fields" =
  let p = yt_point{x: 3, y: 4}

  assert::equals(yaml::encode(p), "x: 3\ny: 4\n")

test "encode struct with yaml tag rename" =
  let u = yt_tagged_user{id: 1, email: "a@b.com"}

  assert::equals(yaml::encode(u), "user_id: 1\nemail_address: a@b.com\n")

test "encode struct with yaml:- skips field" =
  let w = yt_with_secret{name: "alice", pwd: "hunter2"}

  assert::equals(yaml::encode(w), "name: alice\n")

test "encode nested struct" =
  let r = yt_rect{origin: yt_point{x: 0, y: 0}, size: yt_point{x: 100, y: 50}}

  assert::equals(yaml::encode(r), "origin:\n  x: 0\n  y: 0\nsize:\n  x: 100\n  y: 50\n")

// Untyped parsing

test "parse empty string returns null" =
  let v = yaml::parse("").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_null())

test "parse null keyword" =
  let v = yaml::parse("null").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_null())

test "parse tilde null" =
  let v = yaml::parse("~").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_null())

test "parse bool true" =
  let v = yaml::parse("true").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_bool())
  assert::ok(v.as_bool())

test "parse bool false" =
  let v = yaml::parse("false").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_bool())
  assert::not_ok(v.as_bool())

test "parse integer" =
  let v = yaml::parse("42").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_int())
  assert::equals(v.as_int(), 42)

test "parse negative integer" =
  let v = yaml::parse("-7").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_int())
  assert::equals(v.as_int(), 0 - 7)

test "parse float" =
  let v = yaml::parse("3.14").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_float())
  assert::equals(v.as_float(), 3.14)

test "parse plain string" =
  let v = yaml::parse("hello").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_string())
  assert::equals(v.as_string(), "hello")

test "parse double-quoted string" =
  let v = yaml::parse("\"hello world\"").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_string())
  assert::equals(v.as_string(), "hello world")

test "parse quoted string with escape sequences" =
  let v = yaml::parse("\"line1\\nline2\"").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_string())
  assert::equals(v.as_string(), "line1\nline2")

test "parse block mapping" =
  let v = yaml::parse("name: alice\nage: 30\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("name").as_string(), "alice")
  assert::equals(v.get("age").as_int(), 30)

test "parse block mapping missing key returns null" =
  let v = yaml::parse("x: 1\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.get("missing").is_null())

test "parse block mapping keys" =
  let v = yaml::parse("a: 1\nb: 2\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})
  let ks = v.keys()

  assert::equals(len(ks), 2)

test "parse block sequence of integers" =
  let v = yaml::parse("- 10\n- 20\n- 30\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 3)
  assert::equals(v.index(0).as_int(), 10)
  assert::equals(v.index(1).as_int(), 20)
  assert::equals(v.index(2).as_int(), 30)

test "parse block sequence of strings" =
  let v = yaml::parse("- apple\n- banana\n- cherry\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 3)
  assert::equals(v.index(0).as_string(), "apple")
  assert::equals(v.index(1).as_string(), "banana")
  assert::equals(v.index(2).as_string(), "cherry")

test "parse array out of bounds returns null" =
  let v = yaml::parse("- 1\n- 2\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.index(5).is_null())

test "parse nested block mapping" =
  let s = "origin:\n  x: 3\n  y: 4\nsize:\n  x: 100\n  y: 50\n"
  let v = yaml::parse(s).unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  let origin = v.get("origin")

  assert::ok(origin.is_object())
  assert::equals(origin.get("x").as_int(), 3)
  assert::equals(origin.get("y").as_int(), 4)
  let size = v.get("size")

  assert::equals(size.get("x").as_int(), 100)
  assert::equals(size.get("y").as_int(), 50)

test "parse flow mapping" =
  let v = yaml::parse("\{x: 1, y: 2\}").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("x").as_int(), 1)
  assert::equals(v.get("y").as_int(), 2)

test "parse flow sequence" =
  let v = yaml::parse("[1, 2, 3]").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 3)
  assert::equals(v.index(0).as_int(), 1)
  assert::equals(v.index(2).as_int(), 3)

test "parse empty flow sequence" =
  let v = yaml::parse("[]").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 0)

test "parse empty flow mapping" =
  let v = yaml::parse("\{\}").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(len(v.keys()), 0)

test "parse document with leading blank lines" =
  let v = yaml::parse("\n\nname: bob\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("name").as_string(), "bob")

test "parse document with comment lines" =
  let v = yaml::parse("# a comment\nval: 42\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("val").as_int(), 42)

test "parse document start marker" =
  let v = yaml::parse("---\nname: alice\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("name").as_string(), "alice")

test "parse inline comment on value line" =
  let v = yaml::parse("x: 99  # the answer\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("x").as_int(), 99)

test "parse block mapping with bool and float fields" =
  let v = yaml::parse("enabled: true\nrate: 1.5\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.get("enabled").as_bool())
  assert::equals(v.get("rate").as_float(), 1.5)

test "parse block mapping with quoted string value" =
  let v = yaml::parse("msg: \"hello, world\"\n").unwrap_or(yaml::Value{kind: yaml::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("msg").as_string(), "hello, world")

// Typed parsing

test "typed parse basic struct" =
  let c = yaml::parse[yt_coord]("x: 5\ny: 9\n").unwrap_or(yt_coord{})

  assert::equals(c.x, 5)
  assert::equals(c.y, 9)

test "typed parse with yaml tag" =
  let u = yaml::parse[yt_api_user]("user_id: 7\ndisplay_name: bob\n").unwrap_or(yt_api_user{})

  assert::equals(u.id, 7)
  assert::equals(u.name, "bob")

test "typed parse unknown keys ignored" =
  let s = yaml::parse[yt_simple]("x: 3\nextra: ignored\n").unwrap_or(yt_simple{})

  assert::equals(s.x, 3)

test "typed parse float field" =
  let m = yaml::parse[yt_measure]("val: 2.5\n").unwrap_or(yt_measure{})

  assert::equals(m.val, 2.5)

test "typed parse bool field" =
  let f = yaml::parse[yt_flags]("enabled: true\n").unwrap_or(yt_flags{})

  assert::ok(f.enabled)

test "typed parse string field" =
  let g = yaml::parse[yt_greeting]("msg: hi there\n").unwrap_or(yt_greeting{})

  assert::equals(g.msg, "hi there")

test "typed parse nested struct" =
  let s = "origin:\n  x: 3\n  y: 4\nsize:\n  x: 100\n  y: 50\n"
  let r = yaml::parse[yt_rect](s).unwrap_or(yt_rect{})

  assert::equals(r.origin.x, 3)
  assert::equals(r.origin.y, 4)
  assert::equals(r.size.x, 100)
  assert::equals(r.size.y, 50)
