// stdlib/yaml - YAML encoding and decoding
//
// Supports block-style YAML (the common human-readable format) with flow
// collections for inline values.  No external C dependencies.
//
// ## Encoding
//
// yaml::encode(v) serialises any Tin value to a YAML block-style string.
// Field tags @"yaml:key" rename fields; @"yaml:-" omits them.
//
//   struct point = x i64  y i64
//   echo yaml::encode(point{x: 1, y: 2})
//   // x: 1
//   // y: 2
//
// ## Parsing - untyped
//
// yaml::parse(s) returns a Value tree for untyped field access:
//
//   let v = yaml::parse("name: alice\nage: 30\n")
//   echo v.get("name").as_string()  // alice
//   echo v.get("age").as_int()      // 30
//
// ## Parsing - typed (generic)
//
// yaml::parse[T](s) decodes YAML directly into struct T.
// Field tags @"yaml:key" map YAML keys to struct fields.
//
//   struct point = x i64  y i64
//   let p = yaml::parse[point]("x: 3\ny: 4\n")
//   echo p.x    // 3

use str
use errors
use { Err } from errors

// YamlSerializable is implemented by types that produce their own YAML encoding.
// to_yaml must return a complete YAML scalar string.  The returned value is
// embedded directly as the mapping value, so it must be a valid YAML scalar
// (no trailing newline; quoting must be applied when necessary).
trait YamlSerializable =
  fn to_yaml(this YamlSerializable) string = virtual

// YamlDeserializable is implemented by types that can populate themselves from
// a YAML scalar string.  apply_yaml receives the unquoted scalar text and
// modifies the receiver in place.  Returns true on success, false if the
// string was not a valid representation.
trait YamlDeserializable =
  fn apply_yaml(this *YamlDeserializable, s string) bool = virtual

// Kind identifies the type of a parsed YAML value.
enum Kind =
  null_v
  bool_v
  int_v
  float_v
  string_v
  array_v
  object_v

struct Value =
  kind  Kind
  bval  bool
  ival  i64
  fval  f64
  sval  string
  items own [*Value]
  kkeys [string]

  fn is_null(this Value) bool   = return this.kind == Kind.null_v
  fn is_bool(this Value) bool   = return this.kind == Kind.bool_v
  fn is_int(this Value) bool    = return this.kind == Kind.int_v
  fn is_float(this Value) bool  = return this.kind == Kind.float_v
  fn is_string(this Value) bool = return this.kind == Kind.string_v
  fn is_array(this Value) bool  = return this.kind == Kind.array_v
  fn is_object(this Value) bool = return this.kind == Kind.object_v

  fn as_bool(this Value) bool     = return this.bval
  fn as_int(this Value) i64       = return this.ival
  fn as_float(this Value) f64     = return this.fval
  fn as_string(this Value) string = return this.sval
  fn array_len(this Value) i64    = return len(this.items)

  fn keys(this Value) [string] = return this.kkeys

  fn get(this Value, key string) Value =
    if this.kind != Kind.object_v:
      return Value{kind: Kind.null_v}
    let i i64 = 0
    for i < len(this.kkeys):
      if str::strcmp(this.kkeys[i], key) == 0:
        return *this.items[i]
      i = i + 1
    return Value{kind: Kind.null_v}

  fn index(this Value, i i64) Value =
    if this.kind != Kind.array_v || i < 0 || i >= len(this.items):
      return Value{kind: Kind.null_v}
    return *this.items[i]

// String helpers

// needs_quoting returns true when s must be enclosed in double quotes
// to be safely round-tripped through a YAML parser.
fn needs_quoting(s string) bool =
  if len(s) == 0:
    return true
  // Reserved scalars
  if str::strcmp(s, "null") == 0 || str::strcmp(s, "~") == 0:
    return true
  if str::strcmp(s, "true") == 0 || str::strcmp(s, "false") == 0:
    return true
  if str::strcmp(s, "yes") == 0 || str::strcmp(s, "no") == 0:
    return true
  if str::strcmp(s, "on") == 0 || str::strcmp(s, "off") == 0:
    return true
  // Leading characters that introduce YAML structure
  let fc = s[0]
  if fc == @'-' || fc == @'?' || fc == @'|' || fc == @'>':
    return true
  if fc == @'!' || fc == @'&' || fc == @'*' || fc == @' ':
    return true
  if fc == @'{' || fc == @'[' || fc == @'@' || fc == @'`':
    return true
  // Characters that are special anywhere in the value
  for c in s:
    if c == @':' || c == @'#' || c == @'{' || c == @'}':
      return true
    if c == @'[' || c == @']' || c == @',' || c == @39:
      return true
    if c == @'\"' || c == @'\\' || c == @'\n' || c == @'\r' || c == @'\t':
      return true
  return false

// yaml_string encodes s as a YAML scalar: plain if safe, double-quoted otherwise.
fn yaml_string(s string) string =
  if !needs_quoting(s):
    return s
  let result = "\""
  for c in s:
    if c == @'\"':
      result = result ++ "\\\""
    else if c == @'\\':
      result = result ++ "\\\\"
    else if c == @'\n':
      result = result ++ "\\n"
    else if c == @'\r':
      result = result ++ "\\r"
    else if c == @'\t':
      result = result ++ "\\t"
    else:
      result = result ++ c
  return result ++ "\""

// yaml_key maps a struct field to its YAML key via a @"yaml:..." tag.
// Returns "" to signal that the field should be omitted.
fn yaml_key(field_name string, tag string) string =
  if len(tag) == 0:
    return field_name
  if len(tag) <= 5 || str::strncmp(tag, "yaml:", 5) != 0:
    return field_name
  if len(tag) == 6 && tag[5] == @'-':
    return ""
  let key = ""
  let i i64 = 5
  for i < len(tag):
    key = key ++ tag[i]
    i = i + 1
  return key

// make_indent produces a string of depth*2 spaces.
fn make_indent(depth i64) string =
  let s = ""
  let i i64 = 0
  for i < depth:
    s = s ++ " "
    s = s ++ " "
    i = i + 1
  return s

// Encoding

// yaml_encode_any_impl[T] encodes v to YAML text with full struct type dispatch.
// Scalars: returns just the value text (no trailing newline).
// Structs: returns indented block lines (each line ends with \n).
// The phantom type T ensures the field dispatch tables are built in the
// caller's module context, enabling nested user-defined struct encoding.
fn yaml_encode_any_impl[T](v any, depth i64, type_hint T) string =
  let t = typeof(v)
  if t == 'none:
    return "null"
  if t == 'bool:
    if v as bool:
      return "true"
    return "false"
  if t == 'i64:
    let n = v as i64
    return "{n}"
  if t == 'f64:
    let f = v as f64
    return "{f:g}"
  if t == 'string:
    return yaml_string(v as string)
  // YamlSerializable: delegate to the type's own encoding if it implements the trait.
  let vtraits = traitof(v)
  let vti i64 = 0
  for vti < len(vtraits):
    if vtraits[vti] == 'YamlSerializable:
      let ser = v as YamlSerializable
      return ser.to_yaml()
    vti = vti + 1
  let fields = fieldnames(v)
  let nf = len(fields)
  if nf == 0:
    return "null"
  let indent = make_indent(depth)
  let out = ""
  let i i64 = 0
  for i < nf:
    let fname string = fields[i]
    let ykey string = yaml_key(fname, fieldtag(v, fname))
    if len(ykey) > 0:
      let fval = getfield(v, fname)
      let ft = typeof(fval)
      if ft == 'none || ft == 'bool || ft == 'i64 || ft == 'f64 || ft == 'string:
        out = out ++ indent ++ ykey ++ ": " ++ yaml_encode_any_impl[T](fval, depth, type_hint) ++ "\n"
      else:
        let ffields = fieldnames(fval)
        if len(ffields) > 0:
          out = out ++ indent ++ ykey ++ ":\n" ++ yaml_encode_any_impl[T](fval, depth+1, type_hint)
        else:
          out = out ++ indent ++ ykey ++ ": null\n"
    i = i + 1
  return out

// encode[T] serialises a value of type T to a YAML string.
// Primitives are encoded as a single line ending with \n.
// Structs are encoded in block mapping style.
fn encode[T](v T) string =
  let t = typeof(v)
  if t == 'none:
    return "null\n"
  if t == 'bool:
    if v as bool:
      return "true\n"
    return "false\n"
  if t == 'i64:
    let n = v as i64
    return "{n}\n"
  if t == 'f64:
    let f = v as f64
    return "{f:g}\n"
  if t == 'string:
    let sv T = v
    return yaml_string(sv as string) ++ "\n"
  // YamlSerializable: delegate to the type's own YAML encoding.
  let etraits = traitof(v)
  let eti i64 = 0
  for eti < len(etraits):
    if etraits[eti] == 'YamlSerializable:
      return yaml_encode_any_impl[T](v as any, 0, v) ++ "\n"
    eti = eti + 1
  let fields = fieldnames(v)
  let nf = len(fields)
  if nf == 0:
    return "null\n"
  let out = ""
  let i i64 = 0
  for i < nf:
    let fname string = fields[i]
    let ykey string = yaml_key(fname, fieldtag(v, fname))
    if len(ykey) > 0:
      let fval = getfield(v, fname)
      let ft = typeof(fval)
      // Check if the field implements YamlSerializable (custom scalar encoding).
      let ftraits = traitof(fval)
      let fti i64 = 0
      let fIsSerializable bool = false
      for fti < len(ftraits):
        if ftraits[fti] == 'YamlSerializable:
          fIsSerializable = true
        fti = fti + 1
      if fIsSerializable:
        out = out ++ ykey ++ ": " ++ yaml_encode_any_impl[T](fval, 0, v) ++ "\n"
      else if ft == 'none || ft == 'bool || ft == 'i64 || ft == 'f64 || ft == 'string:
        out = out ++ ykey ++ ": " ++ yaml_encode_any_impl[T](fval, 0, v) ++ "\n"
      else:
        let ffields = fieldnames(fval)
        if len(ffields) > 0:
          out = out ++ ykey ++ ":\n" ++ yaml_encode_any_impl[T](fval, 1, v)
        else:
          out = out ++ ykey ++ ": null\n"
    i = i + 1
  return out

// Parser

struct Parser =
  src *byte
  pos i64
  len i64

  fn peek(this Parser) byte =
    if this.pos >= this.len:
      return 0
    return this.src[this.pos]

  fn advance(this *Parser) byte =
    let c = this.src[this.pos]
    this.pos = this.pos + 1
    return c

  fn at_end(this Parser) bool = return this.pos >= this.len

  fn skip_inline_ws(this *Parser) =
    for this.pos < this.len:
      let c = this.src[this.pos]
      if c != @' ' && c != @'\t':
        break
      this.pos = this.pos + 1

  fn skip_to_eol(this *Parser) =
    for this.pos < this.len:
      if this.src[this.pos] == @'\n':
        break
      this.pos = this.pos + 1

  fn skip_eol(this *Parser) =
    if this.pos < this.len && this.src[this.pos] == @'\r':
      this.pos = this.pos + 1
    if this.pos < this.len && this.src[this.pos] == @'\n':
      this.pos = this.pos + 1

  // line_indent counts the number of leading space characters on the current
  // line without advancing pos.  Tabs are treated as single spaces.
  fn line_indent(this Parser) i64 =
    let i = this.pos
    for i < this.len && this.src[i] == @' ':
      i = i + 1
    return i - this.pos

// skip_blanks advances past blank lines, comment lines (#...), and YAML
// document-start markers (---).  Leaves pos at the first content byte of the
// first non-blank line, or at end-of-input.
fn skip_blanks(p *Parser) =
  for !p.at_end():
    let start = p.pos
    // Skip leading spaces on this line.
    for p.pos < p.len && p.src[p.pos] == @' ':
      p.pos = p.pos + 1
    if p.at_end():
      break
    let c = p.src[p.pos]
    if c == @'\n' || c == @'\r':
      p.skip_eol()
    else if c == @'#':
      p.skip_to_eol()
      p.skip_eol()
    else if c == @'-' && p.pos + 2 < p.len && p.src[p.pos+1] == @'-' && p.src[p.pos+2] == @'-':
      // Document-start marker --- (must be followed by space/newline/EOF).
      let n4 byte = 0
      if p.pos + 3 < p.len:
        n4 = p.src[p.pos+3]
      if n4 == @' ' || n4 == @'\n' || n4 == @'\r' || n4 == 0:
        p.skip_to_eol()
        p.skip_eol()
      else:
        p.pos = start
        break
    else:
      p.pos = start
      break

// line_has_key returns true when the current line contains a YAML mapping
// indicator (a ':' followed by space, tab, newline, or end-of-input).
// Does not advance pos.
fn line_has_key(p *Parser) bool =
  let indent = p.line_indent()
  let i = p.pos + indent
  for i < p.len:
    let c = p.src[i]
    if c == @'\n' || c == @'\r' || c == @'#':
      return false
    if c == @':':
      if i + 1 >= p.len:
        return true
      let nc = p.src[i+1]
      if nc == @' ' || nc == @'\n' || nc == @'\r' || nc == @'\t':
        return true
    i = i + 1
  return false

// trim_right removes trailing space and tab characters from s.
fn trim_right(s string) string =
  let n = len(s)
  let end = n
  for end > 0 && (s[end-1] == @' ' || s[end-1] == @'\t'):
    end = end - 1
  if end == n:
    return s
  let result = ""
  let i i64 = 0
  for i < end:
    result = result ++ s[i]
    i = i + 1
  return result

// parse_quoted_str parses a double-quoted YAML string starting at the current
// position (which must be '"').  Handles the same escape sequences as JSON.
fn parse_quoted_str(p *Parser) string =
  p.advance()  // consume opening '"'
  let result = ""
  for !p.at_end():
    let c = p.advance()
    if c == @'\"':
      break
    let out byte = c
    if c == @'\\':
      if p.at_end():
        break
      let esc = p.advance()
      if esc == @'\"':       out = @'\"'
      else if esc == @'\\': out = @'\\'
      else if esc == @'n':  out = @'\n'
      else if esc == @'r':  out = @'\r'
      else if esc == @'t':  out = @'\t'
      else:                 out = esc
    result = result ++ out
  return result

// parse_block_scalar reads an unquoted scalar value in block context.
// Stops at end-of-line or an inline comment (# preceded by a space).
// Trailing whitespace is stripped.
fn parse_block_scalar(p *Parser) string =
  let result = ""
  for !p.at_end():
    let c = p.peek()
    if c == @'\n' || c == @'\r':
      break
    if c == @'#' && len(result) > 0 && result[len(result)-1] == @' ':
      break
    p.advance()
    result = result ++ c
  return trim_right(result)

// parse_flow_scalar reads an unquoted scalar value in flow context.
// Stops at flow terminators (',', '}', ']'), end-of-line, or inline comments.
fn parse_flow_scalar(p *Parser) string =
  let result = ""
  for !p.at_end():
    let c = p.peek()
    if c == @'\n' || c == @'\r':
      break
    if c == @',' || c == @'}' || c == @']':
      break
    if c == @'#' && len(result) > 0 && result[len(result)-1] == @' ':
      break
    p.advance()
    result = result ++ c
  return trim_right(result)

// interpret_scalar converts a plain scalar string to a typed Value:
// null/bool/int/float are detected; everything else becomes a string.
fn interpret_scalar(s string) *Value =
  if str::strcmp(s, "") == 0 || str::strcmp(s, "null") == 0 || str::strcmp(s, "~") == 0:
    return &Value{kind: Kind.null_v}
  if str::strcmp(s, "true") == 0 || str::strcmp(s, "yes") == 0 || str::strcmp(s, "on") == 0:
    return &Value{kind: Kind.bool_v, bval: true}
  if str::strcmp(s, "false") == 0 || str::strcmp(s, "no") == 0 || str::strcmp(s, "off") == 0:
    return &Value{kind: Kind.bool_v, bval: false}
  let n = len(s)
  // Attempt numeric parse.
  let i i64 = 0
  let neg = false
  if s[0] == @'-':
    neg = true
    i = 1
  let is_float = false
  let is_num = i < n
  for i < n:
    let c = s[i]
    if c == @'.':
      is_float = true
      i = i + 1
    else if c == @'e' || c == @'E':
      is_float = true
      i = i + 1
      if i < n && (s[i] == @'+' || s[i] == @'-'):
        i = i + 1
    else if c >= @'0' && c <= @'9':
      i = i + 1
    else:
      is_num = false
      break
  if is_num && i == n:
    if is_float:
      return &Value{kind: Kind.float_v, fval: str::atof(s)}
    // Parse integer directly from digits.
    let j i64 = 0
    let r i64 = 0
    if neg:
      j = 1
    for j < n:
      r = r * 10 + (s[j] - @'0') as i64
      j = j + 1
    if neg:
      r = 0 - r
    return &Value{kind: Kind.int_v, ival: r}
  return &Value{kind: Kind.string_v, sval: s}

// Forward declarations for mutually recursive parsers.
fn parse_node(p *Parser, min_indent i64) *Value
fn parse_flow_mapping(p *Parser) *Value

fn parse_flow_sequence(p *Parser) *Value =
  p.advance()  // consume '['
  let items [*Value] = []
  p.skip_inline_ws()
  if !p.at_end() && p.peek() == @']':
    p.advance()
    return &Value{kind: Kind.array_v, items: items}
  for !p.at_end():
    p.skip_inline_ws()
    let c = p.peek()
    if c == @'\"':
      items ++= &Value{kind: Kind.string_v, sval: parse_quoted_str(p)}
    else if c == @'[':
      items ++= parse_flow_sequence(p)
    else if c == @'{':
      items ++= parse_flow_mapping(p)
    else:
      items ++= interpret_scalar(parse_flow_scalar(p))
    p.skip_inline_ws()
    if p.at_end():
      break
    let nc = p.peek()
    if nc == @']':
      p.advance()
      break
    if nc == @',':
      p.advance()
  return &Value{kind: Kind.array_v, items: items}

fn parse_flow_mapping(p *Parser) *Value =
  p.advance()  // consume '{'
  let items [*Value] = []
  let kkeys [string] = []
  p.skip_inline_ws()
  if !p.at_end() && p.peek() == @'}':
    p.advance()
    return &Value{kind: Kind.object_v, items: items, kkeys: kkeys}
  for !p.at_end():
    p.skip_inline_ws()
    // Parse key.
    let key = ""
    if p.peek() == @'\"':
      key = parse_quoted_str(p)
    else:
      let k = ""
      for !p.at_end():
        let c = p.peek()
        if c == @':' || c == @',' || c == @'}' || c == @'\n' || c == @'\r':
          break
        p.advance()
        k = k ++ c
      key = trim_right(k)
    p.skip_inline_ws()
    if !p.at_end() && p.peek() == @':':
      p.advance()
    kkeys ++= key
    // Parse value.
    p.skip_inline_ws()
    let vc = p.peek()
    if vc == @'\"':
      items ++= &Value{kind: Kind.string_v, sval: parse_quoted_str(p)}
    else if vc == @'[':
      items ++= parse_flow_sequence(p)
    else if vc == @'{':
      items ++= parse_flow_mapping(p)
    else:
      items ++= interpret_scalar(parse_flow_scalar(p))
    p.skip_inline_ws()
    if p.at_end():
      break
    let nc = p.peek()
    if nc == @'}':
      p.advance()
      break
    if nc == @',':
      p.advance()
  return &Value{kind: Kind.object_v, items: items, kkeys: kkeys}

fn parse_block_mapping(p *Parser, indent i64) *Value =
  let items [*Value] = []
  let kkeys [string] = []
  for !p.at_end():
    skip_blanks(p)
    if p.at_end():
      break
    if p.line_indent() != indent:
      break
    // Consume indent spaces.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    // Parse key (plain or double-quoted).
    let key = ""
    if p.peek() == @'\"':
      key = parse_quoted_str(p)
    else:
      let k = ""
      for !p.at_end():
        let c = p.peek()
        if c == @':' || c == @'\n' || c == @'\r' || c == @'#':
          break
        p.advance()
        k = k ++ c
      key = trim_right(k)
    kkeys ++= key
    p.skip_inline_ws()
    if !p.at_end() && p.peek() == @':':
      p.advance()
    p.skip_inline_ws()
    // If nothing follows ':' on this line, value is the next indented block.
    if p.at_end() || p.peek() == @'\n' || p.peek() == @'\r' || p.peek() == @'#':
      if !p.at_end() && p.peek() == @'#':
        p.skip_to_eol()
      p.skip_eol()
      items ++= parse_node(p, indent + 1)
    else:
      // Inline value: flow collection, quoted string, or plain scalar.
      let c = p.peek()
      if c == @'\"':
        items ++= &Value{kind: Kind.string_v, sval: parse_quoted_str(p)}
      else if c == @'[':
        items ++= parse_flow_sequence(p)
      else if c == @'{':
        items ++= parse_flow_mapping(p)
      else:
        items ++= interpret_scalar(parse_block_scalar(p))
      p.skip_to_eol()
      p.skip_eol()
  return &Value{kind: Kind.object_v, items: items, kkeys: kkeys}

fn parse_block_sequence(p *Parser, indent i64) *Value =
  let items [*Value] = []
  for !p.at_end():
    skip_blanks(p)
    if p.at_end():
      break
    if p.line_indent() != indent:
      break
    // Consume indent spaces.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    // Expect '-' sequence indicator.
    if p.peek() != @'-':
      break
    p.advance()  // consume '-'
    if p.at_end() || p.peek() == @'\n' || p.peek() == @'\r':
      // Value is on the next indented lines.
      p.skip_eol()
      items ++= parse_node(p, indent + 1)
    else:
      p.skip_inline_ws()
      let c = p.peek()
      if c == @'\"':
        items ++= &Value{kind: Kind.string_v, sval: parse_quoted_str(p)}
      else if c == @'[':
        items ++= parse_flow_sequence(p)
      else if c == @'{':
        items ++= parse_flow_mapping(p)
      else:
        items ++= interpret_scalar(parse_block_scalar(p))
      p.skip_to_eol()
      p.skip_eol()
  return &Value{kind: Kind.array_v, items: items}

// parse_node dispatches to the appropriate parser based on what the next
// content line looks like, requiring an indentation of at least min_indent.
fn parse_node(p *Parser, min_indent i64) *Value =
  skip_blanks(p)
  if p.at_end():
    return &Value{kind: Kind.null_v}
  let indent = p.line_indent()
  if indent < min_indent:
    return &Value{kind: Kind.null_v}
  // Peek at first non-space character on this line.
  let first byte = 0
  if p.pos + indent < p.len:
    first = p.src[p.pos + indent]
  // Dispatch via else-if to keep all uses of p in a single dominance chain
  // and avoid LLVM IR dominance violations.
  if first == @'[':
    // Flow sequence.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    let v = parse_flow_sequence(p)
    p.skip_to_eol()
    p.skip_eol()
    return v
  else if first == @'{':
    // Flow mapping.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    let v = parse_flow_mapping(p)
    p.skip_to_eol()
    p.skip_eol()
    return v
  else if first == @'\"':
    // Double-quoted string.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    let s = parse_quoted_str(p)
    p.skip_to_eol()
    p.skip_eol()
    return &Value{kind: Kind.string_v, sval: s}
  else if first == @'-':
    // Block sequence: '-' followed by space or newline.
    let after byte = 0
    if p.pos + indent + 1 < p.len:
      after = p.src[p.pos + indent + 1]
    if after == @' ' || after == @'\n' || after == @'\r' || after == 0:
      return parse_block_sequence(p, indent)
    // Fall through: '-' not a sequence indicator, treat as scalar.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    let s = parse_block_scalar(p)
    p.skip_to_eol()
    p.skip_eol()
    return interpret_scalar(s)
  else if line_has_key(p):
    // Block mapping.
    return parse_block_mapping(p, indent)
  else:
    // Plain scalar.
    let j i64 = 0
    for j < indent:
      p.advance()
      j = j + 1
    let s = parse_block_scalar(p)
    p.skip_to_eol()
    p.skip_eol()
    return interpret_scalar(s)

// Public API

// parse parses a YAML string and returns a Value tree for untyped inspection.
//
//   let v = yaml::parse("name: alice\nage: 30\n")
//   echo v.get("name").as_string()  // alice
fn parse(s string) (Value, Err) =
  if len(s) == 0:
    return (Value{kind: Kind.null_v}, errors::new("yaml: empty input"))
  let p = Parser{src: s as *byte, pos: 0, len: len(s)}
  return (*parse_node(&p, 0), nil)

// parse_nested_any_impl[T] populates nested struct fields from a YAML Value object.
// The phantom type T ensures this generic is compiled at the call site with full
// struct type dispatch tables.
fn parse_nested_any_impl[T](zero any, doc Value, type_hint T) any =
  let fields = fieldnames(zero)
  let ftypes = fieldtypes(zero)
  let nf = len(fields)
  let i i64 = 0
  for i < nf:
    let fname string = fields[i]
    let yval = doc.get(fname)
    if !yval.is_null():
      let ftype = ftypes[i]
      match yval.kind:
        case Kind.int_v:
          if ftype == 'i64 || ftype == 'i32 || ftype == 'i16 || ftype == 'i8:
            setfield(zero, fname, yval.ival)
          else if ftype == 'f64:
            setfield(zero, fname, yval.ival as f64)
        case Kind.float_v:
          if ftype == 'f64:
            setfield(zero, fname, yval.fval)
          else if ftype == 'i64:
            setfield(zero, fname, yval.fval as i64)
        case Kind.bool_v:
          if ftype == 'bool:
            setfield(zero, fname, yval.bval)
        case Kind.string_v:
          if ftype == 'string:
            setfield(zero, fname, yval.sval)
          else:
            // YamlDeserializable: let the field type parse itself from the scalar.
            let nfv = getfield(zero, fname)
            let nft = traitof(nfv)
            let nfi i64 = 0
            for nfi < len(nft):
              if nft[nfi] == 'YamlDeserializable:
                let ndeser = nfv as YamlDeserializable
                ndeser.apply_yaml(yval.sval)
                setfield(zero, fname, nfv)
              nfi = nfi + 1
        case Kind.object_v:
          let nested_zero = getfield(zero, fname)
          let nested = parse_nested_any_impl[T](nested_zero, yval, type_hint)
          setfield(zero, fname, nested)
        default:
          pass
    i = i + 1
  return zero

// parse[T] parses a YAML string and decodes it directly into a value of type T.
// T must be a struct.  Field tags @"yaml:key" rename fields; @"yaml:-" skips.
// Unknown YAML keys are silently ignored.
//
//   struct point = x i64  y i64
//   let p = yaml::parse[point]("x: 3\ny: 4\n")
fn parse[T](s string) (T, Err) =
  let (doc, perr) = parse(s)
  let result T
  if errors::has(perr):
    return (result, perr)
  if doc.is_null():
    return (result, nil)
  let fields = fieldnames(result)
  let ftypes = fieldtypes(result)
  let nf = len(fields)
  let i i64 = 0
  for i < nf:
    let fname string = fields[i]
    let ftypei any = ftypes[i]
    let ykey string = yaml_key(fname, fieldtag(result, fname))
    if len(ykey) > 0:
      let yval = doc.get(ykey)
      if !yval.is_null():
        let ftype = ftypei
        match yval.kind:
          case Kind.int_v:
            if ftype == 'i64 || ftype == 'i32 || ftype == 'i16 || ftype == 'i8:
              setfield(result, fname, yval.ival)
            else if ftype == 'f64:
              setfield(result, fname, yval.ival as f64)
          case Kind.float_v:
            if ftype == 'f64:
              setfield(result, fname, yval.fval)
            else if ftype == 'i64:
              setfield(result, fname, yval.fval as i64)
          case Kind.bool_v:
            if ftype == 'bool:
              setfield(result, fname, yval.bval)
          case Kind.string_v:
            if ftype == 'string:
              setfield(result, fname, yval.sval)
            else:
              // YamlDeserializable: let the field type parse itself from the scalar.
              let fv = getfield(result, fname)
              let ftraits = traitof(fv)
              let fi i64 = 0
              for fi < len(ftraits):
                if ftraits[fi] == 'YamlDeserializable:
                  let deser = fv as YamlDeserializable
                  deser.apply_yaml(yval.sval)
                  setfield(result, fname, fv)
                fi = fi + 1
          case Kind.object_v:
            let zero_nested = getfield(result, fname)
            let populated = parse_nested_any_impl[T](zero_nested, yval, result)
            setfield(result, fname, populated)
          default:
            pass
    i = i + 1
  return (result, nil)

export {
  Kind, Value, parse, encode,
  YamlSerializable, YamlDeserializable,
} as yaml
