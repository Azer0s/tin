// stdlib/json/json_test.tin
//
// Tests for the json stdlib: encoding, untyped parsing, and typed parsing.
// Run with: tin test stdlib/json/json_test.tin

use assert
use encoding::json

// Module-level structs used across multiple tests.

struct jt_point =
  x i64
  y i64

struct jt_tagged_user =
  id    i64    @"json:user_id"
  email string @"json:email_address"

struct jt_with_secret =
  name string
  pwd  string @"json:-"

struct jt_coord =
  x i64
  y i64

struct jt_api_user =
  id   i64    @"json:user_id"
  name string @"json:display_name"

struct jt_simple =
  x i64

struct jt_measure =
  val f64

struct jt_flags =
  enabled bool

struct jt_greeting =
  msg string

struct jt_rect =
  origin jt_point
  size   jt_point

// Encoding

test "encode bool true" =
  assert::equals(json::encode(true), "true")

test "encode bool false" =
  assert::equals(json::encode(false), "false")

test "encode i64 positive" =
  assert::equals(json::encode(42 as i64), "42")

test "encode i64 negative" =
  assert::equals(json::encode(0 - 7 as i64), "-7")

test "encode i64 zero" =
  assert::equals(json::encode(0 as i64), "0")

test "encode string plain" =
  assert::equals(json::encode("hello"), "\"hello\"")

test "encode string with quotes" =
  assert::equals(json::encode("say \"hi\""), "\"say \\\"hi\\\"\"")

test "encode string with backslash" =
  assert::equals(json::encode("a\\b"), "\"a\\\\b\"")

test "encode string with newline" =
  assert::equals(json::encode("line1\nline2"), "\"line1\\nline2\"")

test "encode struct all fields" =
  let p = jt_point{x: 3, y: 4}
  let s = json::encode(p)

  assert::equals(s, "\{\"x\":3,\"y\":4\}")

test "encode struct with json tag rename" =
  let u = jt_tagged_user{id: 1, email: "a@b.com"}
  let s = json::encode(u)

  assert::equals(s, "\{\"user_id\":1,\"email_address\":\"a@b.com\"\}")

test "encode struct with json:- skips field" =
  let w = jt_with_secret{name: "alice", pwd: "hunter2"}
  let s = json::encode(w)

  assert::equals(s, "\{\"name\":\"alice\"\}")

test "encode nested struct" =
  let r = jt_rect{origin: jt_point{x: 0, y: 0}, size: jt_point{x: 100, y: 50}}
  let s = json::encode(r)

  assert::equals("\{\"origin\":\{\"x\":0,\"y\":0\},\"size\":\{\"x\":100,\"y\":50\}\}", s)

test "encode tuple" =
  // Tuples are structs with alphabetical field names a, b, c, ...
  let t = (10 as i64, "hello")
  let s = json::encode(t)

  assert::equals("\{\"a\":10,\"b\":\"hello\"\}", s)

// Untyped parsing

test "parse null" =
  let v = json::parse("null").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_null())

test "parse bool true" =
  let v = json::parse("true").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_bool())
  assert::ok(v.as_bool())

test "parse bool false" =
  let v = json::parse("false").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_bool())
  assert::not_ok(v.as_bool())

test "parse integer" =
  let v = json::parse("42").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_int())
  assert::equals(v.as_int(), 42)

test "parse negative integer" =
  let v = json::parse("-7").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_int())
  assert::equals(v.as_int(), 0 - 7)

test "parse float" =
  let v = json::parse("3.14").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_float())
  assert::equals(v.as_float(), 3.14)

test "parse string" =
  let v = json::parse("\"hello\"").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_string())
  assert::equals(v.as_string(), "hello")

test "parse string with escape sequences" =
  let v = json::parse("\"line1\\nline2\"").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_string())
  assert::equals(v.as_string(), "line1\nline2")

test "parse object get field" =
  let v = json::parse("\{\"name\":\"alice\",\"age\":30\}").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(v.get("name").as_string(), "alice")
  assert::equals(v.get("age").as_int(), 30)

test "parse object missing key returns null" =
  let v = json::parse("\{\"x\":1\}").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.get("missing").is_null())

test "parse object keys" =
  let v = json::parse("\{\"a\":1,\"b\":2\}").unwrap_or(json::Value{kind: json::Kind.null_v})
  let ks = v.keys()

  assert::equals(len(ks), 2)

test "parse array index" =
  let v = json::parse("[10,20,30]").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 3)
  assert::equals(v.index(0).as_int(), 10)
  assert::equals(v.index(1).as_int(), 20)
  assert::equals(v.index(2).as_int(), 30)

test "parse array out of bounds returns null" =
  let v = json::parse("[1,2]").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.index(5).is_null())

test "parse empty array" =
  let v = json::parse("[]").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_array())
  assert::equals(v.array_len(), 0)

test "parse empty object" =
  let v = json::parse("\{\}").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_object())
  assert::equals(len(v.keys()), 0)

test "parse empty string input returns null" =
  let v = json::parse("").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::ok(v.is_null())

// Typed parsing

test "typed parse basic struct" =
  let c = json::parse[jt_coord]("\{\"x\":5,\"y\":9\}").unwrap_or(jt_coord{})

  assert::equals(c.x, 5)
  assert::equals(c.y, 9)

test "typed parse with json tag" =
  let u = json::parse[jt_api_user]("\{\"user_id\":7,\"display_name\":\"bob\"\}").unwrap_or(jt_api_user{})

  assert::equals(u.id, 7)
  assert::equals(u.name, "bob")

test "typed parse unknown keys ignored" =
  let s = json::parse[jt_simple]("\{\"x\":3,\"extra\":\"ignored\"\}").unwrap_or(jt_simple{})

  assert::equals(s.x, 3)

test "typed parse float field" =
  let m = json::parse[jt_measure]("\{\"val\":2.5\}").unwrap_or(jt_measure{})

  assert::equals(m.val, 2.5)

test "typed parse bool field" =
  let f = json::parse[jt_flags]("\{\"enabled\":true\}").unwrap_or(jt_flags{})

  assert::ok(f.enabled)

test "typed parse string field" =
  let g = json::parse[jt_greeting]("\{\"msg\":\"hi there\"\}").unwrap_or(jt_greeting{})

  assert::equals(g.msg, "hi there")

test "typed parse nested struct" =
  let s = "\{\"origin\":\{\"x\":3,\"y\":4\},\"size\":\{\"x\":100,\"y\":50\}\}"
  let r = json::parse[jt_rect](s).unwrap_or(jt_rect{})

  assert::equals(r.origin.x, 3)
  assert::equals(r.origin.y, 4)
  assert::equals(r.size.x, 100)
  assert::equals(r.size.y, 50)

// String escape edge cases (RFC 8259 sec 7).  Each previously
// produced silently wrong output: lone surrogates emitted invalid
// UTF-8, surrogate pairs decoded as two 3-byte sequences, malformed
// \u escapes were treated as zero, and an unterminated string
// returned a partial Ok.

test "parse_str: \\u BMP codepoint encodes 2-byte UTF-8" =
  let v = json::parse("\"\\u00e9\"").unwrap_or(json::Value{kind: json::Kind.null_v})

  // U+00E9 -> 0xC3 0xA9
  assert::equals(len(v.sval), 2)
  assert::equals(v.sval[0], 0xC3 as byte)
  assert::equals(v.sval[1], 0xA9 as byte)

test "parse_str: \\u surrogate pair encodes 4-byte UTF-8" =
  // U+1F600 (😀) is encoded as the surrogate pair 😀.
  // Correct UTF-8 is F0 9F 98 80; the buggy code produced two
  // 3-byte sequences and corrupted the output.
  let v = json::parse("\"\\uD83D\\uDE00\"").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::equals(len(v.sval), 4)
  assert::equals(v.sval[0], 0xF0 as byte)
  assert::equals(v.sval[1], 0x9F as byte)
  assert::equals(v.sval[2], 0x98 as byte)
  assert::equals(v.sval[3], 0x80 as byte)

test "parse_str: lone high surrogate fails" =
  assert::ok(json::parse("\"\\uD83D\"").is_err())

test "parse_str: lone low surrogate fails" =
  assert::ok(json::parse("\"\\uDE00\"").is_err())

test "parse_str: high surrogate followed by non-\\u fails" =
  assert::ok(json::parse("\"\\uD83Dx\"").is_err())

test "parse_str: high surrogate followed by another high surrogate fails" =
  assert::ok(json::parse("\"\\uD83D\\uD83D\"").is_err())

test "parse_str: malformed \\u (non-hex digit) fails" =
  assert::ok(json::parse("\"\\uZZZZ\"").is_err())

test "parse_str: \\u with too few hex digits fails" =
  assert::ok(json::parse("\"\\u12\"").is_err())

test "parse_str: unterminated string fails" =
  assert::ok(json::parse("\"abc").is_err())

test "parse_str: unterminated empty string fails" =
  assert::ok(json::parse("\"").is_err())

// Integer literal edge cases (RFC 8259 places no upper bound on the
// magnitude of a JSON number, but the int parser is bounded to i64).
// Pre-fix the parser accumulated positively then negated, so
// `-9223372036854775808` (i64::MIN) was rejected as out-of-range
// because its magnitude equals i64::MAX + 1 and does not fit.

test "parse i64::MIN (-9223372036854775808)" =
  let v = json::parse("-9223372036854775808").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::equals(v.ival, -9223372036854775808)

test "parse i64::MAX (9223372036854775807)" =
  let v = json::parse("9223372036854775807").unwrap_or(json::Value{kind: json::Kind.null_v})

  assert::equals(v.ival, 9223372036854775807)

test "parse rejects integer one past i64::MIN" =
  assert::ok(json::parse("-9223372036854775809").is_err())

test "parse rejects integer one past i64::MAX" =
  assert::ok(json::parse("9223372036854775808").is_err())
