// stdlib/json - JSON encoding and decoding
//
// ## Encoding
//
// json::encode(v) serialises any Tin value to a JSON string.
// Struct field tags control the JSON key name and visibility:
//
//   struct user =
//     id    i64    @"json:id"
//     email string @"json:email_address"
//     pwd   string @"json:-"       // skip this field
//
//   echo json::encode(user{id: 1, email: "a@b.com", pwd: "secret"})
//   // {"id":1,"email_address":"a@b.com"}
//
// ## Parsing - untyped
//
// json::parse(s) returns a Value tree for untyped field access:
//
//   let v = json::parse(s)
//   echo v.get("name").as_string()
//   for k in v.keys():
//     echo k
//
// ## Parsing - typed (generic)
//
// json::parse[T](s) decodes JSON directly into a struct T using reflection.
// Field tags @"json:key" map JSON keys to struct fields; @"json:-" skips.
//
//   struct point = x i64  y i64
//   let p = json::parse[point]("{\"x\":3,\"y\":4}")
//   echo p.x    // 3
//
// ## String iteration
//
// json.tin uses `for c in s:` (for-in over strings) throughout its
// helpers, demonstrating the feature on real code.

use str
use errors
use simd
use result
use { Result } from result

// JsonSerializable

// JsonSerializable is implemented by types that produce their own JSON encoding.
// to_json must return a complete JSON value string, including surrounding quotes
// for string-typed encodings (e.g. `"\"2024-01-01T00:00:00Z\""`).
trait JsonSerializable =
  fn to_json(this JsonSerializable) string = virtual

// JsonDeserializable is implemented by types that can populate themselves from
// a JSON string value.  apply_json receives the unescaped string (without the
// surrounding JSON quotes) and modifies the receiver in place.
// Returns true on success, false if the string was not a valid representation.
trait JsonDeserializable =
  fn apply_json(this *JsonDeserializable, s string) bool = virtual

// Kind enum

// Kind identifies the type of a parsed JSON value.
enum Kind =
  null_v
  bool_v
  int_v
  float_v
  string_v
  array_v
  object_v

// Value

struct Value =
  kind  Kind
  bval  bool
  ival  i64
  fval  f64
  sval  string
  items own [*Value]
  kkeys [string]

  fn is_null(this Value) bool   = return this.kind == Kind.null_v
  fn is_bool(this Value) bool   = return this.kind == Kind.bool_v
  fn is_int(this Value) bool    = return this.kind == Kind.int_v
  fn is_float(this Value) bool  = return this.kind == Kind.float_v
  fn is_string(this Value) bool = return this.kind == Kind.string_v
  fn is_array(this Value) bool  = return this.kind == Kind.array_v
  fn is_object(this Value) bool = return this.kind == Kind.object_v

  fn as_bool(this Value) bool     = return this.bval
  fn as_int(this Value) i64       = return this.ival
  fn as_float(this Value) f64     = return this.fval
  fn as_string(this Value) string = return this.sval
  fn array_len(this Value) i64    = return len(this.items)

  // keys returns the key list for a JSON object Value.
  fn keys(this Value) [string] = return this.kkeys

  // get returns the value for key in a JSON object, or a null Value.
  fn get(this Value, key string) Value =
    if this.kind != Kind.object_v:
      return Value{kind: Kind.null_v}
    let i i64 = 0

    for i < len(this.kkeys):
      if str::strcmp(this.kkeys[i], key) == 0:
        return *this.items[i]
      i = i + 1

    return Value{kind: Kind.null_v}

  // index returns the i-th element of a JSON array, or a null Value.
  fn index(this Value, i i64) Value =
    if this.kind != Kind.array_v || i < 0 || i >= len(this.items):
      return Value{kind: Kind.null_v}
    return *this.items[i]

// String helpers

// hex_digit returns the lowercase hex character for n in [0, 15].
fn hex_digit(n i64) byte =
  if n < 10:
    return (@'0' + n) as byte
  return (@'a' + n - 10) as byte

// hex_val parses a single hex character to its 4-bit value.  Returns
// 0 for invalid input -- callers must validate the byte first if the
// distinction matters.
fn hex_val(c i64) i64 =
  if c >= @'0' as i64 && c <= @'9' as i64:
    return c - (@'0' as i64)
  if c >= @'a' as i64 && c <= @'f' as i64:
    return c - (@'a' as i64) + 10
  if c >= @'A' as i64 && c <= @'F' as i64:
    return c - (@'A' as i64) + 10
  return 0

// is_hex reports whether c is an ASCII hex digit (0-9 / a-f / A-F).
// Used by parse_str's \u escape to validate before delegating to
// hex_val (which silently returns 0 on non-hex input).
fn is_hex(c i64) bool =
  if c >= @'0' as i64 && c <= @'9' as i64: return true
  if c >= @'a' as i64 && c <= @'f' as i64: return true
  if c >= @'A' as i64 && c <= @'F' as i64: return true
  return false

// escape_string produces the JSON encoding of s including surrounding quotes.
// Iterates over bytes with `for c in s:` using string ++ byte concatenation.
// RFC 8259 requires control bytes 0x00-0x1F to be escaped; conformant
// parsers (jq, serde_json, Python json) reject literal control bytes.
fn escape_string(s string) string =
  let result = "\""

  for c in s:
    if c == @'\"':
      result = result ++ "\\\""
    else if c == @'\\':
      result = result ++ "\\\\"
    else if c == 0x08 as byte:
      // 0x08 = BS (\b in JSON).  Tin's byte literals don't recognise
      // \b, so we use the numeric value directly.
      result = result ++ "\\b"
    else if c == 0x0C as byte:
      // 0x0C = FF (\f in JSON).
      result = result ++ "\\f"
    else if c == @'\n':
      result = result ++ "\\n"
    else if c == @'\r':
      result = result ++ "\\r"
    else if c == @'\t':
      result = result ++ "\\t"
    else if c < 0x20 as byte:
      let n = c as i64

      result = result ++ "\\u00" ++ hex_digit((n >> 4) & 0xF) ++ hex_digit(n & 0xF)
    else:
      result = result ++ c

  return result ++ "\""

// json_key maps a struct field to its JSON key via a @"json:..." tag.
// Returns "" to signal that the field should be omitted.
fn json_key(field_name string, tag string) string =
  if len(tag) == 0:
    return field_name

  if len(tag) <= 5 || str::strncmp(tag, "json:", 5) != 0:
    return field_name

  if len(tag) == 6 && tag[5] == @'-':
    return ""

  // Extract the key name: tag[5:] using string ++ byte.
  let key = ""
  let i i64 = 5

  for i < len(tag):
    key = key ++ tag[i]
    i = i + 1

  return key

// Encoding

// encode_any encodes any value to JSON.
// Primitives (bool, i64, f64, string, null) are encoded directly.
// Struct-typed any values encode as null when called directly (use encode[T] for structs).
fn encode_any(v any) string =
  let t = typeof(v)

  if t == 'none:
    return "null"

  if t == 'bool:
    if v as bool:
      return "true"
    return "false"

  if t == 'i64:
    let n = v as i64
    return "{n}"

  if t == 'f64:
    let f = v as f64
    return "{f:g}"

  if t == 'string:
    return escape_string(v as string)
  return "null"

// encode_any_impl[T] encodes an any value to JSON with full struct type dispatch.
// The phantom type parameter T forces per-instantiation compilation at each call site,
// which means the fieldnames(v) call inside has access to all struct types registered
// in the caller's module - including user-defined nested struct types.
// Call as encode_any_impl[T](val) from within encode[T] to encode field values.
fn encode_any_impl[T](v any, type_hint T) string =
  let t = typeof(v)

  if t == 'none:
    return "null"

  if t == 'bool:
    if v as bool:
      return "true"
    return "false"

  if t == 'i64:
    let n = v as i64
    return "{n}"

  if t == 'f64:
    let f = v as f64
    return "{f:g}"

  if t == 'string:
    return escape_string(v as string)

  // JsonSerializable: delegate to the type's own encoding if it implements the trait.
  let vtraits = traitof(v)
  let vti i64 = 0

  for vti < len(vtraits):
    if vtraits[vti] == '"json::JsonSerializable":
      let ser = v as JsonSerializable
      return ser.to_json()

    vti = vti + 1

  // Struct: fieldnames(v: any) compiled in instantiation context -> full type dispatch
  // Handles nested user-defined struct types because the dispatch table is built at the
  // call site (user module's third pass) rather than at json.tin compilation time.
  let fields = fieldnames(v)
  let nf = len(fields)

  if nf == 0:
    return "null"
  let out = "{"
  let written i64 = 0
  let i i64 = 0

  for i < nf:
    let fname string = fields[i]
    let jkey string = json_key(fname, fieldtag(v, fname))

    if len(jkey) > 0:
      if written > 0:
        out = out ++ ","
      out = out ++ escape_string(jkey) ++ ":" ++ encode_any_impl[T](getfield(v, fname), type_hint)
      written = written + 1

    i = i + 1

  return out ++ "}"

// encode[T] serialises a value of type T to a JSON string.
// T may be any primitive type, string, struct, or nested struct.
// Struct fields are encoded using compile-time reflection so all user-defined
// types - including nested structs and tuples - are supported automatically.
// Field tags control JSON keys: @"json:key" renames, @"json:-" omits.
//
//   encode(42 as i64)                -> "42"
//   encode(true)                     -> "true"
//   encode("hi")                     -> "\"hi\""
//   encode(point{x:1,y:2})          -> "{\"x\":1,\"y\":2}"
//   encode(nested{inner: point{...}}) -> nested JSON objects
//   encode((10, "hello"))            -> "{\"a\":10,\"b\":\"hello\"}"
fn encode[T](v T) string =
  let t = typeof(v)

  if t == 'none:
    return "null"

  if t == 'bool:
    if v as bool:
      return "true"
    return "false"

  if t == 'i64:
    let n = v as i64
    return "{n}"

  if t == 'f64:
    let f = v as f64
    return "{f:g}"

  if t == 'string:
    let sv T = v
    return escape_string(sv as string)

  // JsonSerializable: delegate to the type's own JSON encoding.
  let etraits = traitof(v)
  let eti i64 = 0

  for eti < len(etraits):
    if etraits[eti] == '"json::JsonSerializable":
      return encode_any_impl[T](v as any, v)
    eti = eti + 1

  // Struct (including tuples): iterate fields via compile-time reflection on T.
  // Uses encode_any_impl[T] so that nested struct fields are encoded recursively with
  // full struct type dispatch (handles user-defined nested struct types).
  let fields  = fieldnames(v)
  let nf      = len(fields)

  if nf == 0:
    return "null"

  let out     = "{"
  let written i64 = 0
  let i i64 = 0

  for i < nf:
    let fname string = fields[i]
    let jkey  string = json_key(fname, fieldtag(v, fname))

    if len(jkey) > 0:
      if written > 0:
        out = out ++ ","
      out = out ++ escape_string(jkey) ++ ":" ++ encode_any_impl[T](getfield(v, fname), v)
      written = written + 1

    i = i + 1

  return out ++ "}"

// Internal parser

struct Parser =
  src       *byte
  pos       i64
  len       i64
  err_pos   i64
  err_msg   string
  has_err   bool

  fn peek(this Parser) byte =
    if this.pos >= this.len:
      return 0
    return this.src[this.pos]

  fn advance(this *Parser) byte =
    let c = this.src[this.pos]

    this.pos = this.pos + 1

    return c

  // fail records a parser-level error.  Subsequent calls leave the
  // first error intact so the top-level `parse` surfaces the root
  // cause rather than a downstream symptom.
  fn fail(this *Parser, msg string) =
    if !this.has_err:
      this.has_err = true
      this.err_pos = this.pos
      this.err_msg = msg

  fn skip_ws(this *Parser) =
    // SIMD fast path: check 16 bytes at a time for whitespace.
    // A byte is whitespace iff it equals ' ', '\t', '\n', or '\r'.
    let sp  = simd::splat(@' ')
    let tab = simd::splat(@'\t')
    let nl  = simd::splat(@'\n')
    let cr  = simd::splat(@'\r')

    for this.pos + 16 <= this.len:
      let chunk = simd::loadu(addr(this.src[this.pos]))
      let is_sp  = simd::cmpeq(chunk, sp)
      let is_tab = simd::cmpeq(chunk, tab)
      let is_nl  = simd::cmpeq(chunk, nl)
      let is_cr  = simd::cmpeq(chunk, cr)
      let is_ws  = is_sp | is_tab | is_nl | is_cr
      let mask   = simd::movemask(is_ws)

      // mask has a 1-bit for each whitespace byte.  If all 16 bits are set,
      // every byte in this chunk is whitespace - skip the whole chunk.
      if mask == 0xffff:
        this.pos = this.pos + 16
      else if mask == 0:
        // No whitespace in this chunk - we are done.
        return
      else:
        // Mixed chunk: find first non-whitespace byte.
        let i i64 = 0

        for i < 16:
          if ((mask >> (i as u32)) & (1 as u32)) == 0:
            this.pos = this.pos + i
            return

          i = i + 1

        this.pos = this.pos + 16

    // Scalar tail.
    for this.pos < this.len:
      let c = this.src[this.pos]

      if c != @' ' && c != @'\t' && c != @'\n' && c != @'\r':
        break
      this.pos = this.pos + 1

  fn at_end(this Parser) bool = return this.pos >= this.len

fn parse_str(p *Parser) string =
  p.advance()  // consume opening "
  let result = ""
  let dq   = simd::splat(@'\"')
  let bsl  = simd::splat(@'\\')
  let done = false

  for !done && !p.at_end():
    // SIMD inner loop: scan 16 bytes at a time for '"' or '\'.
    // When a special byte is found, copy the plain prefix and break to the
    // scalar handler below (which consumes the special byte itself).
    for p.pos + 16 <= p.len:
      let chunk  = simd::loadu(addr(p.src[p.pos]))
      let hit_dq = simd::cmpeq(chunk, dq)
      let hit_bs = simd::cmpeq(chunk, bsl)
      let hits   = hit_dq | hit_bs
      let mask   = simd::movemask(hits)

      if mask == 0:
        // No special bytes in this chunk - append all 16.
        let j i64 = 0

        for j < 16:
          result = result ++ p.src[p.pos + j]
          j = j + 1

        p.pos = p.pos + 16
      else:
        // Find first special byte, copy plain prefix, leave special for scalar.
        let first i64 = 0

        for first < 16:
          if ((mask >> (first as u32)) & (1 as u32)) != 0:
            break
          first = first + 1

        let j i64 = 0

        for j < first:
          result = result ++ p.src[p.pos + j]
          j = j + 1

        p.pos = p.pos + first
        break  // exit SIMD loop; scalar below handles the special byte

    // Scalar: handle one byte ('"', '\', or a tail byte when < 16 remain).
    if !done && !p.at_end():
      let c = p.advance()

      if c == @'\"':
        done = true
      else:
        let out byte = c
        let emit = true

        if c == @'\\':
          if p.at_end():
            done = true
            emit = false
          else:
            let esc = p.advance()

            if esc == @'\"':      out = @'\"'
            else if esc == @'\\': out = @'\\'
            else if esc == @'/':  out = @'/'
            else if esc == @'b':  out = 0x08 as byte
            else if esc == @'f':  out = 0x0C as byte
            else if esc == @'n':  out = @'\n'
            else if esc == @'r':  out = @'\r'
            else if esc == @'t':  out = @'\t'
            else if esc == @'u':
              // \uXXXX -- parse 4 hex digits into a codepoint and
              // emit valid UTF-8.  Surrogate pairs (RFC 8259 sec 7):
              // a high surrogate (0xD800-0xDBFF) MUST be followed by
              // a low surrogate (0xDC00-0xDFFF) via a second \u
              // escape, combining into a 21-bit codepoint encoded as
              // 4-byte UTF-8.  Lone surrogates and any malformed
              // input fail the parse rather than emit invalid UTF-8.
              emit = false

              if p.pos + 4 > p.len:
                p.fail("\\u escape: not enough characters")
                done = true
              else if !(is_hex(p.src[p.pos] as i64) && is_hex(p.src[p.pos + 1] as i64) && is_hex(p.src[p.pos + 2] as i64) && is_hex(p.src[p.pos + 3] as i64)):
                p.fail("\\u escape: non-hex digit")
                done = true
              else:
                let h0 = p.src[p.pos] as i64
                let h1 = p.src[p.pos + 1] as i64
                let h2 = p.src[p.pos + 2] as i64
                let h3 = p.src[p.pos + 3] as i64
                let cp = (hex_val(h0) << 12) | (hex_val(h1) << 8) | (hex_val(h2) << 4) | hex_val(h3)

                p.pos = p.pos + 4

                if cp >= 0xDC00 && cp <= 0xDFFF:
                  // Lone low surrogate -- never legal on its own.
                  p.fail("unpaired low surrogate in \\u escape")
                  done = true
                else if cp >= 0xD800 && cp <= 0xDBFF:
                  // High surrogate: require a following \uDCxx low
                  // surrogate, combine into a 21-bit codepoint.
                  if p.pos + 6 > p.len || p.src[p.pos] != @'\\' || p.src[p.pos + 1] != @'u':
                    p.fail("unpaired high surrogate in \\u escape")
                    done = true
                  else if !(is_hex(p.src[p.pos + 2] as i64) && is_hex(p.src[p.pos + 3] as i64) && is_hex(p.src[p.pos + 4] as i64) && is_hex(p.src[p.pos + 5] as i64)):
                    p.fail("\\u escape after high surrogate: non-hex digit")
                    done = true
                  else:
                    let l0 = p.src[p.pos + 2] as i64
                    let l1 = p.src[p.pos + 3] as i64
                    let l2 = p.src[p.pos + 4] as i64
                    let l3 = p.src[p.pos + 5] as i64
                    let lo = (hex_val(l0) << 12) | (hex_val(l1) << 8) | (hex_val(l2) << 4) | hex_val(l3)

                    if lo < 0xDC00 || lo > 0xDFFF:
                      p.fail("high surrogate not followed by low surrogate")
                      done = true
                    else:
                      p.pos = p.pos + 6
                      let astral = ((cp - 0xD800) << 10) | (lo - 0xDC00)
                      let combined = astral + 0x10000

                      // 4-byte UTF-8: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                      result = result ++ ((0xF0 | (combined >> 18)) as byte)
                      result = result ++ ((0x80 | ((combined >> 12) & 0x3F)) as byte)
                      result = result ++ ((0x80 | ((combined >> 6) & 0x3F)) as byte)
                      result = result ++ ((0x80 | (combined & 0x3F)) as byte)
                else if cp < 0x80:
                  result = result ++ (cp as byte)
                else if cp < 0x800:
                  result = result ++ ((0xC0 | (cp >> 6)) as byte)
                  result = result ++ ((0x80 | (cp & 0x3F)) as byte)
                else:
                  // Non-surrogate BMP codepoint -- 3-byte UTF-8.
                  result = result ++ ((0xE0 | (cp >> 12)) as byte)
                  result = result ++ ((0x80 | ((cp >> 6) & 0x3F)) as byte)
                  result = result ++ ((0x80 | (cp & 0x3F)) as byte)
            else:                 out = esc

        if !done && emit:
          result = result ++ out

  // Loop exit conditions: `done == true` (saw closing quote OR p.fail
  // already set) or `at_end()` (ran out of input mid-string).  In the
  // second case the string is unterminated; surface the error so
  // callers don't see a silent truncation as a successful parse.
  if !done && p.at_end() && !p.has_err:
    p.fail("unterminated string literal")

  return result

// parse_int_bytes parses an integer directly from raw bytes
// (p.src[start..p.pos]).  Overflow flips the parser's `has_err` flag
// and returns 0 -- callers see the error surface at the top-level
// `parse`.
//
// We accumulate as negative for `-...` inputs so i64::MIN
// (-9223372036854775808) parses correctly.  Building positive then
// negating wraps the magnitude (which equals i64::MAX + 1 and does
// not fit in positive i64) and would force us to reject a
// well-formed JSON literal.
fn parse_int_bytes(p *Parser, start i64) i64 =
  let neg = false
  let i   i64 = start
  let r   i64 = 0

  if i < p.pos && p.src[i] == @'-':
    neg = true
    i = i + 1

  for i < p.pos:
    let c = p.src[i]

    if c < @'0' || c > @'9':
      break
    let d = (c - @'0') as i64

    if neg:
      // r is non-positive; check r * 10 - d >= i64::MIN.
      if r < -922337203685477580:
        p.fail("integer literal out of i64 range")
        return 0
      if r == -922337203685477580 && d > 8:
        p.fail("integer literal out of i64 range")
        return 0
      r = r * 10 - d
    else:
      if r > 922337203685477580:
        p.fail("integer literal out of i64 range")
        return 0
      if r == 922337203685477580 && d > 7:
        p.fail("integer literal out of i64 range")
        return 0
      r = r * 10 + d
    i = i + 1

  return r

fn parse_number(p *Parser) *Value =
  let start    = p.pos
  let is_float = false

  if p.peek() == @'-':
    p.advance()
  for !p.at_end():
    let c = p.peek()

    if c < @'0' || c > @'9':
      break
    p.advance()

  if !p.at_end() && p.peek() == @'.':
    is_float = true
    p.advance()

    for !p.at_end():
      let c = p.peek()

      if c < @'0' || c > @'9':
        break
      p.advance()

  if !p.at_end() && (p.peek() == @'e' || p.peek() == @'E'):
    is_float = true
    p.advance()

    if !p.at_end() && (p.peek() == @'+' || p.peek() == @'-'):
      p.advance()
    for !p.at_end():
      let c = p.peek()

      if c < @'0' || c > @'9':
        break
      p.advance()

  if is_float:
    // Build string from raw bytes for atof.
    let num = ""
    let i i64 = start

    for i < p.pos:
      num = num ++ p.src[i]
      i = i + 1

    return &Value{kind: Kind.float_v, fval: str::atof(num)}

  return &Value{kind: Kind.int_v, ival: parse_int_bytes(p, start)}

fn parse_value(p *Parser) *Value  // forward declaration

fn parse_array(p *Parser) *Value =
  p.advance()  // consume '['
  let items [*Value] = []

  p.skip_ws()

  if !p.at_end() && p.peek() == @']':
    p.advance()
    return &Value{kind: Kind.array_v, items: items}

  for !p.at_end():
    p.skip_ws()
    items ++= parse_value(p)
    p.skip_ws()

    if p.at_end():
      break
    let c = p.peek()

    if c == @']':
      p.advance()
      break

    if c == @',':
      p.advance()

  return &Value{kind: Kind.array_v, items: items}

fn parse_object(p *Parser) *Value =
  p.advance()  // consume '{'
  let items [*Value] = []
  let kkeys [string] = []

  p.skip_ws()

  if !p.at_end() && p.peek() == @'}':
    p.advance()
    return &Value{kind: Kind.object_v, items: items, kkeys: kkeys}

  for !p.at_end():
    p.skip_ws()

    if p.at_end() || p.peek() != @'\"':
      break
    let key = parse_str(p)

    p.skip_ws()

    if !p.at_end() && p.peek() == @':':
      p.advance()
    p.skip_ws()
    kkeys ++= key
    items ++= parse_value(p)
    p.skip_ws()

    if p.at_end():
      break
    let c = p.peek()

    if c == @'}':
      p.advance()
      break

    if c == @',':
      p.advance()

  return &Value{kind: Kind.object_v, items: items, kkeys: kkeys}

fn parse_value(p *Parser) *Value =
  p.skip_ws()

  if p.at_end():
    return &Value{kind: Kind.null_v}
  let c = p.peek()

  if c == @'\"':
    return &Value{kind: Kind.string_v, sval: parse_str(p)}

  if c == @'[':
    return parse_array(p)

  if c == @'{':
    return parse_object(p)

  if c == @'t':
    // Validate "true" byte-by-byte.  The previous implementation
    // blindly advanced 4 bytes, accepting "tnull" as `true` and
    // walking past the end of buffer on a bare "t".  On mismatch we
    // mark the parser as failed and return null; the top-level
    // `parse` surfaces that as a Malformed error.
    if p.pos + 4 > p.len || p.src[p.pos + 1] != @'r' || p.src[p.pos + 2] != @'u' || p.src[p.pos + 3] != @'e':
      p.fail("expected `true`")
      return &Value{kind: Kind.null_v}
    p.pos = p.pos + 4
    return &Value{kind: Kind.bool_v, bval: true}

  if c == @'f':
    if p.pos + 5 > p.len || p.src[p.pos + 1] != @'a' || p.src[p.pos + 2] != @'l' || p.src[p.pos + 3] != @'s' || p.src[p.pos + 4] != @'e':
      p.fail("expected `false`")
      return &Value{kind: Kind.null_v}
    p.pos = p.pos + 5
    return &Value{kind: Kind.bool_v, bval: false}

  if c == @'n':
    if p.pos + 4 > p.len || p.src[p.pos + 1] != @'u' || p.src[p.pos + 2] != @'l' || p.src[p.pos + 3] != @'l':
      p.fail("expected `null`")
      return &Value{kind: Kind.null_v}
    p.pos = p.pos + 4
    return &Value{kind: Kind.null_v}

  return parse_number(p)

// Public API

// JsonErrorKind enumerates the failures parse can surface.
//
//   data JsonErrorKind =
//     EmptyInput                // source string was empty
//     Malformed(pos i64, msg string)
//       // generic malformation at byte offset `pos`; `msg` is a short reason
data JsonErrorKind =
  EmptyInput
  Malformed(pos i64, msg string)

// JsonError implements errors::Err so json failures compose with the
// generic error trait.  Use kind() for structured discrimination.
struct JsonError(errors::Err) =
  _kind JsonErrorKind

  fn kind(this JsonError) JsonErrorKind = return this._kind

  fn errors::Err::message(this JsonError) string =
    match this._kind:
      case EmptyInput:        return "json: empty input"
      case Malformed(pos, m): return "json: malformed at byte {pos}: {m}"

  fn print(this JsonError) string =
    match this._kind:
      case EmptyInput:        return "json: empty input"
      case Malformed(pos, m): return "json: malformed at byte {pos}: {m}"

// parse parses a JSON string into a Value tree.
//
//   match json::parse(s):
//     case Ok(v):  use(v)
//     case Err(e): ...
//
// Or, when you don't care about the error:
//
//   let v = result::unwrap_or(json::parse(s), Value{kind: Kind.null_v})
fn parse(s string) Result[Value, JsonError] =
  if len(s) == 0:
    return Err(JsonError{_kind: EmptyInput})
  let p = Parser{src: s as *byte, pos: 0, len: len(s), err_pos: 0, err_msg: "", has_err: false}
  let v = parse_value(&p)

  if p.has_err:
    return Err(JsonError{_kind: Malformed(p.err_pos, p.err_msg)})

  return Ok(*v)

// parse_nested_any_impl[T] populates nested struct fields from a JSON Value object.
// `zero` is an any-boxed zero value of the nested struct type (obtained via getfield).
// The phantom type parameter T ensures this generic is compiled at the call site with
// full struct type dispatch tables, so fieldnames/fieldtypes work for user-defined types.
// Returns the updated any value with fields set from doc.
fn parse_nested_any_impl[T](zero any, doc Value, type_hint T) any =
  let fields = fieldnames(zero)   // runtime dispatch, full tables in instantiation
  let ftypes = fieldtypes(zero)   // runtime dispatch, full tables in instantiation
  let nf = len(fields)
  let i i64 = 0

  for i < nf:
    let fname string = fields[i]
    let jval = doc.get(fname)

    if !jval.is_null():
      let ftype = ftypes[i]

      match jval.kind:

        case Kind.int_v:
          if ftype == 'i64 || ftype == 'i32 || ftype == 'i16 || ftype == 'i8:
            setfield(zero, fname, jval.ival)
          else if ftype == 'f64:
            setfield(zero, fname, jval.ival as f64)

        case Kind.float_v:
          if ftype == 'f64:
            setfield(zero, fname, jval.fval)
          else if ftype == 'i64:
            setfield(zero, fname, jval.fval as i64)

        case Kind.bool_v:
          if ftype == 'bool:
            setfield(zero, fname, jval.bval)

        case Kind.string_v:
          if ftype == 'string:
            setfield(zero, fname, jval.sval)
          else:
            // JsonDeserializable: let the field type parse itself from a string.
            let nfv = getfield(zero, fname)
            let nft = traitof(nfv)
            let nfi i64 = 0

            for nfi < len(nft):
              if nft[nfi] == '"json::JsonDeserializable":
                let ndeser = nfv as JsonDeserializable

                ndeser.apply_json(jval.sval)
                setfield(zero, fname, nfv)

              nfi = nfi + 1

        case Kind.object_v:
          // Recursively parse deeply-nested struct objects.
          let nested_zero = getfield(zero, fname)
          let nested = parse_nested_any_impl[T](nested_zero, jval, type_hint)

          setfield(zero, fname, nested)

        default:
          pass

    i = i + 1

  return zero

// parse[T] parses a JSON string and decodes it directly into a value of type T.
// T must be a struct. Field tags @"json:key" rename fields; @"json:-" skips.
// Unrecognised JSON keys are silently ignored.
// Nested struct fields (Kind.object_v) are decoded recursively.
//
//   struct user =
//     id   i64    @"json:id"
//     name string @"json:name"
//
//   let u = json::parse[user]("{\"id\":1,\"name\":\"Alice\"}")
//   echo u.name   // Alice
fn parse[T](s string) Result[T, JsonError] =
  let out T
  let doc Value

  match parse(s):
    case Err(e): return Result[T, JsonError]::Err(e)
    case Ok(d):
      doc = d

  if doc.is_null():
    return Ok(out)
  let fields = fieldnames(out)
  let ftypes = fieldtypes(out)
  let nf     = len(fields)
  let i i64  = 0

  for i < nf:
    let fname  string = fields[i]
    let ftypei any    = ftypes[i]
    let jkey   string = json_key(fname, fieldtag(out, fname))

    if len(jkey) > 0:
      let jval = doc.get(jkey)

      if !jval.is_null():
        let ftype = ftypei

        match jval.kind:

          case Kind.int_v:
            if ftype == 'i64 || ftype == 'i32 || ftype == 'i16 || ftype == 'i8:
              setfield(out, fname, jval.ival)
            else if ftype == 'f64:
              setfield(out, fname, jval.ival as f64)

          case Kind.float_v:
            if ftype == 'f64:
              setfield(out, fname, jval.fval)
            else if ftype == 'i64:
              setfield(out, fname, jval.fval as i64)

          case Kind.bool_v:
            if ftype == 'bool:
              setfield(out, fname, jval.bval)

          case Kind.string_v:
            if ftype == 'string:
              setfield(out, fname, jval.sval)
            else:
              // JsonDeserializable: let the field type parse itself from a string.
              let fv = getfield(out, fname)
              let ftraits = traitof(fv)
              let fi i64 = 0

              for fi < len(ftraits):
                if ftraits[fi] == '"json::JsonDeserializable":
                  let deser = fv as JsonDeserializable

                  deser.apply_json(jval.sval)
                  setfield(out, fname, fv)

                fi = fi + 1

          case Kind.object_v:
            // Nested struct field: get the zero-valued field as any, populate it,
            // then set it back (coerce any->FieldType is handled by setfield's coerce).
            let zero_nested = getfield(out, fname)
            let populated = parse_nested_any_impl[T](zero_nested, jval, out)

            setfield(out, fname, populated)

          default:
            pass

    i = i + 1

  return Ok(out)

export {
  Kind, Value, parse, encode,
  JsonError, JsonErrorKind, EmptyInput, Malformed,
  JsonSerializable, JsonDeserializable,
} as json
