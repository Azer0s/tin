// stdlib/decimal - exact decimal arithmetic backed by (coefficient, scale).
//
// `Value` represents `coefficient * 10^(-scale)`. Arithmetic is performed by
// aligning scales so there is no IEEE 754 rounding for sums or differences
// of typical user input. Use `decimal::from(...)` to convert from any
// numeric type or from a literal string; the result implements operator
// overloads, `comp` / `ord`, and the `print` trait so values flow through
// echo / `"{...}"` interpolation directly.
//
//   use decimal
//
//   let total decimal::Value = decimal::from("0.1") + decimal::from("0.2")
//   echo total                // 0.3 - exact
//
// For floats, `decimal::from(f)` uses the shortest-round-trip decimal
// representation of `f`; passing a string keeps the user's literal exact.

use str
use errors
use result
use { Result } from result

// pow10 returns 10^n as i64. n must be in [0, 18]; values outside that
// range overflow i64 and the function panics rather than silently
// returning a corrupted scale factor that would propagate as a wrong
// answer.
fn pow10(n i32) i64 =
  if n < 0 || n > 18:
    panic("decimal: scale {n} out of range [0, 18]; combined coefficient/scale products would overflow i64")
  let r i64 = 1
  let i i32 = 0

  for i < n:
    r = r * 10
    i = i + 1

  return r

// Value is a fixed-point decimal with i64 coefficient and i32 scale.
// (coeff, scale) -> coeff * 10^(-scale). Equality compares values, not
// representations: 1.0 (coeff=10, scale=1) and 1 (coeff=1, scale=0) compare
// equal because align() lifts the lower-scale operand.
struct Value(
  add[Value, Value], sub[Value, Value], mul[Value, Value], div[Value, Value],
  neg[Value], comp[Value], ord[Value],
  implicit[i32], implicit[i64], implicit[f32], implicit[f64], implicit[string],
  print
) =
  coeff i64
  scale i32

  // Operator overloads.

  fn ::add(this Value, other Value) Value =
    let (a, b) = align(this, other)
    return Value{coeff: a.coeff + b.coeff, scale: a.scale}

  fn ::sub(this Value, other Value) Value =
    let (a, b) = align(this, other)
    return Value{coeff: a.coeff - b.coeff, scale: a.scale}

  fn ::mul(this Value, other Value) Value =
    return Value{coeff: this.coeff * other.coeff, scale: this.scale + other.scale}

  // div produces up to ~18 significant digits of precision. Trailing
  // zeros are normalized away so `1.5 / 0.5` returns Value{3, 0} rather
  // than {3e17, 17}.
  fn ::div(this Value, other Value) Value =
    let extra i32 = 18 - this.scale

    if extra < 0:
      extra = 0
    let factor = pow10(extra)
    let new_coeff = (this.coeff * factor) / other.coeff

    return normalize(Value{coeff: new_coeff, scale: this.scale + extra - other.scale})

  fn ::neg(this Value) Value =
    return Value{coeff: -this.coeff, scale: this.scale}

  fn ::comp(this Value, other Value) bool =
    let (a, b) = align(this, other)
    return a.coeff == b.coeff

  // ord returns negative / zero / positive following strcmp convention.
  // Uses branchy compare instead of subtraction so far-apart values
  // (e.g. near i64::MIN and i64::MAX) don't overflow into the wrong
  // sign.
  fn ::ord(this Value, other Value) i64 =
    let (a, b) = align(this, other)

    if a.coeff < b.coeff: return -1
    if a.coeff > b.coeff: return 1

    return 0

  // Implicit conversions: any numeric or string flowing into a Value lands
  // here. The static fns mirror the top-level decimal::from(...) overloads.

  static fn ::implicit(v i32) Value =
    return Value{coeff: v as i64, scale: 0}

  static fn ::implicit(v i64) Value =
    return Value{coeff: v, scale: 0}

  static fn ::implicit(v f32) Value =
    return from_f64_impl(v as f64)

  static fn ::implicit(v f64) Value =
    return from_f64_impl(v)

  static fn ::implicit(s string) Value =
    return parse_impl(s)

  // print: format as a decimal string. coeff and scale are reduced to a
  // canonical (no leading zeros in the integer part, the fractional part
  // length matches scale).
  fn ::print(this Value) string =
    return format_impl(this)

// normalize strips trailing factors of 10 from coeff while decrementing
// scale, so that values like {coeff: 30, scale: 1} collapse to {3, 0}.
// Equality already ignores representation via align(), but keeping div
// results compact prevents pow10 from overflowing on later operations.
fn normalize(v Value) Value =
  let coeff = v.coeff
  let scale = v.scale

  for coeff != 0 && scale > 0 && coeff % 10 == 0:
    coeff = coeff / 10
    scale = scale - 1

  return Value{coeff: coeff, scale: scale}

// align returns a, b at the same scale. The lower-scale operand is lifted
// to match the higher one; the higher operand is unchanged.  An attempted
// helper-fn-based overflow check (`checked_mul_i64`) interacted poorly
// with operator overload resolution -- because Value declares
// `implicit[i64]`, the i64 comparison inside the helper resolved to
// Value's overloaded `>`, which calls align(), which calls the helper:
// infinite recursion at runtime.  The safe overflow check is inlined
// below using only operations that don't go through any overloaded
// trait, so resolution stays purely on i64.
//
// Pre-fix the lift used a plain multiply; a near-i64::MAX coefficient
// with a wide scale gap silently wrapped (worst case: ord() compared
// the wrapped values and returned the wrong sign).
fn align(a Value, b Value) (Value, Value) =
  if a.scale == b.scale:
    return (a, b)

  let max i64 = 9223372036854775807

  if a.scale > b.scale:
    let factor = pow10(a.scale - b.scale)

    // factor is always positive (pow10 is in [1, 1e18]).  Detect
    // overflow before the multiply: |b.coeff| * factor must fit in
    // i64.  Using (max / factor) avoids any i64 multiply that could
    // wrap before the check.
    let limit = max / factor

    if b.coeff > limit:
      panic("decimal: align overflow -- coefficient too large for combined scale")
    if b.coeff < (0 - limit):
      panic("decimal: align overflow -- coefficient too negative for combined scale")
    return (a, Value{coeff: b.coeff * factor, scale: a.scale})

  let factor = pow10(b.scale - a.scale)
  let limit = max / factor

  if a.coeff > limit:
    panic("decimal: align overflow -- coefficient too large for combined scale")
  if a.coeff < (0 - limit):
    panic("decimal: align overflow -- coefficient too negative for combined scale")
  return (Value{coeff: a.coeff * factor, scale: b.scale}, b)

// Top-level overloaded `from`. Each variant produces a fresh Value with
// no IEEE rounding for integer / string inputs and shortest-round-trip for
// floats.
fn from(v i32) Value =
  return Value{coeff: v as i64, scale: 0}

fn from(v i64) Value =
  return Value{coeff: v, scale: 0}

fn from(v f32) Value =
  return from_f64_impl(v as f64)

fn from(v f64) Value =
  return from_f64_impl(v)

fn from(s string) Value =
  return parse_impl(s)

// DecimalError enumerates the failure modes decimal::parse can hit.
// Implements errors::Err so calls return Result[T, errors::Err] like
// the rest of the stdlib's typed-error ecosystem.
data DecimalError(errors::Err, print) =
  EmptyDecimal
  ExtraDot(input string)
  InvalidDecimalChar(input string)
  NoDecimalDigits

  fn errors::Err::message(this DecimalError) string =
    match this:
      case EmptyDecimal:           return "decimal::parse: empty string"
      case ExtraDot(_):            return "decimal::parse: extra '.'"
      case InvalidDecimalChar(_):  return "decimal::parse: invalid character"
      case NoDecimalDigits:        return "decimal::parse: no digits"

  fn ::print(this DecimalError) string = return this.message()

// parse converts a decimal string to a Value. Accepts an optional leading
// `-`, digits, and an optional `.<digits>` fractional part. Anything else
// produces Err(DecimalError).
fn parse(s string) Result[Value, errors::Err] =
  let n = len(s)

  if n == 0:
    return Err(EmptyDecimal)
  let neg = false
  let i i64 = 0

  if s[0] == @'-':
    neg = true
    i = 1
  else if s[0] == @'+':
    i = 1
  let coeff i64 = 0
  let scale i32 = 0
  let seen_dot = false
  let seen_digit = false

  for i < n:
    let c = s[i]

    if c == @'.':
      if seen_dot:
        return Err(ExtraDot(s))
      seen_dot = true
    else if c >= @'0' && c <= @'9':
      coeff = coeff * 10 + ((c - @'0') as i64)
      seen_digit = true

      if seen_dot:
        scale = scale + 1
    else:
      return Err(InvalidDecimalChar(s))
    i = i + 1

  if !seen_digit:
    return Err(NoDecimalDigits)
  if neg:
    coeff = -coeff

  return Ok(Value{coeff: coeff, scale: scale})

// parse_impl is the ::implicit / from(string) variant that panics on
// malformed input rather than returning an error tuple. Callers who want
// graceful handling should use decimal::parse(s).
fn parse_impl(s string) Value =
  match parse(s):
    case Ok(v):  return v
    case Err(e): panic("decimal::from(string): {e.message()}")

// from_f64_impl produces a Value whose decimal representation round-trips
// through f64. Iterates printf precision from 1 to 17 and stops at the
// first precision where atof reproduces the original IEEE bit pattern.
// This matches Go's strconv.FormatFloat(_, 'g', -1, 64).
//
// Non-finite inputs (NaN, +Inf, -Inf) panic - decimal has no representation
// for them, and silently rounding to zero would mask the bug at the call
// site. Callers who handle non-finites explicitly should test before
// converting (`floats::is_nan(x)`, `floats::is_pos_inf(x)`, ...).
fn from_f64_impl(x f64) Value =
  if x != x:
    panic("decimal::from(f64): NaN cannot be represented as a decimal")
  if x > 1.7976931348623157e+308:
    panic("decimal::from(f64): +Inf cannot be represented as a decimal")
  if x < -1.7976931348623157e+308:
    panic("decimal::from(f64): -Inf cannot be represented as a decimal")
  let buf [byte; 64]
  let prec i32 = 1

  for prec <= 17:
    let n = str::sprintf(&buf[0] as *char, "%.*g", prec, x)
    let s = buf[0..n as i64] as string

    if str::atof(s) == x:
      return parse_impl(s)
    prec = prec + 1

  // Fallback: 17g always round-trips for normal doubles.
  let n = str::sprintf(&buf[0] as *char, "%.17g", x)

  return parse_impl(buf[0..n as i64] as string)

// format_impl renders a Value as a canonical decimal string. Empty
// fractional part for scale=0; trailing zeros are NOT stripped so the
// scale information survives round-trip through print/parse.
fn format_impl(v Value) string =
  let coeff = v.coeff
  let neg = coeff < 0

  if neg:
    coeff = -coeff
  let body string = "{coeff}"

  if v.scale == 0:
    if neg:
      return "-" ++ body
    return body

  let n = len(body)
  let s = v.scale as i64

  if n <= s:
    let pad = repeat_char(@'0', s - n + 1)

    body = pad ++ body

  let new_n = len(body)
  let int_end = new_n - s
  let int_part = body[0:int_end]
  let frac_part = body[int_end:new_n]
  let result = int_part ++ "." ++ frac_part

  if neg:
    return "-" ++ result

  return result

fn repeat_char(c char, n i64) string =
  // Build into a [byte] (amortised O(1) push) then convert once.  The
  // earlier `out = out ++ byte` form was O(n^2): every concat
  // reallocated and copied the entire prefix, so a 100k-digit
  // formatted decimal hung visibly.  Cap the length at i64::MAX
  // implicitly via the loop counter; n <= 0 returns "".
  if n <= 0:
    return ""
  let buf [byte] = []
  let i i64 = 0

  for i < n:
    buf ++= (c as byte)
    i = i + 1

  return buf as string

export {
  Value,
  from,
  parse,
  DecimalError,
  EmptyDecimal, ExtraDot, InvalidDecimalChar, NoDecimalDigits,
} as decimal
