// stdlib/io - I/O functions
//
// Wraps standard C file and console I/O, plus async fiber-friendly wrappers.
// No extra linker flags required (all in libc)

use { loop } from macros
use sync
use "./closeable"
use "./async_traits"

// Console output

// puts writes s followed by a newline to stdout
fn puts(s string) = extern("puts")

// fputs writes s to the given FILE* stream (no trailing newline)
// Pass the result of fopen() or the constants stdin/stdout/stderr
fn fputs(s string, stream *void) i32 = extern("fputs")

// fprintf writes a formatted string to a FILE* stream
// Note: only string format args are fat-ptr unwrapped; use %s with string args
fn fprintf(stream *void, fmt string, ...) i32 = extern("fprintf")

// printf writes a formatted string to stdout
fn printf(fmt string, ...) i32 = extern("printf")

// Console input

// fgets reads at most n-1 characters into buf from stream
// Returns buf as a *char on success, null on EOF/error
fn fgets(buf *char, n i32, stream *void) *char = extern("fgets")

// scanf reads formatted input from stdin
fn scanf(fmt string, ...) i32 = extern("scanf")

// File I/O

// fopen opens a file at path with the given mode ("r", "w", "a", "rb", etc.)
// Returns a FILE* (opaque *void) or null on failure
fn fopen(path string, mode string) *void = extern("fopen")

// fclose closes a FILE* stream. Returns 0 on success
fn fclose(stream *void) i32 = extern("fclose")

// fread reads count items of size bytes from stream into buf
fn fread(buf *void, size i64, count i64, stream *void) i64 = extern("fread")

// fwrite writes count items of size bytes from buf to stream
fn fwrite(buf *void, size i64, count i64, stream *void) i64 = extern("fwrite")

// fseek sets the file position of stream. whence: 0=SEEK_SET, 1=SEEK_CUR, 2=SEEK_END
fn fseek(stream *void, offset i64, whence i32) i32 = extern("fseek")

// ftell returns the current file position of stream
fn ftell(stream *void) i64 = extern("ftell")

// fflush flushes the output buffer of stream. Pass null to flush all streams
fn fflush(stream *void) i32 = extern("fflush")

// feof returns non-zero if the end-of-file indicator is set for stream
fn feof(stream *void) i32 = extern("feof")

// ferror returns non-zero if the error indicator is set for stream
fn ferror(stream *void) i32 = extern("ferror")

// remove deletes a file at the given path
fn remove(path string) i32 = extern("remove")

// rename renames/moves a file
fn rename(old_path string, new_path string) i32 = extern("rename")

// print writes s followed by a newline (alias for puts)
fn print(s string) = puts(s)

// Async I/O - non-blocking reads/writes backed by the dedicated I/O thread.
//
// Low-level primitives (async_read, async_write) are {#async} functions that
// must be called with `await spawn`. Higher-level functions (sleep, write_all,
// read_exact) return Future[T] directly and can be awaited without spawn:
//
//   let n = await spawn io::async_read(fd, &buf[0], 4096)  // low-level
//   await io::sleep(100)                                    // high-level
//   await io::write_all(fd, &buf[0], n)                    // high-level

// Raw C helpers (not exported)
fn tin_async_read_c(fd i32, buf *byte, n i64) i64 = extern("_tin_async_read")
fn tin_async_write_c(fd i32, buf *byte, n i64) i64 = extern("_tin_async_write")
fn tin_sleep_ms_c(ms i64) = extern("_tin_sleep_ms")
fn tin_io_blocked_val_c() i64 = extern("_tin_io_blocked_val")
fn tin_now_ms() i64 = extern("_tin_now_ms")
fn tin_now_us() i64 = extern("_tin_now_us")

// now_ms returns monotonic milliseconds (suitable for elapsed-time measurement).
fn now_ms() i64 = return tin_now_ms()

// now_us returns monotonic microseconds.
fn now_us() i64 = return tin_now_us()

// async_read reads up to n bytes from fd into buf.
// Returns the number of bytes read, or a negative errno on error.
// Suspends the fiber if fd is not ready and retries after wakeup.
// Low-level primitive: call with `await spawn io::async_read(fd, buf, n)`.
fn{#async} async_read(fd i32, buf *byte, n i64) i64 =
  let blocked = tin_io_blocked_val_c()

  loop:
    let r = tin_async_read_c(fd, buf, n)

    if r != blocked:
      return r
    yield

// async_write writes up to n bytes from buf to fd.
// Returns the number of bytes written, or a negative errno on error.
// Suspends the fiber if fd is not ready and retries after wakeup.
// Low-level primitive: call with `await spawn io::async_write(fd, buf, n)`.
fn{#async} async_write(fd i32, buf *byte, n i64) i64 =
  let blocked = tin_io_blocked_val_c()

  loop:
    let r = tin_async_write_c(fd, buf, n)

    if r != blocked:
      return r
    yield

// sleep suspends the current fiber for at least ms milliseconds without
// blocking the worker thread. Returns a Future[sync::Unit] - use `await io::sleep(ms)`.
fn sleep(ms i64) Future[sync::Unit] =
  return spawn sleep_impl(ms)

fn{#async} sleep_impl(ms i64) =
  tin_sleep_ms_c(ms)
  yield

// write_all writes all n bytes from buf to fd, retrying on partial writes.
// Returns a Future[sync::Unit] - use `await io::write_all(fd, buf, n)`.
fn write_all(fd i32, buf *byte, n i64) Future[sync::Unit] =
  return spawn write_all_impl(fd, buf, n)

fn{#async} write_all_impl(fd i32, buf *byte, n i64) =
  let sent i64 = 0

  loop:
    if sent >= n:
      break
    do{#unsafe}:
      let w = await spawn async_write(fd, buf + sent, n - sent)
      if w <= 0:
        break
      sent = sent + w

// read_exact reads exactly n bytes from fd into buf, retrying until full or EOF.
// Returns a Future[i64] holding the total bytes read - use `await io::read_exact(fd, buf, n)`.
fn read_exact(fd i32, buf *byte, n i64) Future[i64] =
  return spawn read_exact_impl(fd, buf, n)

fn{#async} read_exact_impl(fd i32, buf *byte, n i64) i64 =
  let got i64 = 0

  loop:
    if got >= n:
      break
    do{#unsafe}:
      let r = await spawn async_read(fd, buf + got, n - got)
      if r <= 0:
        return got
      got = got + r

  return got

// close closes a file descriptor.
fn close(fd i32) = extern("_tin_fd_close")

// Synchronous (blocking) read/write at the syscall level. For fiber-friendly
// I/O use async_read / async_write instead; these block the OS thread.
fn read_sync(fd i32, buf *byte, n i64) i64 = extern("read")
fn write_sync(fd i32, buf *byte, n i64) i64 = extern("write")

// stdin / stdout / stderr file descriptors. Useful for code that reads
// from a pipe or writes diagnostics without going through libc's stdio.
const STDIN  i32 = 0
const STDOUT i32 = 1
const STDERR i32 = 2

// Buffered reader: line-oriented input over a file descriptor.

const BUFREADER_CAP i64 = 4096

// BufferedReader wraps a raw fd with a fixed 4 KiB buffer so read_line and
// read_until don't issue a syscall per byte. Construct with `bufreader(fd)`
// and consume with read_byte / read_line / read_until. Calls block; for
// async use composite the reader yourself with async_read.
struct BufferedReader =
  fd  i32
  buf [byte; 4096]
  pos i64    // next byte to consume in buf
  end i64    // valid bytes in buf are [pos, end)
  done bool  // hit EOF on the underlying fd

  // refill calls read(2) once into the internal buffer. Returns true if
  // any bytes were obtained, false on EOF or error.
  fn refill(this *BufferedReader) bool =
    if this.done:
      return false
    this.pos = 0
    let n = read_sync(this.fd, &this.buf[0], 4096)

    if n <= 0:
      this.done = true
      this.end = 0

      return false

    this.end = n

    return true

  // read_byte returns the next byte plus true; on EOF returns (0, false).
  fn read_byte(this *BufferedReader) (byte, bool) =
    if this.pos >= this.end:
      if !this.refill():
        return (0 as byte, false)
    let b = this.buf[this.pos]

    this.pos = this.pos + 1

    return (b, true)

  // read_until reads bytes up to and including the first occurrence of
  // delim. The delimiter byte itself is NOT included in the returned
  // string. Returns ("", false) only if EOF is reached with no bytes
  // pending (so a final unterminated chunk still comes back as a line).
  fn read_until(this *BufferedReader, delim byte) (string, bool) =
    let out = ""
    let any = false
    let done_flag = false
    let result_str = ""
    let result_ok = false

    for !done_flag:
      let (b, ok) = this.read_byte()

      if !ok:
        if any:
          result_str = out
          result_ok = true

        done_flag = true
      else:
        any = true

        if b == delim:
          result_str = out
          result_ok = true
          done_flag = true
        else:
          out = out ++ b

    return (result_str, result_ok)

  // read_line returns the next line (without the trailing '\n'). Treats
  // EOF as a soft line terminator if any bytes were consumed; (?, false)
  // means "nothing left".
  fn read_line(this *BufferedReader) (string, bool) =
    return this.read_until(@'\n' as byte)

// bufreader is the convenience constructor.
fn bufreader(fd i32) BufferedReader =
  return BufferedReader{fd: fd, pos: 0, end: 0, done: false}

// I/O traits live in ./async_traits.tin so file-path imports below
// (./io_copy) see the trait registrations regardless of inclusion
// order.  io::Reader / io::Writer / io::AsyncReader / io::AsyncWriter
// are re-exported as part of this package's surface.

use "./io_copy"
use "./io_bufwriter"

export {
  puts, fputs, fprintf, printf, print,
  fgets, scanf,
  fopen, fclose, fread, fwrite, fseek, ftell, fflush, feof, ferror,
  remove, rename,
  async_read, async_write, sleep,
  write_all, read_exact,
  close,
  read_sync, write_sync,
  STDIN, STDOUT, STDERR,
  BufferedReader, bufreader,
  now_ms, now_us,
  Reader, Writer, AsyncReader, AsyncWriter,
  Closeable,
  copy,
  BufWriter, bufwriter,
} as io
