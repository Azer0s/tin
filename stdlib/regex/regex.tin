// stdlib/regex - Regular expression matching via PCRE
//
// Links against libpcre (-lpcre).  Every tin file that uses this package
// should already pick up the flag automatically via the //! directive below,
// but you can also pass -lpcre explicitly when building.
//
// Usage:
//
//   use regex
//
//   let re = regex::compile("^hello (\\w+)$")
//   if re.is_err():
//     echo "compile error: {re.err_msg()}"
//   else:
//     let m = re.exec("hello world")
//     if m.matched():
//       echo m.group(0)   // "hello world"
//       echo m.group(1)   // "world"
//
//   // Convenience one-shot functions:
//   if regex::matches("^\\d+$", "12345"):
//     echo "all digits"
//
//   let result = regex::find_all("\\d+", "a1 b22 c333")
//   // result: ["1", "22", "333"]

//!-lpcre

// PCRE C API declarations

// Opaque PCRE handle
fn _pcre_compile(pattern string, options i32, errptr **byte, erroffset *i32, tables *byte) *void = extern("pcre_compile")

fn _pcre_exec(code *void, extra *void, subject string, length i32, startoffset i32, options i32, ovector *i32, ovecsize i32) i32 = extern("pcre_exec")

fn _pcre_free_fn(ptr *void) = extern("pcre_free_fn_wrapper")

fn _pcre_capturecount(code *void, rc *i32) i32 = extern("pcre_fullinfo_capturecount")

fn _tin_string_from_bytes_c(ptr *byte, n i64) string = extern("_tin_string_from_bytes")
fn _tin_string_data_c(s string) *byte              = extern("_tin_string_data")
fn _tin_buf_alloc_c(n i64) *byte                   = extern("_tin_buf_alloc")
fn _tin_buf_free_c(ptr *byte)                      = extern("_tin_buf_free")

// C helper file
//
// A tiny shim is needed because:
//   1. pcre_free is a function pointer variable, not a direct function.
//   2. pcre_fullinfo has a complex variadic interface.
//
// These helpers are defined in regex.c (compiled via //!+regex.c).

//!+regex.c

// Match result

struct Match =
  _matched bool
  _groups  [string]   // captured groups: index 0 = whole match, 1+ = sub-groups
  _ends    [i64]      // end offsets (for iterating find_all)

  fn matched(this Match) bool  = return this._matched
  fn count(this Match) i64     = return len(this._groups)

  // group returns the text of capture group i (0 = whole match).
  fn group(this Match, i i64) string =
    if i < 0 || i >= len(this._groups):
      return ""
    return this._groups[i]

  fn _end(this Match, i i64) i64 =
    if i < 0 || i >= len(this._ends):
      return 0
    return this._ends[i]

// Internal exec helper

fn _exec(code *void, subject string, start i64) Match =
  let slen    = len(subject)
  let ovsize  i32 = 30          // supports up to 9 capture groups
  let ov      = _tin_buf_alloc_c(ovsize as i64 * 4)  // i32 array
  let ov_i32  = ov as *i32
  let rc i32  = _pcre_exec(code, 0 as *void, subject, slen as i32, start as i32, 0, ov_i32, ovsize)
  if rc < 0:
    _tin_buf_free_c(ov)
    return Match{_matched: false, _groups: [], _ends: []}
  let groups [string] = []
  let ends   [i64]    = []
  let src = _tin_string_data_c(subject)
  let i i32 = 0
  for i < rc:
    let beg = ov_i32[i * 2]
    let end = ov_i32[i * 2 + 1]
    let gstr = _tin_string_from_bytes_c(src + beg as i64, (end - beg) as i64)
    groups ++= gstr
    ends   ++= end as i64
    i = i + 1
  _tin_buf_free_c(ov)
  return Match{_matched: true, _groups: groups, _ends: ends}

// Compiled regex

struct Regex =
  _code    *void    // pcre* handle (None on compile error)
  _err_msg string   // non-empty on error

  fn is_err(this Regex) bool     = return this._code == 0 as *void
  fn err_msg(this Regex) string  = return this._err_msg

  // exec executes the regex against subject and returns a Match.
  fn exec(this Regex, subject string) Match =
    if this._code == 0 as *void:
      return Match{_matched: false, _groups: []}
    return _exec(this._code, subject, 0)

  // match_at executes starting at byte offset start.
  fn match_at(this Regex, subject string, start i64) Match =
    if this._code == 0 as *void:
      return Match{_matched: false, _groups: []}
    return _exec(this._code, subject, start)

  // find_all returns all non-overlapping matches of the full pattern in s.
  fn find_all(this Regex, s string) [string] =
    let results [string] = []
    if this._code == 0 as *void:
      return results
    let pos i64 = 0
    let slen = len(s)
    for pos <= slen:
      let m = _exec(this._code, s, pos)
      if !m.matched():
        break
      results ++= m.group(0)
      let end = m._end(0)
      if end <= pos:
        pos = pos + 1
      else:
        pos = end
    return results

// Public API

// compile compiles a PCRE pattern and returns a Regex.
// Check is_err() before using.
fn compile(pattern string) Regex =
  let errptr  *byte = 0 as *byte
  let erroff  i32   = 0
  let code = _pcre_compile(pattern, 0, &errptr, &erroff, 0 as *byte)
  if code == 0 as *void:
    let msg string = "regex compile error"
    if (errptr as i64) != 0:
      // Build error string from C char*
      let elen i64 = 0
      for errptr[elen] != 0:
        elen = elen + 1
      msg = _tin_string_from_bytes_c(errptr, elen)
    return Regex{_code: 0 as *void, _err_msg: msg}
  return Regex{_code: code, _err_msg: ""}

// matches returns true if pattern matches anywhere in s.
fn matches(pattern string, s string) bool =
  let re = compile(pattern)
  if re.is_err():
    return false
  return re.exec(s).matched()

// find returns the first match of pattern in s, or "" if no match.
fn find(pattern string, s string) string =
  let re = compile(pattern)
  if re.is_err():
    return ""
  let m = re.exec(s)
  if !m.matched():
    return ""
  return m.group(0)

// find_all returns all non-overlapping matches of pattern in s.
fn find_all(pattern string, s string) [string] =
  let re = compile(pattern)
  if re.is_err():
    return []
  return re.find_all(s)

// replace replaces the first occurrence of pattern in s with repl.
fn replace(pattern string, s string, repl string) string =
  let re = compile(pattern)
  if re.is_err():
    return s
  let m = re.exec(s)
  if !m.matched():
    return s
  // Build: prefix + repl + suffix
  let src  = _tin_string_data_c(s)
  let slen = len(s)
  // group(0) span: need start offset too
  // Recompile or use a local exec to get start offset
  let beg_buf = _tin_buf_alloc_c(8)
  let beg_i32 = beg_buf as *i32
  _pcre_exec(re._code, 0 as *void, s, slen as i32, 0, 0, beg_i32, 2)
  let beg = beg_i32[0] as i64
  let end = beg_i32[1] as i64
  _tin_buf_free_c(beg_buf)
  let prefix = _tin_string_from_bytes_c(src, beg)
  let suffix = _tin_string_from_bytes_c(src + end, slen - end)
  return prefix ++ repl ++ suffix

// replace_all replaces all non-overlapping occurrences of pattern in s with repl.
fn replace_all(pattern string, s string, repl string) string =
  let re = compile(pattern)
  if re.is_err():
    return s
  let result = ""
  let src  = _tin_string_data_c(s)
  let slen = len(s)
  let pos  i64 = 0
  for pos <= slen:
    let m = re.match_at(s, pos)
    if !m.matched():
      result = result ++ _tin_string_from_bytes_c(src + pos, slen - pos)
      break
    // append text before match
    let beg_buf = _tin_buf_alloc_c(8)
    let beg_i32 = beg_buf as *i32
    _pcre_exec(re._code, 0 as *void, s, slen as i32, pos as i32, 0, beg_i32, 2)
    let beg = beg_i32[0] as i64
    let end = beg_i32[1] as i64
    _tin_buf_free_c(beg_buf)
    result = result ++ _tin_string_from_bytes_c(src + pos, beg - pos)
    result = result ++ repl
    if end <= pos:
      result = result ++ _tin_string_from_bytes_c(src + pos, 1)
      pos = pos + 1
    else:
      pos = end
  return result

// split splits s by all matches of pattern.
fn split(pattern string, s string) [string] =
  let re = compile(pattern)
  let parts [string] = []
  if re.is_err():
    parts ++= s
    return parts
  let src  = _tin_string_data_c(s)
  let slen = len(s)
  let pos  i64 = 0
  for pos <= slen:
    let beg_buf = _tin_buf_alloc_c(8)
    let beg_i32 = beg_buf as *i32
    let rc i32  = _pcre_exec(re._code, 0 as *void, s, slen as i32, pos as i32, 0, beg_i32, 2)
    if rc < 0:
      _tin_buf_free_c(beg_buf)
      parts ++= _tin_string_from_bytes_c(src + pos, slen - pos)
      break
    let beg = beg_i32[0] as i64
    let end = beg_i32[1] as i64
    _tin_buf_free_c(beg_buf)
    parts ++= _tin_string_from_bytes_c(src + pos, beg - pos)
    if end <= pos:
      pos = pos + 1
    else:
      pos = end
  return parts

export { Regex, Match, compile, matches, find, find_all, replace, replace_all, split } as regex
