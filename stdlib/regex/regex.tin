// stdlib/regex - Regular expression matching via PCRE
//
// Links against libpcre (-lpcre). Every tin file that uses this package
// should already pick up the flag automatically via the //! directive below,
// but you can also pass -lpcre explicitly when building.
//
// Usage:
//
//   use regex
//
//   let re = regex::compile("^hello (\\w+)$")
//   if re.is_err():
//     echo "compile error: {re.err_msg()}"
//   else:
//     let m = re.exec("hello world")
//     if m.matched():
//       echo m.group(0)   // "hello world"
//       echo m.group(1)   // "world"
//
//   // Convenience one-shot functions:
//   if regex::matches("^\\d+$", "12345"):
//     echo "all digits"
//
//   let result = regex::find_all("\\d+", "a1 b22 c333")
//   // result: ["1", "22", "333"]

//!-lpcre
//!+regex.c [linux]
//!+regex.c [darwin] -- -I $(brew --prefix pcre)/include
//!-L$(brew --prefix pcre)/lib [darwin]

use mem

// PCRE C API declarations

fn pcre_compile(pattern string, options i32, errptr **byte, erroffset *i32, tables *byte) *void = extern("pcre_compile")

fn pcre_exec(code *void, extra *void, subject string, length i32, startoffset i32, options i32, ovector *i32, ovecsize i32) i32 = extern("pcre_exec")

fn pcre_free_fn(ptr *void) = extern("pcre_free_fn_wrapper")

fn pcre_capturecount(code *void, rc *i32) i32 = extern("pcre_fullinfo_capturecount")

// substr extracts s[beg:end] as a string using byte-by-byte append.
fn substr(s string, beg i64, end i64) string =
  let out = ""
  let i i64 = beg
  for i < end:
    out = out ++ (s[i] as char)
    i = i + 1
  return out

// Match result

struct Match =
  _matched bool
  _groups  [string]   // captured groups: index 0 = whole match, 1+ = sub-groups
  _begs    [i64]      // begin offsets per group
  _ends    [i64]      // end offsets per group (for iterating find_all)

  fn matched(this Match) bool  = return this._matched
  fn count(this Match) i64     = return len(this._groups)

  // group returns the text of capture group i (0 = whole match).
  fn group(this Match, i i64) string =
    if i < 0 || i >= len(this._groups):
      return ""
    return this._groups[i]

  fn beg(this Match, i i64) i64 =
    if i < 0 || i >= len(this._begs):
      return 0
    return this._begs[i]

  fn end(this Match, i i64) i64 =
    if i < 0 || i >= len(this._ends):
      return 0
    return this._ends[i]

// Internal exec helper


fn exec_match(code *void, subject string, start i64) Match =
  let slen   = len(subject)
  let ovsize i32 = 30          // supports up to 9 capture groups
  let ov     = mem::malloc(ovsize as i64 * 4) as *i32
  let rc i32 = pcre_exec(code, 0 as *void, subject, slen as i32, start as i32, 0, ov, ovsize)
  if rc < 0:
    mem::free(ov as *void)
    return Match{_matched: false, _groups: [], _begs: [], _ends: []}

  let groups [string] = []
  let begs   [i64]    = []
  let ends   [i64]    = []
  let i i32 = 0
  for i < rc:
    let beg = ov[i * 2] as i64
    let end = ov[i * 2 + 1] as i64
    groups ++= substr(subject, beg, end)
    begs   ++= beg
    ends   ++= end
    i = i + 1
  mem::free(ov as *void)
  return Match{_matched: true, _groups: groups, _begs: begs, _ends: ends}

// Compiled regex

struct Regex =
  _code    *void    // pcre* handle (None on compile error)
  _err_msg string   // non-empty on error

  fn is_err(this Regex) bool     = return this._code == 0 as *void
  fn err_msg(this Regex) string  = return this._err_msg

  fn deinit(this Regex) =
    if this._code != 0 as *void:
      pcre_free_fn(this._code)

  // exec executes the regex against subject and returns a Match.
  fn exec(this Regex, subject string) Match =
    if this._code == 0 as *void:
      return Match{_matched: false, _groups: []}
    return exec_match(this._code, subject, 0)

  // match_at executes starting at byte offset start.
  fn match_at(this Regex, subject string, start i64) Match =
    if this._code == 0 as *void:
      return Match{_matched: false, _groups: []}
    return exec_match(this._code, subject, start)

  // find_all returns all non-overlapping matches of the full pattern in s.
  fn find_all(this Regex, s string) [string] =

    let results [string] = []
    if this._code == 0 as *void:
      return results
    let pos i64 = 0
    let slen = len(s)
    for pos <= slen:
      let m = exec_match(this._code, s, pos)
      if !m.matched():
        break
      results ++= m.group(0)
      let end = m.end(0)
      if end <= pos:
        pos = pos + 1
      else:
        pos = end
    return results

// Public API

// compile compiles a PCRE pattern and returns a Regex.
// Check is_err() before using.
fn compile(pattern string) Regex =
  let errptr *byte = 0 as *byte
  let erroff i32   = 0
  let code = pcre_compile(pattern, 0, &errptr, &erroff, 0 as *byte)
  if code == 0 as *void:
    let msg = "regex compile error"
    if (errptr as i64) != 0:
      // Build error string from C char* using byte-by-byte append.
      let msg_out = ""
      let ei i64 = 0
      for errptr[ei] != 0:
        msg_out = msg_out ++ errptr[ei]
        ei = ei + 1
      msg = msg_out
    return Regex{_code: 0 as *void, _err_msg: msg}
  return Regex{_code: code, _err_msg: ""}

// matches returns true if pattern matches anywhere in s.
fn matches(pattern string, s string) bool =
  let re = compile(pattern)
  if re.is_err():
    return false
  return re.exec(s).matched()

// find returns the first match of pattern in s, or "" if no match.
fn find(pattern string, s string) string =
  let re = compile(pattern)
  if re.is_err():
    return ""
  let m = re.exec(s)
  if !m.matched():
    return ""
  return m.group(0)

// find_all returns all non-overlapping matches of pattern in s.
fn find_all(pattern string, s string) [string] =
  let re = compile(pattern)
  if re.is_err():
    return []
  return re.find_all(s)

// replace replaces the first occurrence of pattern in s with repl.
fn replace(pattern string, s string, repl string) string =
  let re = compile(pattern)
  if re.is_err():
    return s
  let m = re.exec(s)
  if !m.matched():
    return s
  let beg = m.beg(0)
  let end = m.end(0)
  return substr(s, 0, beg) ++ repl ++ substr(s, end, len(s))

// replace_all replaces all non-overlapping occurrences of pattern in s with repl.
fn replace_all(pattern string, s string, repl string) string =
  let re = compile(pattern)
  if re.is_err():
    return s
  let result = ""
  let slen = len(s)
  let pos  i64 = 0
  for pos <= slen:
    let m = re.match_at(s, pos)
    if !m.matched():
      result = result ++ substr(s, pos, slen)
      break
    let beg = m.beg(0)
    let end = m.end(0)
    result = result ++ substr(s, pos, beg) ++ repl
    if end <= pos:
      result = result ++ substr(s, pos, pos + 1)
      pos = pos + 1
    else:
      pos = end
  return result

// split splits s by all matches of pattern.
fn split(pattern string, s string) [string] =
  let re = compile(pattern)
  let parts [string] = []
  if re.is_err():
    parts ++= s
    return parts
  let slen = len(s)
  let pos  i64 = 0
  for pos <= slen:
    let m = re.match_at(s, pos)
    if !m.matched():
      parts ++= substr(s, pos, slen)
      break
    let beg = m.beg(0)
    let end = m.end(0)
    parts ++= substr(s, pos, beg)
    if end <= pos:
      pos = pos + 1
    else:
      pos = end
  return parts

export { Regex, Match, compile, matches, find, find_all, replace, replace_all, split } as regex
