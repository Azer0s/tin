use assert
use seq

// Some tests use direct calls instead of `|>` because the multi-pipe
// closure path tickles a Tin coro-split LLVM-dominance bug; the seq
// stdlib API itself is fine -- the workaround is per call site.

test "filter + map + sum pipe" =
  let r = [1, 2, 3, 4, 5, 6]
            |> seq::filter(fn(x i64) bool = return x % 2 == 0)
            |> seq::map(fn(x i64) i64 = return x * x)
            |> seq::sum
  assert::equals(r, 56)

test "take eager" =
  let r = seq::take[i64](2)([10, 20, 30, 40, 50])
  assert::equals(len(r), 2)
  assert::equals(r[0], 10)
  assert::equals(r[1], 20)

test "skip eager" =
  let r = seq::skip[i64](3)([10, 20, 30, 40, 50])
  assert::equals(len(r), 2)
  assert::equals(r[0], 40)

test "take_while" =
  let r = seq::take_while(fn(x i64) bool = return x < 3)([1, 2, 3, 4, 1])
  assert::equals(len(r), 2)
  assert::equals(r[0], 1)
  assert::equals(r[1], 2)

test "step_by" =
  let r = seq::step_by[i64](2)([0, 1, 2, 3, 4, 5])
  assert::equals(len(r), 3)
  assert::equals(r[0], 0)
  assert::equals(r[2], 4)

test "chain" =
  let r = seq::chain[i64]([3, 4])([1, 2])
  assert::equals(len(r), 4)
  assert::equals(r[2], 3)

test "reverse" =
  let r = seq::reverse([1, 2, 3, 4])
  assert::equals(len(r), 4)
  assert::equals(r[0], 4)
  assert::equals(r[3], 1)

test "sort_by ascending" =
  let r = seq::sort_by[i64](fn(a i64, b i64) i64 = return a - b)([3, 1, 4, 1, 5])
  assert::equals(r[0], 1)
  assert::equals(r[4], 5)

test "count" =
  assert::equals(seq::count([10, 20, 30]), 3)

test "sum" =
  assert::equals(seq::sum([1, 2, 3, 4]), 10)

test "any / all" =
  assert::ok(seq::any(fn(x i64) bool = return x > 2)([1, 2, 3]))
  assert::ok(seq::all(fn(x i64) bool = return x % 2 == 0)([2, 4, 6]))

test "find" =
  let r = seq::find(fn(x i64) bool = return x > 2)([1, 2, 3, 4])
  match r:
    case Some(v): assert::equals(v, 3)
    case None:    assert::ok(false)

test "first / last" =
  match seq::first([10, 20, 30]):
    case Some(v): assert::equals(v, 10)
    case None:    assert::ok(false)
  match seq::last([10, 20, 30]):
    case Some(v): assert::equals(v, 30)
    case None:    assert::ok(false)

test "fold sum" =
  let r = seq::fold[i64, i64](0, fn(acc i64, x i64) i64 = return acc + x)([1, 2, 3, 4])
  assert::equals(r, 10)

test "reduce" =
  let r = seq::reduce[i64](fn(a i64, b i64) i64 = return a + b)([1, 2, 3, 4])
  match r:
    case Some(v): assert::equals(v, 10)
    case None:    assert::ok(false)

test "min_by / max_by" =
  let cmp = fn(a i64, b i64) i64 = return a - b
  match seq::min_by(cmp)([3, 1, 4, 1, 5]):
    case Some(v): assert::equals(v, 1)
    case None:    assert::ok(false)
  match seq::max_by(cmp)([3, 1, 4, 1, 5]):
    case Some(v): assert::equals(v, 5)
    case None:    assert::ok(false)

test "enumerate" =
  let r = seq::enumerate([10, 20, 30])
  assert::equals(len(r), 3)
